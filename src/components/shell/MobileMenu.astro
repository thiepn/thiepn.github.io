---
import ThemeControl from './ThemeControl.astro';
const path = Astro.url.pathname;
const active = (href: string) => {
  if (href === '/') return path === '/';
  if (href === '/projects/') return path.startsWith('/projects/') || path.startsWith('/project/');
  if (href === '/books/') return path.startsWith('/books/');
  if (href === '/collections/') return path.startsWith('/collections/') || path.startsWith('/collection/');
  if (href === '/about/') return path.startsWith('/about/');
  return path.startsWith(href);
};
const items = [
  ['Home', '/'],
  ['Projects', '/projects/'],
  ['Books', '/books/'],
  ['Collections', '/collections/'],
  ['About', '/about/'],
] as const;
---
<div class="mobile-menu" data-mobile-menu>
  <button class="mobile-menu__trigger" type="button" data-mobile-menu-open aria-haspopup="dialog" aria-controls="mobile-navigation">Menu</button>
  <dialog class="mobile-menu__dialog" id="mobile-navigation" data-mobile-menu-dialog aria-labelledby="mobile-menu-title">
    <div class="mobile-menu__surface">
      <header class="mobile-menu__header">
        <a class="mobile-menu__wordmark" href="/" aria-label="THIEPN portfolio home">thiepn</a>
        <button class="mobile-menu__close" type="button" data-mobile-menu-close aria-label="Close navigation menu">Close</button>
      </header>
      <div class="mobile-menu__index">
        <p class="meta" id="mobile-menu-title">Navigation</p>
        <a class="mobile-menu__search" href="/projects/" data-catalogue-search-open>
          <span><small>Find a project</small><strong>Search projects</strong></span>
          <i aria-hidden="true">⌕</i>
        </a>
        <nav aria-label="Mobile navigation">
          {items.map(([label, href]) => (
            <a class:list={[active(href) && 'is-active']} href={href} aria-current={active(href) ? 'page' : undefined}>
              <strong>{label}</strong><i aria-hidden="true">→</i>
            </a>
          ))}
        </nav>
      </div>
      <footer class="mobile-menu__footer">
        <a href="https://github.com/thiepn" aria-label="THIEPN on GitHub, external site">GitHub <span aria-hidden="true">↗</span></a>
        <ThemeControl />
      </footer>
    </div>
  </dialog>
  <noscript>
    <nav class="mobile-menu__noscript" aria-label="Mobile navigation without JavaScript">
      <a href="/">Home</a><a href="/projects/">Projects</a><a href="/books/">Books</a><a href="/collections/">Collections</a><a href="/about/">About</a>
    </nav>
  </noscript>
</div>

<script>
  const roots = document.querySelectorAll<HTMLElement>('[data-mobile-menu]');
  roots.forEach((root) => {
    const dialog = root.querySelector<HTMLDialogElement>('[data-mobile-menu-dialog]');
    const open = root.querySelector<HTMLButtonElement>('[data-mobile-menu-open]');
    const close = root.querySelector<HTMLButtonElement>('[data-mobile-menu-close]');
    if (!dialog || !open || !close) return;

    let returnFocus: HTMLElement | null = null;
    let restoreOnClose = true;
    const focusableSelector = 'a[href],button:not([disabled]),input:not([disabled]),select:not([disabled]),textarea:not([disabled]),[tabindex]:not([tabindex="-1"])';
    const focusableElements = () => [...dialog.querySelectorAll<HTMLElement>(focusableSelector)].filter((element) => element.getAttribute('aria-hidden') !== 'true' && !element.hasAttribute('hidden'));
    const openDialog = () => {
      returnFocus = document.activeElement instanceof HTMLElement ? document.activeElement : open;
      restoreOnClose = true;
      if (!dialog.open) {
        if (typeof dialog.showModal === 'function') dialog.showModal();
        else dialog.setAttribute('open', '');
      }
      close.focus();
    };
    const closeDialog = () => {
      if (!dialog.open) return;
      if (typeof dialog.close === 'function') dialog.close();
      else { dialog.removeAttribute('open'); dialog.dispatchEvent(new Event('close')); }
    };

    open.addEventListener('click', openDialog);
    close.addEventListener('click', closeDialog);
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) closeDialog();
    });
    dialog.addEventListener('keydown', (event) => {
      if (event.key !== 'Tab') return;
      const focusable = focusableElements();
      if (!focusable.length) {
        event.preventDefault();
        close.focus();
        return;
      }
      const current = document.activeElement instanceof HTMLElement ? focusable.indexOf(document.activeElement) : -1;
      const next = event.shiftKey
        ? (current <= 0 ? focusable.length - 1 : current - 1)
        : (current < 0 || current === focusable.length - 1 ? 0 : current + 1);
      event.preventDefault();
      focusable[next]?.focus();
    });
    dialog.addEventListener('close', () => { if (restoreOnClose) returnFocus?.focus(); });
    dialog.querySelectorAll<HTMLAnchorElement>('a').forEach((link) => link.addEventListener('click', () => { restoreOnClose = false; closeDialog(); }));
  });
</script>

<style>
  .mobile-menu{display:none}
  .mobile-menu__trigger{display:none;min-width:44px;min-height:44px;padding:0;border:0;background:transparent;color:var(--ink);font:500 .7rem var(--font-meta);letter-spacing:.065em;text-transform:uppercase;cursor:pointer}
  .mobile-menu__close{min-width:44px;min-height:44px;padding:0;border:0;background:transparent;color:var(--ink);font:500 .7rem var(--font-meta);letter-spacing:.065em;text-transform:uppercase;cursor:pointer}
  .mobile-menu__dialog{width:100%;max-width:none;height:100vh;height:100dvh;max-height:none;margin:0;padding:0;border:0;background:transparent;color:var(--ink)}
  .mobile-menu__dialog::backdrop{background:rgb(0 0 0 / 42%)}
  .mobile-menu__surface{min-height:100vh;min-height:100dvh;display:grid;grid-template-rows:auto 1fr auto;padding:max(10px,env(safe-area-inset-top)) max(var(--page-padding),env(safe-area-inset-right)) max(18px,env(safe-area-inset-bottom)) max(var(--page-padding),env(safe-area-inset-left));background:var(--canvas)}
  .mobile-menu__header{min-height:48px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--line-strong)}
  .mobile-menu__wordmark{min-height:44px;display:inline-flex;align-items:center;font-family:var(--font-display);font-size:1.14rem;font-weight:500;letter-spacing:-.018em;text-decoration:none}
  .mobile-menu__index{padding-top:clamp(24px,6vh,54px)}
  .mobile-menu__index>p{padding-bottom:var(--space-3);color:var(--ink-muted)}
  .mobile-menu__search{display:grid;grid-template-columns:minmax(0,1fr) 32px;align-items:center;min-height:68px;padding:9px 0;border-top:1px solid var(--line-strong);border-bottom:1px solid var(--line-strong);text-decoration:none}.mobile-menu__search span{display:grid;gap:4px}.mobile-menu__search small{font:500 .7rem var(--font-meta);letter-spacing:.06em;text-transform:uppercase;color:var(--ink-muted)}.mobile-menu__search strong{font-size:1.18rem;line-height:1;letter-spacing:-.035em;font-weight:560}.mobile-menu__search i{font-style:normal;text-align:right;font-size:1.2rem;color:var(--ink-muted)}
  .mobile-menu__index nav{border-bottom:1px solid var(--line-strong)}
  .mobile-menu__index nav a{display:grid;grid-template-columns:minmax(0,1fr) 30px;gap:var(--space-3);align-items:center;min-height:58px;border-bottom:1px solid var(--line);text-decoration:none}
  .mobile-menu__index nav a:last-child{border-bottom:0}
  .mobile-menu__index nav strong{font-size:clamp(1.25rem,5.5vw,1.72rem);line-height:1;letter-spacing:-.04em;font-weight:540}
  .mobile-menu__index nav i{font:500 1rem var(--font-meta);font-style:normal;text-align:right;color:var(--ink-muted)}
  .mobile-menu__index nav a.is-active strong{text-decoration:underline;text-decoration-thickness:2px;text-underline-offset:7px}
  .mobile-menu__footer{display:grid;grid-template-columns:1fr;gap:var(--space-3);align-items:end;padding-top:var(--space-4);border-top:1px solid var(--line-soft)}
  .mobile-menu__footer>a{min-height:44px;display:flex;align-items:center;font:500 .7rem var(--font-meta);letter-spacing:.06em;text-transform:uppercase;text-decoration:none}
  .mobile-menu__footer :global(.theme-control){justify-content:space-between;padding-top:var(--space-2)}
  .mobile-menu__noscript{display:flex;gap:12px;flex-wrap:wrap;padding:8px 0;font:500 .7rem var(--font-meta);letter-spacing:.05em;text-transform:uppercase}

  @media(max-width:720px){.mobile-menu{display:block}:global(html.js) .mobile-menu__trigger{display:block}}
  @media(forced-colors:active){.mobile-menu__dialog::backdrop{background:Canvas}.mobile-menu__surface{border:2px solid CanvasText}}
</style>
