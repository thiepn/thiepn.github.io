---
import BrandMark from '../brand/BrandMark.astro';
import ThemeControl from './ThemeControl.astro';
import MobileMenu from './MobileMenu.astro';
const path = Astro.url.pathname;
const active = (href: string) => {
  if (href === '/') return path === '/';
  if (href === '/projects/') return path.startsWith('/projects/') || path.startsWith('/project/');
  if (href === '/books/') return path.startsWith('/books/');
  if (href === '/collections/') return path.startsWith('/collections/') || path.startsWith('/collection/');
  if (href === '/about/') return path.startsWith('/about/');
  return path.startsWith(href);
};
---
<header class="site-header">
  <div class="page-shell site-header__inner">
    <a class="site-brand" href="/" aria-label="THIEPN portfolio home" data-site-brand>
      <span class="site-brand__mark"><BrandMark size={32} /></span>
      <span class="site-wordmark">thiepn</span>
    </a>
    <nav class="site-nav" aria-label="Primary navigation">
      <a class:list={[active('/') && 'is-active']} href="/" aria-current={active('/') ? 'page' : undefined}>Home</a>
      <a class:list={[active('/projects/') && 'is-active']} href="/projects/" aria-current={active('/projects/') ? 'page' : undefined}>Projects</a>
      <a class:list={[active('/books/') && 'is-active']} href="/books/" aria-current={active('/books/') ? 'page' : undefined}>Books</a>
      <a class:list={[active('/collections/') && 'is-active']} href="/collections/" aria-current={active('/collections/') ? 'page' : undefined}>Collections</a>
      <a class:list={[active('/about/') && 'is-active']} href="/about/" aria-current={active('/about/') ? 'page' : undefined}>About</a>
    </nav>
    <div class="site-header__tools">
      <a class="site-header__search" href="/projects/" data-catalogue-search-open aria-label="Search portfolio">Search <span aria-hidden="true">⌘/Ctrl K</span></a>
      <ThemeControl />
    </div>
    <MobileMenu />
  </div>
</header>

<style>
  .site-header{position:sticky;top:0;z-index:50;border-bottom:1px solid var(--line-soft);background:var(--canvas)}
  .site-header__inner{min-height:64px;display:grid;grid-template-columns:minmax(150px,1fr) auto minmax(250px,1fr);align-items:center;gap:var(--space-6)}
  .site-brand{display:inline-flex;align-items:center;gap:9px;min-height:44px;text-decoration:none;justify-self:start;color:var(--ink)}
  .site-brand__mark{display:grid;place-items:center;width:32px;height:34px;color:var(--ink)}
  .site-wordmark{font-family:var(--font-display);font-size:1.22rem;font-weight:500;letter-spacing:-.018em;line-height:1}
  .site-brand:hover .site-brand__mark,.site-brand:focus-visible .site-brand__mark{color:var(--accent)}
  .site-nav{display:flex;align-items:center;gap:clamp(16px,1.8vw,28px);font:500 .82rem var(--font-ui);letter-spacing:-.005em}.site-nav a{position:relative;min-height:44px;display:flex;align-items:center;text-decoration:none;color:var(--ink-muted)}.site-nav a:hover,.site-nav a:focus-visible,.site-nav a.is-active{color:var(--ink)}.site-nav a::after{content:'';position:absolute;left:0;right:0;bottom:5px;height:1px;background:var(--accent);transform:scaleX(0);transform-origin:left center;transition:transform var(--motion-fast) var(--ease-enter)}.site-nav a:hover::after,.site-nav a:focus-visible::after{transform:scaleX(.38)}.site-nav a.is-active::after{transform:scaleX(1)}
  .site-header__tools{justify-self:end;display:flex;align-items:center;gap:var(--space-5)}.site-header__search{position:relative;min-height:44px;display:flex;align-items:center;gap:7px;font:500 .74rem var(--font-ui);letter-spacing:0;text-decoration:none;color:var(--ink-muted)}.site-header__search span{font-family:var(--font-meta);font-size:.7rem;color:var(--ink-muted)}.site-header__search:hover,.site-header__search:focus-visible{color:var(--accent)}
  :global(.mobile-menu){justify-self:end}
  @media(max-width:960px){.site-header__inner{grid-template-columns:auto 1fr auto}.site-nav{justify-self:center;gap:var(--space-4)}.site-header__search{display:none}.site-header__tools{gap:0}.site-wordmark{display:none}}
  @media(max-width:650px){.site-header{top:0}.site-header__inner{grid-template-columns:1fr auto;min-height:58px;gap:var(--space-3);padding-inline:max(var(--page-padding),env(safe-area-inset-left)) max(var(--page-padding),env(safe-area-inset-right))}.site-nav,.site-header__tools{display:none}.site-brand{grid-column:1}.site-brand__mark{width:30px;height:31px}.site-wordmark{display:inline;font-size:1.1rem}}
  @media(prefers-reduced-motion:reduce){.site-nav a::after{transition:none}}
  @media(forced-colors:active){.site-header{background:Canvas;border-color:CanvasText}.site-nav a::after{background:Highlight}}
</style>