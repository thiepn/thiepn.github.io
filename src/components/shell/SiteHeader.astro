---
import BrandMark from '../brand/BrandMark.astro';
import MobileMenu from './MobileMenu.astro';
const path = Astro.url.pathname;
const workActive = path.startsWith('/work/') || path.startsWith('/project');
---
<header class="site-header">
  <div class="page-shell site-header__inner">
    <a class="site-brand" href="/" aria-label="THIEPN home" aria-current={path === '/' ? 'page' : undefined} data-site-brand><BrandMark size={28}/><span>THIEPN<span class="brand-dot">.</span></span></a>
    <nav class="site-nav" aria-label="Primary navigation">
      <a href="/work/" aria-current={workActive ? 'page' : undefined}>Work</a>
      <a href="/library/">Library</a>
      <a href="/about/" aria-current={path.startsWith('/about/') ? 'page' : undefined}>About</a>
    </nav>
    <a class="site-header__search" href="/projects/" data-catalogue-search-open aria-label="Search projects and collections"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="10" cy="10" r="6.5"/><path d="m15 15 5 5"/></svg><span>Search</span></a>
    <MobileMenu />
  </div>
</header>
