---
import { SITE } from '../../data/site';
interface Props { count?: number; }
const { count = 0 } = Astro.props;
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="page-shell site-footer__inner">
    <a class="site-footer__wordmark" href="/">THIEPN</a>
    <nav class="site-footer__nav" aria-label="Footer navigation">
      <a href="/projects/">Projects</a>
      <a href="/books/">Books</a>
      <a href="/collections/">Collections</a>
      <a href="/privacy/">Privacy</a>
      <a href={SITE.githubUrl} aria-label="THIEPN on GitHub, external site">GitHub <span aria-hidden="true">↗</span></a>
    </nav>
    <p class="site-footer__meta">© {year} · {String(count).padStart(2,'0')} public projects</p>
  </div>
</footer>
<style>
  .site-footer{padding:var(--space-8) 0 max(var(--space-6),env(safe-area-inset-bottom));border-top:1px solid var(--line-strong)}
  .site-footer__inner{display:grid;grid-template-columns:1fr auto auto;align-items:center;gap:var(--space-6)}
  .site-footer__wordmark{min-height:44px;display:inline-flex;align-items:center;font-size:1.08rem;font-weight:630;letter-spacing:-.05em;text-decoration:none}
  .site-footer__nav{display:flex;align-items:center;gap:var(--space-5)}
  .site-footer__nav a{min-height:44px;display:flex;align-items:center;font:500 .7rem var(--font-meta);letter-spacing:.06em;text-transform:uppercase;text-decoration:none;color:var(--ink-muted)}
  .site-footer__nav a:hover,.site-footer__nav a:focus-visible{color:var(--ink);text-decoration:underline;text-decoration-thickness:2px;text-underline-offset:5px}
  .site-footer__meta{margin:0;font:500 .7rem var(--font-meta);letter-spacing:.055em;text-transform:uppercase;color:var(--ink-muted);white-space:nowrap}
  @media(max-width:860px){.site-footer__inner{grid-template-columns:1fr auto}.site-footer__meta{grid-column:1/-1}.site-footer__nav{gap:var(--space-4);flex-wrap:wrap;justify-content:flex-end}}
  @media(max-width:540px){.site-footer__inner{grid-template-columns:1fr}.site-footer__nav{justify-content:flex-start}.site-footer__meta{grid-column:auto}}
</style>
