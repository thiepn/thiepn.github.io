---
import { SITE } from '../../data/site';
interface Props { count?: number; }
const { count = 0 } = Astro.props;
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="page-shell site-footer__inner">
    <a class="site-footer__wordmark" href="/">THIEPN</a>
    <nav class="site-footer__nav" aria-label="Footer navigation">
      <a href="/projects/">Projects</a>
      <a href="/collections/">Collections</a>
      <a href={SITE.githubUrl}>GitHub ↗</a>
    </nav>
    <p class="site-footer__meta">© {year} · {String(count).padStart(2,'0')} public projects</p>
  </div>
</footer>
<style>
  .site-footer{padding:var(--space-8) 0 max(var(--space-6),env(safe-area-inset-bottom));border-top:1px solid var(--line-strong)}
  .site-footer__inner{display:grid;grid-template-columns:1fr auto auto;align-items:center;gap:var(--space-6)}
  .site-footer__wordmark{min-height:44px;display:inline-flex;align-items:center;font-size:1.08rem;font-weight:630;letter-spacing:-.05em;text-decoration:none}
  .site-footer__nav{display:flex;align-items:center;gap:var(--space-5)}
  .site-footer__nav a{min-height:44px;display:flex;align-items:center;font:500 .64rem var(--font-meta);letter-spacing:.06em;text-transform:uppercase;text-decoration:none;color:var(--ink-muted)}
  .site-footer__nav a:hover{color:var(--ink)}
  .site-footer__meta{margin:0;font:500 .6rem var(--font-meta);letter-spacing:.055em;text-transform:uppercase;color:var(--ink-muted);white-space:nowrap}
  @media(max-width:760px){.site-footer__inner{grid-template-columns:1fr auto}.site-footer__meta{grid-column:1/-1}.site-footer__nav{gap:var(--space-4)}}
  @media(max-width:480px){.site-footer__inner{grid-template-columns:1fr}.site-footer__nav{flex-wrap:wrap}.site-footer__meta{grid-column:auto}}
</style>
