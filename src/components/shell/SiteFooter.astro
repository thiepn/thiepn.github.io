---
import { SITE } from '../../data/site';
import BrandMark from '../brand/BrandMark.astro';
interface Props { count?: number; }
const { count = 0 } = Astro.props;
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="page-shell site-footer__inner">
    <a class="site-footer__brand" href="/" aria-label="THIEPN home">
      <BrandMark size={32} />
      <span>
        <strong>thiepn</strong>
        <small>Independent digital portfolio</small>
      </span>
    </a>
    <nav class="site-footer__nav" aria-label="Footer navigation">
      <a href="/projects/">Projects</a>
      <a href="/collections/">Collections</a>
      <a href="/about/">About</a>
      <a href="/privacy/">Privacy</a>
      <a href={SITE.githubUrl} aria-label="THIEPN on GitHub, external site">GitHub <span aria-hidden="true">↗</span></a>
    </nav>
    <p class="site-footer__meta">© {year} · {String(count).padStart(2,'0')} public projects</p>
  </div>
</footer>
<style>
  .site-footer{padding:var(--space-8) 0 max(var(--space-6),env(safe-area-inset-bottom));border-top:1px solid var(--line-strong)}
  .site-footer__inner{display:grid;grid-template-columns:minmax(220px,1fr) auto auto;align-items:center;gap:var(--space-6)}
  .site-footer__brand{min-height:48px;display:inline-flex;align-items:center;gap:11px;text-decoration:none;color:var(--ink);justify-self:start}.site-footer__brand>span{display:flex;flex-direction:column;gap:3px}.site-footer__brand strong{font-family:var(--font-display);font-size:1.16rem;font-weight:500;letter-spacing:-.015em;line-height:1}.site-footer__brand small{font-size:.7rem;line-height:1.3;color:var(--ink-muted)}.site-footer__brand:hover svg,.site-footer__brand:focus-visible svg{color:var(--accent)}
  .site-footer__nav{display:flex;align-items:center;gap:clamp(14px,2vw,var(--space-5));flex-wrap:wrap;justify-content:flex-end}
  .site-footer__nav a{min-height:44px;display:flex;align-items:center;font:500 .74rem var(--font-ui);letter-spacing:0;text-decoration:none;color:var(--ink-muted)}
  .site-footer__nav a:hover,.site-footer__nav a:focus-visible{color:var(--accent);text-decoration:underline;text-underline-offset:5px}
  .site-footer__meta{margin:0;font:500 .7rem var(--font-meta);letter-spacing:.05em;text-transform:uppercase;color:var(--ink-muted);white-space:nowrap}
  @media(max-width:980px){.site-footer__inner{grid-template-columns:1fr auto}.site-footer__meta{grid-column:1/-1}.site-footer__nav{gap:var(--space-4);flex-wrap:wrap;justify-content:flex-end}}
  @media(max-width:620px){.site-footer__inner{grid-template-columns:1fr}.site-footer__nav{justify-content:flex-start}.site-footer__meta{grid-column:auto}.site-footer__brand small{display:none}}
</style>
