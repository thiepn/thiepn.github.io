---
import { SITE } from '../../data/site';
interface Props { count?: number; }
const { count = 0 } = Astro.props;
---
<footer class="site-footer">
  <div class="page-shell">
    <div class="site-footer__rule"></div>
    <div class="site-footer__grid">
      <div><a class="site-footer__wordmark" href="/">THIEPN.</a><p>An evolving index of things I've built.</p></div>
      <div class="site-footer__meta"><span>INDEX / 2026—</span><span>{String(count).padStart(3,'0')} ARTIFACTS</span><a href="/projects/" data-catalogue-search-open data-catalogue-search-random>RANDOM ACCESS →</a></div>
      <a class="site-footer__github" href={SITE.githubUrl} aria-label="THIEPN. on GitHub">GITHUB ↗</a>
    </div>
    <div class="site-footer__end" aria-hidden="true">END / {String(count).padStart(3,'0')}</div>
  </div>
</footer>
<style>
  .site-footer{padding:var(--space-9) 0 max(var(--space-6),env(safe-area-inset-bottom));overflow:hidden}.site-footer__rule{height:1px;background:var(--line-strong)}.site-footer__grid{display:grid;grid-template-columns:1.2fr .8fr auto;gap:var(--space-7);padding-top:var(--space-6);align-items:start}.site-footer__wordmark{min-height:44px;display:inline-flex;align-items:center;font-size:1.35rem;font-weight:620;letter-spacing:-.05em;text-decoration:none}.site-footer p{margin-top:var(--space-2);max-width:30ch;color:var(--ink-muted);font-size:.85rem}.site-footer__meta{display:grid;gap:6px;font:500 .66rem var(--font-meta);letter-spacing:.065em;color:var(--ink-muted);text-transform:uppercase}.site-footer__meta a{min-height:44px;display:flex;align-items:center;text-decoration:none;color:var(--ink)}.site-footer__github{min-height:44px;display:flex;align-items:center;font:500 .68rem var(--font-meta);letter-spacing:.065em;text-transform:uppercase;text-decoration:none}.site-footer__end{margin-top:var(--space-9);font-size:clamp(4rem,12vw,11rem);line-height:.74;letter-spacing:-.07em;font-weight:540;color:color-mix(in srgb,var(--ink) 5%,transparent);white-space:nowrap;user-select:none}
  @media(max-width:700px){.site-footer{padding-top:var(--space-8)}.site-footer__grid{grid-template-columns:1fr auto;gap:var(--space-5)}.site-footer__meta{grid-column:1}.site-footer__github{grid-column:2;grid-row:1}.site-footer__end{margin-top:var(--space-8)}}
  @media(max-width:379px){.site-footer__grid{grid-template-columns:1fr}.site-footer__github{grid-column:1;grid-row:auto}.site-footer__meta{grid-column:1}.site-footer__end{font-size:3.6rem}}
  @media(forced-colors:active){.site-footer__end{color:GrayText}}
</style>
