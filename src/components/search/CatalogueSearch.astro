---
---
<div class="catalogue-search" data-catalogue-search>
  <dialog class="catalogue-search__dialog" data-catalogue-search-dialog aria-labelledby="catalogue-search-title">
    <div class="catalogue-search__surface">
      <header class="catalogue-search__header">
        <div>
          <p class="meta">Portfolio search</p>
          <strong id="catalogue-search-title">Find a project</strong>
        </div>
        <button type="button" data-catalogue-search-close aria-label="Close project search">Close</button>
      </header>

      <label class="catalogue-search__query" for="catalogue-query">
        <span class="sr-only">Search projects and collections</span>
        <input id="catalogue-query" type="search" inputmode="search" autocomplete="off" spellcheck="false" placeholder="Search by title, topic, or code" role="combobox" aria-autocomplete="list" aria-controls="catalogue-search-results" aria-expanded="false" data-catalogue-search-input />
      </label>

      <div class="catalogue-search__shortcuts" aria-label="Search suggestions">
        <span>Try</span>
        <button type="button" data-search-suggestion="games">Games</button>
        <button type="button" data-search-suggestion="Bible">Bible</button>
        <button type="button" data-search-suggestion="French">French</button>
        <button type="button" data-search-suggestion="PDF">PDF</button>
        <button type="button" data-search-suggestion="typing">Typing</button>
        <a href="/projects/">All projects →</a>
      </div>

      <div class="catalogue-search__status" aria-live="polite" aria-atomic="true" data-catalogue-search-status>Featured projects</div>
      <div class="catalogue-search__results" id="catalogue-search-results" role="listbox" aria-label="Project search results" data-catalogue-search-results></div>

      <footer class="catalogue-search__footer">
        <span>↑↓ Select</span>
        <span>Enter Open details</span>
        <span>Esc Close</span>
        <a href="/collections/">Browse collections →</a>
      </footer>
    </div>
  </dialog>
</div>

<style is:global>
  .catalogue-search__dialog{width:min(760px,calc(100vw - 48px));max-width:none;max-height:min(680px,calc(100dvh - 64px));margin:clamp(28px,8vh,80px) auto auto;padding:0;border:1px solid var(--line-strong);background:var(--canvas);color:var(--ink)}
  .catalogue-search__dialog::backdrop{background:rgb(0 0 0 / 58%)}
  .catalogue-search__surface{display:grid;grid-template-rows:auto auto auto auto minmax(170px,1fr) auto;max-height:inherit;overflow:hidden}
  .catalogue-search__header{min-height:66px;display:flex;justify-content:space-between;align-items:center;gap:var(--space-5);padding:10px var(--space-5);border-bottom:1px solid var(--line-strong)}
  .catalogue-search__header>div{display:grid;gap:2px}.catalogue-search__header .meta{color:var(--ink-muted)}.catalogue-search__header strong{font-size:1.05rem;letter-spacing:-.025em;font-weight:560}
  .catalogue-search__header button{min-width:44px;min-height:44px;padding:0;border:0;background:transparent;color:var(--ink-muted);font:500 .62rem var(--font-meta);letter-spacing:.06em;text-transform:uppercase;cursor:pointer}.catalogue-search__header button:hover{color:var(--ink)}
  .catalogue-search__query{display:block;padding:var(--space-4) var(--space-5);border-bottom:1px solid var(--line-strong)}
  .catalogue-search__query input{width:100%;min-width:0;padding:4px 0;border:0;outline:0;background:transparent;color:var(--ink);font-family:var(--font-ui);font-size:clamp(1.2rem,2.4vw,1.65rem);font-weight:520;line-height:1.2;letter-spacing:-.03em}.catalogue-search__query input::placeholder{color:var(--ink-disabled)}
  .catalogue-search__shortcuts{display:flex;align-items:center;gap:6px;min-height:50px;padding:6px var(--space-5);border-bottom:1px solid var(--line);overflow-x:auto;scrollbar-width:none}.catalogue-search__shortcuts::-webkit-scrollbar{display:none}.catalogue-search__shortcuts>span{margin-right:4px;font:500 .57rem var(--font-meta);letter-spacing:.055em;text-transform:uppercase;color:var(--ink-muted)}
  .catalogue-search__shortcuts button,.catalogue-search__shortcuts a{min-height:34px;display:inline-flex;align-items:center;padding:0 9px;border:1px solid var(--line);border-radius:0;background:transparent;color:var(--ink-secondary);font:500 .58rem var(--font-meta);letter-spacing:.045em;text-transform:uppercase;text-decoration:none;white-space:nowrap;cursor:pointer}.catalogue-search__shortcuts button:hover,.catalogue-search__shortcuts a:hover{border-color:var(--line-strong);color:var(--ink);background:var(--surface-1)}.catalogue-search__shortcuts a{margin-left:auto;border-color:transparent}
  .catalogue-search__status{min-height:34px;display:flex;align-items:center;padding:0 var(--space-5);border-bottom:1px solid var(--line);font:500 .58rem var(--font-meta);letter-spacing:.055em;text-transform:uppercase;color:var(--ink-muted)}
  .catalogue-search__results{min-height:0;overflow:auto;overscroll-behavior:contain}
  .catalogue-search__result{--result-accent:var(--result-accent-light,var(--line-strong));position:relative;display:grid;grid-template-columns:62px minmax(0,1fr) 104px;gap:var(--space-4);align-items:center;width:100%;min-height:64px;padding:9px var(--space-5);border:0;border-bottom:1px solid var(--line);background:transparent;color:var(--ink);text-align:left;cursor:pointer}
  .catalogue-search__result::before{content:'';position:absolute;inset:0 auto 0 0;width:3px;background:transparent}.catalogue-search__result.is-selected{background:var(--selection)}.catalogue-search__result.is-selected::before{background:var(--result-accent)}
  .catalogue-search__result-code,.catalogue-search__result-type{font:500 .6rem var(--font-meta);letter-spacing:.06em;text-transform:uppercase;color:var(--ink-muted)}.catalogue-search__result-copy{min-width:0}.catalogue-search__result-copy strong{display:block;font-size:.98rem;line-height:1.15;letter-spacing:-.022em}.catalogue-search__result-copy small{display:block;margin-top:4px;color:var(--ink-muted);font-size:.72rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.catalogue-search__result-type{text-align:right}
  .catalogue-search__empty{display:grid;gap:6px;padding:var(--space-6) var(--space-5);color:var(--ink-secondary)}.catalogue-search__empty strong{font-size:1.15rem;letter-spacing:-.025em}.catalogue-search__empty p{max-width:52ch;font-size:.8rem;line-height:1.5}.catalogue-search__empty a{min-height:44px;display:inline-flex;align-items:center;width:max-content;margin-top:4px;font:500 .61rem var(--font-meta);letter-spacing:.055em;text-transform:uppercase;text-decoration:none}
  .catalogue-search__footer{min-height:44px;display:flex;align-items:center;gap:var(--space-4);padding:0 var(--space-5);border-top:1px solid var(--line-strong);font:500 .56rem var(--font-meta);letter-spacing:.05em;text-transform:uppercase;color:var(--ink-muted)}.catalogue-search__footer a{margin-left:auto;min-height:40px;display:flex;align-items:center;color:var(--ink);text-decoration:none}.catalogue-search__footer a:hover{text-decoration:underline;text-underline-offset:4px}
  html[data-theme="dark"] .catalogue-search__result{--result-accent:var(--result-accent-dark,var(--line-strong))}
  @media(max-width:700px){.catalogue-search__dialog{width:calc(100vw - 24px);max-height:calc(100dvh - 24px);margin:12px auto}.catalogue-search__footer span:nth-child(2){display:none}.catalogue-search__result{grid-template-columns:54px minmax(0,1fr) 82px}.catalogue-search__shortcuts a{margin-left:0}}
  @media(max-width:599px){.catalogue-search__dialog{width:100%;height:100vh;height:100dvh;max-height:none;margin:0;border:0}.catalogue-search__surface{height:100vh;height:100dvh;max-height:none;padding-top:env(safe-area-inset-top);padding-bottom:env(safe-area-inset-bottom)}.catalogue-search__header,.catalogue-search__query,.catalogue-search__shortcuts,.catalogue-search__status,.catalogue-search__footer{padding-inline:max(var(--space-4),env(safe-area-inset-left)) max(var(--space-4),env(safe-area-inset-right))}.catalogue-search__query input{font-size:1.3rem}.catalogue-search__result{grid-template-columns:48px minmax(0,1fr);padding-inline:max(var(--space-4),env(safe-area-inset-left)) max(var(--space-4),env(safe-area-inset-right))}.catalogue-search__result-type{display:none}.catalogue-search__footer{font-size:.54rem}.catalogue-search__footer span{display:none}.catalogue-search__shortcuts{gap:5px}}
  @media(prefers-reduced-motion:reduce){.catalogue-search__dialog::backdrop{transition:none}}
  @media(forced-colors:active){.catalogue-search__dialog{border:2px solid CanvasText}.catalogue-search__result.is-selected{outline:2px solid Highlight;outline-offset:-2px}.catalogue-search__result.is-selected::before{background:Highlight}}
</style>
