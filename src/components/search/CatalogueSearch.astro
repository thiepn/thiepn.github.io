---
---
<div class="catalogue-search" data-catalogue-search>
  <dialog class="catalogue-search__dialog" data-catalogue-search-dialog aria-labelledby="catalogue-search-title">
    <div class="catalogue-search__surface">
      <header class="catalogue-search__header">
        <p class="meta" id="catalogue-search-title">Search / The Index</p>
        <button type="button" data-catalogue-search-close>Esc</button>
      </header>
      <div class="catalogue-search__query">
        <span aria-hidden="true">&gt;</span>
        <label class="sr-only" for="catalogue-query">Search projects and collections</label>
        <input id="catalogue-query" type="search" inputmode="search" autocomplete="off" spellcheck="false" placeholder="Search the catalogue" role="combobox" aria-autocomplete="list" aria-controls="catalogue-search-results" aria-expanded="false" data-catalogue-search-input />
      </div>
      <div class="catalogue-search__status" aria-live="polite" aria-atomic="true" data-catalogue-search-status>Type a project, topic, or catalogue code.</div>
      <div class="catalogue-search__workspace">
        <div class="catalogue-search__results" id="catalogue-search-results" role="listbox" aria-label="Catalogue search results" data-catalogue-search-results></div>
        <aside class="catalogue-search__preview" aria-live="polite" data-catalogue-search-preview>
          <span class="meta">Catalogue ready</span>
          <strong>Search across projects and curated collections.</strong>
          <p>Try “French”, “typing”, “PDF”, “G-003”, or a project title.</p>
        </aside>
      </div>
      <div class="catalogue-search__random" hidden data-catalogue-search-random>
        <p class="meta">Random Access / Selected Artifact</p>
        <div data-catalogue-search-random-card></div>
      </div>
      <footer class="catalogue-search__footer">
        <span>↑↓ Select</span><span>Enter Details</span><span>Ctrl/⌘+Enter Open</span><button type="button" data-catalogue-search-random-trigger>Random Access R</button>
      </footer>
    </div>
  </dialog>
</div>


<style is:global>
  .catalogue-search__dialog{width:min(1180px,calc(100vw - 80px));max-width:none;max-height:min(760px,80vh);margin:10vh auto auto;padding:0;border:1px solid var(--line-strong);background:var(--canvas);color:var(--ink)}
  .catalogue-search__dialog::backdrop{background:rgb(0 0 0 / 68%)}
  .catalogue-search__surface{display:grid;grid-template-rows:auto auto auto minmax(240px,1fr) auto auto;max-height:inherit;overflow:hidden}
  .catalogue-search__header{min-height:52px;display:flex;justify-content:space-between;align-items:center;padding:0 var(--space-5);border-bottom:1px solid var(--line-strong)}
  .catalogue-search__header button{min-width:44px;min-height:44px;border:0;background:transparent;color:var(--ink-muted);font:500 .66rem var(--font-meta);letter-spacing:.07em;text-transform:uppercase;cursor:pointer}
  .catalogue-search__query{display:grid;grid-template-columns:auto minmax(0,1fr);gap:var(--space-3);align-items:center;padding:var(--space-5);border-bottom:1px solid var(--line-strong);font-size:clamp(1.6rem,3vw,2.6rem)}
  .catalogue-search__query>span{font-family:var(--font-meta);color:var(--ink-muted)}
  .catalogue-search__query input{width:100%;min-width:0;padding:0;border:0;outline:0;background:transparent;color:var(--ink);font-family:var(--font-ui);font-size:inherit;font-weight:500;line-height:1;letter-spacing:-.035em}.catalogue-search__query input::placeholder{color:var(--ink-disabled)}
  .catalogue-search__status{min-height:38px;display:flex;align-items:center;padding:0 var(--space-5);border-bottom:1px solid var(--line);font:500 .64rem var(--font-meta);letter-spacing:.06em;text-transform:uppercase;color:var(--ink-muted)}
  .catalogue-search__workspace{display:grid;grid-template-columns:minmax(0,65fr) minmax(260px,35fr);min-height:0}.catalogue-search__results{min-height:0;overflow:auto;border-right:1px solid var(--line-strong)}
  .catalogue-search__result{--result-accent:var(--result-accent-light,var(--line-strong));position:relative;display:grid;grid-template-columns:72px minmax(0,1fr) 116px;gap:var(--space-4);align-items:center;width:100%;min-height:66px;padding:10px var(--space-5);border:0;border-bottom:1px solid var(--line);background:transparent;color:var(--ink);text-align:left;cursor:pointer}
  .catalogue-search__result::before{content:'';position:absolute;inset:0 auto 0 0;width:3px;background:transparent}.catalogue-search__result.is-selected{background:var(--selection)}.catalogue-search__result.is-selected::before{background:var(--result-accent)}
  .catalogue-search__result-code,.catalogue-search__result-type{font:500 .64rem var(--font-meta);letter-spacing:.065em;text-transform:uppercase;color:var(--ink-muted)}.catalogue-search__result-copy{min-width:0}.catalogue-search__result-copy strong{display:block;font-size:1rem;line-height:1.15;letter-spacing:-.025em}.catalogue-search__result-copy small{display:block;margin-top:4px;color:var(--ink-muted);font-size:.75rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.catalogue-search__result-type{text-align:right}
  .catalogue-search__preview{--preview-accent:var(--preview-accent-light,var(--line-strong));min-width:0;display:flex;flex-direction:column;justify-content:flex-end;gap:var(--space-3);padding:var(--space-6);background:var(--canvas-raised)}.catalogue-search__preview::before{content:'';display:block;flex:1;min-height:120px;border-top:3px solid var(--preview-accent,var(--line-strong));border-bottom:1px solid var(--line);background:linear-gradient(135deg,var(--surface-1),var(--surface-3))}.catalogue-search__preview strong{font-size:clamp(1.4rem,2vw,2rem);line-height:1;letter-spacing:-.045em}.catalogue-search__preview p{color:var(--ink-secondary);font-size:.82rem;line-height:1.5}
  .catalogue-search__random{padding:var(--space-5);border-top:1px solid var(--line-strong);background:var(--canvas-raised)}.catalogue-search__random>p{margin-bottom:var(--space-3)}.catalogue-search__random-card{display:grid;grid-template-columns:80px minmax(0,1fr) auto auto;gap:var(--space-4);align-items:center}.catalogue-search__random-card strong{font-size:1.25rem;letter-spacing:-.035em}.catalogue-search__random-card a,.catalogue-search__random-card button{min-height:44px;display:inline-flex;align-items:center;border:0;background:transparent;color:var(--ink);font:500 .65rem var(--font-meta);letter-spacing:.055em;text-transform:uppercase;text-decoration:none;cursor:pointer}
  .catalogue-search__footer{min-height:46px;display:flex;align-items:center;gap:var(--space-5);padding:0 var(--space-5);border-top:1px solid var(--line-strong);font:500 .6rem var(--font-meta);letter-spacing:.055em;text-transform:uppercase;color:var(--ink-muted)}.catalogue-search__footer button{min-height:44px;margin-left:auto;padding:0;border:0;background:transparent;color:var(--ink);font:inherit;letter-spacing:inherit;text-transform:inherit;cursor:pointer}.catalogue-search__footer button:hover{text-decoration:underline;text-underline-offset:5px}
  html[data-theme="dark"] .catalogue-search__result{--result-accent:var(--result-accent-dark,var(--line-strong))}html[data-theme="dark"] .catalogue-search__preview{--preview-accent:var(--preview-accent-dark,var(--line-strong))}
  @media(max-width:900px){.catalogue-search__dialog{width:calc(100vw - 32px);margin:16px auto;max-height:calc(100dvh - 32px)}.catalogue-search__workspace{grid-template-columns:1fr}.catalogue-search__preview{display:none}.catalogue-search__results{border-right:0}.catalogue-search__footer{gap:var(--space-3);flex-wrap:wrap;padding-block:8px}.catalogue-search__result{grid-template-columns:60px minmax(0,1fr) 88px}}
  @media(max-width:599px){.catalogue-search__dialog{width:100%;height:100vh;height:100dvh;max-height:none;margin:0;border:0}.catalogue-search__surface{height:100vh;height:100dvh;max-height:none;padding-top:env(safe-area-inset-top);padding-bottom:env(safe-area-inset-bottom)}.catalogue-search__header,.catalogue-search__query,.catalogue-search__status,.catalogue-search__footer{padding-inline:max(var(--space-4),env(safe-area-inset-left)) max(var(--space-4),env(safe-area-inset-right))}.catalogue-search__query{font-size:1.55rem}.catalogue-search__result{grid-template-columns:54px minmax(0,1fr);padding-inline:max(var(--space-4),env(safe-area-inset-left)) max(var(--space-4),env(safe-area-inset-right))}.catalogue-search__result-type{display:none}.catalogue-search__footer{font-size:.56rem}.catalogue-search__random-card{grid-template-columns:54px minmax(0,1fr);gap:var(--space-2)}.catalogue-search__random-card a,.catalogue-search__random-card button{grid-row:2}}
  @media(prefers-reduced-motion:reduce){.catalogue-search__dialog::backdrop{transition:none}}
  @media(forced-colors:active){.catalogue-search__dialog{border:2px solid CanvasText}.catalogue-search__result.is-selected{outline:2px solid Highlight;outline-offset:-2px}.catalogue-search__result.is-selected::before{background:Highlight}}
</style>
