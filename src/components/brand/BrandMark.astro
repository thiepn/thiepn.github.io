---
interface Props {
  size?: number;
  label?: string;
  decorative?: boolean;
}
const { size = 24, label = 'THIEPN', decorative = true } = Astro.props;
---
<svg
  class="brand-mark"
  viewBox="0 0 32 32"
  width={size}
  height={size}
  role={decorative ? undefined : 'img'}
  aria-hidden={decorative ? 'true' : undefined}
  aria-label={!decorative ? label : undefined}
  focusable="false"
  data-brand-mark
>
  <g fill="currentColor">
    <rect x="7.4" y="8.5" width="17.2" height="2.2" />
    <rect x="14.9" y="9.5" width="2.2" height="15.5" />
    <rect x="10.9" y="18.4" width="10.2" height="1.9" />
    <rect x="5.7" y="7.5" width="3.3" height="3.3" />
    <rect x="23" y="7.5" width="3.3" height="3.3" />
    <rect x="14.35" y="23.35" width="3.3" height="3.3" />
  </g>
</svg>

<style>
  .brand-mark{display:block;flex:none;color:inherit}
</style>
