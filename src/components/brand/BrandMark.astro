---
interface Props {
  size?: number;
  label?: string;
  decorative?: boolean;
}
const { size = 24, label = 'THIEPN', decorative = true } = Astro.props;
---
<svg
  class="brand-mark"
  viewBox="0 0 32 32"
  width={size}
  height={size}
  role={decorative ? undefined : 'img'}
  aria-hidden={decorative ? 'true' : undefined}
  aria-label={!decorative ? label : undefined}
  focusable="false"
  data-brand-mark
>
  <path fill="currentColor" d="M6 5.25h20v1.5H6zM8 8.4h16v2.05h-6.72V27h-2.56V10.45H8z" />
</svg>

<style>
  .brand-mark{display:block;flex:none;color:inherit}
</style>
