---
interface Props { hidden?: boolean }
const { hidden = false } = Astro.props;
---
<section class="ws-visitor-welcome" data-visitor-welcome hidden={hidden} aria-label="Get started">
  <div class="ws-visitor-actions">
    <a class="ws-primary" href="/apps/">Explore apps</a>
    <button class="ws-button" type="button" data-action="welcome-start">Use this workspace</button>
  </div>
</section>
