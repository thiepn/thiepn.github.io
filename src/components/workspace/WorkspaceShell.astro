---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PortalAccount from '../hub/PortalAccount.astro';
import PrivateLibrary from '../hub/PrivateLibrary.astro';
import ReadingPilot from '../hub/ReadingPilot.astro';
import { getHubProjects } from '../../lib/hub';
import { providerAction } from '../../lib/providers/registry';
import { icon, appIcon } from '../../lib/workspace/icons';
import '../../styles/workspace.css';
import '../../styles/hub.css';
import '@fontsource-variable/instrument-sans';
interface Props { view?: 'home'|'tasks'|'calendar'|'trackers'|'settings'|'apps' }
const {view='home'}=Astro.props;
// The pinned reading owner trusts /home/; keep its bridge on that host route.
const readingHost = Astro.url.pathname === '/home/' || Astro.url.pathname === '/home';
const entries=await getHubProjects();
const apps=entries.map(({project,hub})=>{
 const id=project.data.slug;
 const action=id==='notes'?{label:'New note',url:providerAction('notes','capture-text')!}:id==='thiepn-library'?{label:'Continue reading',url:providerAction('library','continue-in-app')!}:id==='tms60'?{label:'Study verses',url:providerAction('tms60','open')!}:null;
 return {id,title:project.data.title,url:project.data.liveUrl!,icon:appIcon(id),category:hub.category,...(action?{action}:{})};
});
const navigation=[['home','Home','/','house'],['apps','Apps','/apps/','squares-four'],['tasks','Tasks','/home/tasks/','check-square'],['calendar','Calendar','/home/calendar/','calendar-blank'],['trackers','Trackers','/home/trackers/','chart-bar']];
---
<BaseLayout title={view==='apps'?'Apps — THIEPN HUB':'Workspace — THIEPN HUB'} description={view==='apps'?`Browse all ${apps.length} THIEPN apps, with your shortcuts, tasks and agenda in the same workspace.`:'Your personal apps, tasks, calendar and trackers in one adaptable workspace.'} noindex={view!=='apps'} workspace>
  <div class="ws" data-workspace data-view={view} data-rail="expanded">
    <aside class="ws-navigation" aria-label="Workspace navigation">
      <div class="ws-brand"><a href="/" aria-label="THIEPN HUB Home"><img src="/favicon.svg" alt="" width="30" height="30"/><strong>THIEPN HUB</strong></a><button type="button" class="ws-icon-button" data-action="rail" aria-label="Collapse sidebar" aria-expanded="true" set:html={icon('sidebar-simple')}/></div>
      <nav class="ws-nav">{navigation.map(([key,label,url,ic])=><a href={url} class:list={{active:key===view}} title={label} aria-current={key===view?'page':undefined}><Fragment set:html={icon(ic!)}/><span>{label}</span></a>)}</nav>
      <div class="ws-workspace-list"><p class="ws-label">Workspaces</p><div data-workspace-list></div><button type="button" class="ws-text-button" data-action="new-workspace"><Fragment set:html={icon('plus')}/><span>New workspace</span></button></div>
      <div class="ws-nav-bottom"><a href="/flows/" title="Workflow guides" class="ws-nav-link"><Fragment set:html={icon('book-open')}/><span>Workflow guides</span></a><a href="/home/settings/" title="Settings" class="ws-nav-link"><Fragment set:html={icon('gear-six')}/><span>Settings</span></a><button type="button" class="ws-nav-link" data-action="account" title="Account"><Fragment set:html={icon('user-circle')}/><span data-profile-label>This device</span></button></div>
    </aside>
    <div class="ws-body">
      <header class="ws-topbar"><button class="ws-search-trigger" type="button" data-action="search"><Fragment set:html={icon('magnifying-glass')}/><span>Search apps, tasks and notes</span><kbd>Ctrl K</kbd></button><div class="ws-topbar-actions"><button class="ws-primary ws-icon-button" type="button" data-action="capture" aria-label="Quick capture"><Fragment set:html={icon('plus')}/></button><button class="ws-icon-button" type="button" data-action="account" aria-label="Account"><Fragment set:html={icon('user-circle')}/></button></div></header>
      <div class="ws-columns">
        <section class="ws-main" aria-labelledby="ws-title">
          <header class="ws-page-heading"><div><h1 id="ws-title">{view==='apps'?'Apps':'Personal workspace'}</h1><p data-workspace-date>{view==='apps'?`${apps.length} apps for work, learning and everything in between`: 'Your day, your way'}</p></div><div class="ws-toolbar" data-toolbar>{view==='home' && <button class="ws-button" type="button" data-action="customize"><Fragment set:html={icon('sliders-horizontal')}/>Customize</button>}</div></header>
          <div class="ws-notice" data-workspace-notice role="status" hidden></div>
          <div data-workspace-content>{view==='apps' ? <slot/> : <><section class="ws-widget"><header><h2>App shortcuts</h2><a href="/apps/">All apps</a></header><div class="ws-shortcuts">{apps.slice(0,4).map(app=><a href={app.url} class="ws-app"><span class="ws-app-icon" set:html={icon(app.icon)}/><strong>{app.title}</strong><Fragment set:html={icon('arrow-up-right')}/></a>)}</div></section><p class="ws-muted" data-initial-status>Opening your local workspace…</p></>}</div>
          <noscript><p class="ws-notice">App links work without JavaScript. Tasks, calendar, trackers and layout customization require JavaScript.</p></noscript>
        </section>
        <aside class="ws-planner" aria-label="Tasks and agenda"><div data-planner><h2>Today</h2><p class="ws-muted">Your local calendar and tasks will appear here.</p></div><footer><span set:html={icon('desktop')}/><div><strong>This device</strong><p data-workspace-status role="status">Opening local storage…</p><button class="ws-text-button" type="button" data-action="export">Export backup</button></div></footer></aside>
      </div>
    </div>
    <nav class="ws-mobile-nav" aria-label="Mobile workspace navigation">{navigation.slice(0,3).map(([key,label,url,ic])=><a href={url} aria-current={key===view?'page':undefined}><Fragment set:html={icon(ic!)}/><span>{label}</span></a>)}<button type="button" data-more-trigger aria-haspopup="dialog" aria-controls="ws-more"><Fragment set:html={icon('dots-three')}/><span>More</span></button></nav>
    <dialog id="ws-more" class="ws-dialog ws-more-dialog" data-more-dialog aria-labelledby="ws-more-title"><header><h2 id="ws-more-title">Your workspace</h2><button type="button" class="ws-button" data-more-close>Close</button></header><nav aria-label="More workspace sections">{[...navigation.slice(3),['settings','Settings','/home/settings/','gear-six']].map(([key,label,url,ic])=><a href={url} class="ws-more-link" aria-current={key===view?'page':undefined}><Fragment set:html={icon(ic!)}/><span>{label}</span><Fragment set:html={icon('arrow-right')}/></a>)}</nav></dialog>
    <div class="ws-toast" data-workspace-toast role="status" hidden></div>
    <dialog class="ws-dialog" data-workspace-dialog aria-labelledby="ws-dialog-title"><form data-workspace-form><header><h2 id="ws-dialog-title"></h2><button type="button" class="ws-button" data-action="close-dialog" aria-label="Close dialog">Close</button></header><div data-dialog-fields></div><p class="ws-error" data-dialog-error role="alert"></p><footer><button type="button" class="ws-button" data-action="close-dialog">Cancel</button><button type="submit" class="ws-primary" data-dialog-submit>Save</button></footer></form></dialog>
    <dialog class="ws-dialog ws-search-dialog" data-search-dialog aria-labelledby="ws-search-title"><header><h2 id="ws-search-title">Search your workspace</h2><button type="button" class="ws-button" data-action="close-search">Close</button></header><label class="ws-sr" for="workspace-search">Search apps, tasks and notes</label><input id="workspace-search" type="search" placeholder="Search apps, tasks and notes…" autocomplete="off"/><div data-search-results></div></dialog>
    <dialog class="ws-dialog" data-account-dialog aria-label="Account and connections"><h2>Account and connections</h2><button class="ws-button" type="button" data-action="close-account">Close</button><PortalAccount/>{readingHost ? <><div class="ws-account-tools"><button type="button" class="ws-button" data-action="privacy" data-connection-privacy>Hide personal content</button></div><div data-reading-shell data-library-host-route="/home/"><PrivateLibrary/><ReadingPilot/></div></> : <a class="ws-button" href="/home/#reading">Open reading connection</a>}<p class="ws-muted">This workspace saves on this device. Connecting an account does not enable cloud sync.</p><a href="/home/connections/" class="ws-button">Existing app connections</a></dialog>
    <script is:inline type="application/json" data-workspace-apps set:html={JSON.stringify(apps).replace(/</g,'\u003c')}/>
  </div>
</BaseLayout>
<script>import '../../scripts/workspace-home';import '../../scripts/portal-library';</script>
