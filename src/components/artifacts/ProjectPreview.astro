---
import fs from 'node:fs';
import path from 'node:path';
import type { CollectionEntry } from 'astro:content';
import InteractivePreview from './InteractivePreview.astro';

interface Props {
  project: CollectionEntry<'projects'>;
  size?: 'hero' | 'feature' | 'standard';
  focusable?: boolean;
}

const { project, size = 'standard', focusable = false } = Astro.props;
const p = project.data;
const automaticPoster = `/projects/${p.slug}/capture.jpg`;
const hasAutomaticCapture = p.preview.type !== 'video' && fs.existsSync(path.join(process.cwd(), 'public', 'projects', p.slug, 'capture.jpg'));
const poster = p.preview.poster ?? (hasAutomaticCapture ? automaticPoster : undefined);
const captured = Boolean(poster) && (p.preview.provenance === 'captured' || hasAutomaticCapture);
const focalPoint = p.preview.focalPoint ?? '50% 50%';
const eager = size === 'hero' || size === 'feature';
---
{captured && poster ? (
  <div
    class:list={['project-preview', `project-preview--${size}`]}
    data-preview-slug={p.slug}
    data-preview-kind="static"
    data-preview-source={poster}
    data-preview-provenance="captured"
    data-preview-state="static"
    data-preview-focusable={focusable ? 'true' : 'false'}
  >
    <div class="captured-preview" aria-hidden="true">
      <img
        src={poster}
        alt=""
        loading={eager ? 'eager' : 'lazy'}
        decoding="async"
        style={`object-position:${focalPoint};`}
      />
    </div>
  </div>
) : (
  <InteractivePreview project={project} size={size} focusable={focusable} />
)}

<style>
  .project-preview{position:relative;min-width:0;isolation:isolate}
  .captured-preview{position:relative;overflow:hidden;aspect-ratio:16/10;background:var(--surface-1);border:1px solid var(--line)}
  .captured-preview img{display:block;width:100%;height:100%;object-fit:cover;background:var(--surface-1)}
  @media(forced-colors:active){.captured-preview{border:1px solid CanvasText}}
</style>
