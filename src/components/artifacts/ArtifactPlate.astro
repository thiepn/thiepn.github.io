---
import type { CollectionEntry } from 'astro:content';
import InteractivePreview from './InteractivePreview.astro';
import StatusLabel from './StatusLabel.astro';
import ArtifactActions from './ArtifactActions.astro';
interface Props { project: CollectionEntry<'projects'>; variant?: 'hero'|'feature'|'standard'; }
const { project, variant='standard' } = Astro.props;
const p = project.data;
const accentStyle = `--project-accent-light:${p.accent.light};--project-accent-dark:${p.accent.dark};`;
const tags = [p.category, ...p.tags.slice(0,2)].join(' / ');
---
<article class:list={["artifact-plate", `artifact-plate--${variant}`, 'artifact-cut']} style={accentStyle}>
  <div class="artifact-plate__meta"><span>{p.code}</span><StatusLabel status={p.status} /></div>
  <div class="artifact-plate__rule" aria-hidden="true"></div>
  <a class="artifact-plate__preview" href={`/project/${p.slug}/`} aria-label={`View ${p.title} details`}><InteractivePreview project={project} size={variant === 'hero' ? 'hero' : variant === 'feature' ? 'feature' : 'standard'} /></a>
  <div class="artifact-plate__body">
    <p class="artifact-plate__eyebrow">{p.subtitle}</p>
    <h3><a href={`/project/${p.slug}/`}>{p.title}</a></h3>
    <p class="artifact-plate__summary">{p.summary}</p>
    <p class="artifact-plate__tags">{tags}</p>
    <ArtifactActions slug={p.slug} title={p.title} liveUrl={p.liveUrl ?? null} primaryLabel={p.actions.primaryLabel} />
  </div>
</article>

<style>
  .artifact-plate { --project-accent:var(--project-accent-light); position:relative; min-width:0; container-type:inline-size; background:var(--surface-1); border:1px solid var(--line); }
  :global(html[data-theme="dark"]) .artifact-plate { --project-accent:var(--project-accent-dark); }
  .artifact-plate::after { content:""; position:absolute; z-index:2; top:-1px; left:-1px; width:3px; height:28px; background:var(--project-accent); }
  .artifact-plate__meta { min-height:36px; display:flex;align-items:center;justify-content:space-between;gap:12px;padding:0 11px;font-family:var(--font-meta);font-size:.62rem;letter-spacing:.07em;text-transform:uppercase;color:var(--ink-muted) }
  .artifact-plate__rule { height:1px;background:var(--line); }
  .artifact-plate__preview { display:block;text-decoration:none; }
  .artifact-plate__preview:focus-visible { outline-color:var(--project-accent); outline-offset:3px; }
  .artifact-plate__body { padding:var(--space-4); min-width:0; }
  .artifact-plate__eyebrow,.artifact-plate__tags { font-family:var(--font-meta);font-size:.59rem;line-height:1.4;letter-spacing:.055em;text-transform:uppercase;color:var(--ink-muted);overflow-wrap:anywhere; }
  h3 { margin-top:7px;font-size:clamp(1.2rem,1.7vw,1.6rem);line-height:1.05;letter-spacing:-.035em;font-weight:560;overflow-wrap:anywhere; }
  h3 a { text-decoration:none; }
  h3 a:focus-visible{outline-color:var(--project-accent)}
  .artifact-plate__summary { margin-top:var(--space-3);max-width:48ch;color:var(--ink-secondary);font-size:.82rem;line-height:1.48; }
  .artifact-plate__tags { margin-top:var(--space-4);padding-top:var(--space-3);border-top:1px solid var(--line-soft);white-space:nowrap;overflow:hidden;text-overflow:ellipsis; }
  :global(.artifact-actions) { margin-top:var(--space-2); }
  .artifact-plate--standard .artifact-plate__summary{display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}
  .artifact-plate--hero .artifact-plate__body { padding:var(--space-6); }
  .artifact-plate--hero h3 { font-size:clamp(2rem,3.2vw,3.5rem);max-width:12ch; }
  .artifact-plate--hero .artifact-plate__summary { font-size:1rem;max-width:56ch; }
  .artifact-plate--feature .artifact-plate__body{padding:var(--space-5)}
  .artifact-plate--feature h3 { font-size:clamp(1.45rem,2.3vw,2.1rem); }
  .artifact-plate--feature .artifact-plate__summary{font-size:.88rem}

  @container (max-width: 420px){
    .artifact-plate__body,.artifact-plate--hero .artifact-plate__body{padding:var(--space-4)}
    .artifact-plate--hero h3,.artifact-plate--feature h3{font-size:clamp(1.55rem,8cqw,2rem)}
    .artifact-plate__summary{font-size:.84rem}
    .artifact-plate__tags{margin-top:var(--space-3)}
  }
  @container (max-width: 310px){
    .artifact-plate__meta{padding-inline:10px;font-size:.6rem}
    .artifact-plate__body{padding:var(--space-3)}
    h3{font-size:1.18rem}
    .artifact-plate__eyebrow,.artifact-plate__tags{font-size:.57rem}
  }
  @media(hover:none){.artifact-plate__preview{filter:none}.artifact-plate__summary{color:var(--ink-secondary)}}
  @media(forced-colors:active){.artifact-plate::after{background:Highlight}.artifact-plate__preview:focus-visible,h3 a:focus-visible{outline-color:Highlight}}
</style>
