---
import type { CollectionEntry } from 'astro:content';
interface Props {
  project: CollectionEntry<'projects'>;
  size?: 'hero' | 'feature' | 'standard' | 'compact';
  variant?: string;
}
const { project, size = 'standard', variant } = Astro.props;
const p = project.data;
const accentStyle = `--project-accent-light:${p.accent.light};--project-accent-dark:${p.accent.dark};`;
const label = p.type === 'game' || p.type === 'quiz' ? 'PLAY STATE' : p.type === 'flashcards' || p.type === 'study-system' ? 'LEARNING STATE' : p.type === 'tool' || p.type === 'app' ? 'WORKSPACE' : 'ARTIFACT';
const previewLabel = p.preview.type === 'video' ? 'VIDEO DEMO' : p.preview.type === 'synthetic' ? 'INTERACTIVE DEMO' : 'STATIC PREVIEW';
---
<div class:list={["aperture", `aperture--${size}`, `aperture--${p.category}`, `aperture--${p.slug}`, variant && `aperture--variant-${variant}`]} style={accentStyle} aria-hidden="true">
  <div class="aperture__chrome"><span>{label}</span><span>{p.code}</span></div>

  {p.slug === 'pdf-studio' ? (
    <div class="scene scene--pdf">
      <div class="pdf-appbar"><strong>PDF STUDIO</strong><span>ORGANIZE</span><span>REDACT</span><span>ANNOTATE</span></div>
      <div class="pdf-rail">
        <span class="pdf-thumb pdf-thumb--1"><b>01</b></span>
        <span class="pdf-thumb pdf-thumb--2"><b>02</b></span>
        <span class="pdf-thumb pdf-thumb--3"><b>03</b></span>
        <span class="pdf-thumb pdf-thumb--4"><b>04</b></span>
      </div>
      <div class="pdf-stage">
        <div class="pdf-page pdf-page--back"><i></i><i></i><i></i><em>02</em></div>
        <div class="pdf-page pdf-page--moving"><b>REPORT</b><i></i><i></i><i class="redact"></i><i></i><em>03 / 08</em></div>
        <div class="pdf-selection">REDACTION AREA</div>
      </div>
      <div class="pdf-tool"><span>LOCAL / PRIVATE</span><strong>EXPORT READY</strong></div>
    </div>
  ) : p.slug === 'manuscript' ? (
    <div class="scene scene--manuscript">
      <div class="manuscript-bar"><span>MANUSCRIPT</span><span>BOOK PROJECT / 07</span></div>
      <div class="editor-pane">
        <span class="md-heading"># Design systems that last</span>
        <span class="md-line md-line--1">A durable system begins with constraints.</span>
        <span class="md-line md-line--2">**Structure** should survive presentation.</span>
        <span class="md-line md-line--3">![figure](archive-grid.png)</span>
        <span class="md-cursor">▌</span>
      </div>
      <div class="publish-arrow"><i></i><span>BUILD</span></div>
      <div class="paper-pane">
        <small>CHAPTER / 04</small>
        <strong>Design systems<br/>that last</strong>
        <i class="paper-rule"></i>
        <p>A durable system begins with constraints. Structure should survive presentation.</p>
        <div class="paper-figure"><span></span><span></span><span></span></div>
        <em>MANUSCRIPT / OUTPUT READY</em>
      </div>
      <div class="manuscript-progress"><span></span></div>
    </div>
  ) : p.slug === 'clean30' ? (
    <div class="scene scene--clean">
      <div class="clean-head"><strong>KITCHEN RESET</strong><span class="clean-count"><b>00</b><b>01</b><b>02</b><b>03</b> / 03</span></div>
      <ul>
        <li class="clean-task clean-task--1"><i></i><span>Clear surfaces</span></li>
        <li class="clean-task clean-task--2"><i></i><span>Wipe counters</span></li>
        <li class="clean-task clean-task--3"><i></i><span>Sweep floor</span></li>
      </ul>
      <div class="clean-progress"><span></span></div>
      <div class="clean-complete"><span>30 / RESET</span><strong>COMPLETE</strong></div>
    </div>
  ) : p.slug === 'wordstrike' ? (
    <div class="scene scene--strike">
      <span class="strike-grid"></span>
      <div class="strike-hud"><span>CAMPAIGN / LV 24</span><span>CORE ■■■</span></div>
      <b class="word-target word-target--a">VECTOR</b>
      <b class="word-target word-target--k">SIGNAL</b>
      <b class="word-target word-target--x">ORBIT</b>
      <div class="strike-core"><span>CORE</span><strong>x03</strong></div>
      <div class="strike-entry">SIGN<span>AL</span><i></i></div>
      <small>COMBO 03 / SCORE 08420 / 97% ACC</small>
    </div>
  ) : p.slug === 'french-3000' ? (
    <div class="scene scene--french">
      <div class="french-card french-card--one">
        <small>A2 / VOCABULARY · CARD 1248</small>
        <strong>bonjour</strong><span>/bɔ̃.ʒuʁ/</span>
        <div class="french-divider"></div>
        <em>hello · good day</em>
        <p>Bonjour, comment allez-vous ?</p>
      </div>
      <div class="french-card french-card--two">
        <small>A2 / VOCABULARY · NEXT</small>
        <strong>prendre</strong><span>/pʁɑ̃dʁ/</span>
        <div class="french-divider"></div>
        <em>to take</em>
      </div>
      <div class="rating"><i>Again</i><i>Hard</i><i class="active">Good</i><i>Easy</i></div>
      <div class="french-progress"><span></span></div>
    </div>
  ) : p.slug === 'ligo-quizabend' ? (
    <div class="scene scene--quiz">
      <div class="quiz-top"><span>QUESTION 06 / ROUND 02</span><strong><i>00:18</i><i>00:07</i></strong></div>
      <p>Which answer belongs here?</p>
      <div class="answers"><i>A / 21%</i><i class="answer-correct">B / 46%</i><i>C / 18%</i><i>D / 15%</i></div>
      <div class="quiz-lock">ANSWER LOCKED / B</div>
      <div class="quiz-score"><span>TEAM 01</span><strong><i>2400</i><i>2800</i></strong></div>
      <div class="quiz-presenter">PRESENTER / CONNECTED</div>
    </div>
  ) : p.slug === 'analysis-ii-klausurlabor' ? (
    <div class="scene scene--analysis">
      <div class="analysis-head"><span>AUFGABE 4.2</span><strong>λ <i>1.25</i><i>1.75</i></strong></div>
      <div class="axis axis--x"></div><div class="axis axis--y"></div>
      <svg class="analysis-curve analysis-curve--a" viewBox="0 0 300 170" preserveAspectRatio="none"><path d="M0 135 C45 128 54 34 104 62 S158 156 205 92 S260 42 300 58" fill="none" stroke="currentColor" stroke-width="3"/></svg>
      <svg class="analysis-curve analysis-curve--b" viewBox="0 0 300 170" preserveAspectRatio="none"><path d="M0 140 C38 118 63 48 110 54 S160 132 205 84 S248 31 300 43" fill="none" stroke="currentColor" stroke-width="3"/></svg>
      <span class="math-label">f<sub>λ</sub>(x)</span>
      <span class="analysis-point"></span>
      <div class="analysis-result"><span>RESULT</span><strong>∫₀¹ f<sub>λ</sub>(x) dx &gt; 0</strong></div>
    </div>
  ) : p.slug === 'curio' ? (
    <div class="scene scene--curio"><small>LOT 014 / INSPECTION</small><div class="curio-object"><span></span></div><strong>€ 420 — 680</strong><div class="curio-bid">CURRENT BID&nbsp;&nbsp; €510</div></div>
  ) : p.slug === 'wordfall' ? (
    <div class="scene scene--wordfall"><div class="orbit"></div><span class="planet"></span><b class="threat threat--1">R</b><b class="threat threat--2">Q</b><b class="threat threat--3">M</b><small>ORBITAL DEFENSE / 93%</small></div>
  ) : p.slug === 'nebula-foundry' ? (
    <div class="scene scene--nebula"><small>FOUNDRY / EPOCH 06</small><strong>1.42e18</strong><div class="nebula-lines"><i></i><i></i><i></i><i></i></div><div class="nebula-node n1"></div><div class="nebula-node n2"></div><div class="nebula-node n3"></div></div>
  ) : p.slug === 'le-carnet-francais' ? (
    <div class="scene scene--carnet"><div class="carnet-tabs"><span>VOCAB</span><span>GRAMMAIRE</span><span>ÉCOUTE</span></div><div class="carnet-page"><small>LE CARNET / UNITÉ 08</small><strong>Parler du quotidien</strong><p><b>Je viens de</b> finir mes devoirs.</p><p><b>Il faut</b> prendre le métro.</p><div class="carnet-note">A1 → A2 / 72%</div></div></div>
  ) : p.slug === 'franzosisch-flashcards' ? (
    <div class="scene scene--flashcards"><small>DECK / FRENCH 2.2</small><div class="flash-stack"><div class="flash-card flash-card--back"></div><div class="flash-card"><span>FR → DE</span><strong>pourtant</strong><em>trotzdem · jedoch</em><i>GOOD / 3D</i></div></div><div class="flash-meter"><span></span></div></div>
  ) : p.slug === 'analysis-ii-lernsystem' ? (
    <div class="scene scene--theorem"><div class="theorem-head"><span>ANALYSIS II / 5.5.6</span><b>RECALL</b></div><div class="theorem-sheet"><small>SATZ</small><strong>Lokale Lipschitz-Stetigkeit</strong><p>∀ x ∈ K ∃ L &gt; 0 : ‖f(x)-f(y)‖ ≤ L‖x-y‖</p><div class="proof-steps"><i></i><i></i><i></i><i></i></div></div></div>
  ) : p.slug === 'algodat-study-system' ? (
    <div class="scene scene--algodat"><div class="algo-head"><span>ALGORITHM / TRACE 07</span><strong>O(n log n)</strong></div><div class="algo-tree"><i class="a1"></i><i class="a2"></i><i class="a3"></i><i class="a4"></i><i class="a5"></i><i class="a6"></i><span class="edge e1"></span><span class="edge e2"></span><span class="edge e3"></span><span class="edge e4"></span></div><div class="algo-trace"><b>01</b><span>split</span><b>02</b><span>recurse</span><b>03</b><span>merge</span></div></div>
  ) : p.slug === 'tms60' ? (
    <div class="scene scene--tms"><div class="tms-ref">2 CORINTHIANS 5:17</div><blockquote>Therefore, if anyone is in Christ, he is a new creation.</blockquote><div class="tms-mask"><span>Therefore, if anyone is in Christ,</span><b>••••••••••••••••••••••••</b></div><div class="tms-state"><span>MAINTAIN</span><strong>08 / 60</strong></div></div>
  ) : p.slug === 'the-bible-challenge' ? (
    <div class="scene scene--bible-quiz"><div class="bq-head"><span>THE BIBLE CHALLENGE</span><strong>07 / 10</strong></div><p>Who rebuilt the walls of Jerusalem?</p><div class="bq-options"><i>A / Ezra</i><i class="selected">B / Nehemiah</i><i>C / Samuel</i><i>D / Daniel</i></div><div class="bq-footer">COLLECTION / OLD TESTAMENT</div></div>
  ) : p.slug === 'echoframe-last-signal' ? (
    <div class="scene scene--echo"><div class="echo-head"><span>ECHOFRAME / SIGNAL 06</span><strong>-72 dB</strong></div><svg viewBox="0 0 320 120" preserveAspectRatio="none"><path d="M0 63 L24 63 L31 48 L38 78 L45 58 L52 64 L76 64 L86 22 L94 97 L103 56 L113 64 L144 64 L153 41 L161 82 L169 59 L180 64 L213 64 L222 30 L231 91 L240 61 L250 64 L320 64" fill="none" stroke="currentColor" stroke-width="2"/></svg><div class="echo-marker"><span></span><b>TRACE / LOCKED</b></div></div>
  ) : p.slug === 'skyspire' ? (
    <div class="scene scene--skyspire"><div class="spire-height">HEIGHT / <strong>0842M</strong></div><div class="spire"><i class="p1"></i><i class="p2"></i><i class="p3"></i><i class="p4"></i><span class="runner"></span></div><div class="spire-floor">SECTOR 12 / ASCENDING</div></div>
  ) : p.slug === 'analysis-idle' ? (
    <div class="scene scene--analysis-idle"><div class="idle-top"><span>ANALYSIS IDLE</span><strong>∑ 8.42e12</strong></div><div class="idle-formula">lim<sub>n→∞</sub> a<sub>n</sub> = ∞</div><div class="idle-bars"><i></i><i></i><i></i><i></i><i></i><i></i></div><div class="idle-row"><span>DERIVATIVE</span><b>×128</b><span>INTEGRAL</span><b>×64</b></div></div>
  ) : (
    <div class="scene scene--generic">
      <span class="generic-code">{p.code}</span><strong>{p.title}</strong><p>{p.subtitle}</p><div class="generic-rule"></div><small>{p.category} / {p.preview.tier}</small>
    </div>
  )}
  <div class="aperture__footer"><span>{p.preview.tier}</span><span>{previewLabel}</span></div>
</div>

<style>
  .aperture { --project-accent:var(--project-accent-light); position:relative; overflow:hidden; aspect-ratio:16/10; min-height:0; background:#0c0d0f; color:#f5f2eb; border-block:1px solid color-mix(in srgb,currentColor 18%,transparent); isolation:isolate; }
  :global(html[data-theme="dark"]) .aperture { --project-accent:var(--project-accent-dark); }
  .aperture::before { content:""; position:absolute; inset:0; background:linear-gradient(120deg,color-mix(in srgb,var(--project-accent) 10%,transparent),transparent 44%),linear-gradient(to bottom,rgba(255,255,255,.015),rgba(0,0,0,.08)); pointer-events:none; z-index:1; }
  .aperture__chrome,.aperture__footer { position:absolute; z-index:8; left:12px; right:12px; display:flex; justify-content:space-between; gap:12px; font-family:var(--font-meta); font-size:.55rem; letter-spacing:.08em; color:rgba(245,242,235,.58); text-transform:uppercase; }
  .aperture__chrome { top:9px; }.aperture__footer { bottom:8px; }
  .scene { position:absolute; z-index:2; inset:28px 14px 26px; overflow:hidden; }
  .scene small,.scene em { font-family:var(--font-meta); font-size:.55rem; letter-spacing:.075em; text-transform:uppercase; font-style:normal; }

  /* PDF Studio / P5 custom feature composition */
  .scene--pdf{display:grid;grid-template-columns:20% 1fr;grid-template-rows:28px 1fr 28px;background:#d8d6cf;color:#111;border:1px solid rgba(0,0,0,.12)}
  .pdf-appbar{grid-column:1/-1;display:flex;align-items:center;gap:13px;padding:0 8px;border-bottom:1px solid rgba(0,0,0,.18);font:500 .46rem var(--font-meta);letter-spacing:.055em;background:#ece9e1}.pdf-appbar strong{margin-right:auto;font-size:.52rem}.pdf-appbar span:nth-of-type(2){color:#8b2424}
  .pdf-rail{grid-column:1;grid-row:2;display:grid;grid-template-columns:1fr 1fr;gap:5px;padding:7px;border-right:1px solid rgba(0,0,0,.18);background:#c4c2bc}.pdf-thumb{position:relative;background:#f5f2eb;border:1px solid rgba(0,0,0,.18);min-height:36px}.pdf-thumb b{position:absolute;bottom:3px;right:4px;font:500 .38rem var(--font-meta);color:#777}.pdf-thumb--3{outline:1px solid var(--project-accent);outline-offset:1px}
  .pdf-stage{position:relative;grid-column:2;grid-row:2;background:#aaa9a5;overflow:hidden}.pdf-page{position:absolute;width:43%;height:74%;background:#faf8f2;box-shadow:0 7px 18px rgba(0,0,0,.18);padding:12px}.pdf-page--back{left:31%;top:14%;transform:rotate(-4deg)}.pdf-page--moving{left:39%;top:8%;transform:rotate(2deg)}.pdf-page b{display:block;font-size:1.05rem;letter-spacing:-.03em;margin-bottom:9px}.pdf-page i{display:block;height:3px;background:#c3c1bb;margin-top:6px}.pdf-page i:nth-of-type(2){width:72%}.pdf-page .redact{width:54%;height:9px;background:#161616}.pdf-page em{position:absolute;bottom:7px;right:7px;color:#777}.pdf-selection{position:absolute;left:49%;top:51%;width:25%;height:12%;border:1px dashed #9d3535;color:#8b2424;font:500 .34rem var(--font-meta);display:grid;place-items:center;opacity:0}
  .pdf-tool{grid-column:1/-1;grid-row:3;display:flex;justify-content:space-between;align-items:center;padding:0 8px;border-top:1px solid rgba(0,0,0,.18);background:#eeeae2;font:500 .43rem var(--font-meta);letter-spacing:.05em}.pdf-tool strong{color:var(--project-accent);opacity:.38}

  /* Manuscript / P5 custom feature composition */
  .scene--manuscript{display:grid;grid-template-columns:1fr 34px 1fr;grid-template-rows:26px 1fr 3px;background:#121313;border:1px solid rgba(255,255,255,.12)}
  .manuscript-bar{grid-column:1/-1;display:flex;justify-content:space-between;align-items:center;padding:0 8px;border-bottom:1px solid rgba(255,255,255,.12);font:500 .44rem var(--font-meta);letter-spacing:.06em;color:#999}.manuscript-bar span:first-child{color:var(--project-accent)}
  .editor-pane{position:relative;padding:14px 10px;overflow:hidden;font:500 .52rem/1.7 var(--font-meta);color:#aaa}.editor-pane>span{display:block;white-space:nowrap}.md-heading{color:var(--project-accent)}.md-line{opacity:.55}.md-cursor{position:absolute;left:10px;bottom:15px;color:var(--project-accent)}
  .publish-arrow{position:relative;border-inline:1px solid rgba(255,255,255,.08);display:grid;place-items:center;color:var(--project-accent)}.publish-arrow i{width:14px;height:1px;background:currentColor;position:relative}.publish-arrow i::after{content:"";position:absolute;right:0;top:-3px;width:6px;height:6px;border-top:1px solid currentColor;border-right:1px solid currentColor;transform:rotate(45deg)}.publish-arrow span{position:absolute;bottom:8px;font:500 .35rem var(--font-meta);writing-mode:vertical-rl;letter-spacing:.06em;color:#777}
  .paper-pane{position:relative;background:#f0ede5;color:#171714;padding:13px 12px;overflow:hidden}.paper-pane small{color:#888}.paper-pane strong{display:block;font-size:clamp(.8rem,2vw,1.18rem);line-height:.95;margin-top:8px;letter-spacing:-.035em}.paper-rule{display:block;height:1px;background:#bbb6aa;margin:10px 0 8px}.paper-pane p{font-size:.48rem;line-height:1.6;color:#56534c;max-width:30ch}.paper-figure{display:grid;grid-template-columns:repeat(3,1fr);gap:3px;margin-top:9px;height:28px}.paper-figure span{border:1px solid #c5c0b4;background:#dedad0}.paper-pane em{position:absolute;bottom:7px;right:8px;color:#777;font-size:.34rem}.manuscript-progress{grid-column:1/-1;background:#292929}.manuscript-progress span{display:block;height:100%;width:12%;background:var(--project-accent)}

  /* Clean30 / P4 */
  .scene--clean{background:#f3efe4;color:#171714;padding:14px}.clean-head{display:flex;justify-content:space-between;font:600 .65rem var(--font-meta);letter-spacing:.05em}.clean-count{position:relative;min-width:42px;text-align:right}.clean-count b{position:absolute;right:18px;top:0;opacity:0;font-weight:600}.clean-count b:first-child{opacity:1}.scene--clean ul{list-style:none;padding:0;margin:18px 0 0;display:grid;gap:9px}.clean-task{display:grid;grid-template-columns:18px 1fr;align-items:center;font-size:.72rem;padding-bottom:6px;border-bottom:1px solid #cbc6b7}.clean-task i{width:10px;height:10px;border:1px solid #777}.clean-progress{position:absolute;left:14px;right:14px;bottom:14px;height:3px;background:#d5d0c2}.clean-progress span{display:block;width:0;height:100%;background:var(--project-accent)}.clean-complete{position:absolute;inset:38px 14px 17px;background:rgba(243,239,228,.95);display:grid;place-content:center;text-align:center;opacity:0}.clean-complete span{font:500 .48rem var(--font-meta);letter-spacing:.07em;color:#777}.clean-complete strong{font-size:1.25rem;letter-spacing:-.04em;margin-top:3px;color:var(--project-accent)}

  /* WORDSTRIKE / P4 gameplay poster */
  .scene--strike{background:#05080e;border:1px solid rgba(255,255,255,.12)}.strike-grid{position:absolute;inset:0;background-image:linear-gradient(rgba(0,245,255,.035) 1px,transparent 1px),linear-gradient(90deg,rgba(0,245,255,.035) 1px,transparent 1px);background-size:20px 20px}.strike-hud{position:absolute;left:10px;right:10px;top:8px;display:flex;justify-content:space-between;font:500 .42rem var(--font-meta);letter-spacing:.055em;color:#8d99a8}.word-target{position:absolute;font:650 .62rem var(--font-meta);letter-spacing:.045em;color:#e9fbff;padding:3px 5px;border-left:1px solid var(--project-accent);background:rgba(4,11,17,.78);box-shadow:0 0 12px color-mix(in srgb,var(--project-accent) 16%,transparent)}.word-target--a{left:11%;top:29%}.word-target--k{right:12%;top:24%}.word-target--x{right:19%;bottom:25%}.strike-core{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);width:64px;height:64px;border:1px solid var(--project-accent);display:grid;place-content:center;text-align:center;clip-path:polygon(13% 0,100% 0,100% 87%,87% 100%,0 100%,0 13%);box-shadow:0 0 24px color-mix(in srgb,var(--project-accent) 16%,transparent)}.strike-core span{font:500 .36rem var(--font-meta);letter-spacing:.08em;color:#778491}.strike-core strong{font:650 .65rem var(--font-meta);color:var(--project-accent)}.strike-entry{position:absolute;left:50%;bottom:10px;transform:translateX(-50%);min-width:80px;text-align:center;font:600 .5rem var(--font-meta);letter-spacing:.08em;color:#fff}.strike-entry span{color:#64727e}.strike-entry i{display:block;height:1px;background:var(--project-accent);margin-top:4px}.scene--strike small{position:absolute;left:10px;bottom:7px;color:#65717f;font-size:.36rem}

  /* French 3000 / P4 */
  .scene--french{background:#e8e4d9;color:#171714;padding:16px}.french-card{position:absolute;inset:16px 16px 37px}.french-card--two{opacity:0;transform:translateX(10px)}.scene--french small{color:#6a675f}.scene--french strong{display:block;font-size:clamp(1.2rem,3vw,2.1rem);font-weight:560;margin-top:16px}.scene--french .french-card>span{display:block;font-size:.68rem;color:#777;margin-top:2px}.french-divider{height:1px;background:#bbb7ac;margin:12px 0 8px}.scene--french em{color:#555}.scene--french p{font-size:.56rem;margin-top:8px;color:#68655e}.rating{position:absolute;left:16px;right:16px;bottom:11px;display:grid;grid-template-columns:repeat(4,1fr);gap:4px}.rating i{font:500 .45rem var(--font-meta);font-style:normal;text-align:center;padding:5px 2px;border:1px solid #c5c0b4}.rating i.active{border-color:var(--project-accent);color:var(--project-accent)}.french-progress{position:absolute;left:16px;right:16px;top:9px;height:2px;background:#d3cfc4}.french-progress span{display:block;height:100%;width:42%;background:var(--project-accent)}

  /* LiGo / P4 */
