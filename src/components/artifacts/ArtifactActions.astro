---
interface Props {
  slug: string;
  title: string;
  liveUrl?: string | null;
  primaryLabel?: string;
  compact?: boolean;
}
const { slug, title, liveUrl, primaryLabel = 'Open project', compact = false } = Astro.props;
---
<div class:list={["artifact-actions", compact && "artifact-actions--compact"]}>
  <a class="artifact-actions__details" href={`/project/${slug}/`} aria-label={`View ${title} details`}>Details →</a>
  {liveUrl && <a class="artifact-actions__open" href={liveUrl} aria-label={`${primaryLabel}: ${title}`}>{primaryLabel} ↗</a>}
</div>
<style>
  .artifact-actions { display:flex; flex-wrap:wrap; align-items:center; justify-content:space-between; gap:var(--space-3) var(--space-4); font-family:var(--font-meta); font-size:.68rem; line-height:1.3; letter-spacing:.055em; text-transform:uppercase; }
  .artifact-actions a { min-height:44px; display:inline-flex; align-items:center; text-decoration:none; }
  .artifact-actions__details { color:var(--ink-muted); }
  .artifact-actions__open { color:var(--ink); }
  .artifact-actions a:hover { text-decoration:underline; text-underline-offset:5px; }
  .artifact-actions--compact { justify-content:flex-start; }
  @media(max-width:340px){.artifact-actions{align-items:flex-start;flex-direction:column;gap:0}.artifact-actions a{width:100%}}
</style>
