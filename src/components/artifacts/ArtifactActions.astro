---
interface Props {
  slug: string;
  title: string;
  liveUrl?: string | null;
  primaryLabel?: string;
  compact?: boolean;
}
const { slug, title, liveUrl, primaryLabel = 'Open project', compact = false } = Astro.props;
---
<div class:list={["artifact-actions", compact && "artifact-actions--compact"]} data-project-actions>
  {liveUrl && <a class="artifact-actions__open structural-button" href={liveUrl} aria-label={`${primaryLabel}: ${title}`} data-primary-project-action>{primaryLabel} <span aria-hidden="true">↗</span></a>}
  <a class="artifact-actions__details" href={`/project/${slug}/`} aria-label={`View ${title} details`}>Details <span aria-hidden="true">→</span></a>
</div>
<style>
  .artifact-actions { display:flex; flex-wrap:wrap; align-items:center; justify-content:flex-start; gap:var(--space-2) var(--space-4); font-family:var(--font-meta); font-size:.68rem; line-height:1.3; letter-spacing:.055em; text-transform:uppercase; }
  .artifact-actions a { min-height:44px; display:inline-flex; align-items:center; gap:.42em; text-decoration:none; }
  .artifact-actions a span{display:inline-block;transition:transform var(--motion-fast) var(--ease-enter)}
  .artifact-actions__open { min-width:92px; justify-content:center; }
  .artifact-actions__details { color:var(--ink-muted); }
  .artifact-actions__details:hover { text-decoration:underline; text-underline-offset:5px; }
  @media(hover:hover) and (pointer:fine){.artifact-actions__details:hover span,.artifact-actions__details:focus-visible span{transform:translateX(var(--motion-nudge))}.artifact-actions__open:hover span,.artifact-actions__open:focus-visible span{transform:translate(var(--motion-nudge),calc(var(--motion-nudge) * -.65))}}
  .artifact-actions--compact { justify-content:flex-start; }
  @media(max-width:340px){.artifact-actions{align-items:flex-start;flex-direction:column;gap:0}.artifact-actions a{width:100%}.artifact-actions__open{justify-content:center}}
  @media(prefers-reduced-motion:reduce){.artifact-actions a span{transition:none}}
</style>
