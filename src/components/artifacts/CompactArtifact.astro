---
import type { CollectionEntry } from 'astro:content';
import StatusLabel from './StatusLabel.astro';
interface Props { project: CollectionEntry<'projects'>; }
const { project } = Astro.props; const p = project.data;
---
<article class="compact-artifact">
  <span class="compact-artifact__code">{p.code}</span>
  <div><h3><a href={`/project/${p.slug}/`}>{p.title}</a></h3><p>{p.subtitle}</p></div>
  <StatusLabel status={p.status} />
</article>
<style>
  .compact-artifact{display:grid;grid-template-columns:68px minmax(0,1fr) auto;gap:var(--space-4);align-items:center;padding:var(--space-3) 0;border-bottom:1px solid var(--line-soft)}
  .compact-artifact__code{font:500 .68rem var(--font-meta);letter-spacing:.06em;color:var(--ink-muted)}h3{font-size:1rem;line-height:1.15}h3 a{text-decoration:none}p{margin-top:2px;color:var(--ink-muted);font-size:.78rem}
  @media(max-width:599px){.compact-artifact{grid-template-columns:54px minmax(0,1fr)}.compact-artifact>:last-child{grid-column:2}}
</style>
