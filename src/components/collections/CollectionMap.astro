---
import type { CollectionEntry } from 'astro:content';
import ProjectPreview from '../artifacts/ProjectPreview.astro';
import { chooseCollectionMapSlugs, createCollectionMapEdges, createCollectionMapPoints } from '../../lib/collection-map';

interface Props {
  collection: CollectionEntry<'collections'>;
  projects: CollectionEntry<'projects'>[];
}
const { collection, projects } = Astro.props;
const c = collection.data;
const bySlug = new Map(projects.map((project) => [project.data.slug, project]));
const visibleSlugs = chooseCollectionMapSlugs(c.projects, c.anchors);
const mapProjects = visibleSlugs.map((slug) => bySlug.get(slug)).filter((value): value is CollectionEntry<'projects'> => Boolean(value));
const points = createCollectionMapPoints(mapProjects.map((project) => project.data.slug));
const pointBySlug = new Map(points.map((point) => [point.slug, point]));
const edges = createCollectionMapEdges(points, c.relationships);
const initial = mapProjects.find((project) => c.anchors.includes(project.data.slug)) ?? mapProjects[0];
const largeCollection = c.projects.length > 8;
---
<div class="collection-map-shell" data-collection-map data-initial-slug={initial?.data.slug}>
  <p class="sr-only" aria-live="polite" data-collection-map-status></p>
  <div class="collection-map-shell__meta">
    <span class="meta">{largeCollection ? `${String(mapProjects.length).padStart(2,'0')} mapped / ${String(c.projects.length).padStart(2,'0')} total` : `${String(mapProjects.length).padStart(2,'0')} mapped projects`}</span>
    <span class="meta">Focus a project or relationship to inspect</span>
  </div>

  <div class="collection-map-shell__workspace">
    <div class="collection-map" role="group" aria-label={`${c.title} relationship map`}>
      <svg class="collection-map__lines" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
        {edges.map((edge) => (
          <line
            data-collection-edge
            data-edge-from={edge.from}
            data-edge-to={edge.to}
            x1={edge.x1}
            y1={edge.y1}
            x2={edge.x2}
            y2={edge.y2}
            vector-effect="non-scaling-stroke"
          />
        ))}
      </svg>
      {edges.map((edge) => (
        <span
          class="collection-map__edge-label"
          data-collection-edge
          data-edge-from={edge.from}
          data-edge-to={edge.to}
          style={`--edge-x:${edge.midX}%;--edge-y:${edge.midY}%;`}
          aria-hidden="true"
        >{edge.label}</span>
      ))}
      {mapProjects.map((project) => {
        const point = pointBySlug.get(project.data.slug)!;
        const p = project.data;
        const isAnchor = c.anchors.includes(p.slug);
        return (
          <a
            class:list={['collection-map__node', isAnchor && 'is-anchor']}
            href={`/project/${p.slug}/`}
            data-collection-node
            data-project-slug={p.slug}
            data-project-title={p.title}
            style={`--node-x:${point.x}%;--node-y:${point.y}%;--node-accent-light:${p.accent.light};--node-accent-dark:${p.accent.dark};`}
          >
            <span>{p.code}{isAnchor ? ' / FEATURED' : ''}</span>
            <strong>{p.title}</strong>
          </a>
        );
      })}
    </div>

    <aside class="collection-map-shell__preview" aria-label="Selected collection artifact preview" aria-live="polite" aria-atomic="true">
      {mapProjects.map((project) => (
        <div class="collection-map-shell__preview-item" data-collection-preview={project.data.slug} hidden={project.data.slug !== initial?.data.slug}>
          <ProjectPreview project={project} size="feature" />
          <div class="collection-map-shell__preview-copy">
            <span class="meta">{project.data.code} / {project.data.category}</span>
            <strong>{project.data.title}</strong>
            <p>{project.data.subtitle}</p>
            <a href={`/project/${project.data.slug}/`}>Details →</a>
          </div>
        </div>
      ))}
    </aside>
  </div>

  <div class="collection-map-shell__relations" aria-label="Collection relationships">
    {c.relationships.map((relationship, index) => (
      <button
        type="button"
        data-collection-relation
        data-relation-from={relationship.from}
        data-relation-to={relationship.to}
        aria-pressed="false"
      >
        <span>{String(index + 1).padStart(2,'0')} / {bySlug.get(relationship.from)?.data.code} ↔ {bySlug.get(relationship.to)?.data.code}</span>
        <strong>{relationship.label}</strong>
        <p>{relationship.note}</p>
      </button>
    ))}
  </div>
</div>

<style>
.collection-map-shell{margin-top:var(--space-4)}
.collection-map-shell__meta{display:flex;justify-content:space-between;gap:var(--space-4);padding-bottom:10px;border-bottom:1px solid var(--line)}
.collection-map-shell__workspace{display:grid;grid-template-columns:minmax(0,1.6fr) minmax(250px,.62fr);gap:var(--space-4);margin-top:var(--space-4);align-items:stretch}
.collection-map{position:relative;min-height:360px;border:1px solid var(--line);background:linear-gradient(var(--line-soft) 1px,transparent 1px),linear-gradient(90deg,var(--line-soft) 1px,transparent 1px),var(--canvas-raised);background-size:40px 40px;overflow:hidden}
.collection-map__lines{position:absolute;inset:0;width:100%;height:100%;overflow:visible}.collection-map__lines line{stroke:var(--line-strong);stroke-width:1;transition:stroke 150ms ease,stroke-width 150ms ease}.collection-map__lines line.is-active{stroke:var(--ink-secondary);stroke-width:2}
.collection-map__edge-label{position:absolute;left:var(--edge-x);top:var(--edge-y);max-width:112px;transform:translate(-50%,-50%);padding:2px 4px;background:var(--canvas-raised);border:1px solid var(--line);font:500 .47rem var(--font-meta);letter-spacing:.035em;text-transform:uppercase;color:var(--ink-muted);text-align:center;transition:color 150ms ease,border-color 150ms ease}.collection-map__edge-label.is-active{color:var(--ink);border-color:var(--line-strong)}
.collection-map__node{--node-accent:var(--node-accent-light);position:absolute;left:var(--node-x);top:var(--node-y);width:min(158px,27%);min-height:58px;transform:translate(-50%,-50%);padding:8px 9px;border:1px solid var(--line-strong);background:var(--canvas);color:var(--ink);text-decoration:none;transition:border-color 150ms ease,background 150ms ease,transform 150ms ease;z-index:2}.collection-map__node::before{content:'';position:absolute;left:-1px;top:-1px;bottom:-1px;width:3px;background:transparent}.collection-map__node span{display:block;font:500 .49rem var(--font-meta);letter-spacing:.055em;text-transform:uppercase;color:var(--ink-muted)}.collection-map__node strong{display:block;margin-top:5px;font-size:clamp(.72rem,.9vw,.88rem);line-height:1.08;letter-spacing:-.02em}.collection-map__node.is-anchor{border-width:2px}.collection-map__node.is-active,.collection-map__node:focus-visible{transform:translate(-50%,-50%) scale(1.015);background:var(--surface-1);border-color:var(--ink-secondary)}.collection-map__node.is-active::before,.collection-map__node:focus-visible::before{background:var(--node-accent)}
:global(html[data-theme='dark']) .collection-map__node{--node-accent:var(--node-accent-dark)}
.collection-map-shell__preview{min-width:0;border-top:2px solid var(--line-strong);background:var(--surface-1);padding-top:var(--space-2)}.collection-map-shell__preview-item[hidden]{display:none}.collection-map-shell__preview-item.is-active{display:block}.collection-map-shell__preview-copy{padding:var(--space-3) 2px}.collection-map-shell__preview-copy strong{display:block;margin-top:8px;font-size:clamp(1.1rem,1.7vw,1.55rem);line-height:1;letter-spacing:-.035em}.collection-map-shell__preview-copy p{margin-top:5px;color:var(--ink-secondary);font-size:.75rem}.collection-map-shell__preview-copy a{display:inline-flex;align-items:center;min-height:44px;margin-top:8px;font:500 .59rem var(--font-meta);letter-spacing:.055em;text-transform:uppercase;text-decoration:none}
.collection-map-shell__relations{margin-top:var(--space-4);border-top:1px solid var(--line-strong)}.collection-map-shell__relations button{position:relative;display:grid;grid-template-columns:160px minmax(150px,.65fr) minmax(0,1.35fr);gap:var(--space-4);width:100%;padding:11px 0;border:0;border-bottom:1px solid var(--line);background:transparent;color:var(--ink);text-align:left;cursor:pointer}.collection-map-shell__relations button::before{content:'';position:absolute;left:0;top:0;bottom:0;width:3px;background:transparent}.collection-map-shell__relations button.is-active::before,.collection-map-shell__relations button:focus-visible::before{background:var(--ink)}.collection-map-shell__relations span{font:500 .54rem var(--font-meta);letter-spacing:.05em;text-transform:uppercase;color:var(--ink-muted)}.collection-map-shell__relations strong{font-size:.82rem;line-height:1.2}.collection-map-shell__relations p{color:var(--ink-secondary);font-size:.72rem;line-height:1.42}
@media(max-width:1000px){.collection-map-shell__workspace{grid-template-columns:1fr}.collection-map{min-height:340px}.collection-map-shell__preview{max-width:620px}}
@media(max-width:699px){.collection-map-shell__meta{align-items:flex-start;flex-direction:column;gap:4px}.collection-map{display:flex;flex-direction:column;min-height:0;padding:var(--space-3);background:var(--canvas-raised)}.collection-map__lines,.collection-map__edge-label{display:none}.collection-map__node{position:relative;left:auto;top:auto;width:100%;min-height:56px;transform:none!important;margin:0;padding:10px 11px 10px 36px;border-width:0 0 1px;background:transparent}.collection-map__node::after{content:'';position:absolute;left:17px;top:0;bottom:0;width:1px;background:var(--line-strong)}.collection-map__node:first-of-type::after{top:50%}.collection-map__node:last-of-type::after{bottom:50%}.collection-map__node::before{left:13px;top:50%;bottom:auto;width:9px;height:9px;transform:translateY(-50%) rotate(45deg);border:1px solid var(--line-strong);background:var(--canvas-raised);z-index:2}.collection-map__node.is-active::before,.collection-map__node:focus-visible::before{background:var(--node-accent);border-color:var(--node-accent)}.collection-map-shell__relations button{grid-template-columns:1fr;gap:5px;padding:11px 0 11px 10px}.collection-map-shell__preview-copy strong{font-size:1.3rem}}
@media(prefers-reduced-motion:reduce){.collection-map__node,.collection-map__lines line,.collection-map__edge-label{transition:none}}
@media(forced-colors:active){.collection-map{border:1px solid CanvasText;background:Canvas}.collection-map__node{border-color:CanvasText}.collection-map__node.is-active{outline:2px solid Highlight}.collection-map-shell__relations button.is-active{outline:2px solid Highlight;outline-offset:-2px}}
</style>
