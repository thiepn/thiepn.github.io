---
import type { CollectionEntry } from 'astro:content';
interface Props { collection: CollectionEntry<'collections'>; projectTitles?: string[]; }
const { collection, projectTitles = [] } = Astro.props;
const c=collection.data;
const relationLabels=c.relationships.slice(0,3).map((relationship)=>relationship.label);
---
<article class="collection-preview artifact-cut">
  <div class="collection-preview__meta"><span>{c.code}</span><span>{String(c.projects.length).padStart(2,'0')} ARTIFACTS / {String(c.relationships.length).padStart(2,'0')} LINKS</span></div>
  <div class="collection-preview__head">
    <div>
      <h3><a href={`/collection/${c.slug}/`}>{c.title}</a></h3>
      <p>{c.summary}</p>
    </div>
    <ol class="collection-preview__relations" aria-label="Example relationships">
      {relationLabels.map((label,index)=><li><span>{String(index+1).padStart(2,'0')}</span><b>{label}</b></li>)}
    </ol>
  </div>
  <div class="collection-preview__logic">
    <span class="meta">Collection logic</span>
    <p>{c.editorialNote}</p>
  </div>
  <ul class="collection-preview__members">
    {projectTitles.slice(0,4).map((title)=><li>{title}</li>)}
    {projectTitles.length>4&&<li>+ {String(projectTitles.length-4).padStart(2,'0')} more</li>}
  </ul>
  <a class="collection-preview__action" href={`/collection/${c.slug}/`}>Explore relationships →</a>
</article>
<style>
.collection-preview{position:relative;min-height:410px;padding:var(--space-5);border:1px solid var(--line);background:var(--surface-1);overflow:hidden}.collection-preview__meta{display:flex;justify-content:space-between;gap:var(--space-4);font:500 .66rem var(--font-meta);letter-spacing:.07em;color:var(--ink-muted);text-transform:uppercase}.collection-preview__head{display:grid;grid-template-columns:minmax(0,1fr) minmax(150px,.58fr);gap:var(--space-6);align-items:start}.collection-preview__head>div{min-width:0}h3{margin-top:var(--space-6);font-size:clamp(1.7rem,3vw,2.8rem);line-height:.98;letter-spacing:-.045em;max-width:12ch}h3 a{text-decoration:none}p{margin-top:var(--space-4);max-width:44ch;color:var(--ink-secondary);font-size:.86rem}.collection-preview__relations{list-style:none;margin:var(--space-6) 0 0;padding:0;border-top:1px solid var(--line-strong)}.collection-preview__relations li{display:grid;grid-template-columns:26px 1fr;gap:8px;padding:7px 0;border-bottom:1px solid var(--line-soft);font:500 .5rem/1.35 var(--font-meta);letter-spacing:.045em;text-transform:uppercase;color:var(--ink-muted)}.collection-preview__relations span{color:var(--ink-disabled)}.collection-preview__relations b{font-weight:500;color:var(--ink-secondary)}.collection-preview__logic{margin-top:var(--space-5);max-width:68%;padding-top:var(--space-3);border-top:1px solid var(--line)}.collection-preview__logic p{display:-webkit-box;margin-top:6px;font-size:.72rem;line-height:1.45;color:var(--ink-muted);-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}.collection-preview__members{position:absolute;left:var(--space-5);bottom:64px;list-style:none;padding:0;margin:0;display:flex;flex-wrap:wrap;gap:7px 14px;max-width:78%;font:500 .58rem var(--font-meta);letter-spacing:.055em;text-transform:uppercase;color:var(--ink-muted)}.collection-preview__members li::before{content:'+';margin-right:5px;color:var(--line-strong)}.collection-preview__action{position:absolute;left:var(--space-5);bottom:18px;font:500 .66rem var(--font-meta);letter-spacing:.055em;text-transform:uppercase;text-decoration:none}
@media(max-width:950px){.collection-preview__head{grid-template-columns:1fr}.collection-preview__relations{display:none}.collection-preview__logic{max-width:82%}}
@media(max-width:599px){.collection-preview{min-height:0;padding:var(--space-4)}.collection-preview__logic{max-width:none}.collection-preview__relations{display:block;margin-top:var(--space-5)}.collection-preview__members{position:static;max-width:none;margin-top:var(--space-7)}.collection-preview__action{position:static;display:inline-flex;min-height:44px;align-items:center;margin-top:var(--space-4)}}
</style>
