---
import '../../styles/office-documents.css';
---
<section class="office-root ws-surface" data-office data-office-mode="split" aria-labelledby="office-heading">
  <header class="office-intro"><div><h2 id="office-heading">Documents</h2><p>Local Markdown drafts · no cloud sync or import from Manuscript</p></div><div class="office-create"><label for="office-template">Starting layout</label><select id="office-template" data-office-template disabled><option value="blank">Blank document</option><option value="meeting">Meeting notes</option><option value="brief">Project brief</option><option value="report">Structured report</option><option value="study">Study notes</option></select><button type="button" class="ws-button" data-office-new disabled>New document</button></div></header>
  <div class="office-grid">
    <nav class="office-list" aria-label="Your documents">
      <label for="office-search">Find documents</label>
      <input id="office-search" type="search" data-office-search maxlength="120" placeholder="Search titles and contents" autocomplete="off" disabled/>
      <div class="office-library-tools"><label for="office-sort">Order</label><select id="office-sort" data-office-sort disabled><option value="recent">Recently edited</option><option value="title">Title A–Z</option></select></div>
      <p class="ws-muted" data-office-count aria-live="polite">Documents on this device</p>
      <div class="office-bundle-controls">
        <p class="ws-muted" data-office-bundle-count aria-live="polite">0 documents selected</p>
        <div class="office-bundle-shortcuts"><button type="button" data-office-select-visible disabled>Select visible</button><button type="button" data-office-clear-selection disabled>Clear selection</button></div>
        <button type="button" class="ws-button" data-office-bundle disabled>Export selected Markdown (.zip)</button>
        <p class="ws-muted">Exports saved Markdown only. For document history use the separate JSON backup; unsaved work is excluded.</p>
      </div>
      <div data-office-list></div>
      <div class="office-import-picker"><label for="office-import-file">Import a Markdown file</label><input id="office-import-file" type="file" accept=".md,.markdown,text/markdown" data-office-import-file disabled/><p class="ws-muted">Local .md/.markdown only · maximum 256 KB</p></div>
      <button type="button" class="ws-button office-backup-button" data-office-backup disabled>Backup saved documents (.json)</button>
      <div class="office-restore-picker"><label for="office-restore-file">Restore an Office backup</label><input id="office-restore-file" type="file" accept=".json,application/json" data-office-restore-file disabled/><p class="ws-muted">Only missing original document IDs will be added. Existing records are never replaced.</p></div>
      <p class="ws-muted">A backup includes saved versions and revision history. Unsaved drafts must be exported separately.</p>
    </nav>
    <section class="office-editor" aria-label="Document editor">
      <section class="office-backup-review" data-office-restore-panel hidden aria-label="Review Office backup restoration">
        <h3>Review backup restoration</h3>
        <p data-office-restore-summary class="ws-muted"></p>
        <p class="ws-muted">Records are added to the current local Office owner only. Backups have no verified owner identity; all existing IDs and history remain untouched.</p>
        <div class="office-restore-list" data-office-restore-list></div>
        <div class="office-import-actions"><button type="button" class="ws-button" data-office-restore-confirm disabled>Restore missing documents</button><button type="button" class="ws-button" data-office-restore-cancel disabled>Cancel</button></div>
      </section>
      <section class="office-import-preview" data-office-import-panel hidden aria-label="Review Markdown import">
        <h3>Review before importing</h3>
        <p data-office-import-info class="ws-muted"></p>
        <label for="office-import-title">New document title</label><input id="office-import-title" data-office-import-title maxlength="120" autocomplete="off" disabled/>
        <p class="ws-muted">A separate new Office document will be created. This preview shows only the first part of the file.</p>
        <div class="office-import-render office-preview" data-office-import-render></div>
        <div class="office-import-actions"><button type="button" class="ws-button" data-office-import-confirm disabled>Import as new document</button><button type="button" class="ws-button" data-office-import-cancel disabled>Cancel</button></div>
      </section>
      <div class="office-actions"><button type="button" class="ws-button" data-office-save disabled>Save</button><button type="button" class="ws-button" data-office-export disabled>Export .md</button><button type="button" class="ws-button" data-office-html disabled>Export .html</button><button type="button" class="ws-button" data-office-print disabled>Print / PDF</button><label for="office-history">Revision</label><select id="office-history" data-office-history disabled><option value="">History</option></select><button type="button" class="ws-button" data-office-restore disabled>Restore selected</button></div>
      <label for="office-title">Title</label><input id="office-title" maxlength="120" data-office-title disabled placeholder="Document title" autocomplete="off"/>
      <div class="office-format" role="toolbar" aria-label="Markdown formatting">
        <button type="button" data-office-format="heading" disabled>Heading</button><button type="button" data-office-format="bold" disabled><strong>Bold</strong></button><button type="button" data-office-format="italic" disabled><em>Italic</em></button><button type="button" data-office-format="bullet" disabled>Bullets</button><button type="button" data-office-format="number" disabled>Numbers</button><button type="button" data-office-format="quote" disabled>Quote</button><button type="button" data-office-format="code" disabled>Code</button><button type="button" data-office-format="link" disabled>Link</button><button type="button" data-office-format="table" disabled>Table</button>
      </div>
      <div class="office-modes" role="group" aria-label="Editor layout"><button type="button" data-office-mode="write" aria-pressed="false">Write</button><button type="button" data-office-mode="split" aria-pressed="true">Split</button><button type="button" data-office-mode="preview" aria-pressed="false">Preview</button></div>
      <div class="office-compose"><div class="office-source"><label for="office-body">Document (Markdown)</label><textarea id="office-body" data-office-body disabled spellcheck="true" placeholder="Start writing…"></textarea></div><section class="office-preview-panel" aria-label="Markdown preview"><h3>Preview</h3><div data-office-preview class="office-preview" aria-live="off"></div></section></div>
      <aside class="office-outline" aria-labelledby="office-outline-heading"><h3 id="office-outline-heading">Document outline</h3><p class="ws-muted" data-office-outline-empty>No headings yet. Add # or ## to navigate a long document.</p><nav data-office-outline aria-label="Document headings"></nav></aside>
      <p class="ws-muted">Plain Markdown source, not a rich-text or DOCX editor. Saved locally in an isolated Office database.</p>
    </section>
  </div>
  <div class="office-print-sheet" data-office-print-sheet aria-hidden="true"></div>
  <p data-office-status role="status" aria-live="polite">Checking Hub privacy and local storage…</p>
</section>
<script>import '../../scripts/office-documents';</script>
