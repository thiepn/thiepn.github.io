---
import '../../styles/office-documents.css';
---
<section class="office-root ws-surface" data-office data-office-mode="split" aria-labelledby="office-heading">
  <header class="office-intro"><div><h2 id="office-heading">Documents</h2><p>Local Markdown drafts · no cloud sync or import from Manuscript</p></div><div class="office-create"><label for="office-template">Starting layout</label><select id="office-template" data-office-template disabled><option value="blank">Blank document</option><option value="meeting">Meeting notes</option><option value="brief">Project brief</option><option value="report">Structured report</option><option value="study">Study notes</option></select><button type="button" class="ws-button" data-office-new disabled>New document</button></div></header>
  <div class="office-grid">
    <nav class="office-list" aria-label="Your documents">
      <label for="office-search">Find documents</label>
      <input id="office-search" type="search" data-office-search maxlength="120" placeholder="Search titles and contents" autocomplete="off" disabled/>
      <div class="office-library-tools"><label for="office-sort">Order</label><select id="office-sort" data-office-sort disabled><option value="recent">Recently edited</option><option value="title">Title A–Z</option></select></div>
      <p class="ws-muted" data-office-count aria-live="polite">Documents on this device</p>
      <div class="office-bundle-controls">
        <p class="ws-muted" data-office-bundle-count aria-live="polite">0 documents selected</p>
        <div class="office-bundle-shortcuts"><button type="button" data-office-select-visible disabled>Select visible</button><button type="button" data-office-clear-selection disabled>Clear selection</button></div>
        <button type="button" class="ws-button" data-office-bundle disabled>Export selected Markdown (.zip)</button>
        <p class="ws-muted">Exports saved Markdown only. For document history use the separate JSON backup; unsaved work is excluded.</p>
      </div>
      <div data-office-list></div>
      <div class="office-import-picker"><label for="office-import-file">Import a Markdown file</label><input id="office-import-file" type="file" accept=".md,.markdown,text/markdown" data-office-import-file disabled/><p class="ws-muted">Local .md/.markdown only · maximum 256 KB</p></div>
<div class="office-multi-picker"><label for="office-multi-files">Import multiple Markdown documents</label><input id="office-multi-files" data-office-multi-files type="file" accept=".md,.markdown,text/markdown" multiple disabled/><p class="ws-muted">Select up to 20 files; each 256 KB maximum, 4 MB combined. All files must pass validation before importing any.</p></div>
      <button type="button" class="ws-button office-backup-button" data-office-backup disabled>Backup saved documents (.json)</button>
      <div class="office-restore-picker"><label for="office-restore-file">Restore an Office backup</label><input id="office-restore-file" type="file" accept=".json,application/json" data-office-restore-file disabled/><p class="ws-muted">Only missing original document IDs will be added. Existing records are never replaced.</p></div>
      <p class="ws-muted">A backup includes saved versions and revision history. Unsaved drafts must be exported separately.</p>
    </nav>
    <section class="office-editor" aria-label="Document editor">
      <section class="office-multi-review" data-office-multi-panel hidden aria-label="Review multiple Markdown documents">
        <h3>Review multi-document import</h3>
        <p class="ws-muted" data-office-multi-summary></p>
        <p class="ws-muted">Each file becomes a separate new document with a new internal ID. Similar titles are allowed; existing documents and revision histories are never overwritten.</p>
        <div class="office-multi-list" data-office-multi-list></div>
        <div class="office-import-actions"><button type="button" class="ws-button" data-office-multi-confirm disabled>Import all as new documents</button><button type="button" class="ws-button" data-office-multi-cancel disabled>Cancel</button></div>
      </section>
      <section class="office-backup-review" data-office-restore-panel hidden aria-label="Review Office backup restoration">
        <h3>Review backup restoration</h3>
        <p data-office-restore-summary class="ws-muted"></p>
        <p class="ws-muted">Records are added to the current local Office owner only. Backups have no verified owner identity; all existing IDs and history remain untouched.</p>
        <div class="office-restore-list" data-office-restore-list></div>
        <div class="office-import-actions"><button type="button" class="ws-button" data-office-restore-confirm disabled>Restore missing documents</button><button type="button" class="ws-button" data-office-restore-cancel disabled>Cancel</button></div>
      </section>
      <section class="office-import-preview" data-office-import-panel hidden aria-label="Review Markdown import">
        <h3>Review before importing</h3>
        <p data-office-import-info class="ws-muted"></p>
        <label for="office-import-title">New document title</label><input id="office-import-title" data-office-import-title maxlength="120" autocomplete="off" disabled/>
        <p class="ws-muted">A separate new Office document will be created. This preview shows only the first part of the file.</p>
        <div class="office-import-render office-preview" data-office-import-render></div>
        <div class="office-import-actions"><button type="button" class="ws-button" data-office-import-confirm disabled>Import as new document</button><button type="button" class="ws-button" data-office-import-cancel disabled>Cancel</button></div>
      </section>
      <div class="office-actions"><button type="button" class="ws-button" data-office-save disabled>Save</button><button type="button" class="ws-button" data-office-export disabled>Export .md</button><button type="button" class="ws-button" data-office-html disabled>Export .html</button><button type="button" class="ws-button" data-office-print disabled>Print / PDF</button><label for="office-history">Revision</label><select id="office-history" data-office-history disabled><option value="">History</option></select><button type="button" class="ws-button" data-office-restore disabled>Restore selected</button><button type="button" class="ws-button" data-office-compare disabled>Compare selected revision</button></div>
      <section class="office-timeline" aria-label="Office revision timeline" data-office-timeline>
        <div class="office-timeline-heading"><h3>Document history</h3><p data-office-timeline-note class="ws-muted">Create or open a document to inspect saved revisions.</p></div>
        <div class="office-history-search">
          <label for="office-history-search">Search retained history</label>
          <input id="office-history-search" type="search" maxlength="120" data-office-history-search disabled autocomplete="off" placeholder="Find titles or saved Markdown"/>
          <label class="office-history-case"><input type="checkbox" data-office-history-case disabled/> Match case</label>
          <p data-office-history-count aria-live="polite" role="status">No versions available</p>
        </div>
        <div class="office-timeline-list" data-office-timeline-list role="list"></div>
        <section data-office-timeline-preview hidden class="office-timeline-preview" aria-label="Selected saved revision">
          <p class="ws-muted" data-office-timeline-summary></p>
          <pre data-office-timeline-excerpt></pre>
          <p class="ws-muted" data-office-timeline-truncated></p>
          <p class="ws-muted" data-office-timeline-baseline-note>No baseline selected</p>
          <section data-office-timeline-pair-panel hidden aria-label="Two saved revisions comparison">
            <h4>Compare two retained revisions</h4>
            <p data-office-timeline-pair-summary></p>
            <div data-office-timeline-pair-diffs class="office-timeline-pair-diffs"></div>
          </section>
          <div class="office-import-actions">
            <button type="button" class="ws-button" data-office-timeline-compare disabled>Compare with current</button>
            <button type="button" class="ws-button" data-office-timeline-baseline disabled>Set comparison baseline</button>
            <button type="button" class="ws-button" data-office-timeline-pair disabled>Compare two saved revisions</button>
            <button type="button" class="ws-button" data-office-timeline-restore disabled>Restore this revision…</button>
            <button type="button" class="ws-button" data-office-timeline-close>Close preview</button>
          </div>
        </section>
      </section>
      <section class="office-revision-review" data-office-compare-panel hidden aria-label="Revision comparison and selective recovery">
        <h3>Compare revision with current draft</h3>
        <p class="ws-muted" data-office-compare-summary></p>
        <section class="office-hunk-navigation" aria-label="Navigate changed sections of revision">
          <div class="office-hunk-toolbar"><button type="button" data-office-hunk-prev disabled>Previous change</button><p data-office-hunk-position role="status" aria-live="polite">No differences selected</p><button type="button" data-office-hunk-next disabled>Next change</button></div>
          <p class="ws-muted" data-office-hunk-details></p>
          <div class="office-revision-diff" data-office-hunk-preview></div>
          <div class="office-hunk-toolbar">
            <button type="button" data-office-hunk-historical disabled>Choose historical lines</button>
            <button type="button" data-office-hunk-current disabled>Focus current change</button>
          </div>
        </section>
        <div class="office-revision-diffs" data-office-compare-diffs aria-label="Changed historical and current lines"></div>
        <section class="office-batch-recovery" data-office-batch-panel aria-label="Recover several historical changes">
          <h4>Recover several changes</h4>
          <p class="ws-muted">Select up to 20 precise change groups below. Preview the complete resulting Markdown before one revision-checked save. This does not overwrite the original history.</p>
          <div class="office-batch-change-list" data-office-batch-list></div>
          <p class="ws-muted" data-office-batch-selection>0 changes selected</p>
          <div class="office-import-actions"><button type="button" class="ws-button" data-office-batch-preview disabled>Preview combined recovery</button><button type="button" class="ws-button" data-office-batch-cancel disabled>Clear selection</button></div>
          <div data-office-batch-result hidden>
            <p data-office-batch-summary class="ws-muted"></p>
            <label for="office-batch-document">Resulting Markdown — review before confirming</label>
            <textarea id="office-batch-document" data-office-batch-document readonly spellcheck="false" rows="10"></textarea>
            <div class="office-import-actions"><button type="button" class="ws-button" data-office-batch-confirm disabled>Confirm and save one new revision…</button><button type="button" class="ws-button" data-office-batch-dismiss>Dismiss preview</button></div>
          </div>
        </section>
        <fieldset class="office-recover-range"><legend>Recover specific historical lines</legend>
          <label for="office-recover-start">From line</label><input id="office-recover-start" data-office-recover-start type="number" min="1" step="1" disabled/>
          <label for="office-recover-end">To line</label><input id="office-recover-end" data-office-recover-end type="number" min="1" step="1" disabled/>
          <p class="ws-muted" data-office-recover-info></p><pre data-office-recover-preview></pre>
        </fieldset>
        <p class="ws-muted">Recovery modifies only the open editor. It cannot change the historical snapshot. Autosave creates a new revision and may reject concurrent edits.</p>
        <div class="office-import-actions">
          <button type="button" class="ws-button" data-office-recover-insert disabled>Insert at cursor…</button>
          <button type="button" class="ws-button" data-office-recover-replace disabled>Replace current selection…</button>
          <button type="button" class="ws-button" data-office-compare-close disabled>Close comparison</button>
        </div>
      </section>
      <label for="office-title">Title</label><input id="office-title" maxlength="120" data-office-title disabled placeholder="Document title" autocomplete="off"/>
      <div class="office-format" role="toolbar" aria-label="Markdown formatting">
        <button type="button" data-office-format="heading" disabled>Heading</button><button type="button" data-office-format="bold" disabled><strong>Bold</strong></button><button type="button" data-office-format="italic" disabled><em>Italic</em></button><button type="button" data-office-format="bullet" disabled>Bullets</button><button type="button" data-office-format="number" disabled>Numbers</button><button type="button" data-office-format="quote" disabled>Quote</button><button type="button" data-office-format="code" disabled>Code</button><button type="button" data-office-format="link" disabled>Link</button><button type="button" data-office-format="table" disabled>Table</button>
      </div>
      <section class="office-writing-tools" aria-label="Long document writing tools">
        <div class="office-writing-stats" data-office-writing-stats role="status" aria-live="polite">Open a document for writing statistics.</div>
        <div class="office-writing-controls">
          <label for="office-writing-line">Go to line</label><input id="office-writing-line" data-office-writing-line type="number" min="1" step="1" disabled placeholder="1"/>
          <button type="button" data-office-writing-go disabled>Go to line</button>
          <label for="office-writing-block">Insert Markdown block</label>
          <select id="office-writing-block" data-office-writing-block disabled><option value="code">Fenced code</option><option value="table">Markdown table</option><option value="tasks">Task checklist</option><option value="rule">Horizontal divider</option></select>
          <label for="office-writing-rows">Rows</label><input id="office-writing-rows" data-office-writing-rows type="number" min="1" max="12" step="1" value="2" disabled/>
          <label for="office-writing-columns">Columns</label><input id="office-writing-columns" data-office-writing-columns type="number" min="2" max="6" step="1" value="2" disabled/>
          <label for="office-writing-language">Code language</label><input id="office-writing-language" data-office-writing-language maxlength="24" placeholder="Optional" disabled/>
          <button type="button" data-office-writing-insert disabled>Insert at selection</button>
        </div>
        <p class="ws-muted">Inserts safe Markdown into the existing editor, using the same original revision-checked autosave. Existing selected text may be replaced.</p>
      </section>
      <section class="office-toc-tools" aria-label="Source-backed contents and cross-references">
        <h3>Contents and internal references</h3>
        <p class="ws-muted">Create or refresh a navigable table of contents from genuine Markdown headings. Preview the entire result before saving. Reference links navigate to original source headings.</p>
        <div class="office-toc-actions">
          <button type="button" data-office-toc-review disabled>Preview table of contents…</button>
          <label for="office-reference-heading">Reference heading</label>
          <select id="office-reference-heading" data-office-reference-heading disabled><option value="">Choose a heading</option></select>
          <button type="button" data-office-reference-insert disabled>Insert link at cursor</button>
        </div>
        <section class="office-toc-review" data-office-toc-panel hidden aria-label="Confirm Markdown table of contents">
          <p data-office-toc-summary class="ws-muted"></p>
          <label for="office-toc-source">Resulting source — review before confirmation</label>
          <textarea id="office-toc-source" data-office-toc-source readonly rows="10" spellcheck="false"></textarea>
          <div class="office-toc-actions">
            <button type="button" data-office-toc-confirm disabled>Confirm one saved revision…</button>
            <button type="button" data-office-toc-cancel>Cancel preview</button>
          </div>
        </section>
      </section>
      <section class="office-footnotes" aria-label="Source footnotes and reference validation">
        <h3>Footnotes and reference check</h3>
        <p class="ws-muted">Insert a footnote in the original Markdown or inspect missing, duplicate and unused footnotes and broken internal heading links. All diagnostics are calculated from this document, without a separate index.</p>
        <div class="office-footnote-controls">
          <label for="office-footnote-id">Footnote ID</label>
          <input id="office-footnote-id" data-office-footnote-id maxlength="48" autocomplete="off" placeholder="Automatic note-1" disabled/>
          <label for="office-footnote-text">Footnote text</label>
          <input id="office-footnote-text" data-office-footnote-text maxlength="1000" autocomplete="off" placeholder="Add source details or a citation" disabled/>
          <button type="button" data-office-footnote-insert disabled>Insert footnote at selection</button>
        </div>
        <div class="office-reference-check">
          <p role="status" aria-live="polite" data-office-reference-summary>No open document.</p>
          <div data-office-reference-problems class="office-reference-problems" aria-label="Reference issues"></div>
        </div>
      </section>
      <section class="office-find" aria-label="Find and replace in document">
        <div class="office-find-row"><label for="office-find-query">Find in document</label><input id="office-find-query" data-office-find-query type="search" maxlength="120" autocomplete="off" disabled placeholder="Find exact text"/><label class="office-find-case"><input type="checkbox" data-office-find-case disabled/> Match case</label></div>
        <div class="office-find-row"><p data-office-find-count role="status" aria-live="polite">No search</p><button type="button" data-office-find-previous disabled>Previous</button><button type="button" data-office-find-next disabled>Next</button></div>
        <div class="office-find-row"><label for="office-replace-value">Replace with</label><input id="office-replace-value" data-office-replace-value type="text" maxlength="120" autocomplete="off" disabled/><button type="button" data-office-replace-all disabled>Replace all…</button></div>
      </section>
      <div class="office-modes" role="group" aria-label="Editor layout"><button type="button" data-office-mode="write" aria-pressed="false">Write</button><button type="button" data-office-mode="split" aria-pressed="true">Split</button><button type="button" data-office-mode="preview" aria-pressed="false">Preview</button></div>
      <div class="office-compose"><div class="office-source"><label for="office-body">Document (Markdown)</label><textarea id="office-body" data-office-body disabled spellcheck="true" placeholder="Start writing…"></textarea></div><section class="office-preview-panel" aria-label="Markdown preview"><h3>Preview</h3><div data-office-preview class="office-preview" aria-live="off"></div></section></div>
      <aside class="office-outline" aria-labelledby="office-outline-heading"><h3 id="office-outline-heading">Document outline</h3><p class="ws-muted" data-office-outline-empty>No headings yet. Add # or ## to navigate a long document.</p><nav data-office-outline aria-label="Document headings"></nav>
        <div class="office-section-controls" aria-label="Section actions">
          <label for="office-section-select">Edit a heading section</label><select id="office-section-select" data-office-section-select disabled><option value="">Choose heading</option></select>
          <div class="office-section-buttons"><button type="button" data-office-section-focus disabled>Select full section</button><button type="button" data-office-section-up disabled>Move earlier</button><button type="button" data-office-section-down disabled>Move later</button></div>
          <div class="office-section-create" aria-label="Insert an original Markdown section">
            <label for="office-section-title">New section title</label><input id="office-section-title" data-office-section-title maxlength="100" disabled autocomplete="off" placeholder="e.g. Key findings"/>
            <div class="office-section-buttons">
              <button type="button" data-office-section-add-sibling disabled>Insert following section</button>
              <button type="button" data-office-section-add-child disabled>Insert nested subsection</button>
            </div>
            <p class="ws-muted">Choose a heading above or place your cursor in a section. Ctrl/⌘ + Shift + Enter inserts a following section using this title.</p>
          </div>
          <section class="office-section-transform" aria-label="Restructure complete Markdown sections">
            <h4>Restructure a saved section</h4>
            <p class="ws-muted">Choose an original heading above. Make a whole-section copy or adjust every genuine nested heading level together. Save current edits first.</p>
            <div class="office-section-buttons">
              <button type="button" data-office-transform-duplicate disabled>Preview duplicate</button>
              <button type="button" data-office-transform-promote disabled>Preview promote</button>
              <button type="button" data-office-transform-demote disabled>Preview demote</button>
            </div>
            <section class="office-transform-review" data-office-transform-review hidden aria-label="Review source section transformation">
              <p class="ws-muted" data-office-transform-summary></p>
              <label for="office-transform-source">Resulting Markdown — read-only before confirmation</label>
              <textarea id="office-transform-source" data-office-transform-source readonly rows="10" spellcheck="false"></textarea>
              <div class="office-section-buttons">
                <button type="button" data-office-transform-confirm disabled>Confirm one revision…</button>
                <button type="button" data-office-transform-cancel>Cancel preview</button>
              </div>
            </section>
          </section>
          <div class="office-section-navigation" aria-label="Document heading navigation">
            <button type="button" data-office-heading-previous disabled>Previous heading</button>
            <button type="button" data-office-heading-next disabled>Next heading</button>
            <p class="ws-muted">In the editor, Ctrl/⌘ + Alt + ↑ or ↓ navigates genuine headings (fenced-code headings are ignored).</p>
          </div>
          <p class="ws-muted">Moves the complete heading and its nested subsections. Changes are saved through the normal revision history.</p>
        </div></aside>
      <p class="ws-muted">Plain Markdown source, not a rich-text or DOCX editor. Saved locally in an isolated Office database.</p>
    </section>
  </div>
  <div class="office-print-sheet" data-office-print-sheet aria-hidden="true"></div>
  <p data-office-status role="status" aria-live="polite">Checking Hub privacy and local storage…</p>
</section>
<script>import '../../scripts/office-documents';</script>
