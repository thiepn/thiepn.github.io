---
import type { CollectionEntry } from 'astro:content';
interface Props { project: CollectionEntry<'projects'>; }
const { project } = Astro.props;
const p = project.data;
const fmt = (date: Date) => new Intl.DateTimeFormat('en-GB',{day:'2-digit',month:'short',year:'numeric'}).format(date).toUpperCase();
const platform = p.platforms.length ? p.platforms.join(' / ') : 'WEB';
const mobile = p.platforms.includes('mobile') ? 'YES' : 'NO';
const offline = p.capabilityTags.includes('offline') ? 'YES' : p.capabilityTags.includes('local-first') ? 'LOCAL-FIRST' : 'NO';
const controls = p.controls.length ? p.controls.join(' / ') : '—';
const source = p.repo && p.actions.source ? 'PUBLIC' : p.repo ? 'LINKED' : 'NOT LISTED';
---
<dl class="record-metadata">
  <div><dt>Project code</dt><dd>{p.code}</dd></div>
  <div><dt>Status</dt><dd>{p.status}</dd></div>
  <div><dt>Type</dt><dd>{p.type}</dd></div>
  <div><dt>Category</dt><dd>{p.category}</dd></div>
  {p.showcase?.release && <div><dt>Release</dt><dd>{p.showcase.release}</dd></div>}
  <div><dt>Added</dt><dd>{fmt(p.dateAdded)}</dd></div>
  <div><dt>Last major update</dt><dd>{p.lastMajorUpdate ? fmt(p.lastMajorUpdate) : '—'}</dd></div>
  <div><dt>Platform</dt><dd>{platform}</dd></div>
  <div><dt>Mobile</dt><dd>{mobile}</dd></div>
  <div><dt>Controls</dt><dd>{controls}</dd></div>
  <div><dt>Offline</dt><dd>{offline}</dd></div>
  <div><dt>Source</dt><dd>{source}</dd></div>
  <div><dt>Preview</dt><dd>{p.preview.tier} / {p.preview.provenance ?? p.preview.type}</dd></div>
  {p.repo && <div><dt>GitHub</dt><dd><a href={`https://github.com/${p.repo}`}>{p.repo} ↗</a></dd></div>}
  {p.liveUrl && <div><dt>Live project</dt><dd><a href={p.liveUrl}>{p.actions.primaryLabel} ↗</a></dd></div>}
</dl>
<style>
  .record-metadata{margin-top:var(--space-6);border-top:1px solid var(--line-strong);display:grid;grid-template-columns:repeat(3,minmax(0,1fr))}
  .record-metadata>div{min-width:0;padding:15px 18px 15px 0;border-bottom:1px solid var(--line)}.record-metadata>div:not(:nth-child(3n+1)){padding-left:18px;border-left:1px solid var(--line)}
  .record-metadata dt{font:500 .68rem var(--font-meta);letter-spacing:.065em;text-transform:uppercase;color:var(--ink-muted)}.record-metadata dd{margin-top:6px;font:500 .78rem var(--font-meta);line-height:1.48;letter-spacing:.025em;text-transform:uppercase;overflow-wrap:anywhere}.record-metadata a{text-decoration:none;color:var(--project-accent)}.record-metadata a:hover,.record-metadata a:focus-visible{text-decoration:underline;text-underline-offset:4px}
  @media(max-width:980px){.record-metadata{grid-template-columns:repeat(2,minmax(0,1fr))}.record-metadata>div:nth-child(n){padding-left:0;border-left:0}.record-metadata>div:nth-child(even){padding-left:18px;border-left:1px solid var(--line)}}
  @media(max-width:620px){.record-metadata{grid-template-columns:1fr}.record-metadata>div:nth-child(n){padding:13px 0;border-left:0}}
</style>