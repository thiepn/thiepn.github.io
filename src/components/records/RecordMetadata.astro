---
import type { CollectionEntry } from 'astro:content';
interface Props { project: CollectionEntry<'projects'>; }
const { project } = Astro.props;
const p = project.data;
const fmt = (date: Date) => new Intl.DateTimeFormat('en-GB',{day:'2-digit',month:'short',year:'2-digit'}).format(date).toUpperCase();
const platform = p.platforms.length ? p.platforms.join(' / ') : 'WEB';
const mobile = p.platforms.includes('mobile') ? 'YES' : 'NO';
const offline = p.capabilityTags.includes('offline') ? 'YES' : p.capabilityTags.includes('local-first') ? 'LOCAL-FIRST' : 'NO';
---
<dl class="record-metadata">
  <div><dt>Project code</dt><dd>{p.code}</dd></div>
  <div><dt>Status</dt><dd>{p.status}</dd></div>
  <div><dt>Type</dt><dd>{p.type}</dd></div>
  <div><dt>Category</dt><dd>{p.category}</dd></div>
  <div><dt>Added</dt><dd>{fmt(p.dateAdded)}</dd></div>
  <div><dt>Last major update</dt><dd>{p.lastMajorUpdate ? fmt(p.lastMajorUpdate) : '—'}</dd></div>
  <div><dt>Platform</dt><dd>{platform}</dd></div>
  <div><dt>Mobile</dt><dd>{mobile}</dd></div>
  <div><dt>Offline</dt><dd>{offline}</dd></div>
  <div><dt>Preview</dt><dd>{p.preview.tier} / {p.preview.type}</dd></div>
  {p.repo && <div><dt>GitHub</dt><dd><a href={`https://github.com/${p.repo}`}>{p.repo} ↗</a></dd></div>}
  {p.liveUrl && <div><dt>Live project</dt><dd><a href={p.liveUrl}>{p.actions.primaryLabel} ↗</a></dd></div>}
</dl>
<style>
  .record-metadata{margin-top:var(--space-6);border-top:1px solid var(--line-strong);display:grid;grid-template-columns:1fr 1fr}
  .record-metadata>div{display:grid;grid-template-columns:minmax(108px,1fr) minmax(0,2fr);gap:var(--space-4);padding:13px 0;border-bottom:1px solid var(--line)}.record-metadata>div:nth-child(odd){padding-right:var(--space-5)}.record-metadata>div:nth-child(even){padding-left:var(--space-5);border-left:1px solid var(--line)}
  .record-metadata dt{font:500 .64rem var(--font-meta);letter-spacing:.065em;text-transform:uppercase;color:var(--ink-muted)}.record-metadata dd{font:500 .72rem var(--font-meta);letter-spacing:.035em;text-transform:uppercase;overflow-wrap:anywhere}.record-metadata a{text-decoration:none}
  @media(max-width:760px){.record-metadata{grid-template-columns:1fr}.record-metadata>div:nth-child(n){padding-left:0;padding-right:0;border-left:0}}
</style>
