---
import type { CollectionEntry } from 'astro:content';
import PreviewAperture from '../artifacts/PreviewAperture.astro';
interface Props { project: CollectionEntry<'projects'>; }
const { project } = Astro.props;
const p = project.data;
const gallery = p.gallery ?? [];
---
{gallery.length > 0 && (
<section id="views" class="artifact-gallery" aria-labelledby="gallery-title" data-artifact-gallery>
  <header class="gallery-head">
    <div><p class="meta">Gallery</p><h2 id="gallery-title">Project views</h2></div>
    <span>{String(gallery.length).padStart(2,'0')} views</span>
  </header>
  <div class="gallery-grid">
    {gallery.map((figure, index) => (
      <figure class="gallery-figure">
        <button
          class="gallery-figure__open"
          type="button"
          data-gallery-open
          data-gallery-index={index}
          data-gallery-label={`${figure.label}`}
          data-gallery-caption={figure.caption}
          aria-label={`Inspect view ${index+1}: ${figure.label}`}
        >
          <span class="gallery-figure__visual">
            {figure.source ? (
              <span class:list={['gallery-capture', figure.variant === 'mobile' && 'gallery-capture--mobile']}>
                <img src={figure.source} alt="" loading="lazy" decoding="async" />
                <span class="gallery-capture__label">Captured UI</span>
              </span>
            ) : (
              <PreviewAperture project={project} size="standard" variant={figure.variant} />
            )}
          </span>
          <span class="gallery-figure__inspect">Inspect ↗</span>
        </button>
        <figcaption><span>{String(index+1).padStart(2,'0')}</span><strong>{figure.label}</strong><p>{figure.caption}</p></figcaption>
      </figure>
    ))}
  </div>
  <dialog class="gallery-inspector" data-gallery-dialog aria-labelledby="gallery-dialog-title">
    <div class="gallery-inspector__bar">
      <div><span class="gallery-inspector__kind">Project view</span><strong id="gallery-dialog-title" data-gallery-dialog-label>Project view</strong></div>
      <div class="gallery-inspector__position" data-gallery-dialog-position>01 / {String(gallery.length).padStart(2,'0')}</div>
      <button type="button" data-gallery-close>Close ×</button>
    </div>
    <div class="gallery-inspector__visual" data-gallery-dialog-visual></div>
    <footer class="gallery-inspector__footer">
      <p data-gallery-dialog-caption></p>
      <div class="gallery-inspector__nav" aria-label="Project views">
        <button type="button" data-gallery-previous>← Previous</button>
        <button type="button" data-gallery-next>Next →</button>
      </div>
    </footer>
  </dialog>
</section>
)}
<style>
  .artifact-gallery{padding-top:clamp(46px,6vw,70px);scroll-margin-top:90px}
  .gallery-head{display:flex;justify-content:space-between;align-items:end;gap:var(--space-5);padding-bottom:12px;border-bottom:1px solid var(--line-strong)}
  .gallery-head .meta,.gallery-head>span{font:500 .6rem var(--font-meta);letter-spacing:.06em;text-transform:uppercase;color:var(--ink-muted)}.gallery-head h2{margin-top:3px;font-size:clamp(1.45rem,2.4vw,2.15rem);line-height:1;letter-spacing:-.035em;font-weight:560}
  .gallery-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:var(--space-4);padding-top:var(--space-5)}
  .gallery-figure{margin:0;min-width:0}
  .gallery-figure__open{position:relative;display:block;width:100%;padding:0;border:0;background:transparent;color:inherit;text-align:inherit;border-radius:0;cursor:zoom-in;scroll-margin-top:80px}.gallery-figure__open:focus-visible{outline:2px solid var(--project-accent);outline-offset:4px}
  .gallery-figure__visual{display:block}.gallery-figure__inspect{position:absolute;right:8px;top:8px;z-index:20;padding:4px 6px;background:var(--surface-1);color:var(--ink-secondary);border:1px solid var(--line-strong);font:600 .52rem var(--font-meta);letter-spacing:.055em;text-transform:uppercase;opacity:.72;transition:opacity var(--motion-fast) var(--ease-standard),color var(--motion-fast) var(--ease-standard),transform var(--motion-fast) var(--ease-standard)}
  .gallery-capture{position:relative;display:block;overflow:hidden;aspect-ratio:16/10;background:#090a0c;border-block:1px solid rgb(245 242 235 / .16)}.gallery-capture img{display:block;width:100%;height:100%;object-fit:cover}.gallery-capture--mobile img{object-fit:contain}.gallery-capture__label{position:absolute;left:8px;bottom:7px;padding:3px 5px;background:rgb(9 10 12 / .78);color:rgb(245 242 235 / .78);font:600 .5rem var(--font-meta);letter-spacing:.06em;text-transform:uppercase;border:1px solid rgb(245 242 235 / .16)}
  .gallery-figure__open:hover .gallery-figure__inspect,.gallery-figure__open:focus-visible .gallery-figure__inspect{opacity:1;color:var(--project-accent);transform:translate(1px,-1px)}
  .gallery-figure figcaption{display:grid;grid-template-columns:26px 1fr;gap:4px 9px;padding-top:10px;border-top:1px solid var(--line)}.gallery-figure figcaption span{grid-row:1/3;font:500 .56rem var(--font-meta);color:var(--ink-muted)}.gallery-figure figcaption strong{font-size:.82rem}.gallery-figure figcaption p{font-size:.72rem;line-height:1.42;color:var(--ink-secondary)}
  .gallery-inspector{width:min(1180px,calc(100vw - 40px));max-width:none;border:1px solid var(--line-strong);padding:0;background:var(--canvas);color:var(--ink)}.gallery-inspector::backdrop{background:rgb(0 0 0 / .72)}
  .gallery-inspector__bar{min-height:52px;display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:var(--space-4);padding:7px 14px;border-bottom:1px solid var(--line);font:500 .6rem var(--font-meta);letter-spacing:.065em;text-transform:uppercase}.gallery-inspector__bar>div:first-child{display:flex;align-items:baseline;gap:10px;min-width:0}.gallery-inspector__kind,.gallery-inspector__position{color:var(--ink-muted)}.gallery-inspector__bar strong{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:var(--project-accent);font-weight:600}.gallery-inspector__position{justify-self:center}.gallery-inspector__bar>button{justify-self:end}
  .gallery-inspector button{min-height:38px;border:0;background:transparent;color:inherit;font:inherit;cursor:pointer}.gallery-inspector button:hover,.gallery-inspector button:focus-visible{color:var(--project-accent)}.gallery-inspector button:disabled{cursor:default;color:var(--ink-muted);opacity:.45}
  .gallery-inspector__visual{padding:clamp(12px,3vw,32px)}.gallery-inspector__visual :global(.aperture),.gallery-inspector__visual :global(.gallery-capture){max-height:72vh;margin:auto}.gallery-inspector__footer{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:var(--space-5);align-items:center;padding:12px clamp(12px,3vw,32px) var(--space-5);border-top:1px solid var(--line)}.gallery-inspector__footer>p{max-width:70ch;color:var(--ink-secondary);font-size:.85rem;line-height:1.5}.gallery-inspector__nav{display:flex;gap:var(--space-3);font:500 .58rem var(--font-meta);letter-spacing:.055em;text-transform:uppercase}
  @media(max-width:800px){.gallery-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.gallery-figure:last-child:nth-child(odd){grid-column:1/-1;max-width:620px}.gallery-inspector__footer{grid-template-columns:1fr}.gallery-inspector__nav{justify-content:space-between}}
  @media(max-width:560px){.gallery-grid{grid-template-columns:1fr}.gallery-inspector{width:calc(100vw - 16px)}.gallery-figure__inspect{opacity:1}.gallery-head>span{display:none}.gallery-inspector__bar{grid-template-columns:1fr auto}.gallery-inspector__position{display:none}.gallery-inspector__kind{display:none}.gallery-inspector__bar>div:first-child{min-width:0}.gallery-inspector__nav{width:100%}}
  @media(prefers-reduced-motion:reduce){.gallery-figure__inspect{transition:none;transform:none!important}}
  @media(forced-colors:active){.gallery-inspector,.gallery-figure__inspect,.gallery-capture{border:1px solid CanvasText}}
</style>
