---
import type { CollectionEntry } from 'astro:content';
interface Props { project: CollectionEntry<'projects'>; }
const { project } = Astro.props;
const p = project.data;
const sectionTitle = p.category === 'learning' ? 'Learning modes' : p.category === 'games' ? 'Core systems' : 'Key features';
---
<section class="record-capabilities" aria-labelledby="capabilities-title">
  <header class="record-subhead">
    <div><p class="meta">Features</p><h2 id="capabilities-title">{sectionTitle}</h2></div>
    <span class="record-subhead__meta">{String(p.capabilities.length).padStart(2,'0')} items</span>
  </header>
  <ol class="capability-list">
    {p.capabilities.map((capability, index) => (
      <li>
        {capability.previewState ? (
          <button
            type="button"
            class="capability-row"
            data-capability-preview={capability.previewState}
            aria-label={`Show ${capability.title} preview state`}
          >
            <span class="capability-row__number">{String(index + 1).padStart(2,'0')}</span>
            <strong>{capability.title}</strong>
            <span class="capability-row__description">{capability.description}</span>
            <span class="capability-row__signal" aria-hidden="true">Preview ↗</span>
          </button>
        ) : (
          <div class="capability-row capability-row--static">
            <span class="capability-row__number">{String(index + 1).padStart(2,'0')}</span>
            <strong>{capability.title}</strong>
            <span class="capability-row__description">{capability.description}</span>
            <span class="capability-row__signal" aria-hidden="true">—</span>
          </div>
        )}
      </li>
    ))}
  </ol>
</section>
<style>
  .record-capabilities{padding-top:clamp(46px,6vw,70px)}
  .record-subhead{display:flex;justify-content:space-between;align-items:end;gap:var(--space-5);padding-bottom:12px;border-bottom:1px solid var(--line-strong)}
  .record-subhead .meta,.record-subhead__meta{font:500 .6rem var(--font-meta);letter-spacing:.06em;text-transform:uppercase;color:var(--ink-muted)}
  .record-subhead h2{margin-top:3px;font-size:clamp(1.45rem,2.4vw,2.15rem);line-height:1;letter-spacing:-.035em;font-weight:560}
  .capability-list{list-style:none;margin:0;padding:0}
  .capability-row{width:100%;display:grid;grid-template-columns:42px minmax(150px,1.7fr) minmax(240px,4fr) auto;gap:var(--space-3);align-items:start;padding:13px 0;border:0;border-bottom:1px solid var(--line);background:transparent;color:inherit;text-align:left;font:inherit;border-radius:0}
  .capability-row:not(:disabled){cursor:pointer}
  .capability-row:not(:disabled):hover,.capability-row:not(:disabled):focus-visible{background:color-mix(in srgb,var(--project-accent) 5%,transparent)}
  .capability-row__number,.capability-row__signal{font:500 .58rem var(--font-meta);letter-spacing:.055em;color:var(--ink-muted)}
  .capability-row strong{font-size:clamp(.92rem,1.15vw,1.08rem);font-weight:560;letter-spacing:-.015em}
  .capability-row__description{max-width:68ch;color:var(--ink-secondary);font-size:.82rem;line-height:1.48}
  .capability-row__signal{justify-self:end;white-space:nowrap}
  .capability-row:not(:disabled):hover .capability-row__signal,.capability-row:not(:disabled):focus-visible .capability-row__signal{color:var(--project-accent)}
  @media(max-width:760px){.capability-row{grid-template-columns:34px minmax(0,1fr) auto}.capability-row__description{grid-column:2/-1}.capability-row__signal{grid-column:3;grid-row:1}}
  @media(max-width:480px){.record-subhead{align-items:flex-start}.record-subhead__meta{display:none}.capability-row{grid-template-columns:28px minmax(0,1fr)}.capability-row__signal{display:none}.capability-row__description{grid-column:2}}
</style>
