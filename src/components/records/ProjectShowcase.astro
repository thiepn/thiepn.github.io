---
import type { CollectionEntry } from 'astro:content';

interface Props { project: CollectionEntry<'projects'>; }
const { project } = Astro.props;
const p = project.data;
const showcase = p.showcase;
const fmt = (date: Date) => new Intl.DateTimeFormat('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }).format(date);
const lifecycle = {
  live: 'Live release',
  beta: 'Active beta',
  experiment: 'Experiment',
  archived: 'Archived',
}[p.status];
const platform = p.platforms.length ? p.platforms.map((value) => value[0].toUpperCase() + value.slice(1)).join(' · ') : 'Web';
const controls = p.controls.length ? p.controls.map((value) => value[0].toUpperCase() + value.slice(1)).join(' · ') : 'Standard web controls';
const offline = p.capabilityTags.includes('offline') ? 'Offline capable' : p.capabilityTags.includes('local-first') ? 'Local-first' : 'Online';
const source = p.repo && p.actions.source ? 'Public source' : p.repo ? 'Repository linked' : 'Source not listed';
const updated = p.lastMajorUpdate ? fmt(p.lastMajorUpdate) : fmt(p.dateAdded);
const facts = [
  { label: 'Lifecycle', value: lifecycle },
  { label: 'Platforms', value: platform },
  { label: 'Connectivity', value: offline },
  { label: 'Controls', value: controls },
  { label: 'Source', value: source },
  { label: 'Updated', value: updated },
];
---
<section id="snapshot" class="project-showcase" aria-labelledby="snapshot-title" data-project-showcase>
  <header class="showcase-head">
    <div><p class="meta">At a glance</p><h2 id="snapshot-title">Project snapshot</h2></div>
    {showcase?.release && <span class="showcase-head__release">Release {showcase.release}</span>}
  </header>

  <dl class="showcase-facts">
    {facts.map((fact) => <div><dt>{fact.label}</dt><dd>{fact.value}</dd></div>)}
  </dl>

  {showcase?.purpose && (
    <div class="showcase-purpose" data-project-purpose>
      <div><p class="meta">Purpose</p><h3>Why this exists</h3></div>
      <p>{showcase.purpose}</p>
    </div>
  )}

  {(showcase?.highlights?.length || showcase?.stack?.length) && (
    <div class="showcase-evidence">
      {showcase?.highlights?.length ? (
        <div class="showcase-block" data-project-highlights>
          <div class="showcase-block__head"><p class="meta">Evidence</p><h3>Verified highlights</h3></div>
          <div class="showcase-highlights">
            {showcase.highlights.map((highlight) => (
              <div class="showcase-highlight">
                <strong>{highlight.value}</strong>
                <span>{highlight.label}</span>
                {highlight.note && <p>{highlight.note}</p>}
              </div>
            ))}
          </div>
        </div>
      ) : null}

      {showcase?.stack?.length ? (
        <div class="showcase-block showcase-block--stack" data-project-stack>
          <div class="showcase-block__head"><p class="meta">Build</p><h3>Technology</h3></div>
          <ul>{showcase.stack.map((item) => <li>{item}</li>)}</ul>
        </div>
      ) : null}
    </div>
  )}
</section>

<style>
  .project-showcase{padding-top:clamp(46px,6vw,70px);scroll-margin-top:90px}
  .showcase-head{display:flex;justify-content:space-between;align-items:end;gap:var(--space-5);padding-bottom:12px;border-bottom:1px solid var(--line-strong)}
  .showcase-head .meta,.showcase-head__release{font:500 .68rem var(--font-meta);letter-spacing:.065em;text-transform:uppercase;color:var(--ink-muted)}
  .showcase-head h2{margin-top:3px;font-size:clamp(1.55rem,2.6vw,2.35rem);line-height:1;letter-spacing:-.04em;font-weight:560}
  .showcase-head__release{color:var(--project-accent);font-weight:600}
  .showcase-facts{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));margin-top:var(--space-5);border-top:1px solid var(--line)}
  .showcase-facts>div{min-width:0;padding:16px 18px 16px 0;border-bottom:1px solid var(--line)}
  .showcase-facts>div:not(:nth-child(3n+1)){padding-left:18px;border-left:1px solid var(--line)}
  .showcase-facts dt{font:500 .68rem var(--font-meta);letter-spacing:.065em;text-transform:uppercase;color:var(--ink-muted)}
  .showcase-facts dd{margin-top:7px;font-size:clamp(.9rem,1.2vw,1.04rem);font-weight:560;letter-spacing:-.015em;overflow-wrap:anywhere}
  .showcase-purpose{display:grid;grid-template-columns:minmax(180px,.72fr) minmax(0,2.28fr);gap:clamp(24px,5vw,72px);margin-top:clamp(34px,5vw,56px);padding:clamp(22px,3vw,34px) 0;border-block:1px solid var(--line-strong)}
  .showcase-purpose .meta,.showcase-block .meta{font:500 .68rem var(--font-meta);letter-spacing:.065em;text-transform:uppercase;color:var(--ink-muted)}
  .showcase-purpose h3,.showcase-block h3{margin-top:5px;font-size:clamp(1.15rem,1.8vw,1.5rem);letter-spacing:-.025em;font-weight:560}
  .showcase-purpose>p{max-width:66ch;font-size:clamp(1rem,1.2vw,1.12rem);line-height:1.62;color:var(--ink-secondary)}
  .showcase-evidence{display:grid;grid-template-columns:minmax(0,2.1fr) minmax(210px,.9fr);gap:clamp(28px,5vw,72px);margin-top:clamp(34px,5vw,56px)}
  .showcase-block__head{padding-bottom:12px;border-bottom:1px solid var(--line-strong)}
  .showcase-highlights{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));border-top:1px solid var(--line)}
  .showcase-highlight{padding:18px 18px 18px 0;border-bottom:1px solid var(--line)}
  .showcase-highlight:nth-child(even){padding-left:18px;border-left:1px solid var(--line)}
  .showcase-highlight strong{display:block;font:600 clamp(1.7rem,3vw,2.7rem)/.95 var(--font-meta);letter-spacing:-.055em;color:var(--project-accent)}
  .showcase-highlight span{display:block;margin-top:8px;font-size:.84rem;font-weight:560}
  .showcase-highlight p{margin-top:5px;color:var(--ink-muted);font-size:.76rem;line-height:1.45}
  .showcase-block--stack ul{list-style:none;margin:0;padding:0;border-top:1px solid var(--line)}
  .showcase-block--stack li{padding:11px 0;border-bottom:1px solid var(--line);font:500 .76rem var(--font-meta);letter-spacing:.035em;text-transform:uppercase}
  @media(max-width:820px){.showcase-facts{grid-template-columns:repeat(2,minmax(0,1fr))}.showcase-facts>div:not(:nth-child(3n+1)){padding-left:0;border-left:0}.showcase-facts>div:nth-child(even){padding-left:16px;border-left:1px solid var(--line)}.showcase-evidence{grid-template-columns:1fr}.showcase-purpose{grid-template-columns:1fr;gap:16px}}
  @media(max-width:520px){.showcase-head{align-items:flex-start}.showcase-head__release{margin-top:4px}.showcase-facts{grid-template-columns:1fr}.showcase-facts>div:nth-child(n){padding:14px 0;border-left:0}.showcase-highlights{grid-template-columns:1fr}.showcase-highlight:nth-child(n){padding:16px 0;border-left:0}.showcase-purpose{padding-block:20px}}
</style>
