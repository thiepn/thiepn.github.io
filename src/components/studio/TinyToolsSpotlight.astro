---
import ToolboxOverview from './ToolboxOverview.astro';
---
<section class="tools-suite" id="tiny-tools" aria-labelledby="tiny-tools-title" data-project="tiny-tools">
  <header class="tools-suite__header">
    <div><h2 id="tiny-tools-title">Tiny Tools<span aria-hidden="true">.</span></h2></div>
    <div class="tools-suite__intro"><p>PDFs, images, audio, video, files, code, calculators, diagnostics and everyday tasks. One collection for work, study and the small tasks in between.</p><div class="actions"><a class="button" href="/tools/">Explore all tools <span aria-hidden="true">↗</span></a><a class="quiet-link" href="/project/tiny-tools/">Inside the project <span aria-hidden="true">→</span></a></div><p class="tools-suite__note">No account needed. Most tools process your content locally.</p></div>
  </header>
  
  <div class="tools-suite__examples"><ToolboxOverview/></div>
  
</section>
<style>
  .tools-suite { margin-top:72px; padding:48px; border:1px solid var(--showcase-rule); border-radius:10px; background:var(--tools-paper); }
  .tools-suite__header { display:grid; grid-template-columns:1fr 1fr; align-items:center; gap:56px; }
  h2 { font-size:clamp(2.2rem,4vw,3.4rem); font-weight:560; letter-spacing:-.045em; }
  h2 span { color:var(--accent); }
  .tools-suite__line { margin-top:16px; font-size:clamp(1.8rem,3.2vw,2.8rem); line-height:1.15; letter-spacing:-.035em; color:var(--tools-ink); }
  .tools-suite__intro>p { max-width:46ch; font-size:1rem; color:var(--ink-secondary); line-height:1.65; }
  .tools-suite__intro .actions { margin-top:22px; gap:8px 24px; }
  .tools-suite__intro .tools-suite__note { margin-top:18px; font-size:.875rem; }
  .tools-suite__examples { margin-top:32px; }

  @media(max-width:1050px) { .tools-suite { padding:32px; } .tools-suite__header { gap:32px; } }
  @media(max-width:760px) { .tools-suite { margin-top:52px; padding:24px; } .tools-suite__header { grid-template-columns:1fr; gap:24px; } .tools-suite__line { font-size:2rem; } .tools-suite__intro .actions { gap:8px 18px; } .tools-suite__intro>p { font-size:.9375rem; } .tools-suite__examples { margin-top:24px; }    }
  @media(max-width:380px) { .tools-suite { padding:18px; } .tools-suite__line { font-size:1.75rem; } }
  @media(forced-colors:active) { .tools-suite { background:Canvas; color:CanvasText; border-color:CanvasText; } }
</style>
