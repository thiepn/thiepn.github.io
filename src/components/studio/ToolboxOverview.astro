---
import { showcase } from '../../lib/showcase';
---
<div class="toolbox-overview" data-toolbox-overview>
  {showcase.toolFamilies.map(family => <div class="toolbox-family" data-toolbox-family>
    <h3><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={family.icon}/></svg>{family.label}</h3>
    <ul>{family.tools.map(tool => <li><a href={tool.href}>{tool.label}<span aria-hidden="true">↗</span></a></li>)}</ul>
  </div>)}
</div>
<style>
  .toolbox-overview { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); column-gap:32px; row-gap:28px; }
  .toolbox-family { min-width:0; padding-top:22px; border-top:1px solid var(--showcase-rule); }
  h3 { display:flex; align-items:center; gap:10px; margin-bottom:12px; font-size:.9375rem; line-height:1.4; letter-spacing:-.015em; font-weight:600; }
  svg { flex-shrink:0; color:var(--accent); }
  ul { margin:0; padding:0; list-style:none; }
  a { display:flex; align-items:center; justify-content:space-between; gap:12px; min-height:44px; color:var(--ink-secondary); font-size:.875rem; line-height:1.5; text-decoration:none; }
  a span { flex-shrink:0; }
  a:hover { color:var(--accent); text-decoration:underline; }
  a:focus-visible { outline-offset:2px; }
  @media(max-width:1050px) { .toolbox-overview { grid-template-columns:repeat(2,minmax(0,1fr)); column-gap:28px; row-gap:24px; } }
  @media(max-width:599px) { .toolbox-overview { gap:20px; } h3 { display:block; min-height:4.8em; font-size:.875rem; } svg { display:block; margin-bottom:9px; } a { gap:8px; font-size:.8125rem; overflow-wrap:anywhere; } .toolbox-family { padding-top:16px; } }
  @media(max-width:359px) { .toolbox-overview { column-gap:16px; } h3 { font-size:.8125rem; } a { font-size:.75rem; } }
</style>
