---
import { PROJECT_CATEGORIES } from '../../data/taxonomy';
interface Props { count?: number; }
const { count = 0 } = Astro.props;
const labels: Record<string,string> = { tools:'Tools', learning:'Learning', games:'Games', resources:'Resources', visualizations:'Visualizations', experiments:'Experiments' };
---
<div class="archive-controls" data-archive-controls>
  <div class="archive-controls__categories" role="group" aria-label="Filter projects by category">
    <button type="button" data-archive-category="all" aria-pressed="true">All</button>
    {PROJECT_CATEGORIES.map((category) => <button type="button" data-archive-category={category} aria-pressed="false">{labels[category]}</button>)}
  </div>
  <div class="archive-controls__utility">
    <label class="archive-controls__search">
      <span>Search</span>
      <input type="search" autocomplete="off" spellcheck="false" data-archive-query aria-label="Search projects" placeholder="Title, topic, or code" />
    </label>
    <label class="archive-controls__select">
      <span>Sort</span>
      <select data-archive-sort aria-label="Sort projects">
        <option value="curated">Featured first</option>
        <option value="recent">Recently updated</option>
        <option value="az">A–Z</option>
      </select>
    </label>
    <div class="archive-controls__view" role="group" aria-label="Project view">
      <button type="button" data-archive-view="grid" aria-pressed="true">Grid</button>
      <span aria-hidden="true">/</span>
      <button type="button" data-archive-view="list" aria-pressed="false">List</button>
    </div>
  </div>
  <div class="archive-controls__result" aria-live="polite">
    <span><b data-archive-result-count>{String(count).padStart(2,'0')}</b> projects</span>
    <button type="button" data-archive-clear hidden>Clear filters</button>
  </div>
</div>
<style>
  .archive-controls{display:none;border-top:1px solid var(--line-strong);border-bottom:1px solid var(--line-strong);margin-top:var(--space-5)}:global(html.js) .archive-controls{display:block}
  .archive-controls__categories{display:flex;align-items:center;gap:var(--space-5);min-height:50px;border-bottom:1px solid var(--line);overflow-x:auto;scrollbar-width:none}.archive-controls__categories::-webkit-scrollbar{display:none}
  .archive-controls button,.archive-controls select,.archive-controls input{font:500 .64rem var(--font-meta);letter-spacing:.055em;text-transform:uppercase;color:var(--ink)}.archive-controls button{min-height:44px;padding:0;border:0;background:transparent;cursor:pointer;white-space:nowrap}
  .archive-controls__categories button{position:relative;color:var(--ink-muted)}.archive-controls__categories button[aria-pressed="true"]{color:var(--ink)}.archive-controls__categories button[aria-pressed="true"]::after{content:'';position:absolute;left:0;right:0;bottom:4px;height:1px;background:currentColor}
  .archive-controls__utility{display:grid;grid-template-columns:minmax(280px,1fr) auto auto;gap:var(--space-5);align-items:center;min-height:62px}
  .archive-controls__search{display:flex;align-items:center;gap:var(--space-3);min-width:0}.archive-controls__search>span,.archive-controls__select>span{font:500 .61rem var(--font-meta);letter-spacing:.055em;text-transform:uppercase;color:var(--ink-muted);white-space:nowrap}
  .archive-controls__search input{width:100%;min-width:0;padding:10px 0;border:0;border-bottom:1px solid var(--line);background:transparent;outline:0;text-transform:none;font-family:var(--font-ui);font-size:.88rem;letter-spacing:0}.archive-controls__search input::placeholder{color:var(--ink-disabled)}.archive-controls__search input:focus-visible{border-bottom:2px solid var(--ink)}
  .archive-controls__select{display:flex;align-items:center;gap:8px}.archive-controls__select select{min-height:44px;padding:0 24px 0 0;border:0;background:transparent;color:var(--ink);cursor:pointer}
  .archive-controls__view{display:flex;align-items:center;gap:7px;color:var(--ink-muted);font:500 .62rem var(--font-meta);letter-spacing:.05em;text-transform:uppercase}.archive-controls__view button{color:var(--ink-muted)}.archive-controls__view button[aria-pressed="true"]{color:var(--ink);text-decoration:underline;text-underline-offset:5px}
  .archive-controls__result{min-height:38px;display:flex;align-items:center;justify-content:space-between;gap:var(--space-4);border-top:1px solid var(--line-soft);font:500 .61rem var(--font-meta);letter-spacing:.055em;text-transform:uppercase;color:var(--ink-muted)}.archive-controls__result b{margin-right:6px;font-weight:500;font-variant-numeric:tabular-nums;color:var(--ink)}.archive-controls__result button{color:var(--ink-muted);font:inherit;letter-spacing:inherit;text-transform:inherit}.archive-controls__result button:hover{color:var(--ink);text-decoration:underline;text-underline-offset:4px}
  @media(max-width:900px){.archive-controls__utility{grid-template-columns:minmax(0,1fr) auto}.archive-controls__search{grid-column:1/-1;margin-top:var(--space-3)}.archive-controls__view{justify-self:end}}
  @media(max-width:599px){.archive-controls__categories{gap:var(--space-4)}.archive-controls__utility{grid-template-columns:1fr auto;gap:var(--space-2) var(--space-4);padding-block:var(--space-3)}.archive-controls__search{grid-column:1/-1;margin:0}.archive-controls__select{grid-column:1}.archive-controls__view{grid-column:2;justify-self:end}.archive-controls__search>span{display:none}.archive-controls__result{align-items:center}}
  @media(forced-colors:active){.archive-controls__categories button[aria-pressed="true"]{outline:1px solid Highlight;outline-offset:-2px}.archive-controls__view button[aria-pressed="true"]{outline:1px solid Highlight}}
</style>
