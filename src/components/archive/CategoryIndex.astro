---
import type { CatalogueStats } from '../../types/catalogue';
interface Props { stats: CatalogueStats; }
const { stats } = Astro.props;
const categories = [
  ['Tools','tools'],['Learning','learning'],['Games','games'],['Resources','resources'],['Visualizations','visualizations'],['Experiments','experiments'],
] as const;
const hint = (key: typeof categories[number][1]) => key === 'tools' ? 'PDF Studio / Manuscript / Clean30' : key === 'learning' ? 'French / Mathematics / Study tools' : key === 'games' ? 'Typing / Strategy / Arcade' : 'Projects in this category';
---
<nav class="category-index" aria-label="Browse projects by type">
  {categories.map(([label,key]) => stats.categories[key] > 0 ? (
    <a class="category-index__row" href={`/projects/?category=${key}`} data-archive-filter-link={key}>
      <span class="category-index__name">{label}</span>
      <span class="category-index__hint">{hint(key)}</span>
      <span class="category-index__count" aria-label={`${stats.categories[key]} projects`}>{String(stats.categories[key]).padStart(2,'0')}</span>
    </a>
  ) : (
    <div class="category-index__row is-empty" aria-disabled="true">
      <span class="category-index__name">{label}</span>
      <span class="category-index__hint">No public projects yet</span>
      <span class="category-index__count" aria-label="0 projects">00</span>
    </div>
  ))}
</nav>
<style>
  .category-index{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));border-top:1px solid var(--line);border-left:1px solid var(--line)}
  .category-index__row{display:grid;grid-template-columns:minmax(0,1fr) auto;grid-template-areas:'name count' 'hint hint';gap:4px 12px;align-content:center;min-height:70px;padding:11px 13px;border-right:1px solid var(--line);border-bottom:1px solid var(--line);text-decoration:none;background:var(--surface-1)}
  .category-index__row>*{min-width:0}.category-index__name{grid-area:name;font-size:1.02rem;line-height:1.1;letter-spacing:-.025em;font-weight:560}.category-index__hint{grid-area:hint;color:var(--ink-muted);font-size:.7rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.category-index__count{grid-area:count;font:500 .62rem var(--font-meta);letter-spacing:.07em;color:var(--ink-muted);text-align:right;font-variant-numeric:tabular-nums}.category-index__row.is-empty{opacity:.5}.category-index__row[href]:hover{background:var(--surface-2)}.category-index__row[href]:hover .category-index__name{text-decoration:underline;text-decoration-thickness:1px;text-underline-offset:4px}
  @media(max-width:900px){.category-index{grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media(max-width:599px){.category-index{grid-template-columns:1fr}.category-index__row{min-height:62px}.category-index__hint{font-size:.68rem}}
</style>
