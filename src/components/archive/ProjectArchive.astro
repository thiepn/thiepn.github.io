---
import type { CollectionEntry } from 'astro:content';
import ArtifactPlate from '../artifacts/ArtifactPlate.astro';
import ArchiveControls from './ArchiveControls.astro';
import { CURATED_PROJECT_ORDER } from '../../data/curation';
interface Props { projects: CollectionEntry<'projects'>[]; id?: string; }
const { projects, id = 'archive-catalogue' } = Astro.props;
const data = projects.map(({ data: p }) => ({
  kind:'project' as const, code:p.code, slug:p.slug, title:p.title, subtitle:p.subtitle, summary:p.summary,
  aliases:p.aliases, category:p.category, status:p.status, tags:p.tags, collections:p.collections, capabilityTags:p.capabilityTags, platforms:p.platforms, repo:p.repo ?? null, liveUrl:p.liveUrl ?? null, primaryLabel:p.actions.primaryLabel,
  accentLight:p.accent.light, accentDark:p.accent.dark, updatedAt:(p.dateUpdated ?? p.lastMajorUpdate ?? p.dateAdded).toISOString(),
}));
const payload = JSON.stringify({ projects:data, curatedOrder:CURATED_PROJECT_ORDER }).replace(/</g,'\\u003c');
---
<div class="project-archive" id={id} data-project-archive>
  <script is:inline type="application/json" data-archive-data set:html={payload}></script>
  <ArchiveControls count={projects.length} />
  <div class="project-archive__empty" hidden data-archive-empty>
    <span class="meta">No matches</span>
    <strong>No projects match these filters.</strong>
    <button type="button" data-archive-reset>Clear filters →</button>
  </div>
  <div class="project-archive__grid" data-archive-grid>
    {projects.map((project, index) => <div class="project-archive__item" data-archive-item data-slug={project.data.slug} data-curated-index={index}><ArtifactPlate project={project} /></div>)}
  </div>
  <!-- List rows are created only if the visitor selects List view; this avoids duplicate initial DOM. -->
  <div class="project-archive__list" hidden data-archive-list></div>
</div>
<style>
  .project-archive__grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:var(--space-4);margin-top:var(--space-5)}
  .project-archive__item{min-width:0;content-visibility:auto;contain-intrinsic-size:auto 420px}
  .project-archive__list{margin-top:var(--space-5);border-top:1px solid var(--line-strong)}
  .project-archive__list>[data-archive-item]{content-visibility:auto;contain-intrinsic-size:auto 58px}
  .project-archive__empty{margin-top:var(--space-5);padding:var(--space-6) 0;border-top:1px solid var(--line-strong);border-bottom:1px solid var(--line-strong)}.project-archive__empty strong{display:block;margin-top:var(--space-3);font-size:clamp(1.35rem,2vw,2rem);letter-spacing:-.04em}.project-archive__empty button{min-height:44px;margin-top:var(--space-4);padding:0;border:0;background:transparent;color:var(--ink);font:500 .7rem var(--font-meta);letter-spacing:.055em;text-transform:uppercase;cursor:pointer}.project-archive [hidden]{display:none!important}
  :global(.archive-runtime-row){display:grid;grid-template-columns:72px minmax(0,1fr) 120px 110px minmax(88px,auto);gap:var(--space-4);align-items:center;min-height:58px;border-bottom:1px solid var(--line);font-family:var(--font-meta);font-size:.72rem;letter-spacing:.055em;text-transform:uppercase}
  :global(.archive-runtime-row>* ){min-width:0}:global(.archive-runtime-row__code),:global(.archive-runtime-row__type),:global(.archive-runtime-row__status){color:var(--ink-muted)}
  :global(.archive-runtime-row__title){font-family:var(--font-ui);font-size:1rem;line-height:1.2;letter-spacing:-.02em;text-transform:none;font-weight:550}:global(.archive-runtime-row__title a){text-decoration:none}
  :global(.archive-runtime-row__status[data-status="live"]){color:var(--ink-secondary)}
  :global(.archive-runtime-row__open){min-height:44px;display:inline-flex;align-items:center;justify-content:flex-end;gap:.42em;text-decoration:none;text-align:right;font-size:.7rem;font-weight:600;color:var(--ink);white-space:nowrap}
  :global(.archive-runtime-row__open:hover),:global(.archive-runtime-row__open:focus-visible){text-decoration:underline;text-underline-offset:5px}
  @media(max-width:1240px){.project-archive__grid{grid-template-columns:repeat(3,minmax(0,1fr))}}
  @media(max-width:900px){.project-archive__grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media(max-width:700px){:global(.archive-runtime-row){grid-template-columns:58px minmax(0,1fr) minmax(76px,auto);gap:var(--space-3)}:global(.archive-runtime-row__type),:global(.archive-runtime-row__status){display:none}}
  @media(max-width:599px){.project-archive__grid{grid-template-columns:1fr;gap:var(--space-4)}}
  @media(max-width:379px){:global(.archive-runtime-row){grid-template-columns:48px minmax(0,1fr) 76px}:global(.archive-runtime-row__code){font-size:.7rem}:global(.archive-runtime-row__title){font-size:.94rem}:global(.archive-runtime-row__open){font-size:.7rem}}
</style>