---
import StatusLabel from '../artifacts/StatusLabel.astro';
import {
  getProjectUpdatedAt,
  selectCurrentlyBuildingProjects,
  selectRecentlyUpdatedProjects,
  type ProjectEntry,
} from '../../lib/catalogue';

interface Props { projects: ProjectEntry[]; }
const { projects } = Astro.props;
const building = selectCurrentlyBuildingProjects(projects, 4);
const buildingSlugs = projects.filter((entry) => entry.data.status === 'beta').map((entry) => entry.data.slug);
const recent = selectRecentlyUpdatedProjects(projects, 5, buildingSlugs);
const formatDate = (date: Date) => new Intl.DateTimeFormat('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }).format(date);
const dateValue = (entry: ProjectEntry) => getProjectUpdatedAt(entry.data);
const dateIso = (entry: ProjectEntry) => dateValue(entry).toISOString().slice(0, 10);
---

{(building.length > 0 || recent.length > 0) && (
  <section class="project-activity" aria-labelledby="activity-title" data-project-activity>
    <header class="activity-heading">
      <div>
        <p class="activity-eyebrow">In motion</p>
        <h2 id="activity-title">What is changing now.</h2>
      </div>
      <p>Active builds and the newest project updates, derived directly from catalogue metadata.</p>
    </header>

    <div class="activity-grid">
      {building.length > 0 && (
        <section class="activity-panel activity-panel--building" aria-labelledby="building-title" data-currently-building>
          <header class="activity-panel__head">
            <div><p>Development</p><h3 id="building-title">Currently building</h3></div>
            <span>{String(building.length).padStart(2, '0')}</span>
          </header>
          <div class="building-list">
            {building.map((entry) => {
              const p = entry.data;
              return (
                <article class="building-card" data-activity-project={p.slug} data-updated={dateIso(entry)}>
                  <div class="building-card__meta">
                    <span>{p.code} · {p.category}</span>
                    <StatusLabel status={p.status} />
                  </div>
                  <h4><a href={`/project/${p.slug}/`}>{p.title}</a></h4>
                  <p>{p.summary}</p>
                  <footer>
                    <time datetime={dateIso(entry)}>Updated {formatDate(dateValue(entry))}</time>
                    {p.liveUrl && <a href={p.liveUrl} aria-label={`${p.actions.primaryLabel}: ${p.title}`}>{p.actions.primaryLabel} <span aria-hidden="true">↗</span></a>}
                  </footer>
                </article>
              );
            })}
          </div>
        </section>
      )}

      {recent.length > 0 && (
        <section class="activity-panel activity-panel--recent" aria-labelledby="recent-title" data-recently-updated>
          <header class="activity-panel__head">
            <div><p>Timeline</p><h3 id="recent-title">Recently updated</h3></div>
            <span>{String(recent.length).padStart(2, '0')}</span>
          </header>
          <ol class="recent-list">
            {recent.map((entry, index) => {
              const p = entry.data;
              return (
                <li data-activity-project={p.slug} data-updated={dateIso(entry)}>
                  <a href={`/project/${p.slug}/`}>
                    <span class="recent-list__number">{String(index + 1).padStart(2, '0')}</span>
                    <span class="recent-list__project"><strong>{p.title}</strong><small>{p.category} · {p.type}</small></span>
                    <time datetime={dateIso(entry)}>{formatDate(dateValue(entry))}</time>
                    <span class="recent-list__arrow" aria-hidden="true">→</span>
                  </a>
                </li>
              );
            })}
          </ol>
          <a class="activity-panel__all" href="/projects/">Browse the full project archive <span aria-hidden="true">→</span></a>
        </section>
      )}
    </div>
  </section>
)}

<style>
  .project-activity{padding-top:clamp(68px,7vw,94px)}
  .activity-heading{display:grid;grid-template-columns:minmax(0,1fr) minmax(280px,.55fr);gap:clamp(32px,7vw,100px);align-items:end;padding-bottom:var(--space-4);border-bottom:1px solid var(--line-strong)}
  .activity-eyebrow,.activity-panel__head p{font:500 .68rem var(--font-meta);letter-spacing:.1em;text-transform:uppercase;color:var(--ink-muted)}
  .activity-heading h2{margin-top:6px;font-size:clamp(2rem,3vw,3rem);line-height:.98;letter-spacing:-.035em;font-weight:500}
  .activity-heading>p{max-width:44ch;justify-self:end;color:var(--ink-secondary);font-size:.84rem;line-height:1.58}
  .activity-grid{display:grid;grid-template-columns:minmax(0,1.18fr) minmax(350px,.82fr);gap:clamp(32px,5vw,72px);padding-top:var(--space-5)}
  .activity-panel{min-width:0;border-top:1px solid var(--line-strong)}
  .activity-panel__head{display:flex;align-items:flex-end;justify-content:space-between;gap:var(--space-4);padding:14px 0;border-bottom:1px solid var(--line)}
  .activity-panel__head h3{margin-top:4px;font-family:var(--font-display);font-size:clamp(1.35rem,1.8vw,1.65rem);letter-spacing:-.02em;font-weight:500}
  .activity-panel__head>span{font:500 .68rem var(--font-meta);letter-spacing:.07em;color:var(--accent)}

  .building-list{display:block}
  .building-card{display:grid;grid-template-columns:minmax(150px,.58fr) minmax(170px,.82fr) minmax(0,1.45fr) auto;align-items:center;gap:clamp(16px,2vw,28px);min-width:0;min-height:104px;padding:16px 0;border-bottom:1px solid var(--line);background:transparent;transition:background-color var(--motion-fast) var(--ease-standard),padding-inline var(--motion-fast) var(--ease-enter)}
  .building-card:hover{padding-inline:12px;background:var(--accent-soft)}
  .building-card__meta{display:flex;flex-direction:column;align-items:flex-start;gap:7px;font:500 .68rem var(--font-meta);letter-spacing:.055em;text-transform:uppercase;color:var(--ink-muted)}
  .building-card h4{margin:0;font-family:var(--font-display);font-size:clamp(1.3rem,1.9vw,1.75rem);line-height:1.03;letter-spacing:-.02em;font-weight:500}
  .building-card h4 a{text-decoration:none}.building-card h4 a:hover,.building-card h4 a:focus-visible{text-decoration:underline;text-underline-offset:5px}
  .building-card>p{margin:0;max-width:48ch;color:var(--ink-secondary);font-size:.82rem;line-height:1.5}
  .building-card footer{display:flex;flex-direction:column;align-items:flex-end;gap:4px;margin:0;padding:0;font:500 .68rem var(--font-meta);letter-spacing:.045em;text-transform:uppercase;color:var(--ink-muted);white-space:nowrap}
  .building-card footer a{min-height:44px;display:inline-flex;align-items:center;text-decoration:none;color:var(--accent)}.building-card footer a:hover,.building-card footer a:focus-visible{text-decoration:underline;text-underline-offset:5px}

  .recent-list{list-style:none;margin:0;padding:0}
  .recent-list li{border-bottom:1px solid var(--line)}
  .recent-list a{display:grid;grid-template-columns:36px minmax(0,1fr) auto 16px;align-items:center;gap:12px;min-height:74px;padding:10px 0;text-decoration:none;background:transparent;transition:background-color var(--motion-fast) var(--ease-standard),padding-inline var(--motion-fast) var(--ease-enter)}
  .recent-list a:hover,.recent-list a:focus-visible{padding-inline:10px;background:var(--accent-soft)}
  .recent-list__number,.recent-list time,.recent-list__project small{font:500 .68rem var(--font-meta);letter-spacing:.05em;text-transform:uppercase;color:var(--ink-muted)}
  .recent-list__number,.recent-list__arrow{color:var(--accent)}
  .recent-list__project{display:flex;min-width:0;flex-direction:column;gap:4px}.recent-list__project strong{font-family:var(--font-display);font-size:1rem;line-height:1.12;letter-spacing:-.012em;font-weight:500;overflow-wrap:anywhere}.recent-list__project small{font-size:.68rem}
  .recent-list time{white-space:nowrap}.recent-list__arrow{justify-self:end}
  .activity-panel__all{display:flex;min-height:48px;align-items:center;justify-content:flex-end;gap:.45em;padding-top:10px;font:500 .68rem var(--font-meta);letter-spacing:.055em;text-transform:uppercase;color:var(--accent);text-decoration:none}.activity-panel__all:hover,.activity-panel__all:focus-visible{text-decoration:underline;text-underline-offset:5px}

  @media(max-width:1080px){.building-card{grid-template-columns:minmax(140px,.7fr) minmax(170px,1fr);}.building-card>p{grid-column:1/-1}.building-card footer{grid-column:2;grid-row:1;align-self:end}}
  @media(max-width:900px){.activity-grid{grid-template-columns:1fr}.activity-heading{grid-template-columns:1fr;gap:14px}.activity-heading>p{justify-self:start}.building-card{grid-template-columns:minmax(140px,.6fr) minmax(180px,1fr) minmax(0,1.35fr) auto}.building-card>p{grid-column:auto}.building-card footer{grid-column:auto;grid-row:auto}}
  @media(max-width:700px){.building-card{grid-template-columns:1fr auto;gap:10px 16px}.building-card__meta{grid-column:1}.building-card h4{grid-column:1}.building-card>p{grid-column:1/-1}.building-card footer{grid-column:2;grid-row:1/span 2;align-self:center}.recent-list a{grid-template-columns:30px minmax(0,1fr) 16px}.recent-list time{grid-column:2;grid-row:2}.recent-list__arrow{grid-column:3;grid-row:1/span 2}}
  @media(max-width:620px){.project-activity{padding-top:var(--space-8)}.building-card{display:block;padding:16px 0}.building-card:hover{padding-inline:0}.building-card h4{margin-top:14px}.building-card>p{margin-top:8px}.building-card footer{margin-top:12px;align-items:flex-start}.activity-panel__all{justify-content:flex-start}}
  @media(prefers-reduced-motion:reduce){.building-card,.recent-list a{transition:none}}
</style>
