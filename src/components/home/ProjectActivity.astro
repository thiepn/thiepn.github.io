---
import StatusLabel from '../artifacts/StatusLabel.astro';
import {
  getProjectUpdatedAt,
  selectCurrentlyBuildingProjects,
  selectRecentlyUpdatedProjects,
  type ProjectEntry,
} from '../../lib/catalogue';

interface Props { projects: ProjectEntry[]; }
const { projects } = Astro.props;
const building = selectCurrentlyBuildingProjects(projects, 4);
const buildingSlugs = building.map((entry) => entry.data.slug);
const recent = selectRecentlyUpdatedProjects(projects, 5, buildingSlugs);
const formatDate = (date: Date) => new Intl.DateTimeFormat('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }).format(date);
const dateValue = (entry: ProjectEntry) => getProjectUpdatedAt(entry.data);
const dateIso = (entry: ProjectEntry) => dateValue(entry).toISOString().slice(0, 10);
---

{(building.length > 0 || recent.length > 0) && (
  <section class="project-activity" aria-labelledby="activity-title" data-project-activity>
    <header class="activity-heading">
      <div>
        <p class="activity-eyebrow">In motion</p>
        <h2 id="activity-title">What is changing now.</h2>
      </div>
      <p>Active builds and the newest project updates, derived directly from catalogue metadata.</p>
    </header>

    <div class="activity-grid">
      {building.length > 0 && (
        <section class="activity-panel activity-panel--building" aria-labelledby="building-title" data-currently-building>
          <header class="activity-panel__head">
            <div><p>Development</p><h3 id="building-title">Currently building</h3></div>
            <span>{String(building.length).padStart(2, '0')}</span>
          </header>
          <div class="building-list">
            {building.map((entry) => {
              const p = entry.data;
              return (
                <article class="building-card" data-activity-project={p.slug} data-updated={dateIso(entry)}>
                  <div class="building-card__meta">
                    <span>{p.code} · {p.category}</span>
                    <StatusLabel status={p.status} />
                  </div>
                  <h4><a href={`/project/${p.slug}/`}>{p.title}</a></h4>
                  <p>{p.summary}</p>
                  <footer>
                    <time datetime={dateIso(entry)}>Updated {formatDate(dateValue(entry))}</time>
                    {p.liveUrl && <a href={p.liveUrl} aria-label={`${p.actions.primaryLabel}: ${p.title}`}>{p.actions.primaryLabel} <span aria-hidden="true">↗</span></a>}
                  </footer>
                </article>
              );
            })}
          </div>
        </section>
      )}

      {recent.length > 0 && (
        <section class="activity-panel activity-panel--recent" aria-labelledby="recent-title" data-recently-updated>
          <header class="activity-panel__head">
            <div><p>Timeline</p><h3 id="recent-title">Recently updated</h3></div>
            <span>{String(recent.length).padStart(2, '0')}</span>
          </header>
          <ol class="recent-list">
            {recent.map((entry, index) => {
              const p = entry.data;
              return (
                <li data-activity-project={p.slug} data-updated={dateIso(entry)}>
                  <a href={`/project/${p.slug}/`}>
                    <span class="recent-list__number">{String(index + 1).padStart(2, '0')}</span>
                    <span class="recent-list__project"><strong>{p.title}</strong><small>{p.category} · {p.type}</small></span>
                    <time datetime={dateIso(entry)}>{formatDate(dateValue(entry))}</time>
                    <span class="recent-list__arrow" aria-hidden="true">→</span>
                  </a>
                </li>
              );
            })}
          </ol>
          <a class="activity-panel__all" href="/projects/">Browse the full project archive <span aria-hidden="true">→</span></a>
        </section>
      )}
    </div>
  </section>
)}

<style>
  .project-activity{padding-top:clamp(64px,8vw,104px)}
  .activity-heading{display:grid;grid-template-columns:minmax(0,1fr) minmax(260px,.6fr);gap:clamp(28px,6vw,88px);align-items:end;padding-bottom:var(--space-5);border-bottom:1px solid var(--line-strong)}
  .activity-eyebrow,.activity-panel__head p{font:500 .68rem var(--font-meta);letter-spacing:.1em;text-transform:uppercase;color:var(--ink-muted)}
  .activity-heading h2{margin-top:5px;font-size:clamp(2rem,3.5vw,3.45rem);line-height:.94;letter-spacing:-.052em;font-weight:560}
  .activity-heading>p{max-width:48ch;justify-self:end;color:var(--ink-secondary);font-size:.82rem;line-height:1.55}
  .activity-grid{display:grid;grid-template-columns:minmax(0,1.25fr) minmax(330px,.75fr);gap:var(--space-5);padding-top:var(--space-5)}
  .activity-panel{min-width:0;border-top:1px solid var(--line-strong)}
  .activity-panel__head{display:flex;align-items:flex-end;justify-content:space-between;gap:var(--space-4);padding:13px 0;border-bottom:1px solid var(--line)}
  .activity-panel__head h3{margin-top:3px;font-size:clamp(1.2rem,1.8vw,1.55rem);letter-spacing:-.03em;font-weight:560}
  .activity-panel__head>span{font:600 .72rem var(--font-meta);letter-spacing:.07em;color:var(--ink-muted)}
  .building-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));border-left:1px solid var(--line)}
  .building-card{display:flex;flex-direction:column;min-width:0;min-height:220px;padding:17px;border-right:1px solid var(--line);border-bottom:1px solid var(--line);background:var(--surface-1)}
  .building-card:hover{background:var(--surface-2)}
  .building-card__meta{display:flex;align-items:center;justify-content:space-between;gap:12px;font:500 .62rem var(--font-meta);letter-spacing:.06em;text-transform:uppercase;color:var(--ink-muted)}
  .building-card h4{margin-top:clamp(22px,3vw,36px);font-size:clamp(1.35rem,2.2vw,1.9rem);line-height:1;letter-spacing:-.04em;font-weight:560}
  .building-card h4 a{text-decoration:none}.building-card h4 a:hover,.building-card h4 a:focus-visible{text-decoration:underline;text-underline-offset:5px}
  .building-card>p{margin-top:10px;max-width:44ch;color:var(--ink-secondary);font-size:.78rem;line-height:1.5}
  .building-card footer{display:flex;align-items:flex-end;justify-content:space-between;gap:14px;margin-top:auto;padding-top:24px;font:500 .61rem var(--font-meta);letter-spacing:.055em;text-transform:uppercase;color:var(--ink-muted)}
  .building-card footer a{min-height:44px;display:inline-flex;align-items:center;text-decoration:none;color:var(--ink)}.building-card footer a:hover,.building-card footer a:focus-visible{text-decoration:underline;text-underline-offset:5px}
  .recent-list{list-style:none;margin:0;padding:0;border-left:1px solid var(--line)}
  .recent-list li{border-right:1px solid var(--line);border-bottom:1px solid var(--line)}
  .recent-list a{display:grid;grid-template-columns:32px minmax(0,1fr) auto 16px;align-items:center;gap:12px;min-height:72px;padding:10px 12px;text-decoration:none;background:var(--surface-1)}
  .recent-list a:hover,.recent-list a:focus-visible{background:var(--surface-2)}
  .recent-list__number,.recent-list time,.recent-list__project small{font:500 .61rem var(--font-meta);letter-spacing:.055em;text-transform:uppercase;color:var(--ink-muted)}
  .recent-list__project{display:flex;min-width:0;flex-direction:column;gap:4px}.recent-list__project strong{font-size:.88rem;line-height:1.15;letter-spacing:-.018em;font-weight:560;overflow-wrap:anywhere}.recent-list__project small{font-size:.57rem}
  .recent-list time{white-space:nowrap}.recent-list__arrow{color:var(--ink-muted)}
  .activity-panel__all{display:flex;min-height:48px;align-items:center;justify-content:flex-end;gap:.45em;padding-top:10px;font:500 .62rem var(--font-meta);letter-spacing:.06em;text-transform:uppercase;color:var(--ink-secondary);text-decoration:none}.activity-panel__all:hover,.activity-panel__all:focus-visible{text-decoration:underline;text-underline-offset:5px}
  @media(max-width:900px){.activity-grid{grid-template-columns:1fr}.activity-heading{grid-template-columns:1fr;gap:14px}.activity-heading>p{justify-self:start}}
  @media(max-width:620px){.project-activity{padding-top:var(--space-8)}.building-list{grid-template-columns:1fr}.building-card{min-height:190px}.recent-list a{grid-template-columns:28px minmax(0,1fr) 16px}.recent-list time{grid-column:2;grid-row:2}.recent-list__arrow{grid-column:3;grid-row:1/span 2}.activity-panel__all{justify-content:flex-start}}
</style>
