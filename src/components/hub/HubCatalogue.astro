---
import HubCard from './HubCard.astro';
import HubFilters from './HubFilters.astro';
import { getHubCategoryCounts, type HubProjectEntry } from '../../lib/hub';
interface Props { entries: HubProjectEntry[]; heading?: string; headingLevel?: 1 | 2; showHeading?: boolean; }
const { entries, heading = 'Apps', headingLevel = 1, showHeading = true } = Astro.props;
const counts = getHubCategoryCounts(entries);
---
<section class="hub-catalogue" id="apps" aria-labelledby={showHeading?"apps-heading":undefined} aria-label={showHeading?undefined:heading} data-hub-catalogue>
  {showHeading && <header class="hub-catalogue__heading">
    {headingLevel === 1 ? <h1 id="apps-heading">{heading}</h1> : <h2 id="apps-heading">{heading}</h2>}
  </header>}

  <HubFilters total={entries.length} counts={counts} />

  <div class="hub-grid" data-hub-grid>
    {entries.map((entry, index) => <HubCard entry={entry} priority={index < 3} />)}
  </div>
</section>
