---
import HubMedia from './HubMedia.astro';
import { presentation } from '../../lib/showcase';
import { getHubSearchText, HUB_CATEGORY_CONFIG, type HubProjectEntry } from '../../lib/hub';
interface Props { entry: HubProjectEntry; priority?: boolean; }
const { entry, priority = false } = Astro.props;
const { project, hub } = entry;
const p = project.data;
const view = presentation(project);
const categoryLabel = HUB_CATEGORY_CONFIG.find((category) => category.id === hub.category)?.label ?? hub.category;
const details = `/project/${p.slug}/`;
const canonicalLiveUrl = p.liveUrl!;
const parsedLiveUrl = new URL(canonicalLiveUrl);
const liveUrl = parsedLiveUrl.origin === 'https://thiepn.dev'
  ? `${parsedLiveUrl.pathname}${parsedLiveUrl.search}${parsedLiveUrl.hash}`
  : canonicalLiveUrl;
const badgeLabel = hub.badge === 'rc' ? 'RC' : hub.badge === 'beta' ? 'Beta' : hub.badge === 'new' ? 'New' : null;
const searchText = getHubSearchText(entry);
---
<article
  class="hub-card"
  data-hub-item
  data-hub-category={hub.category}
  data-hub-search={searchText}
  style={`--hub-accent-light:${p.accent.light};--hub-accent-dark:${p.accent.dark};`}
>
  <a class="hub-card__media" href={liveUrl} aria-label={`Open ${p.title}`}>
    <HubMedia slug={p.slug} fallback={view.media} alt={`${p.title} app interface`} priority={priority} />
  </a>
  <div class="hub-card__body">
    <div class="hub-card__meta">
      <span>{categoryLabel}</span>
      {badgeLabel && <span class="hub-card__badge">{badgeLabel}</span>}
    </div>
    <h2><a href={liveUrl}>{p.title}</a></h2>
    <p>{hub.description}</p>
    <div class="hub-card__actions">
      <a class="hub-card__open" href={liveUrl}>Open app <span aria-hidden="true">↗</span></a>
      <a class="hub-card__details" href={details}>Details</a>
    </div>
  </div>
</article>
