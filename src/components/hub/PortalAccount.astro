<section class="portal-account" aria-labelledby="hub-account-heading" data-hub-account data-home-personal>
  <div><h2 id="hub-account-heading">Optional cloud sync</h2><p data-auth-status role="status">Not connected</p></div>
  <div class="portal-account-actions">
    <button class="portal-button" type="button" data-auth-login hidden>Enable cloud sync</button>
    <button class="portal-button" type="button" data-auth-switch hidden>Switch account</button>
    <button class="portal-button" type="button" data-auth-logout hidden>Sign out of Hub</button>
    <button class="portal-button" type="button" data-auth-retry hidden>Try again</button>
    <a class="portal-button" href="https://account.thiepn.dev/" rel="noreferrer">Open Account</a>
  </div>
</section>
