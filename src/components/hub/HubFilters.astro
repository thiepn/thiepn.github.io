---
import { HUB_CATEGORY_CONFIG } from '../../lib/hub';
import type { HubCategory } from '../../data/taxonomy';
interface Props { total: number; counts: Record<HubCategory, number>; }
const { total, counts } = Astro.props;
---
<div class="hub-controls" data-hub-controls>
  <div class="hub-filter-row">
    <div class="hub-categories" role="group" aria-label="Filter apps by category">
      <button type="button" class="hub-category is-active" data-hub-category="all" aria-pressed="true">All <span>{total}</span></button>
      {HUB_CATEGORY_CONFIG.map((category) => (
        <button type="button" class="hub-category" data-hub-category={category.id} aria-pressed="false">{category.label} <span>{counts[category.id]}</span></button>
      ))}
    </div>
  </div>
  <noscript><p class="hub-noscript">All apps are shown below. Category filters require JavaScript.</p></noscript>
</div>
