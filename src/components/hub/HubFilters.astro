---
import { HUB_CATEGORY_CONFIG } from '../../lib/hub';
import type { HubCategory } from '../../data/taxonomy';
interface Props { total: number; counts: Record<HubCategory, number>; }
const { total, counts } = Astro.props;
---
<div class="hub-controls" data-hub-controls>
  <form class="hub-search" method="get" action="/" data-hub-form role="search">
    <label for="hub-search-input">Search apps</label>
    <div class="hub-search__field">
      <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="10" cy="10" r="6.5"/><path d="m15 15 5 5"/></svg>
      <input id="hub-search-input" name="q" type="search" placeholder="Search 26 apps…" autocomplete="off" data-hub-search />
    </div>
  </form>

  <div class="hub-filter-row">
    <div class="hub-categories" role="group" aria-label="Filter apps by category">
      <button type="button" class="hub-category is-active" data-hub-category="all" aria-pressed="true">All <span>{total}</span></button>
      {HUB_CATEGORY_CONFIG.map((category) => (
        <button type="button" class="hub-category" data-hub-category={category.id} aria-pressed="false">{category.label} <span>{counts[category.id]}</span></button>
      ))}
    </div>
    <p class="hub-result-status" aria-live="polite" aria-atomic="true"><strong data-hub-result-count>{total}</strong> <span data-hub-result-label>apps</span></p>
  </div>
  <noscript><p class="hub-noscript">All apps are shown below. Use your browser's Find command to search this page.</p></noscript>
</div>
