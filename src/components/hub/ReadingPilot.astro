---
import { READING_PILOT_ENABLED } from '../../lib/reading-pilot';
import PrivateLibrary from './PrivateLibrary.astro';
const enabled = READING_PILOT_ENABLED && import.meta.env.PUBLIC_HUB_LIBRARY_PRIVATE !== 'staged-v1';
---
{enabled && <section class="portal-daily" data-reading-pilot data-home-personal aria-labelledby="reading-pilot-heading">
 <header class="portal-section-heading"><div><h2 id="reading-pilot-heading">Pick up your reading</h2></div></header>
 <details><summary>About reading access</summary><p>Library shares titles and progress from this browser. Shared browsers may contain another person’s history. Opening Library ends this session.</p></details>

 <p data-reading-pilot-status role="status" aria-live="polite">Nothing is read until you join and connect. Library’s separate sharing choices still apply.</p>
 <button class="portal-button" type="button" data-reading-pilot-join>Try reading pilot</button>
 <button class="portal-button" type="button" data-reading-pilot-end hidden>End pilot and clear this tab</button>
 <PrivateLibrary pilot />
</section>}
