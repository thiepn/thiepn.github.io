---
const enabled = import.meta.env.PUBLIC_HUB_NOTES_PRIVATE === 'staged-v1';
---
{enabled && <section class="portal-daily portal-private-notes" data-private-notes data-home-personal aria-labelledby="private-notes-heading">
  <header class="portal-section-heading"><div><h2 id="private-notes-heading">Your Notes</h2><p class="portal-muted">Titles and update times from your synced Notes. Local drafts stay in Notes.</p></div></header>
  <p role="status" aria-live="polite" data-notes-status>Sign in to connect your Notes.</p>
  <div class="portal-account-actions"><button class="portal-button" type="button" data-notes-connect>Connect Notes</button><button class="portal-button" type="button" data-notes-refresh hidden>Refresh</button><button class="portal-button" type="button" data-notes-disconnect hidden>Disconnect this tab</button><a class="portal-button" href="https://account.thiepn.dev/hub/connections" rel="noreferrer">Manage sharing</a><a class="portal-button" href="https://thiepn.dev/notes/" rel="noreferrer">Open Notes</a></div>
  <div data-notes-private hidden>
    <fieldset class="portal-view-switch"><legend>Show</legend><label><input type="radio" name="notes-operation" value="summary" checked/> Recent titles</label><label><input type="radio" name="notes-operation" value="continue"/> Continue</label></fieldset>
    <form data-notes-search><label>Search synced titles <input class="portal-input" name="query" type="search" maxlength="256" autocomplete="off"/></label><button class="portal-button" type="submit">Search Notes</button></form>
    <ul data-notes-items></ul><small data-notes-freshness></small>
  </div>
</section>}
