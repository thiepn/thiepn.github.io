---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionIndex from '../../components/index/SectionIndex.astro';
import InteractivePreview from '../../components/artifacts/InteractivePreview.astro';
import StatusLabel from '../../components/artifacts/StatusLabel.astro';
import CompactArtifact from '../../components/artifacts/CompactArtifact.astro';
import CapabilityList from '../../components/records/CapabilityList.astro';
import ArtifactGallery from '../../components/records/ArtifactGallery.astro';
import RecordMetadata from '../../components/records/RecordMetadata.astro';
import RecordNavigation from '../../components/records/RecordNavigation.astro';
import { getPublicProjects, getRelatedProjects, getProjectNeighbors } from '../../lib/catalogue';

export async function getStaticPaths(){
  const projects=await getPublicProjects();
  return projects.map((project)=>({params:{slug:project.data.slug},props:{project}}));
}
type ProjectEntry = Awaited<ReturnType<typeof getPublicProjects>>[number];
interface Props{project:ProjectEntry}
const { project }=Astro.props;
const p=project.data;
const related=await getRelatedProjects(p.slug,4);
const { previous, next }=await getProjectNeighbors(p.slug);
const { Content }=await render(project);
const accentStyle=`--project-accent-light:${p.accent.light};--project-accent-dark:${p.accent.dark};`;
const sectionTitle = p.category === 'learning' ? 'Learning Modes' : p.category === 'games' ? 'Core Systems' : 'Capabilities';
---
<BaseLayout title={`${p.title} — THIEPN.`} description={p.summary} ogImage={`/og/${p.slug}.svg`}>
  <article class="record page-shell" style={accentStyle} data-record-slug={p.slug}>
    <SectionIndex index="03" title="Artifact Record" meta={p.code} headingLevel="div" />

    <header class="record__hero index-grid">
      <div class="record__copy">
        <div class="record__identity"><span class="record__code">{p.code}</span><StatusLabel status={p.status} /></div>
        <h1>{p.title}</h1>
        <p class="record__subtitle">{p.subtitle}</p>
        <p class="record__summary">{p.summary}</p>
        <div class="record__actions">
          {p.liveUrl&&<a class="structural-button" href={p.liveUrl}>{p.actions.primaryLabel} ↗</a>}
          {p.repo&&<a class="text-link" href={`https://github.com/${p.repo}`}>Source ↗</a>}
        </div>
      </div>
      <div class="record__preview" data-record-preview>
        <div class="record__preview-label"><span>PREVIEW / {p.preview.tier}</span><strong data-record-preview-label>PRIMARY PREVIEW</strong></div>
        <InteractivePreview project={project} size="hero" focusable={true} />
      </div>
    </header>

    <section class="record__section record__overview" aria-labelledby="overview-title">
      <SectionIndex index="01" title="Overview" headingId="overview-title" />
      <div class="record__overview-grid">
        <div class="record__overview-label meta">What it is</div>
        <div class="record__prose"><Content /></div>
        <aside><span class="meta">Index note</span><p>{p.type === 'game' ? 'Indexed as a playable system: the record emphasizes its actual loop, controls, and progression rather than marketing claims.' : p.category === 'learning' ? 'Indexed through the learning interaction itself: what the learner recalls, changes, practices, or understands.' : 'Indexed as a working artifact: the record follows the workflow and result rather than a generic product pitch.'}</p></aside>
      </div>
    </section>

    <CapabilityList project={project} />

    <ArtifactGallery project={project} />

    <section class="record__section" aria-labelledby="record-title">
      <SectionIndex index="04" title="Record" headingId="record-title" />
      <RecordMetadata project={project} />
    </section>

    {related.length>0&&<section class="record__section" aria-labelledby="related-title">
      <SectionIndex index="05" title="Related Artifacts" meta={`${String(related.length).padStart(2,'0')} CONNECTED`} headingId="related-title" />
      <div class="record__related">{related.map((entry)=><CompactArtifact project={entry} />)}</div>
    </section>}

    <RecordNavigation previous={previous} next={next} />
    <nav class="record__end" aria-label="Record actions">
      <a class="text-link" href="/projects/">← Return to project archive</a>
      <span class="record__end-context">{p.code} / {sectionTitle.toUpperCase()}</span>
      {p.liveUrl&&<a class="structural-button" href={p.liveUrl}>{p.actions.primaryLabel} ↗</a>}
    </nav>
  </article>
</BaseLayout>
<style>
  .record{--project-accent:var(--project-accent-light);padding-top:clamp(34px,5vw,66px);padding-bottom:var(--space-9)}:global(html[data-theme="dark"]) .record{--project-accent:var(--project-accent-dark)}
  .record__hero{padding:var(--space-9) 0 var(--space-10);align-items:center}.record__copy{grid-column:1/span 5}.record__preview{grid-column:7/-1;min-width:0}.record__identity{display:flex;align-items:center;gap:var(--space-4)}.record__code{font:600 .8rem var(--font-meta);letter-spacing:.07em;color:var(--project-accent)}
  .record h1{margin-top:var(--space-5);font-size:var(--text-display-l);line-height:.84;letter-spacing:-.065em;max-width:10ch}.record__subtitle{margin-top:var(--space-5);font-size:var(--text-h3);letter-spacing:-.025em}.record__summary{margin-top:var(--space-4);max-width:46ch;color:var(--ink-secondary)}
  .record__actions{display:flex;flex-wrap:wrap;align-items:center;gap:var(--space-6);margin-top:var(--space-7)}.record__preview-label{display:flex;justify-content:space-between;gap:var(--space-4);margin-bottom:8px;font:500 .58rem var(--font-meta);letter-spacing:.07em;color:var(--ink-muted)}.record__preview-label strong{color:var(--project-accent);font-weight:600;text-align:right}
  .record__section{padding:var(--space-9) 0}.record__overview-grid{display:grid;grid-template-columns:2fr 6fr 4fr;gap:var(--space-7);margin-top:var(--space-7)}.record__overview-label{color:var(--ink-muted)}.record__prose{max-width:66ch;font-size:var(--text-body-l);line-height:var(--leading-reading)}.record__prose :global(p+p){margin-top:var(--space-4)}.record__overview-grid aside{border-left:1px solid var(--line);padding-left:var(--space-5)}.record__overview-grid aside .meta{color:var(--ink-muted)}.record__overview-grid aside p{margin-top:var(--space-3);color:var(--ink-secondary);font-size:.83rem;line-height:1.55}
  .record__related{margin-top:var(--space-5);border-top:1px solid var(--line-strong)}.record__end{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:var(--space-5);padding-top:var(--space-7);margin-top:var(--space-7)}.record__end .structural-button{justify-self:end}.record__end-context{font:500 .58rem var(--font-meta);letter-spacing:.07em;color:var(--ink-muted)}

  /* Capability-linked hero states. They freeze the same Phase 7 scenes into inspectable states. */
  .record__preview[data-record-preview-variant="organize"] :global(.pdf-page--moving){transform:translate(-25px,8px) rotate(-3deg)}
  .record__preview[data-record-preview-variant="annotate"] :global(.pdf-appbar span:last-child){color:var(--project-accent);font-weight:700}
  .record__preview[data-record-preview-variant="redact"] :global(.pdf-selection),.record__preview[data-record-preview-variant="redact"] :global(.pdf-page--moving .redact){opacity:1;transform:scale(1)}
  .record__preview[data-record-preview-variant="export"] :global(.pdf-page--moving .redact){opacity:1}.record__preview[data-record-preview-variant="export"] :global(.pdf-tool strong){opacity:1;color:var(--project-accent)}
  .record__preview[data-record-preview-variant="source"] :global(.paper-pane){opacity:.28}.record__preview[data-record-preview-variant="build"] :global(.manuscript-progress span){width:66%}.record__preview[data-record-preview-variant="compose"] :global(.paper-figure){outline:2px solid var(--project-accent);outline-offset:2px}.record__preview[data-record-preview-variant="output"] :global(.editor-pane){opacity:.32}.record__preview[data-record-preview-variant="output"] :global(.manuscript-progress span){width:100%}
  .record__preview[data-record-preview-variant="tasks"] :global(.clean-progress span){width:0}.record__preview[data-record-preview-variant="progress"] :global(.clean-progress span){width:67%}.record__preview[data-record-preview-variant="routine"] :global(.clean-head strong){color:var(--project-accent)}.record__preview[data-record-preview-variant="complete"] :global(.clean-progress span){width:100%}.record__preview[data-record-preview-variant="complete"] :global(.clean-complete){opacity:1}
  .record__preview[data-record-preview-variant="campaign"] :global(.strike-core){box-shadow:0 0 25px color-mix(in srgb,var(--project-accent) 28%,transparent)}.record__preview[data-record-preview-variant="typing"] :global(.word-target){opacity:.18}.record__preview[data-record-preview-variant="typing"] :global(.strike-entry){outline:1px solid var(--project-accent)}.record__preview[data-record-preview-variant="endless"] :global(.word-target){color:var(--project-accent)}.record__preview[data-record-preview-variant="daily"] :global(.strike-hud span:first-child){color:var(--project-accent)}
  .record__preview[data-record-preview-variant="prompt"] :global(.french-card--one em),.record__preview[data-record-preview-variant="prompt"] :global(.french-card--one p){opacity:.08}.record__preview[data-record-preview-variant="context"] :global(.french-card--one em),.record__preview[data-record-preview-variant="context"] :global(.french-card--one p){color:var(--project-accent)}.record__preview[data-record-preview-variant="rating"] :global(.rating .active){background:color-mix(in srgb,var(--project-accent) 18%,transparent)}.record__preview[data-record-preview-variant="next"] :global(.french-card--one){opacity:.2}.record__preview[data-record-preview-variant="next"] :global(.french-card--two){opacity:1}
  .record__preview[data-record-preview-variant="question"] :global(.quiz-lock){opacity:0}.record__preview[data-record-preview-variant="timer"] :global(.quiz-top strong){color:var(--project-accent)}.record__preview[data-record-preview-variant="answer"] :global(.answer-correct){border-color:var(--project-accent)}.record__preview[data-record-preview-variant="score"] :global(.quiz-score){color:var(--project-accent)}
  .record__preview[data-record-preview-variant="parameter"] :global(.analysis-head strong){color:var(--project-accent)}.record__preview[data-record-preview-variant="graph"] :global(.analysis-curve--a){opacity:.08}.record__preview[data-record-preview-variant="graph"] :global(.analysis-curve--b){opacity:1}.record__preview[data-record-preview-variant="problem"] :global(.analysis-result strong){opacity:.12}.record__preview[data-record-preview-variant="result"] :global(.analysis-result strong){opacity:1;color:var(--project-accent)}

  @media(max-width:950px){.record__copy{grid-column:1/-1}.record__preview{grid-column:1/-1;margin-top:var(--space-8)}.record__overview-grid{grid-template-columns:2fr 6fr}.record__overview-grid aside{grid-column:2;border-left:0;border-top:1px solid var(--line);padding:var(--space-4) 0 0}}
  @media(max-width:599px){.record__hero{padding:var(--space-8) 0 var(--space-9)}.record h1{font-size:clamp(3.4rem,17vw,5rem)}.record__overview-grid{grid-template-columns:1fr;gap:var(--space-4)}.record__overview-grid aside{grid-column:auto}.record__preview-label{flex-direction:column;gap:3px}.record__preview-label strong{text-align:left}.record__end{grid-template-columns:1fr;align-items:start}.record__end-context{display:none}.record__end .structural-button{justify-self:start}}
  @media(prefers-reduced-motion:reduce){.record__preview :global(*){transition:none!important}}
</style>
