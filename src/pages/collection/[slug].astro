---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CompactArtifact from '../../components/artifacts/CompactArtifact.astro';
import ArtifactPlate from '../../components/artifacts/ArtifactPlate.astro';
import CollectionMap from '../../components/collections/CollectionMap.astro';
import { getCollections,getPublicProjects } from '../../lib/catalogue';

export async function getStaticPaths(){
  const collections=await getCollections();
  return collections.map((collection)=>({params:{slug:collection.data.slug},props:{collection}}));
}

type CollectionRecord=Awaited<ReturnType<typeof getCollections>>[number];
interface Props{collection:CollectionRecord}
const{collection}=Astro.props;
const c=collection.data;
const allProjects=await getPublicProjects();
const bySlug=new Map(allProjects.map((p)=>[p.data.slug,p]));
const projects=c.projects.map((slug)=>bySlug.get(slug)).filter((v):v is NonNullable<typeof v>=>Boolean(v));
const anchors=c.anchors.map((slug)=>bySlug.get(slug)).filter((v):v is NonNullable<typeof v>=>Boolean(v));
const categoryLabels={tools:'Tools',learning:'Learning',games:'Games',resources:'Resources',visualizations:'Visualizations',experiments:'Experiments'} as const;
const categoryCounts=new Map<string,number>();
for(const project of projects) categoryCounts.set(project.data.category,(categoryCounts.get(project.data.category)??0)+1);
const representedCategories=[...categoryCounts.entries()].sort((a,b)=>a[0].localeCompare(b[0]));
const collectionIndex=[
  {href:'#position',label:'Position'},
  {href:'#about',label:'About'},
  ...(anchors.length?[{href:'#featured',label:'Featured'}]:[]),
  {href:'#directory',label:'Directory'},
  {href:'#connections',label:'Connections'},
];
---
<BaseLayout title={`${c.title} — THIEPN`} description={c.summary} ogImage={`/og/collection-${c.slug}.svg`}>
  <article class="collection-record page-shell" data-collection-record={c.slug}>
    <div class="collection-record__breadcrumb"><a href="/collections/">Collections</a><span aria-hidden="true">/</span><span>{c.code}</span></div>

    <header class="collection-record__hero">
      <div class="collection-record__intro">
        <p class="meta">Editorial collection / {c.type}</p>
        <h1>{c.title}</h1>
        <p>{c.summary}</p>
      </div>
      <dl class="collection-record__stats" aria-label="Collection counts">
        <div><dt>Projects</dt><dd>{String(projects.length).padStart(2,'0')}</dd></div>
        <div><dt>Featured</dt><dd>{String(anchors.length).padStart(2,'0')}</dd></div>
        <div><dt>Categories</dt><dd>{String(representedCategories.length).padStart(2,'0')}</dd></div>
      </dl>
    </header>

    <nav class="collection-record__record-index" aria-label="On this collection">
      <span class="collection-record__record-index-label">Collection index</span>
      <div class="collection-record__record-index-links">
        {collectionIndex.map((item,index)=><a href={item.href}><span>{String(index+1).padStart(2,'0')}</span>{item.label}</a>)}
      </div>
    </nav>

    <section id="position" class="collection-record__position" aria-labelledby="position-title" data-collection-classification>
      <header class="collection-record__section-head"><div><p class="meta">Portfolio position</p><h2 id="position-title">Collection, not category</h2></div><span class="meta">Themes may overlap · project types stay singular</span></header>
      <div class="collection-record__position-grid">
        <div class="collection-record__position-copy">
          <span class="meta">Editorial grouping</span>
          <strong>{c.title}</strong>
          <p>This collection groups related work by subject, audience, or use. Membership does not replace a project's category, and the same project may appear in other collections.</p>
        </div>
        <div class="collection-record__category-mix">
          <div class="collection-record__position-label"><span>Categories represented</span><small>{String(representedCategories.length).padStart(2,'0')} project types</small></div>
          <nav aria-label={`Project categories represented in ${c.title}`}>
            {representedCategories.map(([category,count])=><a href={`/projects/?category=${category}`}><strong>{categoryLabels[category as keyof typeof categoryLabels]??category}</strong><span>{String(count).padStart(2,'0')}</span><i aria-hidden="true">→</i></a>)}
          </nav>
        </div>
      </div>
      <div class="collection-record__position-footer">
        <a class="text-link" href="/projects/#category-title">Browse project categories →</a>
        <a class="text-link" href="/collections/">Browse all collections →</a>
      </div>
    </section>

    <section id="about" class="collection-record__logic" aria-labelledby="logic-title">
      <header class="collection-record__section-head"><div><p class="meta">About</p><h2 id="logic-title">About this collection</h2></div></header>
      <div class="collection-record__logic-grid">
        <p>{c.editorialNote}</p>
        <dl>
          <div><dt>Projects</dt><dd>{String(projects.length).padStart(2,'0')}</dd></div>
          <div><dt>Browse</dt><dd>{projects.length > 8 ? 'Featured projects + full directory' : 'Complete project group'}</dd></div>
          <div><dt>Topics</dt><dd>{c.keywords.join(' / ')}</dd></div>
        </dl>
      </div>
    </section>

    {anchors.length>0&&(
      <section id="featured" class="collection-record__anchors" aria-labelledby="anchors-title">
        <header class="collection-record__section-head"><div><p class="meta">Start here</p><h2 id="anchors-title">Featured projects</h2></div><span class="meta">{String(anchors.length).padStart(2,'0')} selected</span></header>
        <div class="collection-record__anchor-grid">{anchors.map((project)=><ArtifactPlate project={project} variant="feature" />)}</div>
      </section>
    )}

    <section id="directory" class="collection-record__index" aria-labelledby="collection-index-title">
      <header class="collection-record__section-head"><div><p class="meta">Directory</p><h2 id="collection-index-title">Everything in this collection</h2></div><span class="meta">{String(projects.length).padStart(2,'0')} projects</span></header>
      <div class="collection-record__project-list">{projects.map((project)=><CompactArtifact project={project} />)}</div>
    </section>

    <section id="connections" class="collection-record__map" aria-labelledby="map-title">
      <header class="collection-record__section-head"><div><p class="meta">Connections</p><h2 id="map-title">How the projects relate</h2></div><span class="meta">Optional relationship view</span></header>
      <p class="collection-record__section-note">A secondary view for seeing how selected projects connect. The complete project list is above.</p>
      <CollectionMap collection={collection} projects={projects} />
    </section>
  </article>
</BaseLayout>
<style>
.collection-record{padding-top:clamp(26px,4vw,52px);padding-bottom:clamp(64px,8vw,104px)}
.collection-record__breadcrumb{display:flex;align-items:center;gap:8px;font:500 .6rem var(--font-meta);letter-spacing:.06em;text-transform:uppercase;color:var(--ink-muted)}.collection-record__breadcrumb a{text-decoration:none;color:inherit}.collection-record__breadcrumb a:hover{color:var(--ink)}
.collection-record__hero{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:clamp(32px,8vw,110px);align-items:end;padding:clamp(28px,4vw,50px) 0 clamp(34px,5vw,58px);border-bottom:1px solid var(--line-strong)}.collection-record__intro{max-width:780px}.collection-record__hero .meta{color:var(--ink-muted)}.collection-record__hero h1{margin-top:8px;font-size:clamp(2.8rem,5.2vw,5rem);line-height:.93;letter-spacing:-.055em;font-weight:560}.collection-record__hero p:not(.meta){margin-top:var(--space-4);max-width:60ch;color:var(--ink-secondary);font-size:clamp(.96rem,1.2vw,1.08rem);line-height:1.55}
.collection-record__stats{display:grid;grid-template-columns:repeat(3,minmax(82px,1fr));margin:0;border-top:1px solid var(--line-strong);border-left:1px solid var(--line)}.collection-record__stats div{display:grid;gap:5px;padding:11px;border-right:1px solid var(--line);border-bottom:1px solid var(--line)}.collection-record__stats dt{font:500 .54rem var(--font-meta);letter-spacing:.055em;text-transform:uppercase;color:var(--ink-muted)}.collection-record__stats dd{margin:0;font:600 1rem var(--font-meta);font-variant-numeric:tabular-nums}
.collection-record__record-index{display:grid;grid-template-columns:minmax(110px,.7fr) minmax(0,4.3fr);gap:var(--space-5);align-items:start;padding:12px 0;border-bottom:1px solid var(--line);font:500 .58rem var(--font-meta);letter-spacing:.055em;text-transform:uppercase}.collection-record__record-index-label{color:var(--ink-muted)}.collection-record__record-index-links{display:flex;flex-wrap:wrap;gap:8px clamp(14px,2.2vw,28px)}.collection-record__record-index-links a{display:inline-flex;gap:7px;color:var(--ink-secondary);text-decoration:none}.collection-record__record-index-links a span{color:var(--ink-muted)}.collection-record__record-index-links a:hover,.collection-record__record-index-links a:focus-visible{color:var(--ink)}
.collection-record__position,.collection-record__logic,.collection-record__anchors,.collection-record__index,.collection-record__map{padding-top:clamp(46px,6vw,70px);scroll-margin-top:90px}.collection-record__section-head{display:flex;justify-content:space-between;align-items:end;gap:var(--space-5);padding-bottom:12px;border-bottom:1px solid var(--line-strong)}.collection-record__section-head .meta{color:var(--ink-muted)}.collection-record__section-head h2{margin-top:3px;font-size:clamp(1.45rem,2.4vw,2.15rem);line-height:1;letter-spacing:-.035em;font-weight:560}.collection-record__section-head>span{max-width:40ch;text-align:right}
.collection-record__position-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(280px,.78fr);border-left:1px solid var(--line);margin-top:var(--space-5)}.collection-record__position-copy,.collection-record__category-mix{min-width:0;padding:15px;border-top:1px solid var(--line);border-right:1px solid var(--line);border-bottom:1px solid var(--line)}.collection-record__position-copy>strong{display:block;margin-top:var(--space-5);padding:10px 0;border-top:1px solid var(--line-soft);border-bottom:1px solid var(--line-soft);font-size:1.15rem;letter-spacing:-.025em;font-weight:560}.collection-record__position-copy>p{margin-top:var(--space-4);max-width:54ch;color:var(--ink-muted);font-size:.72rem;line-height:1.5}.collection-record__position-label{display:flex;justify-content:space-between;gap:var(--space-3);font:500 .56rem var(--font-meta);letter-spacing:.06em;text-transform:uppercase;color:var(--ink-muted)}.collection-record__position-label small{font:inherit;color:var(--ink-disabled);text-align:right}.collection-record__category-mix nav{margin-top:var(--space-5);border-top:1px solid var(--line-soft)}.collection-record__category-mix a{display:grid;grid-template-columns:minmax(0,1fr) 34px auto;gap:var(--space-3);align-items:center;min-height:44px;padding:7px 0;border-bottom:1px solid var(--line-soft);text-decoration:none}.collection-record__category-mix a strong{font-size:.78rem;font-weight:520}.collection-record__category-mix a span{font:500 .55rem var(--font-meta);letter-spacing:.055em;color:var(--ink-muted);text-align:right}.collection-record__category-mix a i{font-style:normal;color:var(--ink-muted)}.collection-record__category-mix a:hover strong,.collection-record__category-mix a:focus-visible strong{text-decoration:underline;text-underline-offset:3px;text-decoration-thickness:1px}.collection-record__position-footer{display:flex;flex-wrap:wrap;justify-content:space-between;gap:var(--space-4);padding-top:var(--space-4)}
.collection-record__logic-grid{display:grid;grid-template-columns:minmax(0,1.35fr) minmax(250px,.65fr);gap:clamp(28px,6vw,90px);margin-top:var(--space-5);align-items:start}.collection-record__logic-grid>p{max-width:62ch;font-size:clamp(1rem,1.45vw,1.2rem);line-height:1.55;letter-spacing:-.012em}.collection-record__logic-grid dl{margin:0;border-top:1px solid var(--line-strong)}.collection-record__logic-grid dl div{display:grid;grid-template-columns:76px 1fr;gap:var(--space-3);padding:9px 0;border-bottom:1px solid var(--line)}.collection-record__logic-grid dt{font:500 .55rem var(--font-meta);letter-spacing:.055em;text-transform:uppercase;color:var(--ink-muted)}.collection-record__logic-grid dd{margin:0;font-size:.74rem;color:var(--ink-secondary)}
.collection-record__section-note{margin-top:var(--space-3);max-width:66ch;color:var(--ink-muted);font-size:.72rem;line-height:1.5}
.collection-record__anchor-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:var(--space-4);margin-top:var(--space-5)}.collection-record__project-list{margin-top:var(--space-4);border-top:1px solid var(--line-strong)}
@media(max-width:900px){.collection-record__hero{grid-template-columns:1fr;gap:var(--space-6)}.collection-record__stats{width:min(100%,440px)}.collection-record__logic-grid,.collection-record__position-grid{grid-template-columns:1fr;gap:0}.collection-record__record-index{grid-template-columns:1fr;gap:7px}}
@media(max-width:760px){.collection-record__anchor-grid{grid-template-columns:1fr}.collection-record__section-head>span{display:none}.collection-record__position-footer{display:grid;justify-content:start}}
@media(max-width:599px){.collection-record{padding-top:var(--space-5)}.collection-record__hero h1{font-size:clamp(2.7rem,14vw,4rem)}.collection-record__stats{grid-template-columns:repeat(3,minmax(0,1fr))}.collection-record__stats div{padding:9px}.collection-record__logic-grid>p{font-size:1rem}.collection-record__logic-grid dl div{grid-template-columns:70px 1fr}.collection-record__record-index-links{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px 12px}.collection-record__position-label{align-items:flex-start}.collection-record__position-label small{max-width:18ch}}
</style>
