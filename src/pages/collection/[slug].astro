---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectExhibit from '../../components/studio/ProjectExhibit.astro';
import {getCollections,getPublicProjects} from '../../lib/catalogue';
export async function getStaticPaths(){return (await getCollections()).map(collection=>({params:{slug:collection.data.slug},props:{collection}}));}
type Entry=Awaited<ReturnType<typeof getCollections>>[number];
interface Props {collection:Entry;}
const {collection}=Astro.props;const c=collection.data;const all=await getPublicProjects();const projects=c.projects.map(slug=>all.find(p=>p.data.slug===slug)).filter((p):p is NonNullable<typeof p>=>Boolean(p));
---
<BaseLayout title={`${c.title} — THIEPN`} description={c.summary} ogImage={`/og/collection-${c.slug}.png`}><div class="page-shell page-content"><a class="back-link" href="/collections/">← Browse by interest</a><header class="page-intro"><h1>{c.title}</h1><p>{c.summary}</p></header><div class="work-gallery">{projects.map((project,index)=><ProjectExhibit project={project} heading="h2" priority={index<2}/>)}</div><div class="archive-invitation"><h2>Keep exploring.</h2><a class="button" href="/work/">Selected work →</a></div></div></BaseLayout>
