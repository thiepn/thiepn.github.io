---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionIndex from '../components/index/SectionIndex.astro';
import LivingIndexField from '../components/index/LivingIndexField.astro';
import HeroArtifact from '../components/artifacts/HeroArtifact.astro';
import FeatureArtifact from '../components/artifacts/FeatureArtifact.astro';
import CompactArtifact from '../components/artifacts/CompactArtifact.astro';
import CategoryIndex from '../components/archive/CategoryIndex.astro';
import ProjectArchive from '../components/archive/ProjectArchive.astro';
import CollectionPreview from '../components/collections/CollectionPreview.astro';
import RecentActivity from '../components/activity/RecentActivity.astro';
import { getCatalogueStats, getCollections, getFeaturedProjects, getPublicProjects } from '../lib/catalogue';

const stats = await getCatalogueStats();
const featured = await getFeaturedProjects();
const projects = await getPublicProjects();
const collections = await getCollections();
collections.sort((a,b)=>a.data.code.localeCompare(b.data.code));
const projectBySlug = new Map(projects.map((p)=>[p.data.slug,p]));
const collectionTitles = (slugs:string[]) => slugs.map((slug)=>projectBySlug.get(slug)?.data.title).filter((v):v is string=>Boolean(v));
const heroFeatured = featured.slice(0,2);
const mediumFeatured = featured.slice(2,5);
const editorialFeatured = featured.slice(5,7);
---
<BaseLayout>
  <section class="hero page-shell" aria-labelledby="index-title" data-index-hero>
    <SectionIndex index="00" title="Index" meta="Current / 2026—" headingLevel="div" />
    <div class="hero__grid index-grid">
      <div class="hero__copy">
        <h1 id="index-title" data-hero-title>THIEPN.</h1>
        <p class="hero__statement" data-hero-copy>Things I've built.</p>
        <p class="hero__description" data-hero-copy>Tools, games, learning systems, resources and experiments—kept as one evolving project index.</p>
        <div class="hero__actions" data-hero-copy><a class="structural-button" href="#featured">Explore ↓</a><a class="text-link" href="/projects/" data-catalogue-search-open>Search the index →</a></div>
      </div>
      <aside class="hero__record" aria-label="Catalogue overview" data-hero-record>
        <div><span>Index size</span><strong>{String(stats.totalListed).padStart(3,'0')}</strong></div>
        <div><span>Live</span><strong>{String(stats.status.live).padStart(3,'0')}</strong></div>
        <div><span>Beta</span><strong>{String(stats.status.beta).padStart(3,'0')}</strong></div>
        <div><span>Experiment</span><strong>{String(stats.status.experiment).padStart(3,'0')}</strong></div>
      </aside>
    </div>
    <LivingIndexField projects={featured} />
  </section>

  <section id="featured" class="featured page-shell section-space--large" aria-labelledby="featured-title" data-motion-section>
    <SectionIndex index="01" title="Featured Work" meta={`${String(featured.length).padStart(3,'0')} Selected`} headingId="featured-title" />
    <p class="section-deck">Selected artifacts that show the range of the index.</p>
    <div class="featured__heroes">
      {heroFeatured.map((project)=><HeroArtifact project={project} />)}
    </div>
    <div class="featured__medium">
      {mediumFeatured.map((project)=><FeatureArtifact project={project} />)}
    </div>
    <div class="featured__editorial">
      {editorialFeatured.map((project)=><CompactArtifact project={project} />)}
    </div>
  </section>

  <section class="types page-shell section-space" aria-labelledby="types-title" data-motion-section>
    <SectionIndex index="02" title="Browse by Type" meta="06 Categories" headingId="types-title" />
    <CategoryIndex stats={stats} />
  </section>

  <section id="projects" class="archive page-shell section-space--large" aria-labelledby="archive-title" data-motion-section>
    <SectionIndex index="03" title="Project Archive" meta={`${String(stats.totalListed).padStart(3,'0')} Artifacts`} headingId="archive-title" />
    <div class="archive__intro"><p>Every listed project, in curated order. Filter, search, sort, or switch to a compact ledger; without JavaScript the full catalogue remains visible.</p><a class="text-link" href="/projects/">Open dedicated archive →</a></div>
    <ProjectArchive projects={projects} id="home-archive-catalogue" />
  </section>

  <section id="collections" class="collections page-shell section-space--large" aria-labelledby="collections-title" data-motion-section>
    <SectionIndex index="04" title="Collections" meta={`${String(collections.length).padStart(2,'0')} Curated Sets`} headingId="collections-title" />
    <div class="collections__grid">
      {collections.map((collection)=><CollectionPreview collection={collection} projectTitles={collectionTitles(collection.data.projects)} />)}
    </div>
    <div class="collections__footer"><a class="text-link" href="/collections/">View all collections →</a></div>
  </section>

  <section id="recent" class="recent page-shell section-space" aria-labelledby="recent-title" data-motion-section>
    <SectionIndex index="05" title="Recent Activity" meta="Index Log" headingId="recent-title" />
    <RecentActivity projects={[...projects].reverse()} />
  </section>
</BaseLayout>

<style>
  .hero{padding-top:clamp(34px,5vw,66px);padding-bottom:var(--space-8)}.hero__grid{align-items:end;min-height:360px;padding-block:clamp(58px,8vw,118px) var(--space-8)}.hero__copy{grid-column:1/span 8}.hero h1{font-size:var(--text-display-xl);line-height:.8;letter-spacing:-.073em;font-weight:540}.hero__statement{margin-top:var(--space-6);font-size:clamp(1.45rem,2.4vw,2.2rem);line-height:1.05;letter-spacing:-.035em}.hero__description{margin-top:var(--space-4);max-width:39ch;color:var(--ink-secondary);font-size:var(--text-body-l)}.hero__actions{display:flex;flex-wrap:wrap;align-items:center;gap:var(--space-6);margin-top:var(--space-7)}.hero__record{grid-column:10/-1;border-top:1px solid var(--line-strong)}.hero__record>div{display:grid;grid-template-columns:1fr auto;gap:var(--space-4);align-items:baseline;padding:10px 0;border-bottom:1px solid var(--line);font:500 .65rem var(--font-meta);letter-spacing:.065em;text-transform:uppercase}.hero__record span{color:var(--ink-muted)}.hero__record strong{font-size:.82rem;font-variant-numeric:tabular-nums}
  .section-deck{margin-top:var(--space-5);max-width:52ch;color:var(--ink-secondary);font-size:.9rem}.featured__heroes{display:grid;grid-template-columns:7fr 5fr;gap:var(--space-5);align-items:start;margin-top:var(--space-8)}.featured__heroes>:nth-child(2){margin-top:var(--space-9)}.featured__medium{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:var(--space-5);margin-top:var(--space-6)}.featured__editorial{margin-top:var(--space-7);border-top:1px solid var(--line-strong)}
  .types{padding-top:var(--space-8)}.types :global(.category-index){margin-top:var(--space-6)}
  .archive__intro{display:flex;justify-content:space-between;align-items:flex-start;gap:var(--space-8);padding:var(--space-6) 0 var(--space-8)}.archive__intro p{max-width:58ch;color:var(--ink-secondary);font-size:.88rem}
  .collections__grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:var(--space-5);margin-top:var(--space-7)}.collections__footer{display:flex;justify-content:flex-end;margin-top:var(--space-5)}.recent :global(.recent-activity){margin-top:var(--space-6)}
  @media(max-width:1100px){.featured__heroes{grid-template-columns:1fr 1fr}.featured__heroes>:nth-child(2){margin-top:var(--space-7)}.featured__medium{grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media(max-width:899px){.hero__copy{grid-column:1/-1}.hero__record{grid-column:5/-1;margin-top:var(--space-8)}}
  @media(max-width:760px){.featured__heroes,.featured__medium,.collections__grid{grid-template-columns:1fr}.featured__heroes>:nth-child(2){margin-top:0}.archive__intro{display:grid;gap:var(--space-4)}}
  @media(max-width:599px){.hero{padding-top:var(--space-5)}.hero__grid{min-height:0;padding-block:var(--space-8)}.hero h1{font-size:clamp(4.5rem,25vw,7.2rem)}.hero__record{grid-column:1/-1;margin-top:var(--space-8)}.hero__actions{gap:var(--space-5);margin-top:var(--space-6)}.featured__medium{margin-top:var(--space-5)}.collections__grid{gap:var(--space-4)}}
</style>
