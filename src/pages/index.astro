---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectPreview from '../components/artifacts/ProjectPreview.astro';
import StatusLabel from '../components/artifacts/StatusLabel.astro';
import BookCard from '../components/books/BookCard.astro';
import ProjectActivity from '../components/home/ProjectActivity.astro';
import { PROJECT_INTENTS, getIntentCounts } from '../data/discovery';
import { getCatalogueStats, getCollections, getFeaturedProjects, getPublicProjects } from '../lib/catalogue';

const stats = await getCatalogueStats();
const featured = await getFeaturedProjects();
const projects = await getPublicProjects();
const books = (await getCollection('books')).sort((a, b) => b.data.lastUpdated.getTime() - a.data.lastUpdated.getTime());
const collections = await getCollections();
collections.sort((a,b)=>a.data.code.localeCompare(b.data.code));

const flagship = featured[0];
const supportingFeatured = featured.slice(1, 5);
const directoryPreview = projects.slice(0, 8);
const booksPreview = books.slice(0, 3);
const intentCounts = getIntentCounts(projects.map(({ data }) => data));
const intentCount = (intent: (typeof PROJECT_INTENTS)[number]) => intent.key === 'read' ? intentCounts.read + books.length : intentCounts[intent.key];
const intentHref = (intent: (typeof PROJECT_INTENTS)[number]) => intent.key === 'read' ? '/books/' : `/projects/?intent=${intent.key}#archive-catalogue`;
---
<BaseLayout>
  <div class="universe page-shell" data-index-hero>
    <section class="universe-hero" aria-labelledby="universe-title">
      <div class="universe-hero__copy">
        <p class="eyebrow">Independent digital portfolio</p>
        <h1 id="universe-title" data-hero-title>Things I build.</h1>
        <p class="universe-hero__intro" data-hero-copy>
          Software, games, learning systems, books, publishing tools and experiments — designed, built and refined as real products.
        </p>
        <div class="universe-hero__actions" data-hero-copy>
          <a class="structural-button" href="#featured">Explore selected work</a>
          <a class="text-link" href="/about/">About <span aria-hidden="true">→</span></a>
        </div>
      </div>

      <aside class="universe-hero__index" aria-label="Portfolio overview" data-hero-record>
        <p class="universe-hero__index-label">Portfolio index</p>
        <div class="universe-hero__stat"><strong>{String(stats.totalListed).padStart(2,'0')}</strong><span>Projects</span></div>
        <div class="universe-hero__stat"><strong>{String(books.length).padStart(2,'0')}</strong><span>Books</span></div>
        <div class="universe-hero__stat"><strong>{String(featured.length).padStart(2,'0')}</strong><span>Featured</span></div>
        <div class="universe-hero__stat"><strong>{String(collections.length).padStart(2,'0')}</strong><span>Collections</span></div>
      </aside>
    </section>

    {flagship && (
      <section id="featured" class="universe-section universe-section--featured" aria-labelledby="featured-title" data-motion-section>
        <header class="section-heading">
          <div>
            <p class="eyebrow">Flagship & featured</p>
            <h2 id="featured-title">Start with the flagship.</h2>
          </div>
          <a class="text-link" href="/projects/">View every project →</a>
        </header>

        <div class="universe-grid">
          <article class="flagship-card">
            <a class="flagship-card__preview" href={`/project/${flagship.data.slug}/`} aria-label={`View ${flagship.data.title}`}>
              <ProjectPreview project={flagship} size="feature" />
            </a>
            <div class="flagship-card__body">
              <div class="flagship-card__topline">
                <span>Flagship · {flagship.data.code} · {flagship.data.category}</span>
                <StatusLabel status={flagship.data.status} />
              </div>
              <div class="flagship-card__copy">
                <div>
                  <h3><a href={`/project/${flagship.data.slug}/`}>{flagship.data.title}</a></h3>
                  {flagship.data.subtitle && <p class="flagship-card__subtitle">{flagship.data.subtitle}</p>}
                  <p class="flagship-card__summary">{flagship.data.summary}</p>
                </div>
                <div class="flagship-card__actions" data-project-actions>
                  {flagship.data.liveUrl && <a class="structural-button flagship-card__launch" href={flagship.data.liveUrl} aria-label={`${flagship.data.actions.primaryLabel}: ${flagship.data.title}`} data-primary-project-action>{flagship.data.actions.primaryLabel} ↗</a>}
                  <a class="text-link" href={`/project/${flagship.data.slug}/`}>Project details →</a>
                </div>
              </div>
            </div>
          </article>

          <div class="supporting-grid" aria-label="More featured projects">
            {supportingFeatured.map((project) => {
              const p = project.data;
              return (
                <article class="support-card">
                  <a class="support-card__preview" href={`/project/${p.slug}/`} aria-label={`View ${p.title}`}>
                    <ProjectPreview project={project} size="standard" />
                  </a>
                  <div class="support-card__body">
                    <div class="support-card__meta"><span>{p.category}</span><StatusLabel status={p.status} /></div>
                    <h3><a href={`/project/${p.slug}/`}>{p.title}</a></h3>
                    <div class="support-card__actions" data-project-actions>
                      {p.liveUrl && <a class="structural-button support-card__launch" href={p.liveUrl} aria-label={`${p.actions.primaryLabel}: ${p.title}`} data-primary-project-action>{p.actions.primaryLabel} <span aria-hidden="true">↗</span></a>}
                      <a class="support-card__details" href={`/project/${p.slug}/`}>Details <span aria-hidden="true">→</span></a>
                    </div>
                  </div>
                </article>
              );
            })}
          </div>
        </div>
      </section>
    )}

    <ProjectActivity projects={projects} />

    <section class="universe-section" aria-labelledby="intent-title" data-motion-section data-intent-discovery>
      <header class="section-heading">
        <div>
          <p class="eyebrow">Start by intent</p>
          <h2 id="intent-title">What do you want to do?</h2>
        </div>
        <span class="section-heading__note">Five ways to explore the portfolio</span>
      </header>

      <nav class="intent-universe" aria-label="Explore projects and publications by intent">
        {PROJECT_INTENTS.map((intent, index) => (
          <a class="intent-node" href={intentHref(intent)} data-project-intent={intent.key}>
            <span class="intent-node__number">0{index + 1}</span>
            <div>
              <strong>{intent.label}</strong>
              <p>{intent.description}</p>
            </div>
            <span class="intent-node__count">{String(intentCount(intent)).padStart(2,'0')}</span>
            <i aria-hidden="true">↗</i>
          </a>
        ))}
      </nav>
      <p class="intent-universe__note">Prefer technical classification? <a href="/projects/#category-title">Browse all six project categories →</a></p>
    </section>

    <section class="universe-section" aria-labelledby="books-preview-title" data-motion-section data-books-discovery>
      <header class="section-heading">
        <div>
          <p class="eyebrow">Books</p>
          <h2 id="books-preview-title">Long-form published works.</h2>
        </div>
        <a class="text-link" href="/books/">View all books →</a>
      </header>
      <div class="books-preview">
        {booksPreview.map((book, index) => <BookCard book={book} heading="h3" priority={index === 0} />)}
      </div>
    </section>

    <section class="universe-section" aria-labelledby="directory-title" data-motion-section>
      <header class="section-heading">
        <div>
          <p class="eyebrow">Project index</p>
          <h2 id="directory-title">More to explore.</h2>
        </div>
        <a class="text-link" href="/projects/">Full directory →</a>
      </header>

      <div class="project-strip">
        {directoryPreview.map((project, index) => {
          const p = project.data;
          return (
            <a class="project-strip__item" href={`/project/${p.slug}/`}>
              <span class="project-strip__number">{String(index + 1).padStart(2,'0')}</span>
              <span class="project-strip__title">{p.title}</span>
              <span class="project-strip__type">{p.category}</span>
              <span class="project-strip__arrow" aria-hidden="true">→</span>
            </a>
          );
        })}
      </div>
    </section>

    <section class="universe-section universe-section--collections" aria-labelledby="collections-title" data-motion-section>
      <header class="section-heading">
        <div>
          <p class="eyebrow">Collections</p>
          <h2 id="collections-title">Follow an interest.</h2>
        </div>
        <a class="text-link" href="/collections/">All collections →</a>
      </header>

      <div class="collection-ribbon">
        {collections.map((collection) => (
          <a class="collection-chip" href={`/collection/${collection.data.slug}/`}>
            <span>{collection.data.code}</span>
            <strong>{collection.data.title}</strong>
            <small>{String(collection.data.projects.length).padStart(2,'0')}</small>
          </a>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .universe{position:relative;padding-top:clamp(34px,4vw,58px);padding-bottom:clamp(72px,8vw,112px);overflow:hidden}
  .universe::before{content:'';position:absolute;z-index:-1;top:0;right:clamp(24px,7vw,110px);width:1px;height:clamp(180px,24vw,340px);background:var(--line-soft);pointer-events:none}
  .eyebrow{font:500 .68rem var(--font-meta);letter-spacing:.105em;text-transform:uppercase;color:var(--ink-muted)}

  .universe-hero{display:grid;grid-template-columns:minmax(0,1.55fr) minmax(300px,.65fr);gap:clamp(48px,8vw,128px);align-items:end;min-height:min(62vh,650px);padding:clamp(30px,4vw,56px) 0 clamp(58px,7vw,96px);border-bottom:1px solid var(--line-strong)}
  .universe-hero__copy{max-width:940px}
  .universe-hero h1{margin-top:14px;max-width:8.2ch;font-size:clamp(4.7rem,9.8vw,9.4rem);line-height:.82;letter-spacing:-.058em;font-weight:520;text-wrap:balance}
  .universe-hero__intro{margin-top:clamp(30px,4vw,48px);max-width:46ch;color:var(--ink-secondary);font-family:var(--font-display);font-size:clamp(1.18rem,1.65vw,1.55rem);line-height:1.48;letter-spacing:-.018em}
  .universe-hero__actions{display:flex;flex-wrap:wrap;align-items:center;gap:var(--space-5);margin-top:var(--space-6)}
  .universe-hero__actions .structural-button{background:var(--ink);color:var(--canvas);border-color:var(--ink)}
  .universe-hero__actions .structural-button:hover{background:var(--accent);border-color:var(--accent);color:var(--accent-ink)}

  .universe-hero__index{position:relative;align-self:end;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));border-top:1px solid var(--line-strong);border-bottom:1px solid var(--line-strong);margin-bottom:2px}
  .universe-hero__index::after{content:'';position:absolute;top:-5px;right:-5px;width:9px;height:9px;border:1px solid var(--line-strong);background:var(--canvas)}
  .universe-hero__index-label{grid-column:1/-1;padding:12px 0;border-bottom:1px solid var(--line);font:500 .68rem var(--font-meta);letter-spacing:.09em;text-transform:uppercase;color:var(--ink-muted)}
  .universe-hero__stat{display:grid;grid-template-columns:minmax(0,1fr) auto;align-items:end;gap:10px;min-height:84px;padding:15px 14px 14px 0;border-bottom:1px solid var(--line-soft)}
  .universe-hero__stat:nth-of-type(odd){border-right:1px solid var(--line);padding-right:18px}
  .universe-hero__stat:nth-of-type(even){padding-left:18px}
  .universe-hero__stat:nth-last-child(-n+2){border-bottom:0}
  .universe-hero__stat strong{font-family:var(--font-display);font-size:clamp(1.8rem,2.5vw,2.55rem);font-weight:480;line-height:.9;letter-spacing:-.035em;font-variant-numeric:tabular-nums}
  .universe-hero__stat span{font:500 .68rem var(--font-meta);letter-spacing:.065em;text-transform:uppercase;color:var(--ink-muted);writing-mode:vertical-rl;transform:rotate(180deg)}

  .universe-section{padding-top:clamp(68px,7vw,94px)}
  .universe-section--featured{padding-top:clamp(72px,7vw,100px)}
  .universe-section--collections{padding-top:clamp(58px,6vw,78px)}
  .section-heading{display:grid;grid-template-columns:minmax(0,1fr) auto;align-items:end;gap:var(--space-6);padding-bottom:var(--space-4);border-bottom:1px solid var(--line-strong)}
  .section-heading h2{margin-top:6px;font-size:clamp(2rem,3vw,3rem);line-height:.98;letter-spacing:-.035em;font-weight:500}
  .section-heading__note{align-self:end;padding-bottom:5px;font:500 .68rem var(--font-meta);letter-spacing:.065em;text-transform:uppercase;color:var(--ink-muted)}

  .universe-grid{display:grid;grid-template-columns:minmax(0,1.18fr) minmax(390px,.82fr);gap:var(--space-5);padding-top:var(--space-5)}
  .flagship-card{border:1px solid var(--line-strong);background:transparent}
  .flagship-card__preview,.support-card__preview{display:block;text-decoration:none;border-bottom:1px solid var(--line);overflow:hidden}
  .flagship-card__body{padding:clamp(22px,2.6vw,34px)}
  .flagship-card__topline,.support-card__meta{display:flex;align-items:center;justify-content:space-between;gap:var(--space-3);font:500 .68rem var(--font-meta);letter-spacing:.065em;text-transform:uppercase;color:var(--ink-muted)}
  .flagship-card__copy{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:clamp(30px,4vw,58px);align-items:end;margin-top:clamp(30px,4vw,50px)}
  .flagship-card h3{font-size:clamp(2.55rem,4.35vw,4.6rem);line-height:.92;letter-spacing:-.04em;font-weight:500}
  .flagship-card h3 a,.support-card h3 a{text-decoration:none}
  .flagship-card__subtitle{margin-top:var(--space-4);color:var(--ink);font:500 .68rem var(--font-meta);letter-spacing:.07em;text-transform:uppercase}
  .flagship-card__summary{margin-top:12px;max-width:55ch;color:var(--ink-secondary);font-size:.96rem;line-height:1.62}
  .flagship-card__actions{display:flex;flex-direction:column;align-items:flex-end;gap:10px;min-width:130px;text-align:right}
  .flagship-card__actions a{text-decoration:none}
  .flagship-card__launch{min-width:122px;justify-content:center}
  .flagship-card:hover{border-color:var(--ink-secondary)}

  .supporting-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));align-content:start;border-top:1px solid var(--line);border-left:1px solid var(--line)}
  .support-card{position:relative;min-width:0;border-right:1px solid var(--line);border-bottom:1px solid var(--line);background:transparent;transition:background-color var(--motion-fast) var(--ease-standard)}
  .support-card:hover,.support-card:focus-within{background:var(--accent-soft)}
  .support-card__body{position:relative;padding:16px}
  .support-card h3{margin-top:18px;font-size:clamp(1.35rem,1.75vw,1.7rem);line-height:1.03;letter-spacing:-.025em;font-weight:500;overflow-wrap:anywhere}
  .support-card__actions{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:8px 12px;margin-top:18px;padding-top:12px;border-top:1px solid var(--line-soft);font:500 .68rem var(--font-meta);letter-spacing:.05em;text-transform:uppercase}
  .support-card__actions a{text-decoration:none}.support-card__launch{min-width:84px;justify-content:center}.support-card__details{min-height:44px;display:inline-flex;align-items:center;gap:.42em;color:var(--accent)}.support-card__details:hover,.support-card__details:focus-visible{text-decoration:underline;text-underline-offset:5px}

  .intent-universe{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));border-top:1px solid var(--line-strong);border-bottom:1px solid var(--line-strong);margin-top:var(--space-5)}
  .intent-node{position:relative;display:grid;grid-template-columns:minmax(0,1fr) auto;grid-template-areas:'number count' 'content content';gap:24px 12px;min-height:180px;padding:18px 18px 16px 0;border-right:1px solid var(--line);text-decoration:none;background:transparent;transition:background-color var(--motion-fast) var(--ease-standard),padding-left var(--motion-fast) var(--ease-enter)}
  .intent-node:not(:first-child){padding-left:18px}
  .intent-node:last-child{border-right:0}
  .intent-node:hover,.intent-node:focus-visible{background:var(--accent-soft);padding-left:18px}
  .intent-node__number{grid-area:number;font:500 .68rem var(--font-meta);letter-spacing:.075em;color:var(--accent)}
  .intent-node__count{grid-area:count;font:500 .68rem var(--font-meta);letter-spacing:.075em;color:var(--ink-muted);font-variant-numeric:tabular-nums}
  .intent-node>div{grid-area:content;align-self:end;padding-right:22px}
  .intent-node strong{font-family:var(--font-display);font-size:clamp(1.55rem,2.15vw,2rem);line-height:1;letter-spacing:-.025em;font-weight:500}
  .intent-node p{margin-top:10px;max-width:31ch;color:var(--ink-secondary);font-size:.8rem;line-height:1.52}
  .intent-node i{position:absolute;right:16px;bottom:15px;font-style:normal;color:var(--accent)}
  .intent-universe__note{margin-top:14px;color:var(--ink-muted);font-size:.78rem;line-height:1.5}.intent-universe__note a{color:var(--accent);text-underline-offset:4px}

  .books-preview{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:var(--space-5);margin-top:var(--space-5);align-items:start}
  .books-preview :global(.book-card){background:transparent;border-color:var(--line)}
  .books-preview :global(.book-card__body){padding-inline:0}

  .project-strip{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));border-top:1px solid var(--line-strong);margin-top:var(--space-5)}
  .project-strip__item{display:grid;grid-template-columns:46px minmax(0,1fr) auto 22px;align-items:center;gap:12px;min-height:72px;padding:11px 12px 11px 0;border-right:1px solid var(--line);border-bottom:1px solid var(--line);text-decoration:none;background:transparent;transition:background-color var(--motion-fast) var(--ease-standard)}
  .project-strip__item:nth-child(even){padding-left:16px;border-right:0}
  .project-strip__item:hover,.project-strip__item:focus-visible{background:var(--accent-soft)}
  .project-strip__number,.project-strip__type{font:500 .68rem var(--font-meta);letter-spacing:.06em;text-transform:uppercase;color:var(--ink-muted)}
  .project-strip__number{color:var(--accent)}
  .project-strip__title{font-family:var(--font-display);font-size:1.05rem;line-height:1.2;font-weight:500;letter-spacing:-.012em;overflow-wrap:anywhere}
  .project-strip__arrow{justify-self:end;color:var(--accent)}

  .collection-ribbon{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));border-top:1px solid var(--line-strong);border-bottom:1px solid var(--line-strong);margin-top:var(--space-5)}
  .collection-chip{display:grid;grid-template-columns:minmax(0,1fr) auto;grid-template-areas:'code count' 'title title';gap:16px 12px;min-height:108px;padding:16px 16px 14px 0;border-right:1px solid var(--line);text-decoration:none;background:transparent;transition:background-color var(--motion-fast) var(--ease-standard)}
  .collection-chip:not(:first-child){padding-left:16px}.collection-chip:last-child{border-right:0}
  .collection-chip:hover,.collection-chip:focus-visible{background:var(--accent-soft)}
  .collection-chip>span,.collection-chip small{font:500 .68rem var(--font-meta);letter-spacing:.065em;text-transform:uppercase;color:var(--ink-muted)}
  .collection-chip>span{grid-area:code;color:var(--accent)}.collection-chip small{grid-area:count;justify-self:end}.collection-chip strong{grid-area:title;align-self:end;font-family:var(--font-display);font-size:1.08rem;line-height:1.15;letter-spacing:-.015em;font-weight:500}

  @media(max-width:1080px){
    .universe-grid{grid-template-columns:1fr}
    .supporting-grid{grid-template-columns:repeat(4,minmax(0,1fr))}
    .intent-universe{grid-template-columns:repeat(2,minmax(0,1fr));border-bottom:0}
    .intent-node{border-bottom:1px solid var(--line)}
    .intent-node:nth-child(2n){border-right:0}
    .collection-ribbon{grid-template-columns:repeat(3,minmax(0,1fr));border-bottom:0}
    .collection-chip{border-bottom:1px solid var(--line)}
    .collection-chip:nth-child(3n){border-right:0}
  }
  @media(max-width:820px){
    .universe-hero{grid-template-columns:1fr;gap:var(--space-8);min-height:0}
    .universe-hero__index{width:min(100%,620px)}
    .supporting-grid{grid-template-columns:repeat(2,minmax(0,1fr))}
    .books-preview{grid-template-columns:repeat(2,minmax(0,1fr))}
    .project-strip{grid-template-columns:1fr}.project-strip__item,.project-strip__item:nth-child(even){padding-left:0;border-right:0}
  }
  @media(max-width:620px){
    .universe{padding-top:var(--space-6)}
    .universe::before{display:none}
    .universe-hero{padding-top:var(--space-4);padding-bottom:var(--space-8)}
    .universe-hero h1{max-width:9ch;font-size:clamp(3.65rem,18.5vw,5.8rem);line-height:.84;letter-spacing:-.055em}
    .universe-hero__intro{font-size:1.08rem}
    .universe-hero__actions{align-items:flex-start;flex-direction:column;gap:var(--space-4)}
    .universe-hero__index{grid-template-columns:1fr}.universe-hero__index-label{grid-column:1}.universe-hero__stat,.universe-hero__stat:nth-of-type(odd),.universe-hero__stat:nth-of-type(even){min-height:66px;padding:12px 0;border-right:0;border-bottom:1px solid var(--line-soft)}.universe-hero__stat:last-child{border-bottom:0}.universe-hero__stat span{writing-mode:initial;transform:none}
    .section-heading{grid-template-columns:1fr;align-items:start;gap:var(--space-3)}.section-heading__note{display:none}
    .universe-section{padding-top:var(--space-8)}
    .flagship-card__copy{grid-template-columns:1fr}.flagship-card__actions{align-items:flex-start;text-align:left}
    .supporting-grid,.intent-universe,.books-preview,.collection-ribbon{grid-template-columns:1fr}
    .intent-node,.intent-node:not(:first-child),.intent-node:hover,.intent-node:focus-visible{min-height:148px;padding-left:0;border-right:0}
    .collection-ribbon{border-bottom:0}.collection-chip,.collection-chip:not(:first-child){min-height:88px;padding-left:0;border-right:0;border-bottom:1px solid var(--line)}
    .project-strip__item{grid-template-columns:36px minmax(0,1fr) 18px}.project-strip__type{display:none}
  }
  @media(prefers-reduced-motion:reduce){.support-card,.intent-node,.project-strip__item,.collection-chip{transition:none}}
</style>