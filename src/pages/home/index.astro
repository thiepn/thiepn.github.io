---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HubCatalogue from '../../components/hub/HubCatalogue.astro';
import PortalAccount from '../../components/hub/PortalAccount.astro';
import PersonalPins from '../../components/hub/PersonalPins.astro';
import PortalCustomize from '../../components/hub/PortalCustomize.astro';
import { getHubProjects } from '../../lib/hub';
import '../../styles/hub.css';
const entries = await getHubProjects();
---
<BaseLayout title="Home — THIEPN" description="Your THIEPN apps, shortcuts and tools in one personal home." portal noindex>
  <div class="portal-home page-shell" data-portal-home>
    <header class="portal-home-heading">
      <div><p class="portal-date" data-local-date>Personal workspace</p><h1>Home</h1></div>
      <button class="portal-button" type="button" data-customize-open aria-haspopup="dialog" aria-controls="portal-customize" hidden>Customize</button>
    </header>
    <PortalAccount />
    <PersonalPins entries={entries} />
    <section class="portal-launch-actions" aria-label="Quick actions">
      <a class="portal-quick-capture" href="https://thiepn.dev/notes/"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 4v16M4 12h16" /></svg><span><strong>Capture a thought</strong><small>Open Notes to write and save</small></span><span aria-hidden="true">↗</span></a>
      <p class="portal-muted">App activity will appear here when connected. <a href="https://account.thiepn.dev/apps">Manage connected apps</a></p>
    </section>
    <HubCatalogue entries={entries} heading="All apps" headingLevel={2} />
    <p class="portal-local-notice" data-preference-status>Home preferences are saved in this browser. Account sync is not enabled.</p>
    <noscript><p class="portal-muted">All app links work without JavaScript. Customization requires JavaScript.</p></noscript>
    <PortalCustomize entries={entries} />
  </div>
</BaseLayout>
<script>import '../../scripts/hub-catalogue'; import '../../scripts/portal-home'; import '../../scripts/portal-auth';</script>
