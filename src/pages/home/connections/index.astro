---
import ConnectionCenter from '../../../components/workspace/ConnectionCenter.astro';
import DailyHome from '../../../components/hub/DailyHome.astro';
import { getHubProjects } from '../../../lib/hub';
import WorkspaceShell from '../../../components/workspace/WorkspaceShell.astro';
import PrivateTms from '../../../components/hub/PrivateTms.astro';
import PrivateNotes from '../../../components/hub/PrivateNotes.astro';
import PrivateCapture from '../../../components/hub/PrivateCapture.astro';
import IntegratedWorkflows from '../../../components/hub/IntegratedWorkflows.astro';
import ContinuationDesk from '../../../components/workspace/ContinuationDesk.astro';
import '../../../styles/hub.css';
import '../../../styles/continuation.css';
const entries=await getHubProjects();
---
<WorkspaceShell view="connections">
  <div class="portal-home page-shell">
    <header class="portal-home-heading"><h2>App connections</h2><p>Manage your account, app sharing and reading connections. Your workspace saves on this device first and syncs when you connect Account.</p><a class="portal-button" href="/">Return to workspace</a></header>
    <ConnectionCenter/><ContinuationDesk/><PrivateTms/><PrivateNotes/><PrivateCapture/><IntegratedWorkflows/><p><a class="portal-button" href="/home/#reading">Open reading connection</a></p>
  </div>
</WorkspaceShell>
<script>import '../../../scripts/workspace-connections';import '../../../scripts/portal-auth';import '../../../scripts/portal-notes';import '../../../scripts/portal-tms60';import '../../../scripts/portal-library';import '../../../scripts/portal-capture';import '../../../scripts/portal-integrated-workflows';import '../../../scripts/workspace-continuation';</script>
