---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="404 — THIEPN" noindex={true}>
  <section class="not-found page-shell" aria-labelledby="not-found-title">
    <div class="not-found__body index-grid">
      <div class="not-found__copy"><p class="meta">404 / Page not found</p><h1 id="not-found-title">This page doesn't exist.</h1><p>The address may be outdated, mistyped, or no longer available.</p><div class="not-found__actions"><a class="structural-button" href="/">Go home →</a><a class="text-link" href="/projects/">Browse projects →</a><a class="text-link" href="/collections/">Collections →</a></div></div>
      <div class="not-found__graphic" aria-hidden="true"><strong>404</strong></div>
    </div>
  </section>
</BaseLayout>
<style>
  .not-found{min-height:calc(100svh - 58px);padding-top:clamp(34px,5vw,66px);padding-bottom:var(--space-9)}.not-found__body{min-height:600px;align-items:center}.not-found__copy{grid-column:1/span 7}.not-found__copy>.meta{color:var(--ink-muted)}h1{margin-top:var(--space-5);max-width:11ch;font-size:var(--text-display-m);line-height:.93;letter-spacing:-.055em}.not-found__copy>p:not(.meta){margin-top:var(--space-5);max-width:55ch;color:var(--ink-secondary);font-size:var(--text-body-l)}.not-found__actions{display:flex;flex-wrap:wrap;align-items:center;gap:var(--space-6);margin-top:var(--space-8)}.not-found__graphic{grid-column:9/-1;aspect-ratio:1;border:1px solid var(--line);display:grid;place-items:center;color:var(--ink-muted)}.not-found__graphic strong{font:500 clamp(3rem,7vw,6rem) var(--font-meta);letter-spacing:-.08em;color:var(--ink)}
  @media(max-width:899px){.not-found__body{min-height:520px}.not-found__copy{grid-column:1/-1}.not-found__graphic{display:none}}@media(max-width:599px){.not-found__body{min-height:440px}.not-found__actions{gap:var(--space-4);margin-top:var(--space-7)}}
</style>
