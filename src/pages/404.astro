---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionIndex from '../components/index/SectionIndex.astro';
---
<BaseLayout title="404 / Uncatalogued — THIEPN.">
  <section class="not-found page-shell" aria-labelledby="not-found-title">
    <SectionIndex index="404" title="Uncatalogued" meta="Outside the index" headingLevel="div" />
    <div class="not-found__body index-grid">
      <div class="not-found__copy"><p class="meta">Record not found</p><h1 id="not-found-title">This artifact does not exist.</h1><p>The requested address is outside the catalogue. Return to the index or continue through the project archive.</p><div class="not-found__actions"><a class="structural-button" href="/">Return to index →</a><a class="text-link" href="/projects/">Project archive →</a><a class="text-link" href="/collections/">Collections →</a></div></div>
      <div class="not-found__graphic" aria-hidden="true"><span>+</span><i></i><strong>404</strong><em>UNCATALOGUED</em></div>
    </div>
  </section>
</BaseLayout>
<style>
  .not-found{min-height:calc(100svh - 58px);padding-top:clamp(34px,5vw,66px);padding-bottom:var(--space-9)}.not-found__body{min-height:600px;align-items:center}.not-found__copy{grid-column:1/span 7}.not-found__copy>.meta{color:var(--ink-muted)}h1{margin-top:var(--space-5);max-width:11ch;font-size:var(--text-display-m);line-height:.93;letter-spacing:-.055em;text-transform:uppercase}.not-found__copy>p:not(.meta){margin-top:var(--space-5);max-width:55ch;color:var(--ink-secondary);font-size:var(--text-body-l)}.not-found__actions{display:flex;flex-wrap:wrap;align-items:center;gap:var(--space-6);margin-top:var(--space-8)}.not-found__graphic{grid-column:9/-1;position:relative;aspect-ratio:1;border:1px solid var(--line);display:grid;place-items:center;color:var(--ink-muted)}.not-found__graphic span{position:absolute;left:-5px;top:-10px;font:400 1rem var(--font-meta)}.not-found__graphic i{position:absolute;left:20%;right:20%;top:50%;height:1px;background:var(--line-strong);transform:rotate(-25deg)}.not-found__graphic strong{font:500 clamp(3rem,7vw,6rem) var(--font-meta);letter-spacing:-.08em;color:var(--ink)}.not-found__graphic em{position:absolute;bottom:12px;right:12px;font:500 .58rem var(--font-meta);letter-spacing:.08em;font-style:normal}
  @media(max-width:899px){.not-found__body{min-height:520px}.not-found__copy{grid-column:1/-1}.not-found__graphic{display:none}}@media(max-width:599px){.not-found__body{min-height:440px}.not-found__actions{gap:var(--space-4);margin-top:var(--space-7)}}
</style>
