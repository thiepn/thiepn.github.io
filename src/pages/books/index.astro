---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BookCard from '../../components/books/BookCard.astro';

const books = (await getCollection('books')).sort((a, b) => b.data.lastUpdated.getTime() - a.data.lastUpdated.getTime());
---
<BaseLayout title="Books — THIEPN" description="Published THIEPN books available to read through the THIEPN Library.">
  <section class="books-page page-shell" aria-labelledby="books-title" data-books-index>
    <header class="books-hero">
      <div class="books-hero__copy">
        <p class="meta">Published works</p>
        <h1 id="books-title">Books</h1>
        <p>Long-form works published through the THIEPN Library. Read the web edition when available, or access the published PDF and EPUB formats from each Library record.</p>
      </div>
      <aside class="books-hero__index" aria-label="Books overview">
        <div><strong>{String(books.length).padStart(2, '0')}</strong><span>Published works</span></div>
        <a href="https://thiepn.dev/library/">Open full Library <span aria-hidden="true">↗</span></a>
      </aside>
    </header>

    <section class="books-catalogue" aria-labelledby="published-books-title">
      <header class="books-section-head">
        <div><p class="meta">Library catalogue</p><h2 id="published-books-title">Published books</h2></div>
        <a href="/projects/?intent=read#archive-catalogue">Browse resource projects →</a>
      </header>
      <div class="books-grid">
        {books.map((book, index) => <BookCard book={book} heading="h3" priority={index === 0} />)}
      </div>
    </section>

    <aside class="books-library-note" aria-label="About the THIEPN Library">
      <p class="meta">Source of truth</p>
      <div>
        <h2>Reading lives in the Library.</h2>
        <p>This portfolio presents the published catalogue. Editions, web reading, downloads, release metadata, and future book updates remain owned by the dedicated THIEPN Library.</p>
      </div>
      <a class="structural-button" href="https://thiepn.dev/library/">Visit Library ↗</a>
    </aside>
  </section>
</BaseLayout>
<style>
  .books-page{padding-top:clamp(30px,5vw,66px);padding-bottom:clamp(72px,9vw,120px)}
  .books-hero{display:grid;grid-template-columns:minmax(0,1fr) minmax(250px,.34fr);gap:clamp(42px,9vw,126px);align-items:end;padding:clamp(34px,5vw,62px) 0 clamp(48px,7vw,80px);border-bottom:1px solid var(--line-strong)}
  .books-hero__copy{max-width:840px}.books-hero__copy>.meta{color:var(--ink-muted)}
  .books-hero h1{margin-top:8px;font-family:var(--font-display);font-size:clamp(4rem,9vw,9rem);line-height:.78;letter-spacing:-.05em;font-weight:500}
  .books-hero__copy>p:not(.meta){margin-top:var(--space-5);max-width:64ch;color:var(--ink-secondary);font-size:clamp(1rem,1.3vw,1.14rem);line-height:1.64}
  .books-hero__index{border-top:1px solid var(--line-strong)}.books-hero__index div{display:grid;grid-template-columns:72px 1fr;align-items:baseline;gap:14px;padding:15px 0;border-bottom:1px solid var(--line)}.books-hero__index strong{font:500 1.4rem var(--font-display);color:var(--accent)}.books-hero__index span{font:500 .68rem var(--font-meta);letter-spacing:.065em;text-transform:uppercase;color:var(--ink-muted)}.books-hero__index>a{min-height:50px;display:flex;align-items:center;justify-content:space-between;gap:12px;border-bottom:1px solid var(--line);font:500 .68rem var(--font-meta);letter-spacing:.055em;text-transform:uppercase;text-decoration:none;color:var(--accent)}
  .books-catalogue{padding-top:clamp(64px,8vw,104px)}
  .books-section-head{display:flex;align-items:end;justify-content:space-between;gap:var(--space-5);padding-bottom:13px;border-bottom:1px solid var(--line-strong)}.books-section-head h2{margin-top:4px;font-family:var(--font-display);font-size:clamp(1.9rem,3vw,2.8rem);line-height:.98;letter-spacing:-.02em;font-weight:500}.books-section-head>a{min-height:44px;display:flex;align-items:center;font:500 .68rem var(--font-meta);letter-spacing:.055em;text-transform:uppercase;color:var(--accent)}
  .books-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:clamp(28px,4vw,54px);margin-top:var(--space-6);align-items:start}
  .books-grid :global(.book-card){border:0;background:transparent}
  .books-grid :global(.book-card:hover){border-color:transparent}
  .books-grid :global(.book-card__cover){border:1px solid var(--line);background:var(--surface-1)}
  .books-grid :global(.book-card__body){padding:18px 0 0}
  .books-grid :global(.book-card h3){font-family:var(--font-display);font-size:clamp(1.55rem,2.2vw,2.05rem);font-weight:500;letter-spacing:-.018em}
  .books-grid :global(.book-card__meta){font-size:.68rem}
  .books-grid :global(.book-card__foot){border-top:1px solid var(--line)}
  .books-library-note{display:grid;grid-template-columns:130px minmax(0,1fr) auto;gap:clamp(24px,5vw,66px);align-items:center;margin-top:clamp(66px,9vw,110px);padding:clamp(24px,3vw,36px) 0;border-top:1px solid var(--line-strong);border-bottom:1px solid var(--line-strong)}.books-library-note>.meta{color:var(--ink-muted)}.books-library-note h2{font-family:var(--font-display);font-size:clamp(1.6rem,2.4vw,2.25rem);line-height:1;letter-spacing:-.018em;font-weight:500}.books-library-note div p{margin-top:9px;max-width:66ch;color:var(--ink-secondary);font-size:.84rem;line-height:1.58}.books-library-note>.structural-button{min-width:120px;justify-content:center}
  @media(max-width:900px){.books-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.books-library-note{grid-template-columns:1fr auto}.books-library-note>.meta{grid-column:1/-1}}
  @media(max-width:700px){.books-hero{grid-template-columns:1fr;gap:var(--space-7)}.books-hero__index{width:min(100%,420px)}.books-section-head{align-items:flex-start;flex-direction:column;gap:var(--space-2)}}
  @media(max-width:599px){.books-page{padding-top:var(--space-5)}.books-grid{grid-template-columns:1fr;gap:var(--space-8)}.books-library-note{grid-template-columns:1fr;align-items:start}.books-library-note>.structural-button{width:100%}}
</style>