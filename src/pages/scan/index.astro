---
import BaseLayout from '../../layouts/BaseLayout.astro';

const version = '1.0.0';
const sourceUrl = 'https://github.com/thiepn/scan';
const releaseUrl = sourceUrl + '/releases/tag/v1.0.0';
const apkUrl = sourceUrl + '/releases/download/v1.0.0/Scan-v1.0.0.apk';

const highlights = [
  {
    mark: '01',
    title: 'Scan without an account',
    body: 'Capture multipage documents with Google Play services, import PDFs or images, and keep the working document library local to your device.'
  },
  {
    mark: '02',
    title: 'Find text, not filenames',
    body: 'On-device OCR powers document search, exact phrase and prefix matching, highlighted results, jump-to-page navigation, and searchable PDF export.'
  },
  {
    mark: '03',
    title: 'Fix pages after capture',
    body: 'Rotate, reorder, crop perspective, enhance, clean up marks, edit recognized text, annotate, redact, sign, fill forms, or replace individual pages.'
  },
  {
    mark: '04',
    title: 'Organize a real archive',
    body: 'Use nested folders, tags, favorites, archive, document types, smart collections, bulk actions, and local classification suggestions.'
  },
  {
    mark: '05',
    title: 'Export the PDF you actually need',
    body: 'Create searchable PDFs at multiple quality levels, merge or extract pages, save through Android document providers, or create AES-256 protected copies.'
  },
  {
    mark: '06',
    title: 'Built for failure cases',
    body: 'Large-document, low-storage, process-recovery, secure-backup, migration, and constrained-device paths are part of the release certification—not afterthoughts.'
  }
];

const workflow = [
  ['Capture', 'Scan a document, book, receipt, ID, form, whiteboard, note, certificate, or photo—or import an existing PDF.'],
  ['Clean', 'Review crop and perspective, choose an enhancement, rotate or reorder pages, and apply cleanup only where it helps.'],
  ['Find', 'Search recognized text across your local library and jump directly to the page containing the match.'],
  ['Export', 'Share or save a searchable PDF, text, structured data, a protected copy, or a standards-oriented output.']
];

const featureGroups = [
  {
    eyebrow: 'Capture',
    title: 'A scanner that keeps going after the shutter.',
    items: [
      'Multipage document scanning',
      'Gallery and PDF import',
      'Document, Receipt, ID Card, Business Card, Book, Whiteboard, Form, Photo, Notes and Certificate modes',
      'Two-step front/back ID capture',
      'Rapid continuous capture for supported modes',
      'Book-spread analysis, split review and reversible restoration'
    ]
  },
  {
    eyebrow: 'Edit',
    title: 'Every page stays editable.',
    items: [
      'Non-destructive page reorder, duplicate and rotation',
      'Perspective crop with draggable corners',
      'Document enhancement and restoration presets',
      'Smart cleanup / reversible mask-based object removal',
      'Recognized-text editing',
      'Markup, redaction, signatures and form filling',
      'Page labels, bookmarks and structured-data review'
    ]
  },
  {
    eyebrow: 'Library',
    title: 'Documents become searchable objects, not camera rolls.',
    items: [
      'Local OCR and FTS5 search',
      'Exact phrases and prefix queries',
      'Search-hit page navigation and word highlighting',
      'Nested folders, tags and document types',
      'Favorites, archive and Trash',
      'Recent, Unfiled and Needs Review smart collections',
      'Bulk organization and workflow automation'
    ]
  },
  {
    eyebrow: 'Output',
    title: 'The result leaves Scan in useful form.',
    items: [
      'Searchable PDF generation',
      'Original, High, Balanced and Small quality presets',
      'Native imported-PDF preservation when possible',
      'PDF merge and page extraction',
      'Plain-text, CSV, JSON and XLSX exports where applicable',
      'AES-256 password-protected PDF copies',
      'Storage Access Framework Save As without broad storage permission'
    ]
  }
];

const qaItems = [
  ['Package', 'com.thiepn.scan'],
  ['Version', '1.0.0 · code 1'],
  ['Android', '8.0+ · API 26 minimum'],
  ['Network', 'No INTERNET permission'],
  ['Account', 'Not required'],
  ['Storage', 'App-private by default']
];
---

<BaseLayout
  title="Scan — Private document scanning for Android — THIEPN"
  description="Scan is a local-first Android document scanner with OCR, searchable PDFs, page editing, organization, secure backup, and no account requirement."
  ogImage="/og/scan.png"
>
  <div class="scan-page">
    <section class="scan-hero page-shell" aria-labelledby="scan-title">
      <div class="scan-hero__copy">
        <div class="scan-chips" aria-label="Scan app facts">
          <span class="scan-chip scan-chip--accent">Android app</span>
          <span class="scan-chip" data-scan-version-state>v{version} RC</span>
          <span class="scan-chip">Local-first</span>
        </div>

        <p class="scan-kicker">Documents in. Searchable PDFs out.</p>
        <h1 id="scan-title">Scan it.<br />Keep it local.</h1>
        <p class="scan-hero__lead">
          A full document scanner for Android with OCR, page editing, organization, secure export and backup—built around the idea that your documents should not need an account or cloud pipeline to become useful.
        </p>

        <div class="scan-hero__actions">
          <a class="scan-button scan-button--primary" href={apkUrl} data-scan-release-download hidden>
            <span class="scan-button__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24"><path d="M12 3v11m0 0 4-4m-4 4-4-4M5 17v3h14v-3"/></svg>
            </span>
            Download APK
          </a>
          <span class="scan-button scan-button--disabled" aria-disabled="true" data-scan-release-pending>
            <span class="scan-button__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24"><path d="M12 3v11m0 0 4-4m-4 4-4-4M5 17v3h14v-3"/></svg>
            </span>
            v1.0.0 release pending
          </span>
          <a class="scan-button scan-button--quiet" href="#how-it-works">See how it works</a>
          <a class="scan-button scan-button--quiet" href={sourceUrl}>Source code ↗</a>
        </div>

        <div class="scan-hero__meta" aria-label="Platform details">
          <span>Android 8.0+</span><i aria-hidden="true"></i>
          <span>No account</span><i aria-hidden="true"></i>
          <span>No subscription</span><i aria-hidden="true"></i>
          <span>No INTERNET permission</span>
        </div>

        <div class="release-notice" role="status" data-scan-release-notice>
          <strong data-scan-release-title>Release candidate certified.</strong>
          <span data-scan-release-copy>The public APK will unlock here after production signing and final physical-device acceptance.</span>
        </div>
      </div>

      <div class="scan-hero__visual" aria-label="Illustration of Scan's document workflow">
        <div class="scan-stage">
          <span class="scan-stage__halo scan-stage__halo--a"></span>
          <span class="scan-stage__halo scan-stage__halo--b"></span>

          <div class="phone phone--library" aria-hidden="true">
            <div class="phone__top">
              <span class="scan-appmark">
                <svg viewBox="0 0 32 32"><path d="M8 3h10l6 6v20H8z"/><path d="M18 3v7h6"/><path d="M11 15h10M11 19h10M11 23h7"/></svg>
              </span>
              <strong>Scan</strong>
              <span class="phone__dots">•••</span>
            </div>
            <div class="library-search"><span></span><b>Search documents</b></div>
            <div class="doc-list">
              <div class="doc-row doc-row--active"><span class="thumb thumb--receipt"></span><div><b>Travel receipts</b><small>8 pages · today</small></div></div>
              <div class="doc-row"><span class="thumb thumb--notes"></span><div><b>Analysis notes</b><small>14 pages · yesterday</small></div></div>
              <div class="doc-row"><span class="thumb thumb--form"></span><div><b>Registration form</b><small>3 pages · Sep 24</small></div></div>
            </div>
            <span class="scan-fab"><i></i>Scan</span>
          </div>

          <div class="phone phone--document" aria-hidden="true">
            <div class="document-head">
              <span>‹</span><b>Travel receipts</b><span>⌕ ⋮</span>
            </div>
            <div class="page-preview">
              <span class="receipt-logo">CAFÉ</span>
              <i></i><i></i><i></i><i></i>
              <b>€ 18.40</b>
            </div>
            <div class="page-actions">
              <span>↻<small>Rotate</small></span>
              <span>⌗<small>Crop</small></span>
              <span>◐<small>Enhance</small></span>
              <span>•••<small>More</small></span>
            </div>
            <div class="ocr-result">
              <small>RECOGNIZED TEXT</small>
              <p>coffee · breakfast · total €18.40</p>
            </div>
          </div>

          <div class="search-card" aria-hidden="true">
            <span class="search-card__icon">⌕</span>
            <div>
              <small>SEARCH RESULT</small>
              <strong>“breakfast”</strong>
              <p>Travel receipts · page 3</p>
            </div>
            <b>→</b>
          </div>

          <div class="export-card" aria-hidden="true">
            <small>EXPORT</small>
            <strong>Searchable PDF</strong>
            <div class="quality-pills"><span>Original</span><span class="active">Balanced</span><span>Small</span></div>
            <p>Save As · Share · Protect</p>
          </div>
        </div>
        <p class="scan-visual-note">Illustrative workflow: library → page tools → OCR search → searchable PDF export.</p>
      </div>
    </section>

    <nav class="scan-subnav" aria-label="Scan page sections">
      <div class="page-shell scan-subnav__inner">
        <a href="#overview">Overview</a>
        <a href="#how-it-works">Workflow</a>
        <a href="#features">Features</a>
        <a href="#privacy">Privacy</a>
        <a href="#install">Install</a>
        <a href="#faq">FAQ</a>
      </div>
    </nav>

    <section class="scan-section page-shell" id="overview" aria-labelledby="overview-title">
      <div class="scan-section__intro">
        <div>
          <p class="scan-kicker">From paper to something useful</p>
          <h2 id="overview-title">More than a camera pointed at a page.</h2>
        </div>
        <p>
          Scan treats every capture as a document you can keep improving. OCR, page geometry, organization, edits and export settings remain attached to the document instead of disappearing after a one-time PDF share.
        </p>
      </div>

      <div class="highlight-grid">
        {highlights.map((item) => (
          <article class="highlight-card">
            <span>{item.mark}</span>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="workflow-band" id="how-it-works" aria-labelledby="workflow-title">
      <div class="page-shell">
        <div class="scan-section__intro scan-section__intro--dark">
          <div>
            <p class="scan-kicker">The everyday path</p>
            <h2 id="workflow-title">Capture. Clean. Find. Export.</h2>
          </div>
          <p>
            The core flow stays simple while the deeper tools remain available when a document actually needs them.
          </p>
        </div>

        <ol class="workflow-steps">
          {workflow.map(([title, body], index) => (
            <li>
              <span class="workflow-index">0{index + 1}</span>
              <div class="workflow-symbol" aria-hidden="true">
                {index === 0 && <span class="symbol-scan"><i></i></span>}
                {index === 1 && <span class="symbol-clean">◐</span>}
                {index === 2 && <span class="symbol-find">⌕</span>}
                {index === 3 && <span class="symbol-export">↗</span>}
              </div>
              <h3>{title}</h3>
              <p>{body}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="scan-section page-shell" id="features" aria-labelledby="features-title">
      <div class="scan-section__intro">
        <div>
          <p class="scan-kicker">Full v1 toolkit</p>
          <h2 id="features-title">Simple surface. Deep document tools underneath.</h2>
        </div>
        <p>
          The main interface keeps routine scanning close at hand. Editing, publishing, security, structured extraction and specialized workflows stay progressively disclosed instead of filling every screen.
        </p>
      </div>

      <div class="feature-groups">
        {featureGroups.map((group) => (
          <article class="feature-group">
            <div class="feature-group__head">
              <span>{group.eyebrow}</span>
              <h3>{group.title}</h3>
            </div>
            <ul>
              {group.items.map((item) => <li>{item}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </section>

    <section class="tool-relationship-band" aria-labelledby="tool-relationship-title">
      <div class="page-shell">
        <div class="scan-section__intro">
          <div>
            <p class="scan-kicker">Part of the THIEPN document toolkit</p>
            <h2 id="tool-relationship-title">Use the tool that matches where the document is.</h2>
          </div>
          <p>
            Scan, PDF Studio and Tiny Tools overlap intentionally at the edges, but they solve different stages of the document workflow.
          </p>
        </div>

        <div class="tool-relationship-grid">
          <article class="tool-card tool-card--scan">
            <span>ANDROID · CAPTURE</span>
            <h3>Scan</h3>
            <p>Start here when the document is paper, a receipt, a form, a book spread, an ID, or something you need to capture and keep searchable on your phone.</p>
            <strong>Camera → OCR → local library → searchable PDF</strong>
          </article>
          <a class="tool-card" href="/pdf/">
            <span>WEB · PDF WORKSPACE</span>
            <h3>PDF Studio</h3>
            <p>Use it when the document already exists as a PDF and the job is deeper page organization, annotation, redaction, conversion or browser-based editing.</p>
            <strong>Existing PDF → edit → transform → export ↗</strong>
          </a>
          <a class="tool-card" href="/tools/">
            <span>WEB · QUICK UTILITIES</span>
            <h3>Tiny Tools</h3>
            <p>Use it for focused one-off jobs such as conversion, formatting, inspection or small document utilities without opening a larger workspace.</p>
            <strong>Small task → direct utility → result ↗</strong>
          </a>
        </div>
      </div>
    </section>

    <section class="privacy-band" id="privacy" aria-labelledby="privacy-title">
      <div class="page-shell privacy-layout">
        <div class="privacy-visual" aria-hidden="true">
          <div class="privacy-document">
            <span class="privacy-lock"><i></i><b></b></span>
            <span class="privacy-line privacy-line--1"></span>
            <span class="privacy-line privacy-line--2"></span>
            <span class="privacy-line privacy-line--3"></span>
          </div>
          <span class="privacy-ring privacy-ring--a"></span>
          <span class="privacy-ring privacy-ring--b"></span>
        </div>

        <div class="privacy-copy">
          <p class="scan-kicker">Local-first by architecture</p>
          <h2 id="privacy-title">Your scanner does not need to become a document cloud.</h2>
          <p>
            Scan stores document files in app-private storage and metadata in its local Room database. The release APK explicitly removes the <code>INTERNET</code> permission and does not include an account, advertising SDK or app-managed cloud document service.
          </p>

          <div class="privacy-facts">
            <span><b>No account</b><small>Open the app and scan.</small></span>
            <span><b>No INTERNET permission</b><small>Enforced in the final APK manifest.</small></span>
            <span><b>No broad storage permission</b><small>Save As uses Android's document providers.</small></span>
            <span><b>Encrypted portable backup</b><small>Restore after reinstall or app-data loss.</small></span>
          </div>

          <div class="privacy-note">
            <strong>Capture dependency</strong>
            <p>Google Play services supplies the ML Kit document-scanner UI and may download or update that scanner module before first use. Scan's own library, OCR, editing and document processing remain local-first.</p>
          </div>

          <a class="text-link" href={sourceUrl + '/blob/main/README.md'}>Read the technical architecture ↗</a>
        </div>
      </div>
    </section>

    <section class="scan-section page-shell" aria-labelledby="reliability-title">
      <div class="reliability-grid">
        <div class="reliability-copy">
          <p class="scan-kicker">Release engineering</p>
          <h2 id="reliability-title">The boring failure cases are part of the product.</h2>
          <p>
            Scan v1 is certified around installation, migration, large documents, constrained devices, accessibility, backup integrity and low-storage behavior—not only the happy-path camera flow.
          </p>
        </div>

        <div class="qa-table" role="list" aria-label="Scan release facts">
          {qaItems.map(([name, value]) => (
            <div role="listitem"><span>{name}</span><strong>{value}</strong></div>
          ))}
        </div>
      </div>

      <div class="certification-strip">
        <div>
          <span class="cert-dot cert-dot--ok"></span>
          <strong>Android CI</strong>
          <small>Passed on final source SHA</small>
        </div>
        <div>
          <span class="cert-dot cert-dot--ok"></span>
          <strong>API 26</strong>
          <small>Install / update / accessibility certified</small>
        </div>
        <div>
          <span class="cert-dot cert-dot--ok"></span>
          <strong>API 35</strong>
          <small>Install / update / accessibility certified</small>
        </div>
        <div>
          <span class="cert-dot cert-dot--pending" data-scan-cert-dot></span>
          <strong>Production release</strong>
          <small data-scan-cert-copy>Signing + physical-device acceptance pending</small>
        </div>
      </div>
    </section>

    <section class="install-band" id="install" aria-labelledby="install-title">
      <div class="page-shell install-layout">
        <div class="install-copy">
          <p class="scan-kicker">Install Scan</p>
          <h2 id="install-title" data-scan-install-title>The official APK is almost ready.</h2>
          <p data-scan-install-copy>
            The source candidate is certified, but the public download remains intentionally locked until the permanent production signing identity and physical-device release gates are complete.
          </p>

          <div class="install-actions">
            <a class="scan-button scan-button--primary scan-button--large" href={apkUrl} data-scan-release-download hidden>Download Scan v{version}</a>
            <a class="scan-button scan-button--outline" href={releaseUrl} data-scan-release-link hidden>Release notes ↗</a>
            <span class="scan-button scan-button--disabled scan-button--large" aria-disabled="true" data-scan-release-pending>Production APK pending</span>
            <a class="scan-button scan-button--outline" href={sourceUrl} data-scan-pending-source>View repository ↗</a>
          </div>

          <p class="install-meta">Android 8.0+ · package <code>com.thiepn.scan</code> · open source</p>
        </div>

        <aside class="install-guide" aria-labelledby="install-guide-title">
          <span class="install-guide__eyebrow">APK installation</span>
          <h3 id="install-guide-title">When v1.0.0 is published</h3>
          <ol>
            <li>Download <code>Scan-v1.0.0.apk</code> from this page or the official GitHub release.</li>
            <li>Open the APK. Android may ask you to allow installs from that browser or file manager.</li>
            <li>Confirm the package is <code>com.thiepn.scan</code> and install.</li>
            <li>For later updates, install newer official Scan APKs over the existing app without clearing app data.</li>
          </ol>
          <details>
            <summary>How do I verify the APK?</summary>
            <p>The release includes SHA-256 checksums. On Windows, compare the published value with:</p>
            <code class="command">Get-FileHash .\Scan-v1.0.0.apk -Algorithm SHA256</code>
          </details>
        </aside>
      </div>
    </section>

    <section class="faq page-shell" id="faq" aria-labelledby="faq-title">
      <div class="faq__intro">
        <p class="scan-kicker">Useful answers</p>
        <h2 id="faq-title">Before you install.</h2>
      </div>

      <div class="faq__items">
        <details>
          <summary>Does Scan upload my documents?</summary>
          <p>No app-managed cloud document service is part of Scan v1, and the release APK does not request Android's INTERNET permission. The Google Play services document-scanner module is a separate capture dependency and may be downloaded or updated by Play services.</p>
        </details>
        <details>
          <summary>Can I use Scan completely offline?</summary>
          <p>Once the required Google Play services scanner module is present, Scan's library, OCR, search, editing, organization and export workflows are designed to operate locally. First-use scanner-module availability is controlled by Google Play services.</p>
        </details>
        <details>
          <summary>Can Scan import an existing PDF?</summary>
          <p>Yes. Imported PDFs are kept as native originals where possible while local page derivatives provide OCR, search and editing support.</p>
        </details>
        <details>
          <summary>Can I search inside scanned documents?</summary>
          <p>Yes. OCR feeds a local full-text index with phrase and prefix search, highlighted snippets and jump-to-page navigation.</p>
        </details>
        <details>
          <summary>Can I protect or back up sensitive documents?</summary>
          <p>Scan can create AES-256 password-protected PDF copies, offers secure-vault controls, and supports encrypted portable backup with password and tamper validation.</p>
        </details>
        <details>
          <summary>Where do I download Scan?</summary>
          <p>This page checks the official GitHub v1.0.0 release. Before publication it shows the certified release candidate as pending; once the production-signed release exists, the same download controls automatically point to the official APK.</p>
        </details>
      </div>
    </section>

    <section class="scan-closing">
      <div class="page-shell scan-closing__inner">
        <div class="closing-mark" aria-hidden="true">
          <svg viewBox="0 0 48 48"><path d="M12 5h15l9 9v29H12z"/><path d="M27 5v10h9"/><path d="M17 23h14M17 29h14M17 35h9"/></svg>
        </div>
        <div>
          <p class="scan-kicker">Scan v{version}</p>
          <h2>Paper should become searchable—not become an account.</h2>
        </div>
        <a class="scan-button scan-button--outline" href={sourceUrl}>Explore the source ↗</a>
      </div>
    </section>
  </div>

  <script is:inline>
    (() => {
      const api = 'https://api.github.com/repos/thiepn/scan/releases/tags/v1.0.0';
      const expectedAsset = 'Scan-v1.0.0.apk';

      const setPublished = (release, asset) => {
        document.querySelectorAll('[data-scan-release-download]').forEach((node) => {
          node.hidden = false;
          if (node instanceof HTMLAnchorElement) node.href = asset.browser_download_url;
        });
        document.querySelectorAll('[data-scan-release-link]').forEach((node) => {
          node.hidden = false;
          if (node instanceof HTMLAnchorElement) node.href = release.html_url;
        });
        document.querySelectorAll('[data-scan-release-pending]').forEach((node) => { node.hidden = true; });
        document.querySelectorAll('[data-scan-pending-source]').forEach((node) => { node.hidden = true; });

        const versionState = document.querySelector('[data-scan-version-state]');
        if (versionState) versionState.textContent = 'v1.0.0';

        const title = document.querySelector('[data-scan-release-title]');
        const copy = document.querySelector('[data-scan-release-copy]');
        if (title) title.textContent = 'Scan v1.0.0 is published.';
        if (copy) copy.textContent = 'The production-signed APK is available from the official THIEPN GitHub release.';

        const installTitle = document.querySelector('[data-scan-install-title]');
        const installCopy = document.querySelector('[data-scan-install-copy]');
        if (installTitle) installTitle.textContent = 'Download the official Android build.';
        if (installCopy) installCopy.textContent = 'Download the production-signed APK from the official GitHub release. Android may ask you to allow installs from your browser or file manager if you are sideloading.';

        const certDot = document.querySelector('[data-scan-cert-dot]');
        const certCopy = document.querySelector('[data-scan-cert-copy]');
        if (certDot) {
          certDot.classList.remove('cert-dot--pending');
          certDot.classList.add('cert-dot--ok');
        }
        if (certCopy) certCopy.textContent = 'Production-signed v1.0.0 published';
      };

      fetch(api, {
        headers: { Accept: 'application/vnd.github+json' },
        referrerPolicy: 'no-referrer'
      })
        .then((response) => response.ok ? response.json() : null)
        .then((release) => {
          if (!release || release.draft || release.prerelease || release.tag_name !== 'v1.0.0') return;
          const asset = Array.isArray(release.assets)
            ? release.assets.find((candidate) => candidate?.name === expectedAsset)
            : null;
          if (!asset?.browser_download_url) return;
          setPublished(release, asset);
        })
        .catch(() => {
          // Fail closed: the page remains in release-candidate state when GitHub is unavailable.
        });
    })();
  </script>

  <style>
    .scan-page {
      --scan-bg: #f6f8fc;
      --scan-surface: #ffffff;
      --scan-surface-soft: #eef3fb;
      --scan-surface-strong: #e5ebf5;
      --scan-ink: #152238;
      --scan-ink-2: #46556d;
      --scan-muted: #69778d;
      --scan-line: #d6dfeb;
      --scan-line-strong: #bac8d9;
      --scan-accent: #4d57c8;
      --scan-accent-strong: #3541b1;
      --scan-accent-soft: #e7e9ff;
      --scan-teal: #137c6e;
      --scan-deep: #101727;
      --scan-radius: 22px;
      overflow: hidden;
      color: var(--scan-ink);
      background:
        radial-gradient(circle at 7% 4%, rgb(77 87 200 / 10%), transparent 29rem),
        linear-gradient(180deg, #fbfcff 0%, var(--scan-bg) 48%, #ffffff 100%);
    }

    :global(html[data-theme="dark"]) .scan-page {
      --scan-bg: #11151d;
      --scan-surface: #171d27;
      --scan-surface-soft: #1d2531;
      --scan-surface-strong: #242e3d;
      --scan-ink: #f0f1f7;
      --scan-ink-2: #c0c6d2;
      --scan-muted: #929bab;
      --scan-line: #2d3745;
      --scan-line-strong: #465366;
      --scan-accent: #aeb2ff;
      --scan-accent-strong: #c7caff;
      --scan-accent-soft: #25294d;
      --scan-teal: #74d5c3;
      background:
        radial-gradient(circle at 8% 4%, rgb(111 118 255 / 10%), transparent 28rem),
        linear-gradient(180deg, #10141c 0%, #121720 52%, #10141c 100%);
    }

    .scan-page :where(h1,h2,h3) { color: var(--scan-ink); letter-spacing: -.05em; text-wrap: balance; }
    .scan-page :where(p) { text-wrap: pretty; }

    .scan-hero {
      min-height: 720px;
      padding-top: clamp(64px, 8vw, 118px);
      padding-bottom: clamp(72px, 9vw, 126px);
      display: grid;
      grid-template-columns: minmax(0,.9fr) minmax(520px,1.1fr);
      gap: clamp(44px, 7vw, 105px);
      align-items: center;
    }

    .scan-chips { display:flex; flex-wrap:wrap; gap:8px; margin-bottom:26px; }
    .scan-chip {
      display:inline-flex; align-items:center; min-height:30px; padding:5px 11px;
      border:1px solid var(--scan-line); border-radius:999px; background:color-mix(in srgb,var(--scan-surface) 82%,transparent);
      color:var(--scan-muted); font:650 .72rem/1.2 var(--font-meta); letter-spacing:.025em;
    }
    .scan-chip--accent { border-color:color-mix(in srgb,var(--scan-accent) 30%,var(--scan-line)); background:var(--scan-accent-soft); color:var(--scan-accent-strong); }

    .scan-kicker { margin:0 0 13px; color:var(--scan-accent); font-size:.82rem; font-weight:700; letter-spacing:.025em; }
    .scan-hero h1 { margin:0; max-width:9ch; font-size:clamp(4.4rem,8.6vw,8.2rem); line-height:.88; font-weight:650; letter-spacing:-.075em; }
    .scan-hero__lead { max-width:61ch; margin:30px 0 0; color:var(--scan-ink-2); font-size:clamp(1.05rem,1.35vw,1.28rem); line-height:1.72; }

    .scan-hero__actions,.install-actions { display:flex; flex-wrap:wrap; gap:11px; align-items:center; margin-top:33px; }
    .scan-button {
      min-height:50px; display:inline-flex; align-items:center; justify-content:center; gap:10px;
      padding:12px 18px; border:1px solid transparent; border-radius:12px;
      font-size:.91rem; font-weight:700; text-decoration:none; transition:transform 160ms ease,border-color 160ms ease,background 160ms ease;
    }
    a.scan-button:hover { transform:translateY(-1px); text-decoration:none; }
    .scan-button--primary { color:#fff; background:linear-gradient(180deg,#626ce0,#4651c5); border-color:#404ab7; box-shadow:0 12px 30px rgb(61 70 175 / 20%); }
    .scan-button--primary:hover { color:#fff; background:linear-gradient(180deg,#7079e8,#3f4aba); }
    .scan-button--quiet,.scan-button--outline { color:var(--scan-ink-2); border-color:var(--scan-line); background:color-mix(in srgb,var(--scan-surface) 72%,transparent); }
    .scan-button--quiet:hover,.scan-button--outline:hover { color:var(--scan-accent-strong); border-color:color-mix(in srgb,var(--scan-accent) 45%,var(--scan-line)); background:var(--scan-surface); }
    .scan-button--disabled { color:var(--scan-muted); border-color:var(--scan-line); background:var(--scan-surface-soft); cursor:not-allowed; }
    .scan-button--large { min-height:58px; padding-inline:23px; font-size:1rem; }
    .scan-button__icon { width:20px; height:20px; display:grid; place-items:center; }
    .scan-button__icon svg { width:20px; height:20px; fill:none; stroke:currentColor; stroke-width:1.8; stroke-linecap:round; stroke-linejoin:round; }

    .scan-hero__meta { display:flex; flex-wrap:wrap; gap:8px 11px; align-items:center; margin-top:23px; color:var(--scan-muted); font-size:.77rem; }
    .scan-hero__meta i { width:3px; height:3px; border-radius:50%; background:var(--scan-line-strong); }

    .release-notice { max-width:660px; display:grid; grid-template-columns:auto 1fr; gap:7px 12px; margin-top:24px; padding:13px 15px; border:1px solid color-mix(in srgb,var(--scan-accent) 24%,var(--scan-line)); border-radius:12px; background:color-mix(in srgb,var(--scan-accent-soft) 64%,transparent); font-size:.78rem; line-height:1.5; }
    .release-notice strong { color:var(--scan-accent-strong); }
    .release-notice span { color:var(--scan-ink-2); }

    .scan-stage {
      position:relative; min-height:580px; border:1px solid color-mix(in srgb,var(--scan-accent) 16%,var(--scan-line));
      border-radius:28px; overflow:hidden; isolation:isolate;
      background:
        linear-gradient(140deg,rgb(255 255 255 / 42%),transparent 38%),
        linear-gradient(145deg,#dfe4ff 0%,#c7d7f5 49%,#cce9e1 100%);
      box-shadow:0 26px 70px rgb(44 56 96 / 15%);
    }
    :global(html[data-theme="dark"]) .scan-stage { background:linear-gradient(145deg,#242a50 0%,#1d2942 50%,#163b37 100%); box-shadow:none; }
    .scan-stage__halo { position:absolute; border-radius:50%; opacity:.66; filter:blur(1px); }
    .scan-stage__halo--a { width:270px; height:270px; top:-70px; right:-30px; background:#f7f4ff; }
    .scan-stage__halo--b { width:230px; height:230px; bottom:-100px; left:-35px; background:#def3ea; }
    :global(html[data-theme="dark"]) .scan-stage__halo { opacity:.08; }

    .phone { position:absolute; overflow:hidden; border:1px solid rgb(85 100 139 / 26%); border-radius:28px; background:#fbfcff; color:#24304a; box-shadow:0 22px 55px rgb(47 60 97 / 24%); }
    .phone::after { content:''; position:absolute; inset:7px auto auto 50%; width:60px; height:5px; transform:translateX(-50%); border-radius:5px; background:#c5ccda; }
    .phone--library { width:43%; height:72%; top:9%; left:7%; transform:rotate(-2.1deg); padding:24px 15px 16px; }
    .phone--document { width:40%; height:69%; top:16%; right:7%; transform:rotate(2.1deg); padding:23px 13px 15px; }
    .phone__top,.document-head { min-height:38px; display:flex; align-items:center; gap:9px; padding-inline:4px; }
    .phone__top strong { font-size:.8rem; }
    .phone__dots { margin-left:auto; color:#778399; letter-spacing:2px; }
    .scan-appmark { width:26px; height:26px; display:grid; place-items:center; border-radius:8px; background:#e8eaff; color:#4d57c8; }
    .scan-appmark svg { width:17px; height:17px; fill:none; stroke:currentColor; stroke-width:1.6; stroke-linecap:round; stroke-linejoin:round; }
    .library-search { height:34px; display:flex; align-items:center; gap:8px; margin-top:8px; padding:0 10px; border:1px solid #e1e6ef; border-radius:10px; background:#f4f6fa; color:#929bab; }
    .library-search span { width:10px; height:10px; border:1.5px solid currentColor; border-radius:50%; position:relative; }
    .library-search span::after { content:''; position:absolute; width:5px; height:1px; background:currentColor; right:-4px; bottom:-2px; transform:rotate(45deg); }
    .library-search b { color:#5d6880; font-size:.54rem; font-weight:550; }
    .doc-list { display:grid; gap:8px; margin-top:12px; }
    .doc-row { display:grid; grid-template-columns:48px 1fr; gap:9px; align-items:center; padding:8px; border:1px solid #e5e9f0; border-radius:10px; background:#fff; }
    .doc-row--active { border-color:#c5c9f5; background:#f6f6ff; }
    .doc-row div { min-width:0; }
    .doc-row b,.doc-row small { display:block; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
    .doc-row b { color:#344058; font-size:.57rem; }
    .doc-row small { margin-top:3px; color:#59657b; font-size:.47rem; }
    .thumb { display:block; height:60px; border-radius:5px; border:1px solid #e0e3e8; background:#fff; position:relative; overflow:hidden; }
    .thumb::before,.thumb::after { content:''; position:absolute; left:9px; right:9px; height:2px; background:#cbd0d8; box-shadow:0 7px #d5dae1,0 14px #d5dae1,0 21px #d5dae1; }
    .thumb::before { top:13px; }
    .thumb::after { top:42px; right:20px; box-shadow:none; }
    .thumb--receipt { background:linear-gradient(#fff,#fdfcf8); }
    .thumb--notes::before { transform:rotate(-1deg); }
    .thumb--form::before { background:#b8c3d4; box-shadow:0 8px #d0d7e1,0 16px #d0d7e1; }
    .scan-fab { position:absolute; right:16px; bottom:16px; min-height:34px; display:flex; align-items:center; gap:6px; padding:0 11px; border-radius:10px; background:#4d57c8; color:#fff; font-size:.53rem; font-weight:700; }
    .scan-fab i { width:11px; height:8px; border:1.3px solid currentColor; border-radius:2px; position:relative; }
    .scan-fab i::before { content:''; position:absolute; width:4px; height:4px; left:2px; top:1px; border:1px solid currentColor; border-radius:50%; }

    .document-head { justify-content:space-between; color:#46516a; font-size:.62rem; }
    .document-head b { max-width:58%; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; color:#29364e; }
    .page-preview { position:relative; height:230px; margin-top:8px; padding:26px 20px; border:1px solid #dfe4ea; border-radius:7px; background:#fffdf7; box-shadow:0 6px 18px rgb(44 54 74 / 8%); }
    .receipt-logo { display:block; color:#455067; font-size:.74rem; font-weight:800; letter-spacing:.16em; text-align:center; }
    .page-preview i { display:block; height:3px; margin-top:15px; border-radius:2px; background:#d6d9dd; }
    .page-preview i:nth-of-type(2){width:80%}.page-preview i:nth-of-type(3){width:92%}.page-preview i:nth-of-type(4){width:67%}
    .page-preview b { position:absolute; right:20px; bottom:24px; color:#38435a; font-size:.82rem; }
    .page-actions { display:grid; grid-template-columns:repeat(4,1fr); gap:4px; margin-top:9px; }
    .page-actions span { min-height:38px; display:grid; place-items:center; align-content:center; gap:2px; border-radius:8px; background:#f1f3f7; color:#5d6880; font-size:.68rem; }
    .page-actions small { display:block; font-size:.38rem; }
    .ocr-result { margin-top:8px; padding:9px 10px; border-radius:8px; background:#f1f3f8; }
    .ocr-result small { color:#727d91; font-size:.42rem; font-weight:700; letter-spacing:.08em; }
    .ocr-result p { margin:4px 0 0; color:#59657b; font-size:.48rem; line-height:1.4; }

    .search-card,.export-card { position:absolute; z-index:5; border:1px solid rgb(93 111 148 / 28%); border-radius:16px; background:rgb(255 255 255 / 92%); box-shadow:0 15px 40px rgb(42 54 87 / 20%); backdrop-filter:blur(10px); }
    .search-card { left:13%; bottom:7%; width:39%; display:grid; grid-template-columns:34px 1fr auto; gap:9px; align-items:center; padding:13px; transform:rotate(1.5deg); }
    .search-card__icon { width:34px; height:34px; display:grid; place-items:center; border-radius:10px; background:#e9ebff; color:#4d57c8; font-size:1rem; }
    .search-card small,.export-card small { display:block; color:#59657b; font-size:.43rem; font-weight:800; letter-spacing:.08em; }
    .search-card strong { display:block; margin-top:2px; color:#354157; font-size:.65rem; }
    .search-card p { margin:2px 0 0; color:#798499; font-size:.48rem; }
    .search-card>b { color:#657087; }

    .export-card { right:11%; bottom:5%; width:38%; padding:14px; transform:rotate(-1.2deg); }
    .export-card strong { display:block; margin-top:4px; color:#354157; font-size:.72rem; }
    .quality-pills { display:flex; gap:4px; margin-top:9px; }
    .quality-pills span { padding:4px 6px; border-radius:8px; background:#f0f2f6; color:#59657b; font-size:.39rem; }
    .quality-pills span.active { background:#e4e6ff; color:#4650bd; }
    .export-card p { margin:9px 0 0; color:#7c879a; font-size:.45rem; }

    .scan-visual-note { margin:17px auto 0; max-width:62ch; color:var(--scan-muted); font-size:.76rem; text-align:center; }

    .scan-subnav { position:sticky; top:76px; z-index:20; border-block:1px solid var(--scan-line); background:color-mix(in srgb,var(--scan-bg) 88%,transparent); backdrop-filter:blur(14px); }
    .scan-subnav__inner { min-height:52px; display:flex; justify-content:center; align-items:center; gap:clamp(17px,4vw,44px); overflow-x:auto; scrollbar-width:none; }
    .scan-subnav__inner::-webkit-scrollbar{display:none}
    .scan-subnav a { flex:0 0 auto; color:var(--scan-muted); font-size:.77rem; font-weight:650; text-decoration:none; }
    .scan-subnav a:hover { color:var(--scan-accent-strong); text-decoration:none; }

    .scan-section { padding-top:clamp(88px,9vw,136px); padding-bottom:clamp(88px,9vw,136px); }
    .scan-section__intro { display:grid; grid-template-columns:1fr .78fr; gap:clamp(40px,8vw,116px); align-items:end; margin-bottom:52px; }
    .scan-section__intro h2 { margin:0; max-width:14ch; font-size:clamp(2.6rem,4.9vw,4.8rem); line-height:.98; font-weight:610; }
    .scan-section__intro>p { max-width:54ch; margin:0; color:var(--scan-ink-2); font-size:.98rem; line-height:1.72; }

    .highlight-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:14px; }
    .highlight-card { min-height:250px; padding:27px; border:1px solid var(--scan-line); border-radius:18px; background:var(--scan-surface); }
    .highlight-card>span { display:inline-flex; min-width:34px; min-height:26px; align-items:center; justify-content:center; border-radius:999px; background:var(--scan-accent-soft); color:var(--scan-accent-strong); font:700 .63rem var(--font-meta); }
    .highlight-card h3 { margin:42px 0 0; font-size:1.42rem; line-height:1.13; }
    .highlight-card p { margin:13px 0 0; color:var(--scan-ink-2); font-size:.87rem; line-height:1.67; }

    .workflow-band { padding:clamp(92px,10vw,148px) 0; background:linear-gradient(145deg,#0e1525,#171e34 63%,#162d32); color:#eaf0fa; }
    .scan-section__intro--dark h2 { color:#f6f7fb; }
    .scan-section__intro--dark>p { color:#aeb8c9; }
    .scan-section__intro--dark .scan-kicker { color:#aeb2ff; }
    .workflow-steps { display:grid; grid-template-columns:repeat(4,1fr); gap:1px; margin:0; padding:0; list-style:none; border:1px solid rgb(181 192 216 / 18%); border-radius:20px; overflow:hidden; background:rgb(181 192 216 / 16%); }
    .workflow-steps li { position:relative; min-height:310px; padding:25px; background:#131b2c; }
    .workflow-index { color:#8492aa; font:700 .64rem var(--font-meta); letter-spacing:.08em; }
    .workflow-symbol { width:76px; height:76px; display:grid; place-items:center; margin-top:42px; border:1px solid rgb(174 178 255 / 27%); border-radius:22px; background:rgb(174 178 255 / 7%); color:#bfc2ff; font-size:2rem; }
    .symbol-scan { width:32px; height:40px; position:relative; border:2px solid currentColor; border-radius:4px; }
    .symbol-scan::before,.symbol-scan::after,.symbol-scan i::before,.symbol-scan i::after { content:''; position:absolute; width:8px; height:8px; border-color:currentColor; }
    .symbol-scan::before{left:-7px;top:-7px;border-left:2px solid;border-top:2px solid}.symbol-scan::after{right:-7px;top:-7px;border-right:2px solid;border-top:2px solid}
    .symbol-scan i::before{left:-7px;bottom:-7px;border-left:2px solid;border-bottom:2px solid}.symbol-scan i::after{right:-7px;bottom:-7px;border-right:2px solid;border-bottom:2px solid}
    .workflow-steps h3 { margin:28px 0 0; color:#f3f5fb; font-size:1.5rem; }
    .workflow-steps p { margin:12px 0 0; color:#a6b0c1; font-size:.83rem; line-height:1.66; }

    .feature-groups { display:grid; grid-template-columns:1fr 1fr; gap:16px; }
    .feature-group { display:grid; grid-template-columns:.75fr 1.25fr; gap:32px; min-height:320px; padding:30px; border:1px solid var(--scan-line); border-radius:20px; background:var(--scan-surface); }
    .feature-group__head>span { color:var(--scan-accent); font:700 .67rem var(--font-meta); letter-spacing:.07em; text-transform:uppercase; }
    .feature-group h3 { margin:16px 0 0; font-size:1.75rem; line-height:1.08; }
    .feature-group ul { margin:0; padding:0; list-style:none; border-top:1px solid var(--scan-line); }
    .feature-group li { position:relative; padding:11px 0 11px 20px; border-bottom:1px solid var(--scan-line); color:var(--scan-ink-2); font-size:.79rem; line-height:1.45; }
    .feature-group li::before { content:'✓'; position:absolute; left:0; color:var(--scan-teal); font-weight:800; }

    .tool-relationship-band { padding:clamp(88px,9vw,136px) 0; border-block:1px solid var(--scan-line); background:var(--scan-surface); }
    .tool-relationship-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:14px; }
    .tool-card { min-height:260px; display:flex; flex-direction:column; padding:27px; border:1px solid var(--scan-line); border-radius:18px; background:var(--scan-bg); color:inherit; text-decoration:none; transition:transform 160ms ease,border-color 160ms ease,background 160ms ease; }
    a.tool-card:hover { transform:translateY(-2px); border-color:color-mix(in srgb,var(--scan-accent) 42%,var(--scan-line)); background:var(--scan-surface-soft); text-decoration:none; }
    .tool-card--scan { border-color:color-mix(in srgb,var(--scan-accent) 34%,var(--scan-line)); background:var(--scan-accent-soft); }
    .tool-card>span { color:var(--scan-accent); font:700 .65rem var(--font-meta); letter-spacing:.08em; }
    .tool-card h3 { margin:36px 0 0; font-size:1.65rem; }
    .tool-card p { margin:13px 0 0; color:var(--scan-ink-2); font-size:.84rem; line-height:1.67; }
    .tool-card strong { margin-top:auto; padding-top:24px; color:var(--scan-ink); font-size:.74rem; line-height:1.5; }

    .privacy-band { padding:clamp(92px,10vw,148px) 0; background:var(--scan-surface-soft); border-block:1px solid var(--scan-line); }
    .privacy-layout { display:grid; grid-template-columns:.72fr 1.28fr; gap:clamp(48px,8vw,110px); align-items:center; }
    .privacy-visual { position:relative; min-height:470px; display:grid; place-items:center; overflow:hidden; }
    .privacy-document { position:relative; z-index:2; width:230px; height:300px; border:1px solid color-mix(in srgb,var(--scan-accent) 34%,var(--scan-line)); border-radius:22px; background:linear-gradient(180deg,var(--scan-surface),color-mix(in srgb,var(--scan-accent-soft) 35%,var(--scan-surface))); box-shadow:0 24px 60px rgb(51 65 112 / 12%); }
    .privacy-lock { position:absolute; width:86px; height:76px; left:50%; top:93px; transform:translateX(-50%); border:2px solid var(--scan-accent); border-radius:16px; background:var(--scan-accent-soft); }
    .privacy-lock i { position:absolute; width:47px; height:38px; left:50%; top:-29px; transform:translateX(-50%); border:9px solid var(--scan-accent); border-bottom:0; border-radius:17px 17px 0 0; }
    .privacy-lock b { position:absolute; width:12px; height:12px; left:50%; top:29px; transform:translateX(-50%); border-radius:50%; background:var(--scan-accent); }
    .privacy-line { position:absolute; left:38px; right:38px; height:5px; border-radius:5px; background:var(--scan-line); }
    .privacy-line--1{bottom:54px}.privacy-line--2{bottom:38px;right:70px}.privacy-line--3{bottom:22px;right:105px}
    .privacy-ring { position:absolute; border:1px solid color-mix(in srgb,var(--scan-accent) 20%,transparent); border-radius:50%; }
    .privacy-ring--a{width:330px;height:330px}.privacy-ring--b{width:450px;height:450px}
    .privacy-copy h2 { margin:0; max-width:14ch; font-size:clamp(2.7rem,4.8vw,4.8rem); line-height:.98; }
    .privacy-copy>p { max-width:66ch; margin:22px 0 0; color:var(--scan-ink-2); line-height:1.72; }
    .privacy-copy code,.install-copy code,.install-guide code { padding:2px 5px; border-radius:5px; background:var(--scan-surface-strong); color:var(--scan-ink); font-size:.8em; }
    .privacy-facts { display:grid; grid-template-columns:1fr 1fr; gap:10px; margin-top:27px; }
    .privacy-facts span { padding:16px; border:1px solid var(--scan-line); border-radius:13px; background:var(--scan-surface); }
    .privacy-facts b,.privacy-facts small { display:block; }
    .privacy-facts b { color:var(--scan-ink); font-size:.82rem; }
    .privacy-facts small { margin-top:5px; color:var(--scan-muted); font-size:.69rem; line-height:1.5; }
    .privacy-note { margin-top:18px; padding:16px 18px; border-left:3px solid var(--scan-accent); background:color-mix(in srgb,var(--scan-surface) 70%,transparent); }
    .privacy-note strong { color:var(--scan-ink); font-size:.78rem; }
    .privacy-note p { margin:5px 0 0; color:var(--scan-ink-2); font-size:.76rem; line-height:1.6; }
    .text-link { display:inline-flex; margin-top:24px; color:var(--scan-accent-strong); font-size:.8rem; font-weight:700; text-decoration:none; }
    .text-link:hover{text-decoration:underline}

    .reliability-grid { display:grid; grid-template-columns:1fr 1fr; gap:clamp(50px,8vw,115px); align-items:start; }
    .reliability-copy h2 { margin:0; max-width:13ch; font-size:clamp(2.5rem,4.4vw,4.3rem); line-height:1; }
    .reliability-copy>p { max-width:58ch; margin:20px 0 0; color:var(--scan-ink-2); line-height:1.7; }
    .qa-table { border-top:1px solid var(--scan-line); }
