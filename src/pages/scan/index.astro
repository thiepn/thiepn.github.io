  <script is:inline>
    (() => {
      const releaseApi = 'https://api.github.com/repos/thiepn/scan/releases/tags/v1.0.0';
      const expected = { apk: 'Scan-v1.0.0.apk', aab: 'Scan-v1.0.0.aab', checksums: 'release-checksums.sha256' };
      const all = (selector) => [...document.querySelectorAll(selector)];
      const one = (selector) => document.querySelector(selector);
      const setText = (selector, value) => { const node = one(selector); if (node) node.textContent = value; };
      const formatBytes = (bytes) => {
        if (!Number.isFinite(bytes) || bytes <= 0) return 'Available';
        const units = ['B', 'KB', 'MB', 'GB']; let value = bytes; let unit = 0;
        while (value >= 1024 && unit < units.length - 1) { value /= 1024; unit += 1; }
        return `${value.toFixed(unit >= 2 ? 1 : 0)} ${units[unit]}`;
      };
      const formatDate = (value) => {
        const date = value ? new Date(value) : null;
        if (!date || Number.isNaN(date.getTime())) return 'Published';
        return new Intl.DateTimeFormat(undefined, { year: 'numeric', month: 'short', day: 'numeric' }).format(date);
      };
      const showPublished = (release, assets) => {
        all('[data-scan-release-download]').forEach((node) => { node.hidden = false; if (node instanceof HTMLAnchorElement) node.href = assets.apk.browser_download_url; });
        all('[data-scan-release-link]').forEach((node) => { node.hidden = false; if (node instanceof HTMLAnchorElement) node.href = release.html_url; });
        all('[data-scan-release-pending]').forEach((node) => { node.hidden = true; });
        all('[data-scan-pending-source]').forEach((node) => { node.hidden = true; });
        if (assets.aab) all('[data-scan-aab-download]').forEach((node) => { node.hidden = false; if (node instanceof HTMLAnchorElement) node.href = assets.aab.browser_download_url; });
        if (assets.checksums) all('[data-scan-checksums-download]').forEach((node) => { node.hidden = false; if (node instanceof HTMLAnchorElement) node.href = assets.checksums.browser_download_url; });

        setText('[data-scan-version-state]', 'v1.0.0');
        setText('[data-scan-release-title]', 'Scan v1.0.0 is published.');
        setText('[data-scan-release-copy]', 'The production-signed APK is available from the official THIEPN GitHub release.');
        setText('[data-scan-install-title]', 'Download the official Android build.');
        setText('[data-scan-install-copy]', 'Install the production-signed APK directly, verify its SHA-256 checksum, or open the full GitHub Release for the Android App Bundle and release notes.');
        setText('[data-scan-release-status]', 'Scan v1.0.0');
        setText('[data-scan-release-status-copy]', 'Production-signed public release');
        setText('[data-scan-release-version]', '1.0.0');
        setText('[data-scan-apk-size]', formatBytes(assets.apk.size));
        setText('[data-scan-release-date]', formatDate(release.published_at || release.created_at));
        setText('[data-scan-cert-copy]', 'Production-signed v1.0.0 published');

        one('[data-scan-release-panel]')?.classList.add('is-published');
        const releaseDot = one('[data-scan-release-state-dot]');
        releaseDot?.classList.remove('release-state-dot--pending');
        releaseDot?.classList.add('release-state-dot--ok');
        const certDot = one('[data-scan-cert-dot]');
        certDot?.classList.remove('cert-dot--pending');
        certDot?.classList.add('cert-dot--ok');

        if (!assets.checksums) { setText('[data-scan-checksum]', 'Checksum file unavailable'); return; }
        setText('[data-scan-checksum]', 'Available in release');
        fetch(assets.checksums.browser_download_url, { referrerPolicy: 'no-referrer' })
          .then((response) => response.ok ? response.text() : '')
          .then((text) => {
            const line = text.split(/\r?\n/).find((candidate) => candidate.trim().endsWith(expected.apk));
            const hash = line?.trim().split(/\s+/)[0] || '';
            if (!/^[a-f0-9]{64}$/i.test(hash)) return;
            const checksum = one('[data-scan-checksum]');
            if (checksum) { checksum.textContent = `${hash.slice(0, 12)}…`; checksum.setAttribute('title', hash); }
            const copy = one('[data-copy-checksum]');
            if (copy instanceof HTMLButtonElement) { copy.hidden = false; copy.dataset.checksum = hash; }
          })
          .catch(() => {});
      };
      one('[data-copy-checksum]')?.addEventListener('click', async (event) => {
        const button = event.currentTarget;
        if (!(button instanceof HTMLButtonElement) || !button.dataset.checksum) return;
        try { await navigator.clipboard.writeText(button.dataset.checksum); const previous = button.textContent; button.textContent = 'Copied'; window.setTimeout(() => { button.textContent = previous || 'Copy'; }, 1400); } catch {}
      });
      fetch(releaseApi, { headers: { Accept: 'application/vnd.github+json' }, referrerPolicy: 'no-referrer' })
        .then((response) => response.ok ? response.json() : null)
        .then((release) => {
          if (!release || release.draft || release.prerelease || release.tag_name !== 'v1.0.0') return;
          const releaseAssets = Array.isArray(release.assets) ? release.assets : [];
          const assets = {
            apk: releaseAssets.find((asset) => asset?.name === expected.apk),
            aab: releaseAssets.find((asset) => asset?.name === expected.aab),
            checksums: releaseAssets.find((asset) => asset?.name === expected.checksums)
          };
          if (
            !assets.apk?.browser_download_url ||
            !assets.aab?.browser_download_url ||
            !assets.checksums?.browser_download_url
          ) return;
          showPublished(release, assets);
        })
        .catch(() => {});
    })();
