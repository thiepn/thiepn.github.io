---
import WorkspaceShell from '../../components/workspace/WorkspaceShell.astro';
import ProviderCoverage from '../../components/hub/ProviderCoverage.astro';
const enabled = import.meta.env.PUBLIC_HUB_INBOX_PRIVATE === 'staged-v1';
---
<WorkspaceShell view="inbox">
  <div class="portal-inbox page-shell" data-portal-inbox>
    <header class="portal-home-heading"><div class="portal-home-title-row"><button type="button" class="portal-button" data-inbox-hide hidden>Hide Inbox</button></div></header>

    <section class="ws-surface" aria-labelledby="workspace-attention-title"><h2 id="workspace-attention-title">Workspace attention</h2><div data-workspace-attention role="status">Checking this workspace…</div></section>
    <section class="portal-inbox-content" aria-labelledby="inbox-coverage-heading" data-inbox-content>
      <h2 id="inbox-coverage-heading">App attention sources</h2>
      <p data-inbox-description>No connected feeds.</p>
      <ProviderCoverage operation="inbox" />

      {enabled && <div class="portal-account-actions"><button type="button" class="portal-button" data-inbox-connect>Connect Notes reminders</button><button type="button" class="portal-button" data-inbox-disconnect hidden>Disconnect this tab</button><a class="portal-button" href="https://account.thiepn.dev/hub/connections" rel="noreferrer">Manage Inbox sharing</a></div>}
      {enabled && <p class="portal-muted">Dismiss hides a reminder here; it stays unchanged in Notes.</p>}
      <p role="status" aria-live="polite" data-inbox-status></p>
      <button type="button" class="portal-button" data-inbox-refresh hidden>Refresh Inbox</button>
      <div data-inbox-items></div>
    </section>
    <p class="portal-home-hidden" data-inbox-hidden hidden>Inbox is hidden. Choose Show Inbox to reveal its coverage. You can still open all apps.</p>
    <p class="portal-inbox-footer"><span data-inbox-total>No unread total is available.</span></p>
    <noscript><p class="portal-muted">All source links work without JavaScript.</p></noscript>
  </div>
</WorkspaceShell>
<script>import '../../scripts/portal-inbox';</script>
