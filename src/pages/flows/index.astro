---
import WorkspaceShell from '../../components/workspace/WorkspaceShell.astro';
import { WORKFLOWS, WORKFLOW_APPS, workflowLocation } from '../../lib/workflows/catalogue';
---
<WorkspaceShell view="flows">
  <div class="portal-flows page-shell" data-portal-flows>
    <nav class="portal-flow-choices" aria-label="Workflow guides">{WORKFLOWS.map(flow => <a href={workflowLocation(flow.id)} data-flow-choice={flow.id}>{flow.title}</a>)}</nav>
    <p class="portal-muted" role="status" data-flow-status>Manual workflows</p>
    {WORKFLOWS.map(flow => <section class="portal-flow-guide" data-flow-guide={flow.id} aria-labelledby={`flow-${flow.id}`}>
      <h2 id={`flow-${flow.id}`}>{flow.title}</h2><p>{flow.description}</p>
      <ol class="portal-flow-steps">{flow.steps.map((step, index) => <li data-flow-step={index}>
        <header><small>{WORKFLOW_APPS[step.owner].label}</small><h3>{step.title}</h3></header>
        <p>{step.instruction}</p><p><strong>Check in the app:</strong> {step.check}</p>
        <details><summary>If something stops</summary><p>{step.recovery}</p></details>
        <div class="portal-flow-actions"><a class="portal-button" href={WORKFLOW_APPS[step.owner].href} target="_blank" rel="noopener noreferrer">{step.owner === 'scan' ? 'Open Scan product page' : `Open ${WORKFLOW_APPS[step.owner].label}`} <span class="sr-only">(new tab)</span></a><a href={workflowLocation(flow.id, index)} data-flow-position={index}>View step {index + 1}</a></div>
      </li>)}</ol>
    </section>)}

    <p><a href="/">Home</a> · <a href="/search/?scope=actions">Search actions</a></p>
    <noscript><p>All guides and app links are available without JavaScript.</p></noscript>
  </div>
</WorkspaceShell>
<script>import '../../scripts/portal-flows';</script>
