---
import WorkspaceShell from '../../components/workspace/WorkspaceShell.astro';
import { getHubProjects } from '../../lib/hub';
import { hubSearchProjects } from '../../lib/hub-search';
import { HUB_ACTIONS } from '../../lib/hub-actions';
import ProviderCoverage from '../../components/hub/ProviderCoverage.astro';
const projects = hubSearchProjects((await getHubProjects()).filter(({project})=>project.data.slug!=='notes'));
const payload = JSON.stringify(projects).replaceAll('<', '\\u003c');
---
<WorkspaceShell view="search">
  <div class="portal-search-page page-shell" data-portal-search-page>
    <div class="portal-search-scopes" role="tablist" aria-label="Search scope" data-search-scopes hidden>{[['apps', 'Apps'], ['actions', 'Actions'], ['resources', 'My resources']].map(([scope, label]) => <button type="button" role="tab" id={`scope-${scope}`} aria-controls={`search-${scope}`} aria-selected={scope === 'apps' ? 'true' : 'false'} tabindex={scope === 'apps' ? 0 : -1} data-search-scope-choice={scope}>{label}</button>)}</div>
    <form class="portal-search-form" role="search" action="/search/" method="get" data-public-search-form>
      <label for="app-query" data-public-query-label>App name or task</label>
      <div><input type="search" id="app-query" name="q" placeholder="Try merge PDF or French vocabulary" maxlength="200" autocomplete="off" spellcheck="false" data-portal-query /><button type="submit">Search</button></div>
    </form>
    <p class="portal-search-status" role="status" aria-live="polite" data-portal-search-status>{projects.length} apps</p>
    <section id="search-apps" aria-labelledby="scope-apps" data-search-panel="apps">
    <div class="portal-search-results" data-portal-search-results>
      {projects.map(project => <article class="portal-search-row" data-portal-search-slug={project.slug}>
        <div><h2><a href={project.liveUrl!}>{project.title}</a></h2><p>{project.subtitle}</p><small>{project.category === 'faith' ? 'Faith' : project.category[0]!.toUpperCase() + project.category.slice(1)}{project.slug === 'scan' && ' · Android download'}</small></div>
        <div class="portal-search-actions"><a href={project.liveUrl!}>Open app <span aria-hidden="true">↗</span></a></div>
      </article>)}
    </div>
    <p class="portal-search-empty" data-portal-search-empty hidden>No apps match. Try another name or task, or <a href="/apps/#apps">browse all apps</a>.</p>
    </section>
    <section id="search-actions" aria-labelledby="scope-actions" data-search-panel="actions" hidden>

      <div class="portal-action-results">{HUB_ACTIONS.map(action => <article class="portal-search-row" data-search-action={action.id}><h2><a href={action.href} rel="noreferrer">{action.title}</a></h2><p>{action.description}</p></article>)}</div>
      <p class="portal-search-empty" data-action-empty hidden>No actions match. Try another task or search Apps.</p>
    </section>
    <section id="search-resources" aria-labelledby="scope-resources" data-search-panel="resources" hidden>
      <h2 class="portal-resource-title">Connected search</h2>

      <ProviderCoverage operation="search" />

    </section>
    <noscript><p>All apps are listed. Filtering requires JavaScript.</p></noscript>
    <script is:inline type="application/json" data-portal-app-index set:html={payload}></script>
    <script is:inline type="application/json" data-portal-action-index set:html={JSON.stringify(HUB_ACTIONS).replaceAll('<', '\\u003c')}></script>
  </div>
</WorkspaceShell>
<script>import '../../scripts/portal-search';</script>
