---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CollectionPreview from '../../components/collections/CollectionPreview.astro';
import { getCollections,getPublicProjects } from '../../lib/catalogue';
const collections=await getCollections();collections.sort((a,b)=>a.data.code.localeCompare(b.data.code));const projects=await getPublicProjects();const bySlug=new Map(projects.map((p)=>[p.data.slug,p]));const titles=(slugs:string[])=>slugs.map((s)=>bySlug.get(s)?.data.title).filter((v):v is string=>Boolean(v));
---
<BaseLayout title="Collections — THIEPN" description="Browse related THIEPN projects grouped by interest and theme.">
  <section class="collections-page page-shell" aria-labelledby="collections-title">
    <header class="collections-page__hero">
      <p class="meta">Browse by interest</p>
      <h1 id="collections-title">Collections</h1>
      <p>Groups of related projects that make it easier to explore a topic, format, or kind of work.</p>
    </header>
    <section class="collections-page__index" aria-labelledby="collection-index-title">
      <header class="collections-page__section-head"><div><p class="meta">Explore</p><h2 id="collection-index-title">Project collections</h2></div><span class="meta">{String(collections.length).padStart(2,'0')} collections</span></header>
      <div class="collections-page__grid">{collections.map((collection)=><CollectionPreview collection={collection} projectTitles={titles(collection.data.projects)} />)}</div>
    </section>
  </section>
</BaseLayout>
<style>
  .collections-page{padding-top:clamp(40px,5vw,72px);padding-bottom:var(--space-9)}
  .collections-page__hero{padding:var(--space-7) 0 var(--space-8);border-bottom:1px solid var(--line-strong)}.collections-page__hero .meta{color:var(--ink-muted)}.collections-page__hero h1{margin-top:var(--space-3);font-size:var(--text-display-l);line-height:.88;letter-spacing:-.06em}.collections-page__hero p:not(.meta){margin-top:var(--space-5);max-width:58ch;color:var(--ink-secondary);font-size:var(--text-body-l)}
  .collections-page__index{padding-top:var(--space-8)}.collections-page__section-head{display:flex;justify-content:space-between;align-items:end;gap:var(--space-5);padding-bottom:var(--space-4);border-bottom:1px solid var(--line-strong)}.collections-page__section-head .meta{color:var(--ink-muted)}.collections-page__section-head h2{margin-top:4px;font-size:var(--text-h2);letter-spacing:-.04em}.collections-page__grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:var(--space-5);margin-top:var(--space-6)}
  @media(max-width:760px){.collections-page__grid{grid-template-columns:1fr}.collections-page__section-head>span{display:none}}
</style>
