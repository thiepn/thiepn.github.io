---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {getCollections} from '../../lib/catalogue';
const collections=await getCollections();
---
<BaseLayout title="Browse by interest — THIEPN" description="Follow an interest through related games, tools and learning projects."><div class="page-shell page-content"><header class="page-intro"><p class="eyebrow">A few paths through the work</p><h1>Follow an interest.</h1><p>Related projects, brought together.</p></header><div class="interest-list">{collections.map(({data:c})=><a href={`/collection/${c.slug}/`}><h2>{c.title}</h2><p>{c.summary}</p><span aria-hidden="true">→</span></a>)}</div><a class="action-link" href="/projects/">Explore all projects →</a></div></BaseLayout>
