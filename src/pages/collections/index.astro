---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollections,getPublicProjects } from '../../lib/catalogue';
const collections=await getCollections();
collections.sort((a,b)=>a.data.code.localeCompare(b.data.code));
const projects=await getPublicProjects();
const bySlug=new Map(projects.map((p)=>[p.data.slug,p]));
const titles=(slugs:string[])=>slugs.map((s)=>bySlug.get(s)?.data.title).filter((v):v is string=>Boolean(v));
const assignments=collections.reduce((sum,collection)=>sum+collection.data.projects.length,0);
---
<BaseLayout title="Collections — THIEPN" description="Browse THIEPN projects through overlapping editorial themes and interest groups.">
  <section class="collections-page page-shell" aria-labelledby="collections-title">
    <header class="collections-page__hero">
      <div>
        <p class="meta">Editorial groupings</p>
        <h1 id="collections-title">Collections</h1>
        <p>Collections group projects by subject, audience, or use. Unlike Categories, they may overlap: one project can belong to several collections without changing its single project type.</p>
      </div>
      <dl class="collections-page__stats" aria-label="Collection counts">
        <div><dt>Collections</dt><dd>{String(collections.length).padStart(2,'0')}</dd></div>
        <div><dt>Placements</dt><dd>{String(assignments).padStart(2,'0')}</dd></div>
      </dl>
    </header>

    <nav class="collections-page__browse-model" aria-label="Portfolio browsing model" data-portfolio-browse-model>
      <a href="/projects/#category-title">
        <span class="meta">01 / Categories</span>
        <strong>Project type</strong>
        <p>Singular classification. Every project appears in exactly one category.</p>
        <i aria-hidden="true">→</i>
      </a>
      <a href="#collection-index-title" aria-current="page">
        <span class="meta">02 / Collections</span>
        <strong>Editorial themes</strong>
        <p>Overlapping groupings. Projects can appear wherever their subject or purpose fits.</p>
        <i aria-hidden="true">↓</i>
      </a>
    </nav>

    <section class="collections-page__index" aria-labelledby="collection-index-title">
      <header class="collections-page__section-head">
        <div><p class="meta">Browse by theme</p><h2 id="collection-index-title">Project collections</h2></div>
        <span class="meta">Open a collection to see its editorial logic, projects, and category mix</span>
      </header>

      <div class="collections-page__grid">
        {collections.map((collection)=>{
          const c=collection.data;
          const memberTitles=titles(c.projects);
          return (
            <article class="collection-card" data-collection-index-item={c.slug}>
              <a class="collection-card__link" href={`/collection/${c.slug}/`} aria-label={`View ${c.title} collection`}>
                <div class="collection-card__meta"><span>{c.code}</span><span>{String(c.projects.length).padStart(2,'0')} projects</span></div>
                <h3>{c.title}</h3>
                <p>{c.summary}</p>
                <ul aria-label="Example projects">
                  {memberTitles.slice(0,3).map((title)=><li>{title}</li>)}
                  {memberTitles.length>3&&<li>+ {memberTitles.length-3} more</li>}
                </ul>
                <span class="collection-card__open">View collection <i aria-hidden="true">→</i></span>
              </a>
            </article>
          );
        })}
      </div>
    </section>
  </section>
</BaseLayout>
<style>
  .collections-page{padding-top:clamp(30px,4vw,58px);padding-bottom:clamp(72px,9vw,120px)}
  .collections-page__hero{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:clamp(40px,9vw,132px);align-items:end;padding:clamp(34px,5vw,62px) 0 clamp(42px,6vw,70px);border-bottom:1px solid var(--line-strong)}
  .collections-page__hero>div:first-child{max-width:820px}.collections-page__hero .meta{color:var(--ink-muted)}
  .collections-page__hero h1{margin-top:8px;font-family:var(--font-display);font-size:clamp(3.4rem,7vw,7.2rem);line-height:.84;letter-spacing:-.045em;font-weight:500}
  .collections-page__hero p:not(.meta){margin-top:var(--space-5);max-width:66ch;color:var(--ink-secondary);font-size:clamp(.98rem,1.25vw,1.1rem);line-height:1.62}
  .collections-page__stats{display:flex;gap:clamp(28px,4vw,52px);margin:0;padding-top:13px;border-top:1px solid var(--line-strong)}.collections-page__stats div{display:grid;gap:5px;min-width:96px}.collections-page__stats dt{font:500 .68rem var(--font-meta);letter-spacing:.06em;text-transform:uppercase;color:var(--ink-muted)}.collections-page__stats dd{margin:0;font:500 1.35rem var(--font-display);font-variant-numeric:tabular-nums;color:var(--accent)}
  .collections-page__browse-model{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));margin-top:var(--space-6);border-top:1px solid var(--line-strong);border-bottom:1px solid var(--line-strong)}.collections-page__browse-model a{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:7px var(--space-4);min-height:132px;padding:18px 24px 18px 0;border-right:1px solid var(--line);text-decoration:none;background:transparent;transition:padding-inline var(--motion-fast) var(--ease-enter),background-color var(--motion-fast) var(--ease-standard)}.collections-page__browse-model a:last-child{padding-left:24px;border-right:0}.collections-page__browse-model .meta{grid-column:1/-1;color:var(--accent)}.collections-page__browse-model strong{font-family:var(--font-display);font-size:1.35rem;line-height:1.08;letter-spacing:-.012em;font-weight:500}.collections-page__browse-model p{grid-column:1/2;max-width:52ch;color:var(--ink-secondary);font-size:.76rem;line-height:1.48}.collections-page__browse-model i{grid-column:2;grid-row:2/4;align-self:center;font-style:normal;font:500 .82rem var(--font-meta);color:var(--accent)}.collections-page__browse-model a:hover,.collections-page__browse-model a:focus-visible,.collections-page__browse-model a[aria-current="page"]{padding-inline:14px;background:var(--accent-soft)}.collections-page__browse-model a:hover strong,.collections-page__browse-model a:focus-visible strong{text-decoration:underline;text-underline-offset:4px;text-decoration-thickness:1px}
  .collections-page__index{padding-top:clamp(60px,8vw,100px);scroll-margin-top:90px}
  .collections-page__section-head{display:flex;justify-content:space-between;align-items:end;gap:var(--space-5);padding-bottom:13px;border-bottom:1px solid var(--line-strong)}
  .collections-page__section-head .meta{color:var(--ink-muted)}.collections-page__section-head h2{margin-top:4px;font-family:var(--font-display);font-size:clamp(1.8rem,2.9vw,2.65rem);line-height:1;letter-spacing:-.02em;font-weight:500}.collections-page__section-head>span{max-width:48ch;text-align:right}
  .collections-page__grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));margin-top:var(--space-5);border-top:1px solid var(--line-strong)}
  .collection-card{min-width:0;border-bottom:1px solid var(--line);background:transparent}.collection-card:nth-child(odd){padding-right:clamp(24px,4vw,52px)}.collection-card:nth-child(even){padding-left:clamp(24px,4vw,52px);border-left:1px solid var(--line)}
  .collection-card__link{display:grid;grid-template-rows:auto auto minmax(3.9em,auto) 1fr auto;min-height:300px;padding:20px 0;text-decoration:none;transition:padding-inline var(--motion-fast) var(--ease-enter),background-color var(--motion-fast) var(--ease-standard)}
  .collection-card__link:hover,.collection-card__link:focus-visible{padding-inline:14px;background:var(--accent-soft)}
  .collection-card__meta{display:flex;justify-content:space-between;gap:var(--space-3);font:500 .68rem var(--font-meta);letter-spacing:.06em;text-transform:uppercase;color:var(--ink-muted)}.collection-card__meta span:first-child{color:var(--accent)}
  .collection-card h3{margin-top:var(--space-5);font-family:var(--font-display);font-size:clamp(1.6rem,2.4vw,2.15rem);line-height:1;letter-spacing:-.018em;font-weight:500}
  .collection-card p{margin-top:var(--space-3);max-width:46ch;color:var(--ink-secondary);font-size:.84rem;line-height:1.52}
  .collection-card ul{align-self:end;display:flex;flex-wrap:wrap;gap:7px 14px;list-style:none;margin:var(--space-6) 0 0;padding:var(--space-3) 0 0;border-top:1px solid var(--line-soft);font:500 .68rem var(--font-meta);letter-spacing:.05em;text-transform:uppercase;color:var(--ink-muted)}
  .collection-card li{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.collection-card li::before{content:'+';margin-right:4px;color:var(--accent)}
  .collection-card__open{display:flex;justify-content:space-between;gap:var(--space-4);align-items:center;margin-top:var(--space-4);font:500 .68rem var(--font-meta);letter-spacing:.06em;text-transform:uppercase;color:var(--accent)}.collection-card__open i{font-style:normal;color:var(--accent)}
  @media(max-width:760px){.collections-page__hero{grid-template-columns:1fr;gap:var(--space-7)}.collections-page__stats{width:min(100%,360px)}.collections-page__section-head>span{display:none}.collections-page__grid{grid-template-columns:1fr}.collection-card:nth-child(n){padding-inline:0;border-left:0}.collection-card__link{min-height:250px}}
  @media(max-width:599px){.collections-page{padding-top:var(--space-5)}.collections-page__hero{padding-top:var(--space-5)}.collections-page__hero h1{font-size:clamp(3rem,18vw,5rem)}.collections-page__browse-model{grid-template-columns:1fr;border-bottom:0}.collections-page__browse-model a:nth-child(n){min-height:108px;padding-inline:0;border-right:0;border-bottom:1px solid var(--line)}.collections-page__browse-model a:hover,.collections-page__browse-model a:focus-visible,.collections-page__browse-model a[aria-current="page"]{padding-inline:10px}.collections-page__index{padding-top:var(--space-8)}}
  @media(prefers-reduced-motion:reduce){.collections-page__browse-model a,.collection-card__link{transition:none}}
</style>