---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BrandMark from '../../components/brand/BrandMark.astro';
import { SITE } from '../../data/site';

const disciplines = [
  {
    code: '01',
    title: 'Software & tools',
    copy: 'Practical browser-based software built around a concrete workflow, with an emphasis on clarity, speed and useful defaults.',
  },
  {
    code: '02',
    title: 'Games & interaction',
    copy: 'Small and large interactive systems where controls, feedback, progression and replayability matter as much as visual presentation.',
  },
  {
    code: '03',
    title: 'Learning systems',
    copy: 'Tools for practice, recall and structured learning — designed to make repetition more deliberate and progress more visible.',
  },
  {
    code: '04',
    title: 'Publishing & experiments',
    copy: 'Long-form work, prototypes and research-driven ideas that do not fit neatly into a single product category.',
  },
];

const principles = [
  ['Use before decoration', 'A project should solve its core job clearly before extra visual or technical complexity is added.'],
  ['Local-first when it helps', 'Where practical, projects avoid unnecessary accounts, servers and dependencies so the product remains fast and durable.'],
  ['Real interfaces, real evidence', 'Finished work should be shown with authentic screenshots, working demos, measurable capabilities and honest lifecycle labels.'],
  ['Iterate, test, certify', 'Projects are refined through repeated audits across usability, accessibility, responsive behavior, performance and browser compatibility.'],
] as const;
---
<BaseLayout
  title="About — THIEPN"
  description="About the person and approach behind THIEPN: independent software, games, learning systems, publications and experiments."
>
  <main class="about page-shell">
    <header class="about-hero">
      <div class="about-hero__copy">
        <p class="meta">About / THIEPN</p>
        <h1>I build useful things.</h1>
        <p class="about-hero__lead">
          THIEPN is my independent portfolio for software, games, learning systems, publishing tools, books and experiments. The projects vary in scale, but the goal stays consistent: make something clear, useful and worth keeping.
        </p>
        <div class="about-hero__actions">
          <a class="structural-button" href="/projects/">Explore projects</a>
          <a class="text-link" href="#contact">Contact <span aria-hidden="true">↓</span></a>
        </div>
      </div>

      <aside class="about-hero__mark" aria-label="Page and Pixel identity">
        <BrandMark size={112} decorative={false} label="THIEPN Page and Pixel mark" />
        <div>
          <span class="meta">Identity</span>
          <strong>Page / Pixel</strong>
          <p>Documents, systems and digital building blocks.</p>
        </div>
      </aside>
    </header>

    <section class="about-section" aria-labelledby="build-title">
      <header class="about-section__head">
        <div><p class="meta">What I build</p><h2 id="build-title">A broad portfolio, one standard.</h2></div>
        <p>Different formats, but the same expectation: the result should work as a product rather than exist only as a concept.</p>
      </header>

      <div class="discipline-grid">
        {disciplines.map((item) => (
          <article>
            <span>{item.code}</span>
            <h3>{item.title}</h3>
            <p>{item.copy}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="about-section" aria-labelledby="approach-title">
      <header class="about-section__head">
        <div><p class="meta">Approach</p><h2 id="approach-title">How I work.</h2></div>
        <p>The portfolio is built iteratively: define the real problem, make the core experience work, then polish and verify it.</p>
      </header>

      <ol class="principle-list">
        {principles.map(([title, copy], index) => (
          <li>
            <span>{String(index + 1).padStart(2, '0')}</span>
            <div><h3>{title}</h3><p>{copy}</p></div>
          </li>
        ))}
      </ol>
    </section>

    <section class="about-section about-section--site" aria-labelledby="site-title">
      <header class="about-section__head">
        <div><p class="meta">This portfolio</p><h2 id="site-title">The site is part of the work.</h2></div>
      </header>
      <div class="about-site-grid">
        <p>
          THIEPN is not only a list of links. It is a maintained catalogue with project records, real media, status and platform information, collections, books, search and related-project discovery.
        </p>
        <p>
          The visual system is deliberately editorial rather than dashboard-like. The Page / Pixel identity combines the idea of documents and research with modular digital systems.
        </p>
      </div>
    </section>

    <section class="contact" id="contact" aria-labelledby="contact-title">
      <div class="contact__copy">
        <p class="meta">Contact</p>
        <h2 id="contact-title">Want to discuss a project?</h2>
        <p>GitHub is the public contact and source channel currently connected to this portfolio. You can also inspect the repositories behind many of the projects directly.</p>
      </div>
      <div class="contact__actions">
        <a class="structural-button" href={SITE.githubUrl} aria-label="Open THIEPN on GitHub">GitHub <span aria-hidden="true">↗</span></a>
        <a class="text-link" href="/projects/">Browse the work <span aria-hidden="true">→</span></a>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .about{padding-top:clamp(34px,5vw,66px);padding-bottom:clamp(72px,9vw,120px)}
  .about-hero{display:grid;grid-template-columns:minmax(0,1.45fr) minmax(270px,.55fr);gap:clamp(48px,9vw,136px);align-items:end;min-height:min(68vh,720px);padding:clamp(42px,6vw,78px) 0 clamp(58px,7vw,94px);border-bottom:1px solid var(--line-strong)}
  .about-hero__copy{max-width:900px}.about-hero__copy>.meta{color:var(--ink-muted)}
  .about-hero h1{margin-top:12px;max-width:9ch;font-family:var(--font-display);font-size:clamp(4.4rem,10vw,9.8rem);font-weight:500;line-height:.82;letter-spacing:-.06em}
  .about-hero__lead{margin-top:clamp(28px,4vw,46px);max-width:56ch;font-family:var(--font-display);font-size:clamp(1.18rem,1.7vw,1.58rem);line-height:1.48;letter-spacing:-.02em;color:var(--ink-secondary)}
  .about-hero__actions{display:flex;align-items:center;flex-wrap:wrap;gap:var(--space-5);margin-top:var(--space-6)}
  .about-hero__actions .structural-button,.contact .structural-button{background:var(--ink);border-color:var(--ink);color:var(--canvas)}
  .about-hero__actions .structural-button:hover,.contact .structural-button:hover{background:var(--accent);border-color:var(--accent);color:var(--accent-ink)}

  .about-hero__mark{display:grid;gap:clamp(34px,5vw,54px);padding:clamp(24px,3vw,34px) 0 4px;border-top:1px solid var(--line-strong);border-bottom:1px solid var(--line-strong)}
  .about-hero__mark :global(.brand-mark){color:var(--ink)}
  .about-hero__mark>div{display:grid;grid-template-columns:1fr auto;gap:6px 18px;padding-top:18px;border-top:1px solid var(--line)}
  .about-hero__mark .meta{color:var(--ink-muted)}.about-hero__mark strong{font-family:var(--font-display);font-size:1.28rem;font-weight:500;letter-spacing:-.02em}
  .about-hero__mark p{grid-column:1/-1;max-width:32ch;color:var(--ink-secondary);font-size:.8rem;line-height:1.5}

  .about-section{padding-top:clamp(68px,8vw,104px)}
  .about-section__head{display:grid;grid-template-columns:minmax(0,1fr) minmax(280px,.7fr);gap:clamp(34px,8vw,112px);align-items:end;padding-bottom:15px;border-bottom:1px solid var(--line-strong)}
  .about-section__head .meta{color:var(--ink-muted)}.about-section__head h2{margin-top:5px;max-width:15ch;font-family:var(--font-display);font-size:clamp(2rem,3.7vw,3.55rem);line-height:.98;letter-spacing:-.04em;font-weight:500}
  .about-section__head>p{max-width:56ch;color:var(--ink-secondary);font-size:.9rem;line-height:1.58}

  .discipline-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));border-top:1px solid var(--line);margin-top:var(--space-5)}
  .discipline-grid article{display:grid;grid-template-columns:56px minmax(0,1fr);gap:12px 22px;min-height:220px;padding:24px 26px 26px 0;border-bottom:1px solid var(--line)}
  .discipline-grid article:nth-child(even){padding-left:26px;border-left:1px solid var(--line)}
  .discipline-grid article>span{grid-row:1/3;font:500 .68rem var(--font-meta);letter-spacing:.07em;color:var(--accent)}
  .discipline-grid h3{font-family:var(--font-display);font-size:clamp(1.45rem,2.4vw,2.2rem);line-height:1;letter-spacing:-.03em;font-weight:500}
  .discipline-grid p{max-width:48ch;color:var(--ink-secondary);font-size:.86rem;line-height:1.58}

  .principle-list{list-style:none;margin:var(--space-5) 0 0;padding:0;border-top:1px solid var(--line-strong)}
  .principle-list li{display:grid;grid-template-columns:72px minmax(0,1fr);gap:var(--space-5);padding:22px 0;border-bottom:1px solid var(--line)}
  .principle-list li>span{padding-top:4px;font:500 .68rem var(--font-meta);letter-spacing:.07em;color:var(--accent)}
  .principle-list li>div{display:grid;grid-template-columns:minmax(220px,.75fr) minmax(0,1.25fr);gap:clamp(26px,6vw,84px);align-items:start}
  .principle-list h3{font-family:var(--font-display);font-size:clamp(1.3rem,2vw,1.72rem);font-weight:500;letter-spacing:-.02em}
  .principle-list p{max-width:64ch;color:var(--ink-secondary);font-size:.86rem;line-height:1.58}

  .about-section--site .about-section__head{grid-template-columns:1fr}
  .about-site-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:clamp(34px,8vw,120px);padding:clamp(28px,4vw,46px) 0;border-bottom:1px solid var(--line)}
  .about-site-grid p{max-width:60ch;font-family:var(--font-display);font-size:clamp(1.04rem,1.45vw,1.3rem);line-height:1.58;letter-spacing:-.014em;color:var(--ink-secondary)}

  .contact{scroll-margin-top:90px;display:grid;grid-template-columns:minmax(0,1.5fr) auto;gap:clamp(40px,8vw,120px);align-items:end;margin-top:clamp(78px,9vw,124px);padding:clamp(34px,5vw,54px) 0;border-top:1px solid var(--line-strong);border-bottom:1px solid var(--line-strong)}
  .contact__copy>.meta{color:var(--ink-muted)}.contact h2{margin-top:7px;max-width:15ch;font-family:var(--font-display);font-size:clamp(2.4rem,5vw,5rem);font-weight:500;line-height:.92;letter-spacing:-.05em}
  .contact__copy>p:last-child{margin-top:var(--space-4);max-width:60ch;color:var(--ink-secondary);font-size:.9rem;line-height:1.58}
  .contact__actions{display:flex;flex-direction:column;align-items:flex-end;gap:var(--space-4)}

  @media(max-width:900px){.about-hero{grid-template-columns:1fr;min-height:0}.about-hero__mark{grid-template-columns:auto minmax(0,1fr);align-items:center}.about-hero__mark>div{align-self:stretch}.about-section__head{grid-template-columns:1fr;gap:var(--space-4)}.principle-list li>div{grid-template-columns:1fr;gap:8px}.contact{grid-template-columns:1fr}.contact__actions{align-items:flex-start;flex-direction:row;flex-wrap:wrap}}
  @media(max-width:620px){.about{padding-top:var(--space-5)}.about-hero{padding-top:var(--space-5);gap:var(--space-8)}.about-hero h1{font-size:clamp(3.7rem,18vw,6rem)}.about-hero__mark{grid-template-columns:1fr}.discipline-grid{grid-template-columns:1fr}.discipline-grid article:nth-child(n){min-height:0;padding:22px 0;border-left:0}.principle-list li{grid-template-columns:46px minmax(0,1fr);gap:var(--space-3)}.about-site-grid{grid-template-columns:1fr;gap:var(--space-5)}.contact__actions{flex-direction:column}.about-section{padding-top:var(--space-9)}}
</style>
