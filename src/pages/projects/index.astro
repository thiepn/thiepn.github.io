---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CategoryIndex from '../../components/archive/CategoryIndex.astro';
import ProjectArchive from '../../components/archive/ProjectArchive.astro';
import { getCatalogueStats, getPublicProjects } from '../../lib/catalogue';
const projects = await getPublicProjects();
const stats = await getCatalogueStats();
const categoryCount = Object.values(stats.categories).filter(Boolean).length;
---
<BaseLayout title="Projects — THIEPN" description="Browse, search, and filter all public THIEPN projects.">
  <section class="projects-page page-shell" aria-labelledby="projects-title">
    <header class="projects-page__hero">
      <div class="projects-page__intro">
        <p class="meta">Project directory</p>
        <h1 id="projects-title">Projects</h1>
        <p>Games, tools, learning systems, Bible projects and experiments. Browse directly or narrow the directory by category.</p>
      </div>
      <dl class="projects-page__stats" aria-label="Project counts">
        <div><dt>Public</dt><dd>{String(stats.totalListed).padStart(2,'0')}</dd></div>
        <div><dt>Categories</dt><dd>{String(categoryCount).padStart(2,'0')}</dd></div>
      </dl>
    </header>

    <section class="projects-page__types" aria-labelledby="category-title">
      <header class="projects-page__section-head">
        <div><p class="meta">Browse by type</p><h2 id="category-title">Categories</h2></div>
        <span class="meta">Choose a category or use the full directory below</span>
      </header>
      <CategoryIndex stats={stats} />
    </section>

    <section class="projects-page__browser" aria-labelledby="browser-title">
      <header class="projects-page__section-head">
        <div><p class="meta">Directory</p><h2 id="browser-title">Find a project</h2></div>
        <span class="meta">Search · Filter · Sort · View</span>
      </header>
      <ProjectArchive projects={projects} />
    </section>
  </section>
</BaseLayout>
<style>
  .projects-page{padding-top:clamp(26px,4vw,52px);padding-bottom:clamp(64px,8vw,104px)}
  .projects-page__hero{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:clamp(32px,8vw,110px);align-items:end;padding:clamp(28px,4vw,50px) 0 clamp(34px,5vw,58px);border-bottom:1px solid var(--line-strong)}
  .projects-page__intro{max-width:760px}.projects-page__intro>.meta{color:var(--ink-muted)}
  .projects-page__hero h1{margin-top:8px;font-size:clamp(2.8rem,5.2vw,5rem);line-height:.93;letter-spacing:-.055em;font-weight:560}
  .projects-page__hero p:not(.meta){margin-top:var(--space-4);max-width:62ch;color:var(--ink-secondary);font-size:clamp(.96rem,1.2vw,1.08rem);line-height:1.55}
  .projects-page__stats{display:grid;grid-template-columns:repeat(2,minmax(90px,1fr));margin:0;border-top:1px solid var(--line-strong);border-left:1px solid var(--line)}
  .projects-page__stats div{display:grid;gap:5px;min-width:110px;padding:12px;border-right:1px solid var(--line);border-bottom:1px solid var(--line)}
  .projects-page__stats dt{font:500 .56rem var(--font-meta);letter-spacing:.06em;text-transform:uppercase;color:var(--ink-muted)}
  .projects-page__stats dd{margin:0;font:600 1.05rem var(--font-meta);font-variant-numeric:tabular-nums}
  .projects-page__types{padding-top:clamp(38px,5vw,58px)}
  .projects-page__types :global(.category-index){margin-top:var(--space-4)}
  .projects-page__browser{padding-top:clamp(48px,6vw,72px)}
  .projects-page__section-head{display:flex;justify-content:space-between;align-items:end;gap:var(--space-5);padding-bottom:12px;border-bottom:1px solid var(--line-strong)}
  .projects-page__section-head h2{margin-top:3px;font-size:clamp(1.45rem,2.4vw,2.15rem);line-height:1;letter-spacing:-.035em;font-weight:560}
  .projects-page__section-head>.meta{max-width:44ch;text-align:right;color:var(--ink-muted)}
  @media(max-width:760px){.projects-page__hero{grid-template-columns:1fr;gap:var(--space-6)}.projects-page__stats{width:min(100%,360px)}.projects-page__section-head>.meta{display:none}}
  @media(max-width:599px){.projects-page{padding-top:var(--space-5)}.projects-page__hero{padding-top:var(--space-5)}.projects-page__hero h1{font-size:clamp(2.7rem,14vw,4rem)}.projects-page__types{padding-top:var(--space-7)}.projects-page__browser{padding-top:var(--space-8)}}
</style>
