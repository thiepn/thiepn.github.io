---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CategoryIndex from '../../components/archive/CategoryIndex.astro';
import ProjectArchive from '../../components/archive/ProjectArchive.astro';
import { PROJECT_INTENTS, getIntentCounts } from '../../data/discovery';
import { getCatalogueStats, getPublicProjects } from '../../lib/catalogue';
const projects = await getPublicProjects();
const books = await getCollection('books');
const stats = await getCatalogueStats();
const categoryCount = Object.values(stats.categories).filter(Boolean).length;
const intentCounts = getIntentCounts(projects.map(({ data }) => data));
const intentCount = (intent: (typeof PROJECT_INTENTS)[number]) => intent.key === 'read' ? intentCounts.read + books.length : intentCounts[intent.key];
const intentHref = (intent: (typeof PROJECT_INTENTS)[number]) => intent.key === 'read' ? '/books/' : `/projects/?intent=${intent.key}#archive-catalogue`;
---
<BaseLayout title="Projects — THIEPN" description="Browse, search, and filter all public THIEPN projects.">
  <section class="projects-page page-shell" aria-labelledby="projects-title">
    <header class="projects-page__hero">
      <div class="projects-page__intro">
        <p class="meta">Project directory</p>
        <h1 id="projects-title">Projects</h1>
        <p>Start with what you want to do, browse the six canonical project categories, open Books for published long-form works, or switch to Collections for overlapping themes. Intent is a discovery shortcut; every project still has one canonical category.</p>
      </div>
      <dl class="projects-page__stats" aria-label="Project counts">
        <div><dt>Public</dt><dd>{String(stats.totalListed).padStart(2,'0')}</dd></div>
        <div><dt>Categories</dt><dd>{String(categoryCount).padStart(2,'0')}</dd></div>
      </dl>
    </header>

    <nav class="projects-page__browse-model" aria-label="Portfolio browsing model" data-portfolio-browse-model>
      <a href="#intent-title">
        <span class="meta">00 / Intent</span>
        <strong>Visitor intent</strong>
        <p>Derived discovery shortcuts. Play, Use, Learn, Read, and Explore do not change project classification.</p>
        <i aria-hidden="true">↓</i>
      </a>
      <a href="#category-title">
        <span class="meta">01 / Categories</span>
        <strong>Project type</strong>
        <p>Singular classification. Each project appears in exactly one category.</p>
        <i aria-hidden="true">↓</i>
      </a>
      <a href="/collections/">
        <span class="meta">02 / Collections</span>
        <strong>Editorial themes</strong>
        <p>Overlapping groupings. A project can appear in several collections.</p>
        <i aria-hidden="true">→</i>
      </a>
      <a href="/books/">
        <span class="meta">03 / Books</span>
        <strong>Published works</strong>
        <p>Long-form publications with real editions, cover art, and reading in the THIEPN Library.</p>
        <i aria-hidden="true">→</i>
      </a>
    </nav>

    <section class="projects-page__intents" aria-labelledby="intent-title" data-intent-discovery>
      <header class="projects-page__section-head">
        <div><p class="meta">Browse by visitor intent</p><h2 id="intent-title">What do you want to do?</h2></div>
        <span class="meta">Derived discovery · books remain a separate publication surface</span>
      </header>
      <nav class="intent-index" aria-label="Browse projects and publications by intent">
        {PROJECT_INTENTS.map((intent, index) => (
          <a href={intentHref(intent)} data-archive-intent-link={intent.key} data-project-intent={intent.key}>
            <span class="intent-index__number">0{index + 1}</span>
            <strong>{intent.label}</strong>
            <p>{intent.description}</p>
            <small>{String(intentCount(intent)).padStart(2,'0')} items</small>
            <i aria-hidden="true">{intent.key === 'read' ? '→' : '↓'}</i>
          </a>
        ))}
      </nav>
    </section>

    <section class="projects-page__types" aria-labelledby="category-title">
      <header class="projects-page__section-head">
        <div><p class="meta">Browse by project type</p><h2 id="category-title">Categories</h2></div>
        <span class="meta">One category per project · choose a type or use the full directory</span>
      </header>
      <CategoryIndex stats={stats} />
    </section>

    <section class="projects-page__browser" aria-labelledby="browser-title">
      <header class="projects-page__section-head">
        <div><p class="meta">Directory</p><h2 id="browser-title">Find a project</h2></div>
        <span class="meta">Intent · Category · Search · Sort · View</span>
      </header>
      <ProjectArchive projects={projects} />
    </section>
  </section>
</BaseLayout>
<style>
  .projects-page{padding-top:clamp(30px,4vw,58px);padding-bottom:clamp(72px,9vw,120px)}
  .projects-page__hero{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:clamp(40px,9vw,132px);align-items:end;padding:clamp(34px,5vw,62px) 0 clamp(42px,6vw,70px);border-bottom:1px solid var(--line-strong)}
  .projects-page__intro{max-width:820px}.projects-page__intro>.meta{color:var(--ink-muted)}
  .projects-page__hero h1{margin-top:8px;font-family:var(--font-display);font-size:clamp(3.4rem,7vw,7.2rem);line-height:.84;letter-spacing:-.045em;font-weight:500}
  .projects-page__hero p:not(.meta){margin-top:var(--space-5);max-width:70ch;color:var(--ink-secondary);font-size:clamp(.98rem,1.25vw,1.1rem);line-height:1.62}
  .projects-page__stats{display:flex;gap:clamp(28px,4vw,52px);margin:0;padding-top:13px;border-top:1px solid var(--line-strong)}
  .projects-page__stats div{display:grid;gap:5px;min-width:96px}.projects-page__stats dt{font:500 .68rem var(--font-meta);letter-spacing:.06em;text-transform:uppercase;color:var(--ink-muted)}.projects-page__stats dd{margin:0;font:500 1.35rem var(--font-display);font-variant-numeric:tabular-nums;color:var(--accent)}
  .projects-page__browse-model{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));margin-top:var(--space-6);border-top:1px solid var(--line-strong);border-bottom:1px solid var(--line-strong)}.projects-page__browse-model a{position:relative;display:grid;grid-template-columns:minmax(0,1fr) auto;gap:7px var(--space-4);min-height:146px;padding:18px 20px 18px 0;border-right:1px solid var(--line);text-decoration:none;background:transparent;transition:padding-inline var(--motion-fast) var(--ease-enter),background-color var(--motion-fast) var(--ease-standard)}.projects-page__browse-model a:not(:first-child){padding-left:20px}.projects-page__browse-model a:last-child{border-right:0}.projects-page__browse-model .meta{grid-column:1/-1;color:var(--accent)}.projects-page__browse-model strong{font-family:var(--font-display);font-size:1.3rem;line-height:1.08;letter-spacing:-.012em;font-weight:500}.projects-page__browse-model p{grid-column:1/2;max-width:48ch;color:var(--ink-secondary);font-size:.76rem;line-height:1.48}.projects-page__browse-model i{grid-column:2;grid-row:2/4;align-self:center;font-style:normal;font:500 .8rem var(--font-meta);color:var(--accent)}.projects-page__browse-model a:hover,.projects-page__browse-model a:focus-visible{padding-inline:14px;background:var(--accent-soft)}.projects-page__browse-model a:hover strong,.projects-page__browse-model a:focus-visible strong{text-decoration:underline;text-underline-offset:4px;text-decoration-thickness:1px}
  .projects-page__intents{padding-top:clamp(54px,7vw,88px);scroll-margin-top:90px}
  .intent-index{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));margin-top:var(--space-5);border-top:1px solid var(--line-strong);border-bottom:1px solid var(--line-strong)}
  .intent-index a{position:relative;display:grid;grid-template-columns:minmax(0,1fr) auto;grid-template-areas:'number count' 'title title' 'copy copy';gap:10px 12px;min-height:188px;padding:17px;border-right:1px solid var(--line);text-decoration:none;background:transparent;transition:background-color var(--motion-fast) var(--ease-standard),padding-inline var(--motion-fast) var(--ease-enter)}
  .intent-index a:last-child{border-right:0}.intent-index a:hover,.intent-index a:focus-visible{padding-inline:22px;background:var(--accent-soft)}
  .intent-index__number{grid-area:number;font:500 .68rem var(--font-meta);letter-spacing:.07em;color:var(--accent)}
  .intent-index small{grid-area:count;justify-self:end;font:500 .68rem var(--font-meta);letter-spacing:.055em;text-transform:uppercase;color:var(--ink-muted)}
  .intent-index strong{grid-area:title;align-self:end;font-family:var(--font-display);font-size:clamp(1.35rem,2.2vw,1.9rem);line-height:1;letter-spacing:-.015em;font-weight:500}
  .intent-index p{grid-area:copy;padding-right:18px;color:var(--ink-secondary);font-size:.76rem;line-height:1.48}
  .intent-index i{position:absolute;right:17px;bottom:17px;font-style:normal;color:var(--accent)}
  .projects-page__types{padding-top:clamp(58px,7vw,92px);scroll-margin-top:90px}
  .projects-page__types :global(.category-index){margin-top:var(--space-5)}
  .projects-page__browser{padding-top:clamp(64px,8vw,104px);scroll-margin-top:90px}
  .projects-page__section-head{display:flex;justify-content:space-between;align-items:end;gap:var(--space-5);padding-bottom:13px;border-bottom:1px solid var(--line-strong)}
  .projects-page__section-head h2{margin-top:4px;font-family:var(--font-display);font-size:clamp(1.8rem,2.9vw,2.65rem);line-height:1;letter-spacing:-.02em;font-weight:500}
  .projects-page__section-head>.meta{max-width:48ch;text-align:right;color:var(--ink-muted)}
  @media(max-width:1080px){.projects-page__browse-model{grid-template-columns:repeat(2,minmax(0,1fr))}.projects-page__browse-model a:nth-child(2){border-right:0}.projects-page__browse-model a:nth-child(-n+2){border-bottom:1px solid var(--line)}.intent-index{grid-template-columns:repeat(3,minmax(0,1fr))}.intent-index a:nth-child(3){border-right:0}.intent-index a:nth-child(-n+3){border-bottom:1px solid var(--line)}}
  @media(max-width:760px){.projects-page__hero{grid-template-columns:1fr;gap:var(--space-7)}.projects-page__stats{width:min(100%,360px)}.projects-page__browse-model{grid-template-columns:1fr;border-bottom:0}.projects-page__browse-model a:nth-child(n){min-height:108px;padding-inline:0;border-right:0;border-bottom:1px solid var(--line)}.projects-page__browse-model a:hover,.projects-page__browse-model a:focus-visible{padding-inline:10px}.projects-page__section-head>.meta{display:none}.intent-index{grid-template-columns:repeat(2,minmax(0,1fr))}.intent-index a:nth-child(n){border-right:1px solid var(--line);border-bottom:1px solid var(--line)}.intent-index a:nth-child(even){border-right:0}}
  @media(max-width:599px){.projects-page{padding-top:var(--space-5)}.projects-page__hero{padding-top:var(--space-5)}.projects-page__hero h1{font-size:clamp(3rem,18vw,5rem)}.projects-page__intents,.projects-page__types{padding-top:var(--space-8)}.projects-page__browser{padding-top:var(--space-9)}.intent-index{grid-template-columns:1fr;border-bottom:0}.intent-index a:nth-child(n){min-height:142px;border-right:0}.intent-index a:hover,.intent-index a:focus-visible{padding-inline:17px}}
  @media(prefers-reduced-motion:reduce){.projects-page__browse-model a,.intent-index a{transition:none}}
</style>