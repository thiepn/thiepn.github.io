---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CategoryIndex from '../../components/archive/CategoryIndex.astro';
import ProjectArchive from '../../components/archive/ProjectArchive.astro';
import { PROJECT_INTENTS, getIntentCounts } from '../../data/discovery';
import { getCatalogueStats, getPublicProjects } from '../../lib/catalogue';
const projects = await getPublicProjects();
const books = await getCollection('books');
const stats = await getCatalogueStats();
const categoryCount = Object.values(stats.categories).filter(Boolean).length;
const intentCounts = getIntentCounts(projects.map(({ data }) => data));
const intentCount = (intent: (typeof PROJECT_INTENTS)[number]) => intent.key === 'read' ? intentCounts.read + books.length : intentCounts[intent.key];
const intentHref = (intent: (typeof PROJECT_INTENTS)[number]) => intent.key === 'read' ? '/books/' : `/projects/?intent=${intent.key}#archive-catalogue`;
---
<BaseLayout title="Projects — THIEPN" description="Browse, search, and filter all public THIEPN projects.">
  <section class="projects-page page-shell" aria-labelledby="projects-title">
    <header class="projects-page__hero">
      <div class="projects-page__intro">
        <p class="meta">Project directory</p>
        <h1 id="projects-title">Projects</h1>
        <p>Start with what you want to do, browse the six canonical project categories, open Books for published long-form works, or switch to Collections for overlapping themes. Intent is a discovery shortcut; every project still has one canonical category.</p>
      </div>
      <dl class="projects-page__stats" aria-label="Project counts">
        <div><dt>Public</dt><dd>{String(stats.totalListed).padStart(2,'0')}</dd></div>
        <div><dt>Categories</dt><dd>{String(categoryCount).padStart(2,'0')}</dd></div>
      </dl>
    </header>

    <nav class="projects-page__browse-model" aria-label="Portfolio browsing model" data-portfolio-browse-model>
      <a href="#intent-title">
        <span class="meta">00 / Intent</span>
        <strong>Visitor intent</strong>
        <p>Derived discovery shortcuts. Play, Use, Learn, Read, and Explore do not change project classification.</p>
        <i aria-hidden="true">↓</i>
      </a>
      <a href="#category-title">
        <span class="meta">01 / Categories</span>
        <strong>Project type</strong>
        <p>Singular classification. Each project appears in exactly one category.</p>
        <i aria-hidden="true">↓</i>
      </a>
      <a href="/collections/">
        <span class="meta">02 / Collections</span>
        <strong>Editorial themes</strong>
        <p>Overlapping groupings. A project can appear in several collections.</p>
        <i aria-hidden="true">→</i>
      </a>
      <a href="/books/">
        <span class="meta">03 / Books</span>
        <strong>Published works</strong>
        <p>Long-form publications with real editions, cover art, and reading in the THIEPN Library.</p>
        <i aria-hidden="true">→</i>
      </a>
    </nav>

    <section class="projects-page__intents" aria-labelledby="intent-title" data-intent-discovery>
      <header class="projects-page__section-head">
        <div><p class="meta">Browse by visitor intent</p><h2 id="intent-title">What do you want to do?</h2></div>
        <span class="meta">Derived discovery · books remain a separate publication surface</span>
      </header>
      <nav class="intent-index" aria-label="Browse projects and publications by intent">
        {PROJECT_INTENTS.map((intent, index) => (
          <a href={intentHref(intent)} data-archive-intent-link={intent.key} data-project-intent={intent.key}>
            <span class="intent-index__number">0{index + 1}</span>
            <strong>{intent.label}</strong>
            <p>{intent.description}</p>
            <small>{String(intentCount(intent)).padStart(2,'0')} items</small>
            <i aria-hidden="true">{intent.key === 'read' ? '→' : '↓'}</i>
          </a>
        ))}
      </nav>
    </section>

    <section class="projects-page__types" aria-labelledby="category-title">
      <header class="projects-page__section-head">
        <div><p class="meta">Browse by project type</p><h2 id="category-title">Categories</h2></div>
        <span class="meta">One category per project · choose a type or use the full directory</span>
      </header>
      <CategoryIndex stats={stats} />
    </section>

    <section class="projects-page__browser" aria-labelledby="browser-title">
      <header class="projects-page__section-head">
        <div><p class="meta">Directory</p><h2 id="browser-title">Find a project</h2></div>
        <span class="meta">Intent · Category · Search · Sort · View</span>
      </header>
      <ProjectArchive projects={projects} />
    </section>
  </section>
</BaseLayout>
<style>
  .projects-page{padding-top:clamp(26px,4vw,52px);padding-bottom:clamp(64px,8vw,104px)}
  .projects-page__hero{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:clamp(32px,8vw,110px);align-items:end;padding:clamp(28px,4vw,50px) 0 clamp(34px,5vw,58px);border-bottom:1px solid var(--line-strong)}
  .projects-page__intro{max-width:760px}.projects-page__intro>.meta{color:var(--ink-muted)}
  .projects-page__hero h1{margin-top:8px;font-size:clamp(2.8rem,5.2vw,5rem);line-height:.93;letter-spacing:-.055em;font-weight:560}
  .projects-page__hero p:not(.meta){margin-top:var(--space-4);max-width:68ch;color:var(--ink-secondary);font-size:clamp(.96rem,1.2vw,1.08rem);line-height:1.55}
  .projects-page__stats{display:grid;grid-template-columns:repeat(2,minmax(90px,1fr));margin:0;border-top:1px solid var(--line-strong);border-left:1px solid var(--line)}
  .projects-page__stats div{display:grid;gap:5px;min-width:110px;padding:12px;border-right:1px solid var(--line);border-bottom:1px solid var(--line)}
  .projects-page__stats dt{font:500 .56rem var(--font-meta);letter-spacing:.06em;text-transform:uppercase;color:var(--ink-muted)}
  .projects-page__stats dd{margin:0;font:600 1.05rem var(--font-meta);font-variant-numeric:tabular-nums}
  .projects-page__browse-model{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));border-left:1px solid var(--line);margin-top:var(--space-5)}.projects-page__browse-model a{position:relative;display:grid;grid-template-columns:minmax(0,1fr) auto;gap:5px var(--space-4);min-height:126px;padding:14px;border-top:1px solid var(--line);border-right:1px solid var(--line);border-bottom:1px solid var(--line);text-decoration:none}.projects-page__browse-model .meta{grid-column:1/-1;color:var(--ink-muted)}.projects-page__browse-model strong{font-size:1.15rem;line-height:1.1;letter-spacing:-.025em;font-weight:560}.projects-page__browse-model p{grid-column:1/2;max-width:48ch;color:var(--ink-secondary);font-size:.72rem;line-height:1.45}.projects-page__browse-model i{grid-column:2;grid-row:2/4;align-self:center;font-style:normal;font:500 .8rem var(--font-meta);color:var(--ink-muted)}.projects-page__browse-model a:hover,.projects-page__browse-model a:focus-visible{background:var(--surface-2)}.projects-page__browse-model a:hover strong,.projects-page__browse-model a:focus-visible strong{text-decoration:underline;text-underline-offset:4px;text-decoration-thickness:1px}
  .projects-page__intents{padding-top:clamp(38px,5vw,58px);scroll-margin-top:90px}
  .intent-index{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));border-top:1px solid var(--line);border-left:1px solid var(--line);margin-top:var(--space-4)}
  .intent-index a{position:relative;display:grid;grid-template-columns:minmax(0,1fr) auto;grid-template-areas:'number count' 'title title' 'copy copy';gap:9px 12px;min-height:168px;padding:14px;border-right:1px solid var(--line);border-bottom:1px solid var(--line);text-decoration:none;background:var(--surface-1)}
  .intent-index a:hover,.intent-index a:focus-visible{background:var(--surface-2)}
  .intent-index__number{grid-area:number;font:500 .59rem var(--font-meta);letter-spacing:.07em;color:var(--ink-muted)}
  .intent-index small{grid-area:count;justify-self:end;font:500 .58rem var(--font-meta);letter-spacing:.055em;text-transform:uppercase;color:var(--ink-muted)}
  .intent-index strong{grid-area:title;align-self:end;font-size:clamp(1.3rem,2vw,1.8rem);line-height:1;letter-spacing:-.04em;font-weight:560}
  .intent-index p{grid-area:copy;padding-right:18px;color:var(--ink-secondary);font-size:.72rem;line-height:1.45}
  .intent-index i{position:absolute;right:14px;bottom:14px;font-style:normal;color:var(--ink-muted)}
  .projects-page__types{padding-top:clamp(42px,5vw,64px);scroll-margin-top:90px}
  .projects-page__types :global(.category-index){margin-top:var(--space-4)}
  .projects-page__browser{padding-top:clamp(48px,6vw,72px);scroll-margin-top:90px}
  .projects-page__section-head{display:flex;justify-content:space-between;align-items:end;gap:var(--space-5);padding-bottom:12px;border-bottom:1px solid var(--line-strong)}
  .projects-page__section-head h2{margin-top:3px;font-size:clamp(1.45rem,2.4vw,2.15rem);line-height:1;letter-spacing:-.035em;font-weight:560}
  .projects-page__section-head>.meta{max-width:48ch;text-align:right;color:var(--ink-muted)}
  @media(max-width:1080px){.projects-page__browse-model{grid-template-columns:repeat(2,minmax(0,1fr))}.intent-index{grid-template-columns:repeat(3,minmax(0,1fr))}}
  @media(max-width:760px){.projects-page__hero{grid-template-columns:1fr;gap:var(--space-6)}.projects-page__stats{width:min(100%,360px)}.projects-page__browse-model{grid-template-columns:1fr}.projects-page__browse-model a{min-height:104px}.projects-page__section-head>.meta{display:none}.intent-index{grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media(max-width:599px){.projects-page{padding-top:var(--space-5)}.projects-page__hero{padding-top:var(--space-5)}.projects-page__hero h1{font-size:clamp(2.7rem,14vw,4rem)}.projects-page__intents,.projects-page__types{padding-top:var(--space-7)}.projects-page__browser{padding-top:var(--space-8)}.intent-index{grid-template-columns:1fr}.intent-index a{min-height:132px}}
</style>
