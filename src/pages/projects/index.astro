---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CategoryIndex from '../../components/archive/CategoryIndex.astro';
import ProjectArchive from '../../components/archive/ProjectArchive.astro';
import { getCatalogueStats, getPublicProjects } from '../../lib/catalogue';
const projects = await getPublicProjects();
const stats = await getCatalogueStats();
---
<BaseLayout title="Projects — THIEPN" description="Browse, search, and filter all public THIEPN projects.">
  <section class="projects-page page-shell" aria-labelledby="projects-title">
    <header class="projects-page__hero">
      <div>
        <p class="meta">All public projects</p>
        <h1 id="projects-title">Projects</h1>
        <p>Browse everything I currently share: games, tools, learning projects, Bible projects, and experiments.</p>
      </div>
      <aside aria-label="Project counts">
        <span class="meta">Public</span><strong>{String(stats.totalListed).padStart(2,'0')}</strong>
        <span class="meta">Categories</span><strong>{String(Object.values(stats.categories).filter(Boolean).length).padStart(2,'0')}</strong>
      </aside>
    </header>

    <section class="projects-page__types" aria-label="Project categories">
      <CategoryIndex stats={stats} />
    </section>

    <section class="projects-page__browser" aria-labelledby="browser-title">
      <header class="projects-page__section-head">
        <div><p class="meta">Browse</p><h2 id="browser-title">Find a project</h2></div>
        <span class="meta">Search · Filter · Sort</span>
      </header>
      <ProjectArchive projects={projects} />
    </section>
  </section>
</BaseLayout>
<style>
  .projects-page{padding-top:clamp(40px,5vw,72px);padding-bottom:var(--space-9)}
  .projects-page__hero{display:grid;grid-template-columns:minmax(0,1fr) minmax(230px,.28fr);gap:clamp(36px,8vw,110px);align-items:end;padding:var(--space-7) 0 var(--space-8);border-bottom:1px solid var(--line-strong)}
  .projects-page__hero h1{margin-top:var(--space-3);font-size:var(--text-display-l);line-height:.88;letter-spacing:-.06em}
  .projects-page__hero p:not(.meta){margin-top:var(--space-5);max-width:60ch;color:var(--ink-secondary);font-size:var(--text-body-l)}
  .projects-page__hero aside{display:grid;grid-template-columns:1fr auto;gap:8px 16px;border-top:1px solid var(--line-strong);padding-top:var(--space-4)}
  .projects-page__hero aside strong{font:600 1rem var(--font-meta);text-align:right}.projects-page__hero aside .meta{color:var(--ink-muted)}
  .projects-page__types{padding:var(--space-7) 0 var(--space-8)}
  .projects-page__browser{padding-top:var(--space-6)}
  .projects-page__section-head{display:flex;justify-content:space-between;align-items:end;gap:var(--space-5);padding-bottom:var(--space-4);border-bottom:1px solid var(--line-strong)}
  .projects-page__section-head h2{margin-top:4px;font-size:var(--text-h2);letter-spacing:-.04em}
  .projects-page__section-head>.meta{color:var(--ink-muted)}
  @media(max-width:899px){.projects-page__hero{grid-template-columns:1fr}.projects-page__hero aside{max-width:420px}}
  @media(max-width:599px){.projects-page__types{padding-bottom:var(--space-7)}.projects-page__section-head{align-items:flex-start}.projects-page__section-head>.meta{display:none}}
</style>
