---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublicProjects } from '../../lib/catalogue';
import { typeLabels, presentation } from '../../lib/showcase';
const projects = (await getPublicProjects()).sort((a,b) => a.data.title.localeCompare(b.data.title));
const types = [...new Set(projects.map(p=>p.data.category))];
---
<BaseLayout title="All projects — THIEPN" description="Search the complete archive of games, useful tools, learning systems and experiments by Jonathan.">
<div class="page-shell page-content"><header class="page-intro"><p class="eyebrow">The complete archive</p><h1>All projects.</h1><div class="page-intro__bottom"><p>The useful, the playful, and the works in progress.</p><a class="action-link" href="/work/">Back to selected work <span aria-hidden="true">→</span></a></div></header>
<section class="simple-archive" id="archive-catalogue" data-simple-archive aria-label="Find a project">
<form class="archive-filter" method="get" action="/projects/"><label>Search<input name="q" type="search" placeholder="A name, a topic, an idea…" data-archive-query autocomplete="off"/></label><label>Type<select name="category" data-archive-type><option value="all">All types</option>{types.map(type=><option value={type}>{typeLabels[type]}</option>)}</select></label><label>Sort<select name="sort" data-archive-sort><option value="az">A–Z</option><option value="newest">Newest additions</option></select></label><button class="button" type="submit">Find projects</button></form>
<p class="archive-count" data-simple-count aria-live="polite" aria-atomic="true">{projects.length} projects</p>
<div class="archive-empty" data-simple-empty hidden><h2>No matching projects.</h2><p>Try a shorter search or a different type.</p><button class="button" data-simple-reset type="button">Clear search and filters</button></div>
<div class="archive-rows" data-simple-rows>{projects.map(project=>{const p=project.data;const view=presentation(project);return <article class="archive-item" data-simple-item data-title={p.title} data-date={p.dateAdded.toISOString()} data-type={p.category} data-search={[p.title,p.subtitle,p.summary,p.code,...p.tags,...p.aliases].join(' ')}><div class="archive-item__main"><h2><a href={`/project/${p.slug}/`}>{p.title}</a></h2><p>{view.summary}</p>{p.status !== 'live' && <small class="archive-item__status">{p.status === 'beta' ? 'In beta' : p.status}</small>}</div><span class="archive-item__type">{typeLabels[p.category]}</span><a class="action-link" href={p.liveUrl && !p.unavailable ? p.liveUrl : `/project/${p.slug}/`} aria-label={view.action}>{p.liveUrl ? p.actions.primaryLabel.replace(' tool','') : 'Details'}<span aria-hidden="true">↗</span></a></article>})}</div>
<noscript><p class="archive-noscript">All projects are listed below. Browser Find can search this page; interactive filters require JavaScript.</p></noscript>
</section></div>
<script>import '../../scripts/simple-archive';</script>
</BaseLayout>
