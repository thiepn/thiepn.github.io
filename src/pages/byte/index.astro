---
import BaseLayout from '../../layouts/BaseLayout.astro';

const version = '0.1.0';
const releaseUrl = 'https://github.com/thiepn/byte/releases/tag/v0.1.0';
const installerUrl = 'https://github.com/thiepn/byte/releases/download/v0.1.0/Byte-v0.1.0-windows-x64-setup.exe';
const portableUrl = 'https://github.com/thiepn/byte/releases/download/v0.1.0/Byte-v0.1.0-windows-x64-portable.zip';
const sourceUrl = 'https://github.com/thiepn/byte';
const characterRoot = 'https://raw.githubusercontent.com/thiepn/byte/v0.1.0/public/assets/characters';

const characters = [
  {
    id: 'byte',
    name: 'Byte',
    note: 'The original compact robot. Calm, expressive, and built for tiny desktop spaces.',
    image: characterRoot + '/byte/preview.png',
    className: 'byte'
  },
  {
    id: 'mochi',
    name: 'Mochi',
    note: 'A round cat-like companion with big paws, bouncy reactions, and Bongo-Cat energy.',
    image: characterRoot + '/mochi/preview.png',
    className: 'mochi'
  },
  {
    id: 'pip',
    name: 'Pip',
    note: 'A soft blob companion with simple expressions and playful squash-and-stretch motion.',
    image: characterRoot + '/pip/preview.png',
    className: 'pip'
  },
  {
    id: 'kiwi',
    name: 'Kiwi',
    note: 'A lively bird companion with pecking typing reactions and energetic movement.',
    image: characterRoot + '/kiwi/preview.png',
    className: 'kiwi'
  }
];

const features = [
  {
    title: 'System health, without the dashboard',
    body: 'Byte watches CPU, memory, storage, network, battery and best-effort temperature locally, then turns them into plain-language states: Calm, Busy, Stressed, or Needs attention.',
    mark: '01'
  },
  {
    title: 'Click Byte for the useful part',
    body: 'The Quick Panel explains the most important issue, shows a compact resource overview, and offers safe shortcuts like Task Manager or Windows storage settings.',
    mark: '02'
  },
  {
    title: 'A deeper view when you need it',
    body: 'Open the full app for Overview, Activity history, point-in-time app diagnostics, customization, notification controls, accessibility options, and settings.',
    mark: '03'
  },
  {
    title: 'Four characters, six habitats',
    body: 'Choose Byte, Mochi, Pip or Kiwi, then place them in Meadow, Cozy Desk, Bedroom, Space, Aquarium or Rooftop. Add palettes, cosmetics, decorations and a personality.',
    mark: '04'
  },
  {
    title: 'Desktop-aware by design',
    body: 'Byte can hide for fullscreen games, movies and presentations, pause heavier work during lock and sleep states, and restore itself when your desktop returns.',
    mark: '05'
  },
  {
    title: 'Private by default',
    body: 'There is no account or cloud analytics. Byte does not collect typed text, key identity, browser history, clipboard content or mouse-coordinate history.',
    mark: '06'
  }
];

const modes = [
  ['Habitat', 'The full little world around your companion.'],
  ['Perch', 'A smaller companion that sits against the Windows work area.'],
  ['Mini', 'Character-only mode for the smallest footprint.'],
  ['Edge', 'Keeps Byte snapped to the side of your screen.'],
  ['Tray', 'Hide the companion while Byte keeps monitoring locally.']
];
---

<BaseLayout
  title="Byte — Cute system health for Windows — THIEPN"
  description="Download Byte, a privacy-first Windows desktop companion that turns system health into a cute customizable character."
  ogImage="/og/index.png"
>
  <div class="byte-page">
    <section class="byte-hero page-shell" aria-labelledby="byte-title">
      <div class="byte-hero__copy">
        <div class="byte-chip-row">
          <span class="byte-chip byte-chip--blue">Windows app</span>
          <span class="byte-chip">v{version}</span>
          <span class="byte-chip">Privacy-first</span>
        </div>

        <p class="byte-kicker">A desktop companion that understands your PC.</p>
        <h1 id="byte-title">Meet Byte.</h1>
        <p class="byte-hero__lead">
          Byte turns system health into a small, expressive character on your desktop—so you can tell when your PC is calm, busy, stressed, or actually needs attention without living inside a hardware dashboard.
        </p>

        <div class="byte-hero__actions">
          <a class="byte-button byte-button--primary" href={installerUrl}>
            <span class="byte-button__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24"><path d="M12 3v11m0 0 4-4m-4 4-4-4M5 17v3h14v-3"/></svg>
            </span>
            Download for Windows
          </a>
          <a class="byte-button byte-button--quiet" href="#how-to-use">See how it works</a>
        </div>

        <div class="byte-hero__meta" aria-label="Download information">
          <span>Windows x64</span>
          <i aria-hidden="true"></i>
          <span>Current-user install</span>
          <i aria-hidden="true"></i>
          <span>No account</span>
          <i aria-hidden="true"></i>
          <span>Open source</span>
        </div>
      </div>

      <div class="byte-hero__visual" aria-label="Illustration of Byte running on a Windows desktop">
        <div class="desktop-scene">
          <div class="desktop-glow desktop-glow--one"></div>
          <div class="desktop-glow desktop-glow--two"></div>

          <div class="window-card window-card--main" aria-hidden="true">
            <div class="window-titlebar">
              <span class="window-appmark">
                <img src={characterRoot + '/byte/preview.png'} alt="" />
              </span>
              <strong>Byte</strong>
              <span class="window-dots"><i></i><i></i><i></i></span>
            </div>
            <div class="window-layout">
              <div class="window-sidebar">
                <span class="side-pill active"></span>
                <span class="side-pill"></span>
                <span class="side-pill"></span>
                <span class="side-pill"></span>
              </div>
              <div class="window-content">
                <p class="mini-label">Your PC feels</p>
                <div class="status-line"><span class="status-orb"></span><strong>Calm</strong></div>
                <p class="status-copy">Everything looks comfortable right now.</p>
                <div class="resource-grid">
                  <div><span>CPU</span><strong>24%</strong><i><b style="width:24%"></b></i></div>
                  <div><span>Memory</span><strong>48%</strong><i><b style="width:48%"></b></i></div>
                  <div><span>Storage</span><strong>61%</strong><i><b style="width:61%"></b></i></div>
                </div>
              </div>
            </div>
          </div>

          <div class="habitat-card" aria-hidden="true">
            <div class="habitat-sky"></div>
            <span class="habitat-cloud cloud-a"></span>
            <span class="habitat-cloud cloud-b"></span>
            <span class="habitat-hill hill-a"></span>
            <span class="habitat-hill hill-b"></span>
            <span class="habitat-flower flower-a"></span>
            <span class="habitat-flower flower-b"></span>
            <img src={characterRoot + '/byte/preview.png'} alt="" />
            <span class="habitat-label">Habitat mode</span>
          </div>

          <div class="quick-card" aria-hidden="true">
            <div class="quick-card__head">
              <span class="status-orb"></span>
              <div><small>BYTE SAYS</small><strong>Everything looks calm.</strong></div>
            </div>
            <div class="quick-card__resources">
              <span>CPU <b>24%</b></span>
              <span>RAM <b>48%</b></span>
            </div>
            <div class="quick-card__action">Open Byte <span>→</span></div>
          </div>
        </div>

        <p class="visual-note">Companion, Quick Panel, and full app—three levels of detail instead of one giant monitoring screen.</p>
      </div>
    </section>

    <nav class="byte-subnav" aria-label="Byte page sections">
      <div class="page-shell byte-subnav__inner">
        <a href="#showcase">Showcase</a>
        <a href="#characters">Characters</a>
        <a href="#features">Features</a>
        <a href="#how-to-use">How to use</a>
        <a href="#download">Download</a>
      </div>
    </nav>

    <section class="byte-section page-shell" id="showcase" aria-labelledby="showcase-title">
      <div class="section-intro">
        <div>
          <p class="byte-kicker">Three layers, one tiny companion</p>
          <h2 id="showcase-title">Glance. Click. Investigate.</h2>
        </div>
        <p>
          Byte stays quiet until you need more detail. Most of the time, the character and its environment are enough. One click opens the explanation. The full app is there for the deeper stuff.
        </p>
      </div>

      <div class="showcase-grid">
        <article class="showcase-card showcase-card--companion">
          <div class="showcase-card__copy">
            <span class="showcase-index">01 · Companion</span>
            <h3>System health you can read at a glance.</h3>
            <p>
              Byte reacts to typing, clicks, charging, network activity, heat, memory pressure, low battery and more—while still behaving like a character, not a gauge.
            </p>
          </div>
          <div class="companion-demo" aria-hidden="true">
            <div class="companion-demo__world">
              <span class="demo-star star-a"></span><span class="demo-star star-b"></span>
              <span class="demo-moon"></span>
              <span class="demo-building building-a"></span>
              <span class="demo-building building-b"></span>
              <span class="demo-building building-c"></span>
              <img src={characterRoot + '/byte/preview.png'} alt="" />
              <span class="demo-speech">all calm</span>
            </div>
            <div class="mode-strip">
              {modes.map(([name]) => <span class:list={[name === 'Habitat' && 'active']}>{name}</span>)}
            </div>
          </div>
        </article>

        <article class="showcase-card showcase-card--panel">
          <div class="showcase-card__copy">
            <span class="showcase-index">02 · Quick Panel</span>
            <h3>The useful explanation, one click away.</h3>
            <p>
              Get the current status, primary issue, resource overview, companion controls and safe Windows actions without opening a large application.
            </p>
          </div>
          <div class="panel-demo" aria-hidden="true">
            <div class="panel-demo__top">
              <span class="panel-avatar"><img src={characterRoot + '/byte/preview.png'} alt="" /></span>
              <div><small>CURRENT STATE</small><strong><span></span> Calm</strong></div>
            </div>
            <div class="panel-demo__message">
              <strong>Your PC looks comfortable.</strong>
              <p>No sustained issues need your attention.</p>
            </div>
            <div class="panel-demo__meters">
              <div><span>CPU</span><b>24%</b><i><em style="width:24%"></em></i></div>
              <div><span>Memory</span><b>48%</b><i><em style="width:48%"></em></i></div>
              <div><span>Storage</span><b>61%</b><i><em style="width:61%"></em></i></div>
            </div>
            <button type="button" tabindex="-1">Open full Byte</button>
          </div>
        </article>

        <article class="showcase-card showcase-card--app">
          <div class="showcase-card__copy">
            <span class="showcase-index">03 · Full app</span>
            <h3>Details when you actually want details.</h3>
            <p>
              Review activity, inspect current app resource usage, change the companion, tune notifications and accessibility, or revisit privacy and startup settings.
            </p>
          </div>
          <div class="app-demo" aria-hidden="true">
            <div class="app-demo__sidebar">
              <span class="app-brand"><img src={characterRoot + '/byte/preview.png'} alt="" /><b>Byte</b></span>
              <span class="nav-row active"><i></i>Overview</span>
              <span class="nav-row"><i></i>Activity</span>
              <span class="nav-row"><i></i>Apps</span>
              <span class="nav-row"><i></i>Customize</span>
              <span class="nav-row"><i></i>Settings</span>
            </div>
            <div class="app-demo__body">
              <small>OVERVIEW</small>
              <h4>Your PC feels calm.</h4>
              <p>Nothing needs attention.</p>
              <div class="app-demo__cards">
                <span><small>CPU</small><b>24%</b></span>
                <span><small>Memory</small><b>48%</b></span>
                <span><small>Storage</small><b>61%</b></span>
              </div>
              <div class="trend-line"><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div>
            </div>
          </div>
        </article>
      </div>
    </section>

    <section class="character-band" id="characters" aria-labelledby="characters-title">
      <div class="page-shell">
        <div class="section-intro section-intro--light">
          <div>
            <p class="byte-kicker">Pick your desktop roommate</p>
            <h2 id="characters-title">Four characters. Very different energy.</h2>
          </div>
          <p>
            They share the same system intelligence, but not the same personality on screen. Every character has its own authored poses, reactions, rare idles and palettes.
          </p>
        </div>

        <div class="character-grid">
          {characters.map((character) => (
            <article class:list={['character-card', 'character-card--' + character.className]}>
              <div class="character-card__stage">
                <span class="pixel-grid" aria-hidden="true"></span>
                <img src={character.image} alt={character.name + ' character preview'} loading="lazy" />
              </div>
              <div class="character-card__copy">
                <h3>{character.name}</h3>
                <p>{character.note}</p>
              </div>
            </article>
          ))}
        </div>

        <div class="character-facts">
          <span><b>26</b> authored poses each</span>
          <span><b>8+</b> palettes each</span>
          <span><b>12 + 12</b> cosmetics &amp; decorations</span>
          <span><b>6</b> habitats</span>
          <span><b>3</b> personalities</span>
        </div>
      </div>
    </section>

    <section class="byte-section page-shell" id="features" aria-labelledby="features-title">
      <div class="section-intro">
        <div>
          <p class="byte-kicker">What Byte actually does</p>
          <h2 id="features-title">Cute outside. Serious boundaries underneath.</h2>
        </div>
        <p>
          The point is not to add another technical dashboard to your desktop. Byte filters local system signals into something understandable, then stays out of the way.
        </p>
      </div>

      <div class="feature-grid">
        {features.map((feature) => (
          <article class="feature-card">
            <span class="feature-mark">{feature.mark}</span>
            <h3>{feature.title}</h3>
            <p>{feature.body}</p>
          </article>
        ))}
      </div>

      <div class="privacy-panel">
        <div class="privacy-panel__visual" aria-hidden="true">
          <span class="lock-shape">
            <i></i>
            <b></b>
          </span>
          <span class="privacy-pulse pulse-a"></span>
          <span class="privacy-pulse pulse-b"></span>
        </div>
        <div class="privacy-panel__copy">
          <p class="byte-kicker">Local means local</p>
          <h3>Byte watches your PC, not you.</h3>
          <p>
            System monitoring and interaction reactions stay on your machine. Global input is anonymous activity only: Byte does not store which keys you pressed, what you typed, your clipboard, window titles, browsing history or cursor coordinates.
          </p>
          <ul>
            <li>No account or sign-in</li>
            <li>No cloud analytics</li>
            <li>No uploaded process history</li>
            <li>No generic shell or arbitrary command access</li>
          </ul>
          <a href={sourceUrl + '/blob/v0.1.0/docs/SECURITY_PRIVACY.md'}>Read the security &amp; privacy model ↗</a>
        </div>
      </div>
    </section>

    <section class="use-band" id="how-to-use" aria-labelledby="use-title">
      <div class="page-shell">
        <div class="section-intro">
          <div>
            <p class="byte-kicker">Your first five minutes</p>
            <h2 id="use-title">Download it. Meet your character. Put it where you want.</h2>
          </div>
          <p>
            Byte is designed so you should not need a manual, but here is the complete start-to-finish path.
          </p>
        </div>

        <ol class="use-steps">
          <li>
            <span class="step-number">1</span>
            <div>
              <h3>Install Byte</h3>
              <p>Download the Windows installer below and run it. It installs for your current Windows user, so administrator elevation is not normally required.</p>
            </div>
          </li>
          <li>
            <span class="step-number">2</span>
            <div>
              <h3>Finish the 30-second setup</h3>
              <p>Byte explains what it can read locally, lets you enable or disable system monitoring, and keeps Smart Notifications off unless you explicitly opt in.</p>
            </div>
          </li>
          <li>
            <span class="step-number">3</span>
            <div>
              <h3>Choose your companion</h3>
              <p>Pick Byte, Mochi, Pip or Kiwi, select a habitat and decide whether you want the full Habitat, Perch, Mini, Edge or Tray-only display mode.</p>
            </div>
          </li>
          <li>
            <span class="step-number">4</span>
            <div>
              <h3>Move Byte into place</h3>
              <p>Use <strong>Move Byte</strong> from the Quick Panel or tray menu, drag the companion once, and Byte remembers a safe monitor-relative position for that mode.</p>
            </div>
          </li>
          <li>
            <span class="step-number">5</span>
            <div>
              <h3>Click Byte when you want an explanation</h3>
              <p>The Quick Panel shows the current state, key resources and the most important issue. Open the full app only when you want history, app diagnostics or settings.</p>
            </div>
          </li>
          <li>
            <span class="step-number">6</span>
            <div>
              <h3>Make it yours</h3>
              <p>Open Customize to change palettes, habitats, cosmetics, decorations, personality, size and interaction level. Changes save locally and apply immediately.</p>
            </div>
          </li>
        </ol>

        <div class="mode-guide" aria-labelledby="mode-guide-title">
          <div class="mode-guide__title">
            <p class="byte-kicker">Display modes</p>
            <h3 id="mode-guide-title">How much Byte do you want on screen?</h3>
          </div>
          <div class="mode-guide__rows">
            {modes.map(([name, description]) => (
              <div>
                <strong>{name}</strong>
                <p>{description}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="byte-section page-shell" aria-labelledby="notifications-title">
      <div class="split-feature">
        <div class="split-feature__copy">
          <p class="byte-kicker">Smart Notifications</p>
          <h2 id="notifications-title">Alerts only when something has stayed wrong long enough to matter.</h2>
          <p>
            Byte uses sustained timing, recovery rules and per-category cooldowns instead of firing notifications for every temporary spike. You choose which categories are allowed, and you can use Quiet mode or snooze them.
          </p>
          <div class="micro-list">
            <span>Memory pressure</span>
            <span>Thermal pressure</span>
            <span>Storage pressure</span>
            <span>Battery</span>
            <span>Confident runaway process</span>
          </div>
        </div>
        <div class="notification-stack" aria-hidden="true">
          <div class="notification-card notification-card--back">
            <span class="notif-icon">B</span>
            <div><strong>Byte</strong><p>System status update</p></div>
          </div>
          <div class="notification-card">
            <span class="notif-icon">B</span>
            <div>
              <div class="notif-heading"><strong>Byte noticed sustained memory pressure</strong><small>now</small></div>
              <p>Open Byte to see the current cause and next step.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="download-band" id="download" aria-labelledby="download-title">
      <div class="page-shell download-layout">
        <div class="download-copy">
          <p class="byte-kicker">Byte {version}</p>
          <h2 id="download-title">Put a tiny system companion on your desktop.</h2>
          <p>
            The installer is the recommended option. The portable ZIP contains a standalone <code>Byte.exe</code> if you prefer not to install the app.
          </p>

          <div class="download-actions">
            <a class="byte-button byte-button--primary byte-button--large" href={installerUrl}>
              <span class="byte-button__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24"><path d="M12 3v11m0 0 4-4m-4 4-4-4M5 17v3h14v-3"/></svg>
              </span>
              Download installer
            </a>
            <a class="byte-button byte-button--outline" href={portableUrl}>Portable ZIP</a>
          </div>

          <p class="download-meta">Windows x64 · v{version} · current-user NSIS installer · open source</p>
        </div>

        <aside class="install-card" aria-labelledby="install-card-title">
          <span class="install-card__eyebrow">Before you run it</span>
          <h3 id="install-card-title">Windows may show an unknown-publisher warning.</h3>
          <p>
            Byte v0.1.0 is fully release-certified but is not Authenticode-signed yet. If SmartScreen appears, first make sure the file came from this page or the official GitHub release.
          </p>
          <ol>
            <li>Confirm the filename is <code>Byte-v0.1.0-windows-x64-setup.exe</code>.</li>
            <li>Optionally verify its SHA-256 checksum below.</li>
            <li>On the SmartScreen dialog, choose <strong>More info</strong>, then <strong>Run anyway</strong>.</li>
          </ol>
          <details>
            <summary>Verify the installer checksum</summary>
            <code class="hash">effef85d352a283634433e22ecc80b7e5440e11a18e5e84002fb103bd5f0526e</code>
            <p>PowerShell: <code>Get-FileHash .\Byte-v0.1.0-windows-x64-setup.exe -Algorithm SHA256</code></p>
          </details>
        </aside>
      </div>

      <div class="page-shell release-footer">
        <div>
          <strong>Release certification</strong>
          <p>Three packaged launches, duplicate-launch handoff, install/reinstall/uninstall, data preservation, x64/version checks and GitHub build provenance all passed before publication.</p>
        </div>
        <div class="release-links">
          <a href={releaseUrl}>Release v{version} ↗</a>
          <a href={sourceUrl}>Source code ↗</a>
          <a href={sourceUrl + '/blob/v0.1.0/docs/RELEASE_CERTIFICATION.md'}>Certification details ↗</a>
        </div>
      </div>
    </section>

    <section class="faq page-shell" aria-labelledby="faq-title">
      <div class="faq__intro">
        <p class="byte-kicker">A few useful answers</p>
        <h2 id="faq-title">Before Byte moves in.</h2>
      </div>
      <div class="faq__items">
        <details open>
          <summary>Does Byte upload my system data?</summary>
          <p>No. System telemetry, customization and activity history stay local. Byte does not use cloud analytics or require an account.</p>
        </details>
        <details>
          <summary>Can I hide Byte during games or presentations?</summary>
          <p>Yes. Byte can automatically suppress the companion during fullscreen and presentation states, then restore it afterward. You can also use Tray mode whenever you want it completely out of the way.</p>
        </details>
        <details>
          <summary>Can Byte clean RAM or kill processes for me?</summary>
          <p>No. Byte intentionally avoids generic process killing, RAM trimming and “optimizer” behavior. It explains issues and can open a small allowlist of safe Windows destinations such as Task Manager.</p>
        </details>
        <details>
          <summary>How do updates work?</summary>
          <p>Byte does not silently poll, download or install updates. You choose Stable or Beta in Settings and use Check for updates when you want to open the corresponding official GitHub release page.</p>
        </details>
      </div>
    </section>

    <section class="closing-cta">
      <div class="page-shell closing-cta__inner">
        <img src={characterRoot + '/byte/preview.png'} alt="" aria-hidden="true" />
        <div>
          <p class="byte-kicker">Ready?</p>
          <h2>Byte is waiting on the desktop.</h2>
        </div>
        <a class="byte-button byte-button--primary" href={installerUrl}>Download Byte {version}</a>
      </div>
    </section>
  </div>

  <style>
    .byte-page {
      --byte-blue: #4f8cff;
      --byte-blue-strong: #2565e8;
      --byte-blue-soft: #eaf2ff;
      --byte-navy: #10203a;
      --byte-ink: #1c2b42;
      --byte-muted: #627089;
      --byte-line: #d9e3ef;
      --byte-panel: #f7faff;
      --byte-green: #55c69a;
      --byte-warm: #ffbf69;
      --byte-deep: #0b1424;
      --byte-radius: 22px;
      overflow: hidden;
      color: var(--byte-ink);
      background:
        radial-gradient(circle at 6% 4%, rgb(104 166 255 / 14%), transparent 25rem),
        linear-gradient(180deg, #fbfdff 0%, #f7faff 36%, #fff 100%);
    }

    .byte-page :where(h1,h2,h3,h4) {
      color: var(--byte-navy);
      letter-spacing: -.045em;
    }

    .byte-page :where(p) { text-wrap: pretty; }

    .byte-hero {
      min-height: 690px;
      padding-top: clamp(64px, 8vw, 116px);
      padding-bottom: clamp(70px, 8vw, 112px);
      display: grid;
      grid-template-columns: minmax(0, .88fr) minmax(520px, 1.12fr);
      align-items: center;
      gap: clamp(48px, 7vw, 104px);
    }

    .byte-chip-row { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 28px; }
    .byte-chip {
      display: inline-flex; align-items: center; min-height: 30px; padding: 5px 11px;
      border: 1px solid var(--byte-line); border-radius: 18px;
      background: rgb(255 255 255 / 74%);
      font: 600 .72rem/1.2 var(--font-meta);
      color: var(--byte-muted);
      letter-spacing: .025em;
    }
    .byte-chip--blue { border-color: #bed2ff; background: var(--byte-blue-soft); color: #315fae; }

    .byte-kicker {
      margin: 0 0 13px;
      color: #4770aa;
      font-size: .83rem;
      font-weight: 650;
      letter-spacing: .025em;
    }

    .byte-hero h1 {
      margin: 0;
      max-width: 8ch;
      font-size: clamp(4.5rem, 9vw, 8rem);
      line-height: .86;
      font-weight: 650;
      letter-spacing: -.075em;
    }

    .byte-hero__lead {
      max-width: 59ch;
      margin-top: 30px;
      color: #4f6078;
      font-size: clamp(1.08rem, 1.35vw, 1.3rem);
      line-height: 1.7;
    }

    .byte-hero__actions, .download-actions {
      display: flex; flex-wrap: wrap; align-items: center; gap: 12px;
      margin-top: 34px;
    }

    .byte-button {
      min-height: 50px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 11px;
      padding: 12px 18px;
      border: 1px solid transparent;
      border-radius: 12px;
      font-size: .92rem;
      font-weight: 650;
      text-decoration: none;
      transition: transform 160ms ease, box-shadow 160ms ease, background-color 160ms ease, border-color 160ms ease;
    }
    .byte-button:hover { text-decoration: none; transform: translateY(-1px); }
    .byte-button--primary {
      color: #fff;
      background: linear-gradient(180deg, #5a94ff, #3377f0);
      border-color: #2d6fe6;
      
    }
    .byte-button--primary:hover {
      color: #fff;
      background: linear-gradient(180deg, #6ba0ff, #2a6ee8);
      
    }
    .byte-button--quiet { color: #40526b; background: transparent; border-color: #dce5f0; }
    .byte-button--quiet:hover, .byte-button--outline:hover { color: #235cb6; border-color: #9fbee9; background: #fff; }
    .byte-button--outline { color: #334760; border-color: #cbd9ea; background: rgb(255 255 255 / 76%); }
    .byte-button--large { min-height: 58px; padding-inline: 23px; font-size: 1rem; }
    .byte-button__icon { width: 20px; height: 20px; display: inline-grid; place-items: center; }
    .byte-button__icon svg { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }

    .byte-hero__meta {
      display: flex; flex-wrap: wrap; gap: 8px 11px; align-items: center;
      margin-top: 24px; color: #718098; font-size: .78rem;
    }
    .byte-hero__meta i { width: 3px; height: 3px; border-radius: 50%; background: #a9b7c9; }

    .byte-hero__visual { min-width: 0; }
    .desktop-scene {
      position: relative;
      height: clamp(460px, 43vw, 590px);
      border: 1px solid #cbdcf2;
      border-radius: 22px;
      overflow: hidden;
      background:
        linear-gradient(135deg, rgb(255 255 255 / 45%), transparent 40%),
        linear-gradient(145deg, #dbe9ff 0%, #bcd7ff 47%, #d5ebed 100%);
      
      isolation: isolate;
    }
    .desktop-scene::after {
      content: '';
      position: absolute; inset: auto 0 0; height: 22%;
      background: linear-gradient(180deg, transparent, rgb(46 72 105 / 12%));
      pointer-events: none;
    }
    .desktop-glow { position:absolute; border-radius:50%;  opacity:.8; }
    .desktop-glow--one { width: 260px; height:260px; background:#ecf6ff; right:-30px; top:-60px; }
    .desktop-glow--two { width: 190px; height:190px; background:#d7f0de; left:20px; bottom:-80px; }

    .window-card {
      position: absolute;
      border: 1px solid rgb(132 159 194 / 44%);
      border-radius: 18px;
      overflow: hidden;
      background: rgb(251 253 255 / 91%);
      
      
    }
