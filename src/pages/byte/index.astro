    .window-layout { height:calc(100% - 42px); display:grid; grid-template-columns:54px 1fr; }
    .window-sidebar { padding:18px 12px; border-right:1px solid #e5edf6; display:flex; flex-direction:column; gap:12px; }
    .side-pill { width:29px; height:9px; border-radius:18px; background:#dfe7f0; }
    .side-pill.active { background:#8cb4ff; }
    .window-content { padding:22px 25px; }
    .mini-label { margin:0; color:#8390a4; font-size:.6rem; font-weight:700; letter-spacing:.08em; }
