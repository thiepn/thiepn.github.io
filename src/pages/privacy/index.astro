---
import BaseLayout from '../../layouts/BaseLayout.astro';

const token = import.meta.env.PUBLIC_CLOUDFLARE_WEB_ANALYTICS_TOKEN?.trim() ?? '';
const analyticsConfigured = import.meta.env.PROD && token.length > 0;
---
<BaseLayout
  title="Privacy — THIEPN"
  description="How THIEPN handles privacy, local preferences, and privacy-conscious aggregate web analytics."
>
  <div class="page-shell privacy-page">
    <header class="privacy-hero">
      <p class="eyebrow">Site policy</p>
      <h1>Privacy</h1>
      <p class="privacy-hero__lede">THIEPN is designed to work without accounts, advertising profiles, or persistent analytics identifiers.</p>
      <div class="privacy-status" data-analytics-status={analyticsConfigured ? 'configured' : 'not-configured'}>
        <span class="privacy-status__label">Analytics status</span>
        <strong>{analyticsConfigured ? 'Configured' : 'Not configured'}</strong>
        <span>{analyticsConfigured ? 'The privacy guards below apply before the analytics beacon can load.' : 'No Cloudflare Web Analytics beacon is emitted by this deployment.'}</span>
      </div>
    </header>

    <div class="privacy-grid">
      <section aria-labelledby="analytics-heading">
        <p class="section-index">01</p>
        <h2 id="analytics-heading">Aggregate analytics</h2>
        <p>When configured, THIEPN uses Cloudflare Web Analytics for aggregate traffic and real-user performance measurement. It is intentionally limited to page and performance analytics rather than behavioral event tracking.</p>
        <p>Useful measurements can include visits and page views, page path, referring origin, broad country, browser, operating-system and device categories, plus load timing and Core Web Vitals.</p>
      </section>

      <section aria-labelledby="not-collected-heading">
        <p class="section-index">02</p>
        <h2 id="not-collected-heading">Deliberate limits</h2>
        <ul>
          <li>No analytics cookies, <code>localStorage</code>, <code>sessionStorage</code>, or persistent visitor ID.</li>
          <li>No advertising pixels, ad profiles, fingerprinting, or cross-site analytics tracking.</li>
          <li>No custom analytics events for searches, clicks, project launches, or book reads.</li>
          <li>No analytics beacon on URLs containing a query string or fragment, so filter/search state is not sent as the landing URL.</li>
          <li>No analytics on development routes or pages marked <code>noindex</code>.</li>
        </ul>
      </section>

      <section aria-labelledby="signals-heading">
        <p class="section-index">03</p>
        <h2 id="signals-heading">Browser privacy signals</h2>
        <p>Before requesting Cloudflare's analytics script, THIEPN checks Global Privacy Control and Do Not Track. If either signal opts out, the analytics script is not requested.</p>
        <p>The site also uses a <code>strict-origin</code> referrer policy, reducing referrer information to the origin rather than a full page path or query.</p>
      </section>

      <section aria-labelledby="provider-heading">
        <p class="section-index">04</p>
        <h2 id="provider-heading">Cloudflare processing</h2>
        <p>Cloudflare documents Web Analytics as privacy-first and cookie-free. Its RUM documentation states that the browser beacon does not access browser storage and that the source IP received during normal network handling is discarded at the nearest Cloudflare data center rather than stored in RUM core databases or logs.</p>
        <p class="privacy-links">
          <a href="https://developers.cloudflare.com/web-analytics/about/" rel="noreferrer">Web Analytics documentation <span aria-hidden="true">↗</span></a>
          <a href="https://developers.cloudflare.com/speed/observatory/rum-beacon/" rel="noreferrer">RUM data details <span aria-hidden="true">↗</span></a>
          <a href="https://www.cloudflare.com/privacypolicy/" rel="noreferrer">Cloudflare privacy policy <span aria-hidden="true">↗</span></a>
        </p>
      </section>

      <section class="privacy-local" aria-labelledby="local-heading">
        <p class="section-index">05</p>
        <h2 id="local-heading">Local site preferences</h2>
        <p>Analytics storage is separate from functional site preferences. For example, the THIEPN theme control may store a light/dark preference locally in your browser so the interface can remember your choice. That preference is not used as an analytics identifier or sent as an analytics event.</p>
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  .privacy-page{padding:clamp(4rem,8vw,7.5rem) 0 clamp(5rem,9vw,8rem)}
  .privacy-hero{max-width:820px;margin-bottom:clamp(3.5rem,7vw,6rem)}
  .eyebrow,.section-index{margin:0 0 var(--space-3);font:600 .72rem var(--font-meta);letter-spacing:.12em;text-transform:uppercase;color:var(--ink-muted)}
  h1{margin:0;font-size:clamp(3.6rem,10vw,8.4rem);line-height:.88;letter-spacing:-.075em}
  .privacy-hero__lede{max-width:720px;margin:var(--space-6) 0 0;font-size:clamp(1.08rem,2.2vw,1.45rem);line-height:1.55;color:var(--ink-secondary)}
  .privacy-status{display:grid;grid-template-columns:auto auto 1fr;align-items:baseline;gap:var(--space-3) var(--space-5);margin-top:var(--space-7);padding:var(--space-4) 0;border-block:1px solid var(--line-strong);font:500 .76rem/1.55 var(--font-meta);color:var(--ink-muted)}
  .privacy-status__label{text-transform:uppercase;letter-spacing:.09em}.privacy-status strong{color:var(--ink);font-weight:650}
  .privacy-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0 var(--space-8);border-top:1px solid var(--line-strong)}
  .privacy-grid section{padding:clamp(2rem,4vw,3.5rem) 0;border-bottom:1px solid var(--line-strong)}
  .privacy-grid h2{margin:0 0 var(--space-4);font-size:clamp(1.35rem,2.3vw,1.8rem);letter-spacing:-.035em}
  .privacy-grid p,.privacy-grid li{font-size:.98rem;line-height:1.72;color:var(--ink-secondary)}
  .privacy-grid p{margin:0 0 var(--space-4)}
  .privacy-grid ul{margin:0;padding-left:1.25rem}.privacy-grid li+li{margin-top:.55rem}
  .privacy-grid code{font:500 .86em var(--font-meta);color:var(--ink)}
  .privacy-local{grid-column:1/-1;max-width:820px}
  .privacy-links{display:flex;flex-wrap:wrap;gap:var(--space-3) var(--space-5)}
  .privacy-links a{min-height:44px;display:inline-flex;align-items:center;font:600 .72rem var(--font-meta);letter-spacing:.045em;text-transform:uppercase;text-underline-offset:4px}
  @media(max-width:760px){.privacy-grid{grid-template-columns:1fr}.privacy-local{grid-column:auto}.privacy-status{grid-template-columns:1fr auto}.privacy-status>span:last-child{grid-column:1/-1}}
</style>
