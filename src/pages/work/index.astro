---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectExhibit from '../../components/studio/ProjectExhibit.astro';
import { getPublicProjects } from '../../lib/catalogue';
import { showcase, selectProjects } from '../../lib/showcase';
const projects = selectProjects(await getPublicProjects(), showcase.work);
---
<BaseLayout title="Selected work — THIEPN" description="A selection of games, browser tools, learning systems and interactive projects by Jonathan.">
<div class="page-shell page-content"><header class="page-intro"><h1>Selected work</h1><div class="page-intro__bottom"><a class="action-link" href="/projects/">All projects <span aria-hidden="true">→</span></a></div></header>
<div class="work-gallery">{projects.map((project,index) => <ProjectExhibit project={project} heading="h2" priority={index < 2}/>)}</div>
</div>
</BaseLayout>
